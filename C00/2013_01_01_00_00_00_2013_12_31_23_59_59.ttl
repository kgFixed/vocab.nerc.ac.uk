@prefix tree: <https://w3id.org/tree#> .
@prefix ldes: <https://w3id.org/ldes#> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

@base <https://kgfixed.github.io/vocab.nerc.ac.uk/C00/2013_01_01_00_00_00_2013_12_31_23_59_59.ttl> .

<>
    a tree:Node
     .

<feed>
  a ldes:EventStream ;
  ldes:timestampPath dc:modified ;
  ldes:versionOfPath dc:isVersionOf ;
  
  
  tree:shape [
    a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path dc:isVersionOf
    ],
    [
      sh:datatype xsd:dateTime ;
      sh:minCount 1 ;
      sh:path dc:modified
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:altLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:prefLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:definition
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:notation
    ];
    sh:targetClass skos:Concept
  ] ;
  tree:view <> ;
  .

<feed> tree:member <http://vocab.nerc.ac.uk/collection/C00/current/PEVENT/1/> .
<http://vocab.nerc.ac.uk/collection/C00/current/PEVENT/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/C00/current/PEVENT/>;
    dc:modified '2013-05-07T11:36:41'^^xsd:dateTime ;
    skos:altLabel 'Avg_Uway'^^xsd:string ;
    skos:prefLabel 'Averaged underway bathymetry'@en ;
    skos:definition 'Bathymetric depth was obtained by averaging underway echo-sounder data over the duration of the data collection event. EVENT water depths obtained using PEVENT and subsequently ported to ZESH (e.g. CTD migration) are obtained in this way.'@en ;
    skos:notation 'SDN:C00::PEVENT'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/C00/current/BUDS/2/> .
<http://vocab.nerc.ac.uk/collection/C00/current/BUDS/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/C00/current/BUDS/>;
    dc:modified '2013-04-24T15:16:56'^^xsd:dateTime ;
    skos:altLabel 'BUDS'^^xsd:string ;
    skos:prefLabel 'BUDS object'@en ;
    skos:definition 'Bathymetric depth was obtained from shipboard echosounder data processed by BODC using the BUDS underway data system. The acceptable depth value located closest to the series position (providing separation distance is reasonable) is taken.'@en ;
    skos:notation 'SDN:C00::BUDS'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/C00/current/CTDDATA/2/> .
<http://vocab.nerc.ac.uk/collection/C00/current/CTDDATA/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/C00/current/CTDDATA/>;
    dc:modified '2013-04-23T13:36:39'^^xsd:dateTime ;
    skos:altLabel 'CTD_data'^^xsd:string ;
    skos:prefLabel 'CTD data'@en ;
    skos:definition 'Bathymetric depth was obtained from the depth below surface recorded by the CTD pressure sensor and the height above the bed obtained from the CTD package altimeter at the time of closest approach of the CTD package to the bed.'@en ;
    skos:notation 'SDN:C00::CTDDATA'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/C00/current/GEBCO00/3/> .
<http://vocab.nerc.ac.uk/collection/C00/current/GEBCO00/3/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/C00/current/GEBCO00/>;
    dc:modified '2013-04-23T11:38:23'^^xsd:dateTime ;
    skos:altLabel 'GEBCO_1-minute'^^xsd:string ;
    skos:prefLabel 'GEBCO one-minute grid'@en ;
    skos:definition 'Bathymetric depth set to the value for the one-minute by one-minute grid cell containing the series spatial coverage from the GEBCO one-minute gridded bathymetry.'@en ;
    skos:notation 'SDN:C00::GEBCO00'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/C00/current/DATAHEAD/1/> .
<http://vocab.nerc.ac.uk/collection/C00/current/DATAHEAD/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/C00/current/DATAHEAD/>;
    dc:modified '2013-04-23T10:30:15'^^xsd:dateTime ;
    skos:altLabel 'Data_header'^^xsd:string ;
    skos:prefLabel 'Usage metadata in data header'@en ;
    skos:definition 'Bathymetric depth was obtained from the value included as usage metadata in the header of the source file for the series.'@en ;
    skos:notation 'SDN:C00::DATAHEAD'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/C00/current/CRREP/1/> .
<http://vocab.nerc.ac.uk/collection/C00/current/CRREP/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/C00/current/CRREP/>;
    dc:modified '2013-04-23T10:27:20'^^xsd:dateTime ;
    skos:altLabel 'Cruise_report'^^xsd:string ;
    skos:prefLabel 'Cruise report'@en ;
    skos:definition 'Bathymetric depth was obtained from the value published in the cruise report for the data collection activity.'@en ;
    skos:notation 'SDN:C00::CRREP'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/C00/current/SCILOG/1/> .
<http://vocab.nerc.ac.uk/collection/C00/current/SCILOG/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/C00/current/SCILOG/>;
    dc:modified '2013-04-23T10:24:43'^^xsd:dateTime ;
    skos:altLabel 'Science_log'^^xsd:string ;
    skos:prefLabel 'Scientific log sheets'@en ;
    skos:definition 'Bathymetric depth was obtained from the value logged for the data collection activity by the scientific party. This is generally a spot reading at some stage during the activity taken from the scientific echo sounder.'@en ;
    skos:notation 'SDN:C00::SCILOG'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/C00/current/BRIDGE/1/> .
<http://vocab.nerc.ac.uk/collection/C00/current/BRIDGE/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/C00/current/BRIDGE/>;
    dc:modified '2013-04-23T10:22:29'^^xsd:dateTime ;
    skos:altLabel 'Bridge_log'^^xsd:string ;
    skos:prefLabel 'Bridge log sheets'@en ;
    skos:definition 'Bathymetric depth was obtained from the value logged for the data collection activity by the ship\'s deck officers. This will be based on the bridge echosounder which may not be the same instrument used by the scientific party.'@en ;
    skos:notation 'SDN:C00::BRIDGE'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/C00/current/GEBCO0801/1/> .
