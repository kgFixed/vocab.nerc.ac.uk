    skos:altLabel 'GEBCO_08_20100927'^^xsd:string ;
    skos:prefLabel 'GEBCO_08 grid version 20100927'@en ;
    skos:definition 'Bathymetric depth set to the value for the 30-second by 30-second grid cell containing the series spatial coverage from the GEBCO-08 gridded bathymetry published on 2010-09-27.'@en ;
    skos:notation 'SDN:C00::GEBCO0801'^^xsd:string .
