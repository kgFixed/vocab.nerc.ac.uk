  ] ;
  tree:view <> ;
  .

<feed> tree:member <http://vocab.nerc.ac.uk/collection/C00/current/CHART/2/> .
<http://vocab.nerc.ac.uk/collection/C00/current/CHART/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/C00/current/CHART/>;
    dc:modified '2018-05-14T10:21:58'^^xsd:dateTime ;
    skos:altLabel 'chart'^^xsd:string ;
    skos:prefLabel 'Bathymetric chart'@en ;
    skos:definition 'Bathymetric depth was read by eye from a published bathymetric chart of the area (e.g. the UK Admiralty Charts used for navigation), using the series spatial coordinates or station position.'@en ;
