@prefix tree: <https://w3id.org/tree#> .
@prefix ldes: <https://w3id.org/ldes#> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

@base <https://kgfixed.github.io/vocab.nerc.ac.uk/C96/2012_01_01_00_00_00_2012_12_31_23_59_59.ttl> .

<>
    a tree:Node
     .

<feed>
  a ldes:EventStream ;
  ldes:timestampPath dc:modified ;
  ldes:versionOfPath dc:isVersionOf ;
  
  
  tree:shape [
    a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path dc:isVersionOf
    ],
    [
      sh:datatype xsd:dateTime ;
      sh:minCount 1 ;
      sh:path dc:modified
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:altLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:prefLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:definition
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:notation
    ];
    sh:targetClass skos:Concept
  ] ;
  tree:view <> ;
  .

<feed> tree:member <http://vocab.nerc.ac.uk/collection/C96/current/STATION/1/> .
<http://vocab.nerc.ac.uk/collection/C96/current/STATION/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/C96/current/STATION/>;
    dc:modified '2012-10-03T16:32:28'^^xsd:dateTime ;
    skos:altLabel 'station'^^xsd:string ;
    skos:prefLabel 'Fixed station'@en ;
    skos:definition 'A spatial coverage occupied for a period of time or visited on several occasions for the making of measurements and/or the collection of samples.'@en ;
    skos:notation 'SDN:C96::STATION'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/C96/current/EVENT/1/> .
<http://vocab.nerc.ac.uk/collection/C96/current/EVENT/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/C96/current/EVENT/>;
    dc:modified '2012-10-03T16:27:35'^^xsd:dateTime ;
    skos:altLabel 'event'^^xsd:string ;
    skos:prefLabel 'Event'@en ;
    skos:definition 'A discrete action during a cruise or other data collection activity that results in data generating measurements or the collection of samples.'@en ;
    skos:notation 'SDN:C96::EVENT'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/C96/current/CRUISE/1/> .
<http://vocab.nerc.ac.uk/collection/C96/current/CRUISE/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/C96/current/CRUISE/>;
    dc:modified '2012-10-03T16:22:51'^^xsd:dateTime ;
    skos:altLabel 'cruise'^^xsd:string ;
    skos:prefLabel 'Cruise'@en ;
    skos:definition 'The deployment of a platform between two fixed points on a mission to collect data'@en ;
    skos:notation 'SDN:C96::CRUISE'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/C96/current/SERIES/1/> .
<http://vocab.nerc.ac.uk/collection/C96/current/SERIES/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/C96/current/SERIES/>;
    dc:modified '2012-10-03T15:43:21'^^xsd:dateTime ;
    skos:altLabel 'series'^^xsd:string ;
    skos:prefLabel 'BODC data series'@en ;
    skos:definition 'A discrete fixed package of data served by BODC'@en ;
    skos:notation 'SDN:C96::SERIES'^^xsd:string .
