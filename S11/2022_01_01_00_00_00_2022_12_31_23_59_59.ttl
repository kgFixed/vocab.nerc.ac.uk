     ;
    tree:relation [
      a tree:LessThanRelation ;
      tree:node <https://kgfixed.github.io/vocab.nerc.ac.uk/S11/2020_01_01_00_00_00_2021_12_31_23_59_59.ttl> ;
      tree:path dc:modified ;
