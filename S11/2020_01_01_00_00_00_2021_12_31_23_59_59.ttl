<feed> tree:member <http://vocab.nerc.ac.uk/collection/S11/current/S1197/1/> .
<http://vocab.nerc.ac.uk/collection/S11/current/S1197/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S11/current/S1197/>;
    dc:modified '2021-08-24T12:20:09'^^xsd:dateTime ;
    skos:altLabel 'nectochaetae'^^xsd:string ;
    skos:prefLabel 'nectochaeta'@en ;
    skos:definition 'A developmental stage found in Polychaeta species, it is a planktonic stage bearing functioning parapodia serving locomotion [Plate and Huseman 1994](https://hmr.biomedcentral.com/track/pdf/10.1007/BF02366201.pdf).'@en ;
    skos:notation 'SDN:S11::S1197'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S11/current/S1196/1/> .
<http://vocab.nerc.ac.uk/collection/S11/current/S1196/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S11/current/S1196/>;
    dc:modified '2021-08-24T12:13:11'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'nurse'@en ;
    skos:definition 'A developmental stage in the life cycle of doliolids (Order Doliolida). The nurse stage is the terminal life stage for doliolids, often characterized by a conspicuous tail (cadophore) sprouting small trophozooids (i.e. \'nutrition zooids\') also called \'gastrozooids\' (i.e., feeding buds) [[Paffenhofer and Koster, 2011](https://doi.org/10.1093/plankt/fbr001); [Greer et al 2020](https://doi.org/10.1002/lno.11450)].'@en ;
    skos:notation 'SDN:S11::S1196'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S11/current/S1195/1/> .
