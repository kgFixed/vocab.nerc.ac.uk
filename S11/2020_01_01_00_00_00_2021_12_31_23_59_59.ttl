    skos:altLabel 'paralarvae'^^xsd:string ;
    skos:prefLabel 'paralarva'@en ;
    skos:definition 'Planktonic stage of young cephalopods between hatching and sub-adult.'@en ;
    skos:notation 'SDN:S11::S1194'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S11/current/S1193/1/> .
<http://vocab.nerc.ac.uk/collection/S11/current/S1193/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S11/current/S1193/>;
    dc:modified '2021-08-24T11:24:18'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'veliger'@en ;
    skos:definition 'Planktonic larva typical of many marine and freshwater snails and bivalves. The veliger develops from the trochophore larva.'@en ;
    skos:notation 'SDN:S11::S1193'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S11/current/S1192/1/> .
<http://vocab.nerc.ac.uk/collection/S11/current/S1192/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S11/current/S1192/>;
    dc:modified '2021-08-24T11:19:16'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'trochophore'@en ;
    skos:definition 'Free-swimming planktonic marine larva occurring in the first developmental stage of Molluscs and certain marine annelids. The trochophore is the developmental stage prior to veliger.'@en ;
    skos:notation 'SDN:S11::S1192'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S11/current/S1191/1/> .
<http://vocab.nerc.ac.uk/collection/S11/current/S1191/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S11/current/S1191/>;
    dc:modified '2021-08-23T21:51:36'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'praniza'@en ;
    skos:definition 'The juvenile form of a family of marine isopod crustaceans known as Gnathiidae. The adults are associated with sponges and occur in a wide range of depths. The praniza \'larva\' is a temporary parasite of marine fishes.'@en ;
    skos:notation 'SDN:S11::S1191'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S11/current/S1182/2/> .
<http://vocab.nerc.ac.uk/collection/S11/current/S1182/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S11/current/S1182/>;
    dc:modified '2021-03-23T14:41:41'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'chalimus'@en ;
    skos:definition 'The life stages of parasitic copepod species marked by their secure attachment to a host by a frontal filament. The chalimus stages follow the free-swimming copepodid stage and precede the pre-adult stages (sometimes referred to as \'sub-adult\') where the organism is capable of detaching from its filament to move across the surface of its host.'@en ;
    skos:notation 'SDN:S11::S1182'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S11/current/S1183/1/> .
<http://vocab.nerc.ac.uk/collection/S11/current/S1183/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S11/current/S1183/>;
    dc:modified '2021-03-23T14:39:37'^^xsd:dateTime ;
    skos:altLabel 'motile (sea lice)'^^xsd:string ;
    skos:prefLabel 'pre-adult and adult motile stages'@en ;
    skos:definition 'The pre-adult and adult life stages of parasitic copepod species, commonly referred to as \'sea lice\', that are marked by the ability of parasites to move freely across the surface of their host or swim freely in the water column. Sea lice motile stages are preceded by the chalimus stages in which the organism is attached to its host by a frontal filament and exclude the free-swimming naupliar and copepodid stages.'@en ;
    skos:notation 'SDN:S11::S1183'^^xsd:string .
