    dc:modified '2021-08-24T11:47:51'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'eudoxid'@en ;
    skos:definition 'Free-living sexual unit of a majority of calycophoran siphonophores.'@en ;
    skos:notation 'SDN:S11::S1195'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S11/current/S1194/1/> .
