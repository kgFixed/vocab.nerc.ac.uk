<feed> tree:member <http://vocab.nerc.ac.uk/collection/P01/current/NTLOCF01/1/> .
<http://vocab.nerc.ac.uk/collection/P01/current/NTLOCF01/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P01/current/NTLOCF01/>;
    dc:modified '2026-05-27T08:22:26'^^xsd:dateTime ;
    skos:altLabel 'NO3+NO2_in-situ_filt_col'^^xsd:string ;
    skos:prefLabel 'Concentration of nitrate+nitrite {NO3+NO2} per unit volume of the water body [dissolved plus reactive particulate <0.4/0.45um phase] by in-situ nutrient analysis system and colorimetry'@en ;
    skos:definition 'Concentration of nitrate plus nitrite per unit volume of any fresh or salt water body passed through a 0.4um or 0.45um filter and determined by an in-situ nutrient analyser using a method that converts the analyte to a coloured substance and determines the strength of that colour.'@en ;
    skos:notation 'SDN:P01::NTLOCF01'^^xsd:string .
