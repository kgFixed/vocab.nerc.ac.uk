    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P01/current/IOCWID01/>;
    dc:modified '2026-05-05T10:04:49'^^xsd:dateTime ;
    skos:altLabel 'Interocular_width'^^xsd:string ;
    skos:prefLabel 'Width of biological entity specified elsewhere [Subcomponent: interocular space] {interocular width}'@en ;
    skos:definition 'The side-to-side dimension of the soft-bodied or segmented abdominal region of a biological entity identified elsewhere in the data schema. This measurement typically captures the maximum lateral span of the abdomen.'@en ;
    skos:notation 'SDN:P01::IOCWID01'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P01/current/POHLEN01/1/> .
