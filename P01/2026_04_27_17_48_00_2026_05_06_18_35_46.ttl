<http://vocab.nerc.ac.uk/collection/P01/current/BLKALIN5/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P01/current/BLKALIN5/>;
    dc:modified '2026-05-05T12:21:48'^^xsd:dateTime ;
    skos:altLabel 'APA_wb_unk'^^xsd:string ;
    skos:prefLabel 'Activity of alkaline phosphatase {EC_3.1.3.1 CAS 9001-78-9} {APA} per hour per unit volume of the water body [unknown phase]'@en ;
    skos:definition 'The hourly rate at which the specified enzyme catalyses the hydrolysis of targeted chemical compounds measured in a specified volume of sample from any body of fresh or salt water. The phase is described as unknown to indicate that there is no information on whether the determination was on filtered or unfiltered water. This type of activity is also known as extracellular enzymatic activity.'@en ;
    skos:notation 'SDN:P01::BLKALIN5'^^xsd:string .
