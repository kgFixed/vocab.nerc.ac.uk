    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P01/current/POHLEN01/>;
    dc:modified '2026-05-05T10:04:49'^^xsd:dateTime ;
    skos:altLabel 'Postorbital-hypural_length'^^xsd:string ;
    skos:prefLabel 'Length of biological entity specified elsewhere [Subcomponent: post-orbit to hypural plate] {postorbital-hypural}'@en ;
    skos:definition 'The length of the bony or chitinous case or shield covering the back or part of the back of some animals like turtles or crabs identified elsewhere in the data schema.'@en ;
    skos:notation 'SDN:P01::POHLEN01'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P01/current/TAILEN01/1/> .
<http://vocab.nerc.ac.uk/collection/P01/current/TAILEN01/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P01/current/TAILEN01/>;
    dc:modified '2026-05-05T10:04:49'^^xsd:dateTime ;
    skos:altLabel 'Total_tail_length'^^xsd:string ;
    skos:prefLabel 'Length (total length) of biological entity specified elsewhere [Subcomponent: tail] {Total Tail Length}'@en ;
    skos:definition 'The length of the tail of the biological entity identified elsewhere in the data schema. This parameter captures the full tail length from its point of origin at the body to its distal tip. For turtles, this is the same as Total Tail Length (TTL) defined as the distance from the midline of the posterior margin of the plastron to the end of the tail following the curvature of the tail.'@en ;
    skos:notation 'SDN:P01::TAILEN01'^^xsd:string .
