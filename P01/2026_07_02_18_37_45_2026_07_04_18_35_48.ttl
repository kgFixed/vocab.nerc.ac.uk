    skos:altLabel 'chl-c_water>GF/F_m_HPLC'^^xsd:string ;
    skos:prefLabel 'Concentration of chlorophyll-c {chl-c} per unit volume of the water body [particulate >GF/F phase] by filtration, methanol extraction and high performance liquid chromatography (HPLC)'@en ;
    skos:definition 'The amount (mass or moles) of the specified pigment determined by HPLC assay of a sample collected by dissolution in methanol of the residue collected by GF/F filtration of a known volume of any water body. The quoted value either results from a single determination or the average of replicate determinations.'@en ;
