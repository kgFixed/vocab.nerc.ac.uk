    dc:modified '2026-04-20T16:11:31'^^xsd:dateTime ;
    skos:altLabel 'Soundspeed_TEOS'^^xsd:string ;
    skos:prefLabel 'Speed of sound {\'sound velocity\'} in the water body by computation from salinity and temperature using UNESCO algorithm'@en ;
    skos:definition 'The rate at which sound waves move through the water column often inaccurately labelled \'sound velocity\' as calculated from salinity and temperature using the IOC, SCOR and IAPSO (UNESCO TEOS) algorithm where the TEOS version has not been specified.'@en ;
    skos:notation 'SDN:P01::SVELCA01'^^xsd:string .
