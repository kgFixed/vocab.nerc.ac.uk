    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P01/current/BPVSO412/>;
    dc:modified '2024-03-01T10:02:54'^^xsd:dateTime ;
    skos:altLabel 'VolScattering_Beta_p_particles_412nm'^^xsd:string ;
    skos:prefLabel 'Volume scattering attributable to particles of electromagnetic radiation (412nm wavelength) {Beta(p)} in the water body by in-situ optical backscatter measurement'@en ;
    skos:definition 'The radiant intensity of scattered light from particles in the water body as a function of angle, with the scattering contribution of pure seawater removed, measured at the specified wavelength by an in-situ optical backscattering instrument. Beta(p) is determined by calculating the volume scattering of pure seawater and removing it from the total volume scattering coefficient (Beta) to yield the volume scattering attributable to particles only.'@en ;
    skos:notation 'SDN:P01::BPVSO412'^^xsd:string .
