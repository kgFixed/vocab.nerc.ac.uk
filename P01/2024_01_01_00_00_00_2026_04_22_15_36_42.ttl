    skos:altLabel 'Resp_IV_Chamber'^^xsd:string ;
    skos:prefLabel 'Consumption rate of oxygen {O2 CAS 7782-44-7} {respiration} per unit time per unit wet weight of biota {biological entity specified elsewhere} by in-vitro incubation chamber and oxygen sensor'@en ;
    skos:definition 'Respiration rates estimated from in-vitro incubations of organisms using an enclosure isolated from the natural system. Rates are estimated from changes in oxygen concentration over time measured by one or multiple oxygen sensor(s) and are standardised to the wet weight of the organism(s).'@en ;
    skos:notation 'SDN:P01::RESPIVCS'^^xsd:string .
