    skos:altLabel 'Width'^^xsd:string ;
    skos:prefLabel 'Width of biological entity specified elsewhere'@en ;
    skos:definition 'The side-to-side dimension of the main body of a biological organism identified elsewhere in the metadata at its widest point, excluding any appendages. In skates and rays, this is equivalent to Disc Width.'@en ;
    skos:notation 'SDN:P01::ESEWID01'^^xsd:string .
