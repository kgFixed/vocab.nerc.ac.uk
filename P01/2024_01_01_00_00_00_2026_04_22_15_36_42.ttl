    skos:altLabel 'inst_sed_penetration_depth'^^xsd:string ;
    skos:prefLabel 'Penetration depth of instrument in the sediment'@en ;
    skos:definition 'The maximum vertical extent to which an instrument penetrates in the sediment. In Sediment Profile Imaging data this is sometimes referred to as the prism penetration depth, which gives an indication of relative sediment compaction.'@en ;
    skos:notation 'SDN:P01::PTDPINST'^^xsd:string .
