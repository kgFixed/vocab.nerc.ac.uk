    dc:modified '2025-02-26T16:11:47'^^xsd:dateTime ;
    skos:altLabel 'surface_roughness_sed'^^xsd:string ;
    skos:prefLabel 'Surface roughness of sediment-water interface by sediment profile imager and computation using ImageJ software'@en ;
    skos:definition 'A quantification of the irregularities in the geometry of the sediment surface, determined using the ImageJ software package. It is used as an indicator of the degree of physical disturbance or biotic activity at the sediment water boundary.'@en ;
    skos:notation 'SDN:P01::SRSDSW01'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P01/current/PTDPINST/1/> .
