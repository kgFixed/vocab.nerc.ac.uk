    skos:prefLabel 'Count of total clicks detected in time interval specified elsewhere by biota {biological entity specified elsewhere}'@en ;
    skos:definition 'Total number of detected high intensity, highly directional, short (milliseconds) sounds which are produced by individuals of a specific species or group of species (specified elsewhere in the metadata), within a time frame that is also specified elsewhere in the metadata.'@en ;
    skos:notation 'SDN:P01::CETA0001'^^xsd:string .
