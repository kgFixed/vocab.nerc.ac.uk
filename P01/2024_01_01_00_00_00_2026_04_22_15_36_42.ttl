    dc:modified '2025-11-23T19:10:24'^^xsd:dateTime ;
    skos:altLabel 'OUR'^^xsd:string ;
    skos:prefLabel 'Consumption rate of oxygen {O2 CAS 7782-44-7} {Oxygen Utilisation Rate (OUR)} per unit time per unit mass of the water body by computation from Apparent Oxygen Utilisation (AOU) and water mass age along isopycnal surfaces'@en ;
    skos:definition 'The rate of oxygen utilisation in a mass unit of a water body calculated from the change in apparent oxygen utilisation (AOU) in a layer of constant density (isopycnal surface) along a given distance, divided by the change in water age calculated along the same distance.'@en ;
    skos:notation 'SDN:P01::OURO2KGZ'^^xsd:string .
