    skos:altLabel 'Resp_Winkler'^^xsd:string ;
    skos:prefLabel 'Consumption rate of oxygen {O2 CAS 7782-44-7} {respiration} per day per unit volume of the water body by in-vitro incubation in the dark and Winkler titration'@en ;
    skos:definition 'Respiration rates estimated on bulk water samples from changes in oxygen concentration measured by the Winkler method, in bottles incubated in the dark for a set time period (typically 24 hours) in on-deck incubators cooled with pumped surface water ("shipboard incubations"), or on an in-situ rig at the depths the samples were collected, or in an incubation chamber in the laboratory at temperatures close to in-situ temperatures.'@en ;
    skos:notation 'SDN:P01::RESPWINK'^^xsd:string .
