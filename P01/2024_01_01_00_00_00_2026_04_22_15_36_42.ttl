    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P01/current/CETA0003/>;
    dc:modified '2026-04-01T14:49:22'^^xsd:dateTime ;
    skos:altLabel 'DPM_BE007117'^^xsd:string ;
    skos:prefLabel 'Count of detection positive minutes in time interval specified elsewhere by biota {biological entity specified elsewhere}'@en ;
    skos:definition 'Number of minutes in which individuals of a specific species or group of species (specified elsewhere in the metadata) were detected within a time frame (also specified elsewhere in the metadata). These minutes do not need to be consecutive, and the term "detection positive minutes" often refers to the detection marine mammals via their vocalisations.'@en ;
    skos:notation 'SDN:P01::CETA0003'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P01/current/CETA0002/1/> .
<http://vocab.nerc.ac.uk/collection/P01/current/CETA0002/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P01/current/CETA0002/>;
    dc:modified '2026-04-01T14:49:22'^^xsd:dateTime ;
    skos:altLabel 'FilteredClicks_BE007117'^^xsd:string ;
    skos:prefLabel 'Count of filtered clicks in time interval specified elsewhere by biota {biological entity specified elsewhere}'@en ;
    skos:definition 'Number of high intensity, highly directional, short (milliseconds) sounds that fit certain criteria of frequency and direction. These are produced by individuals of a specific species or group of species (specified elsewhere in the metadata), within a time frame that is also specified elsewhere in the metadata. This code is expected to be used in a format (e.g. Darwin Core) that gives more details on how the clicks were filtered.'@en ;
    skos:notation 'SDN:P01::CETA0002'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P01/current/CETA0001/1/> .
