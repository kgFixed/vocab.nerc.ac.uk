    skos:altLabel 'Zeu_1%LD'^^xsd:string ;
    skos:prefLabel 'Depth of euphotic zone (1% light depth) relative to water surface in the water body'@en ;
    skos:definition 'The depth of the surface layer of a water body where light is sufficient to support photosynthesis. The operational definition of the euphotic zone in lake and ocean sciences is the depth at which photosynthetic available radiation (PAR) is 1% of its surface value (1%LD) as measured just below the surface.'@en ;
    skos:notation 'SDN:P01::ZEUDEP01'^^xsd:string .
