    dc:modified '2025-11-11T11:22:11'^^xsd:dateTime ;
    skos:altLabel 'Total_length_stretched'^^xsd:string ;
    skos:prefLabel 'Length (total length) of biological entity specified elsewhere {stretched total length} by stretching and linear measurement'@en ;
    skos:definition 'A standard body length measurement used in biometric studies used when the caudal fin is forked with asymmetric lobes (e.g. sharks) and taken as the distance in a straight line from the tip of the snout to the extremity of caudal fin with the upper (longest) lobe stretched down to its fullest extension in line with the center of the body.'@en ;
    skos:notation 'SDN:P01::STL01X01'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P01/current/ESEWID01/1/> .
