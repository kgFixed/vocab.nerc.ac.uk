<http://vocab.nerc.ac.uk/collection/P01/current/PRNODS01/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P01/current/PRNODS01/>;
    dc:modified '2026-05-29T14:00:55'^^xsd:dateTime ;
    skos:altLabel 'PropCount_detritus_in_stomach'^^xsd:string ;
    skos:prefLabel 'Proportion by number of organic detritus in biota {biological entity specified elsewhere [Subcomponent: stomach]}'@en ;
    skos:definition 'A quantified subset, based on counts, of small pieces of dead organic material of animal, plant, fungal, or microbial origin, or detached and broken down fragments of a structure of organic origin (for example: fish scales, faecal pellets, marine snow, or fragments of seaweed and coral) found within an identified biological object described elsewhere in the metadata.'@en ;
    skos:notation 'SDN:P01::PRNODS01'^^xsd:string .
