    skos:prefLabel 'Proportion by number of inorganic items in biota {biological entity specified elsewhere [Subcomponent: stomach]}'@en ;
    skos:definition 'A quantified subset, based on counts, of unspecified objects (whole or fragments) made of matter of mineral or man-made origin (for example: plastic, glass, metal, sediment, or stones) found within an identified biological object described elsewhere in the metadata.'@en ;
    skos:notation 'SDN:P01::PRNIIS01'^^xsd:string .
