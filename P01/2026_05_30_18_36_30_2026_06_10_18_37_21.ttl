<feed> tree:member <http://vocab.nerc.ac.uk/collection/P01/current/PRESAUV1/1/> .
<http://vocab.nerc.ac.uk/collection/P01/current/PRESAUV1/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P01/current/PRESAUV1/>;
    dc:modified '2026-06-09T08:44:26'^^xsd:dateTime ;
    skos:altLabel 'Pres_AUV'^^xsd:string ;
    skos:prefLabel 'Pressure (spatial coordinate) exerted by the water body by autonomous platform piloting pressure sensor and correction to read zero at sea level'@en ;
    skos:definition 'The force per unit area exerted by the water column on a sensor located on a moving platform such as an autonomous underwater vehicle (AUV). The data are used to determine the depth of the platform below the sea surface for piloting and navigation purposes only.'@en ;
    skos:notation 'SDN:P01::PRESAUV1'^^xsd:string .
