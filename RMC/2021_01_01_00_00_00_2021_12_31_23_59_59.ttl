@prefix tree: <https://w3id.org/tree#> .
@prefix ldes: <https://w3id.org/ldes#> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

@base <https://kgfixed.github.io/vocab.nerc.ac.uk/RMC/2021_01_01_00_00_00_2021_12_31_23_59_59.ttl> .

<>
    a tree:Node
     .

<feed>
  a ldes:EventStream ;
  ldes:timestampPath dc:modified ;
  ldes:versionOfPath dc:isVersionOf ;
  
  
  tree:shape [
    a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path dc:isVersionOf
    ],
    [
      sh:datatype xsd:dateTime ;
      sh:minCount 1 ;
      sh:path dc:modified
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:altLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:prefLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:definition
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:notation
    ];
    sh:targetClass skos:Concept
  ] ;
  tree:view <> ;
  .

<feed> tree:member <http://vocab.nerc.ac.uk/collection/RMC/current/RGENC/4/> .
<http://vocab.nerc.ac.uk/collection/RMC/current/RGENC/4/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/RMC/current/RGENC/>;
    dc:modified '2021-12-01T14:18:02'^^xsd:dateTime ;
    skos:altLabel 'Relative Generic Codes'^^xsd:string ;
    skos:prefLabel 'Relative Generic Codes'@en ;
    skos:definition 'Measurement codes marking measurements recorded while transitioning towards a primary or secondary measurement code, or taken as part of a surface sequence of in-water or in-air samples. If \'MC\' is defined as a primary or secondary measurement code, relative generic codes \'RGENC\' correspond to all codes falling within the (MC-15) and (MC-10) range, and within the (MC-6) and (MC-1) range; i.e. (MC-16) < RGENC < (MC-9) and (MC-7) <RGENC < MC. Moreover, RGENC also correspond to MC+10 and MC+11 for MCs of either 600, 700 or 800. The definitions for relative generic codes are purposely broad, so that they may be associated with trajectory measurements recorded by a wide range of different float types.'@en ;
    skos:notation 'SDN:RMC::RGENC'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/RMC/current/PRIMC/1/> .
<http://vocab.nerc.ac.uk/collection/RMC/current/PRIMC/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/RMC/current/PRIMC/>;
    dc:modified '2021-11-30T12:44:50'^^xsd:dateTime ;
    skos:altLabel 'Primary MC'^^xsd:string ;
    skos:prefLabel 'Primary Measurement Codes (MC)'@en ;
    skos:definition 'Measurement codes marking a mandatory cycle timing variable. These are essential to determine trajectory estimates for all float types.'@en ;
    skos:notation 'SDN:RMC::PRIMC'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/RMC/current/RSPEC/1/> .
<http://vocab.nerc.ac.uk/collection/RMC/current/RSPEC/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/RMC/current/RSPEC/>;
    dc:modified '2021-11-30T12:44:50'^^xsd:dateTime ;
    skos:altLabel 'Relative Specific Codes'^^xsd:string ;
    skos:prefLabel 'Relative Specific Codes'@en ;
    skos:definition 'Measurement codes reserved for unique timing events which are not repeated anywhere else within a float\'s cycle. If \'MC\' is defined as a primary or secondary measurement code, relative specific codes \'RSPEC\' generally fall anywhere within the (MC+1) and (MC+25) range; i.e. MC < RSPEC < (MC+26). However, please note that a RSPEC may not be associated with an MC at all. Each relative specific code is unique, and is matched with a trajectory measurement that is generally recorded by a limited number of float types.'@en ;
    skos:notation 'SDN:RMC::RSPEC'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/RMC/current/SECMC/1/> .
<http://vocab.nerc.ac.uk/collection/RMC/current/SECMC/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/RMC/current/SECMC/>;
    dc:modified '2021-11-30T12:44:50'^^xsd:dateTime ;
    skos:altLabel 'Secondary MC'^^xsd:string ;
    skos:prefLabel 'Secondary Measurement Codes (MC)'@en ;
    skos:definition 'Measurement codes marking a recommended cycle timing variable. These are used to determine trajectory estimates for a range of float types.'@en ;
    skos:notation 'SDN:RMC::SECMC'^^xsd:string .
