    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'experiment water sample'@en ;
    skos:definition 'A sample of water whose chemical and biological composition has been artificially modified under known controlled conditions. Used where determined property is an observation on the sample as a whole and therefore the concept of phase is inapplicable.'@en ;
    skos:notation 'SDN:S26::MAT00871'^^xsd:string .
