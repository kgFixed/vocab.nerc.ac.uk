    skos:definition 'A sample of water whose chemical and biological composition has been artificially modified under known controlled conditions and has not been filtered prior to analysis.'@en ;
    skos:notation 'SDN:S26::MAT00864'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S26/current/MAT00871/1/> .
