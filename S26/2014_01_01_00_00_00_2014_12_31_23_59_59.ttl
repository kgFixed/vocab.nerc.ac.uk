    skos:definition 'The solid surface at the base of any body of water from a puddle to an ocean.'@en ;
    skos:notation 'SDN:S26::MAT00850'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S26/current/MAT00857/1/> .
