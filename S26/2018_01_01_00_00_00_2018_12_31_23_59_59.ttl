    dc:modified '2018-07-11T13:19:03'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'water body [particulate non-sinking >GF/F phase]'@en ;
    skos:definition 'Solids classified as non-sinking that are contained in a sample from any body of water from a puddle to an ocean that have been collected by filtration through a GF/F (nominal pore size0.7um) filter. This term is used for measurements on the solid expressed in the context of the water body (e.g. Analyte concentration multiplied by SPM concentration).'@en ;
    skos:notation 'SDN:S26::MAT01982'^^xsd:string .
