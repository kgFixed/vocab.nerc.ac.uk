    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S26/current/MAT01998/>;
    dc:modified '2022-10-11T09:30:23'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'water body [particulate >0.7um phase]'@en ;
    skos:definition 'Solids contained in a sample from any body of water from a puddle to an ocean that have been collected by filtration through a 0.7um filter. This term is used for measurements on the solid expressed in the context of the water body (e.g. Analyte concentration multiplied by SPM concentration).'@en ;
    skos:notation 'SDN:S26::MAT01998'^^xsd:string .
