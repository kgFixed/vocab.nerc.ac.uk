@base <https://kgfixed.github.io/vocab.nerc.ac.uk/H01/2022_01_01_00_00_00_2022_12_31_23_59_59.ttl> .

<>
    a tree:Node
     .

<feed>
  a ldes:EventStream ;
  ldes:timestampPath dc:modified ;
  ldes:versionOfPath dc:isVersionOf ;
  
  
  tree:shape [
    a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path dc:isVersionOf
    ],
    [
      sh:datatype xsd:dateTime ;
      sh:minCount 1 ;
      sh:path dc:modified
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:altLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:prefLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:definition
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:notation
    ];
    sh:targetClass skos:Concept
  ] ;
  tree:view <> ;
  .

<feed> tree:member <http://vocab.nerc.ac.uk/collection/H01/current/H0100009/2/> .
<http://vocab.nerc.ac.uk/collection/H01/current/H0100009/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/H01/current/H0100009/>;
    dc:modified '2022-07-20T14:41:36'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'granules'@en ;
    skos:definition 'Micro-litter particles with smooth spherical shape. In comparison with pellets, they have a rounder shape and are smaller in size (adapted from [Matiddi et al, 2021](https://accedacris.ulpgc.es/bitstream/10553/114417/1/Report_Monitoring-microlitter-ingestion-in-marine-fish.pdf)).'@en ;
    skos:notation 'SDN:H01::H0100009'^^xsd:string .
