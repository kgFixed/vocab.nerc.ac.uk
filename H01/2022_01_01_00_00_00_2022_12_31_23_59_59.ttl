    dc:modified '2022-06-28T10:23:40'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'filaments'@en ;
    skos:definition 'Slender thread-like micro-litter particles.'@en ;
    skos:notation 'SDN:H01::H0100004'^^xsd:string .
