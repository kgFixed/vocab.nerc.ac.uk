<feed> tree:member <http://vocab.nerc.ac.uk/collection/H01/current/H0100003/3/> .
<http://vocab.nerc.ac.uk/collection/H01/current/H0100003/3/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/H01/current/H0100003/>;
    dc:modified '2022-06-28T10:20:49'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'pellets'@en ;
    skos:definition 'Micro-litter particles from industrial origin only. In comparison with granules, pellets are usually flat on one side, rough surface and irregular, round shapes. Normally bigger in size.'@en ;
