<feed> tree:member <http://vocab.nerc.ac.uk/collection/C30/current/EMODSBHB/1/> .
<http://vocab.nerc.ac.uk/collection/C30/current/EMODSBHB/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/C30/current/EMODSBHB/>;
    dc:modified '2023-09-05T11:44:55'^^xsd:dateTime ;
    skos:altLabel 'EMODnet SeaHab'^^xsd:string ;
    skos:prefLabel 'EMODnet Seabed Habitats Lot'@en ;
    skos:definition 'A European project consortium aimed at the creation of broad-scale seabed habitat data products (EUSeaMap) using data amassed through SeaDataNet from surveys across Europe. The governance is loosely defined as the scientific expertise within the consortium with no formal processes defined.'@en ;
    skos:notation 'SDN:C30::EMODSBHB'^^xsd:string .
