    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/C30/current/WMO/>;
    dc:modified '2009-09-28T15:11:57'^^xsd:dateTime ;
    skos:altLabel 'WMO'^^xsd:string ;
    skos:prefLabel 'World Meteorological Organisation'@en ;
    skos:definition 'Governance for vocabularies used in the international exchange of meteorological and metocean data between national meteorological organisations'@en ;
    skos:notation 'SDN:C30::WMO'^^xsd:string .
