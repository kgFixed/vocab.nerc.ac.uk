    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/C30/current/EC/>;
    dc:modified '2009-07-29T11:45:57'^^xsd:dateTime ;
    skos:altLabel 'EC'^^xsd:string ;
    skos:prefLabel 'European Commission'@en ;
    skos:definition 'Governance for vocabularies used in INSPIRE spatial data infrastructure metadata'@en ;
