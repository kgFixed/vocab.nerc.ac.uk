@base <https://kgfixed.github.io/vocab.nerc.ac.uk/C30/2017_01_01_00_00_00_2018_12_31_23_59_59.ttl> .

<>
    a tree:Node
     ;
    tree:relation [
      a tree:LessThanRelation ;
      tree:node <https://kgfixed.github.io/vocab.nerc.ac.uk/C30/2016_01_01_00_00_00_2016_12_31_23_59_59.ttl> ;
      tree:path dc:modified ;
      tree:value '2018-12-31T23:59:59'^^xsd:dateTime
    ]
     .

<feed>
  a ldes:EventStream ;
  ldes:timestampPath dc:modified ;
  ldes:versionOfPath dc:isVersionOf ;
  
  
  tree:shape [
    a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path dc:isVersionOf
    ],
    [
      sh:datatype xsd:dateTime ;
      sh:minCount 1 ;
      sh:path dc:modified
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:altLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:prefLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:definition
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:notation
    ];
    sh:targetClass skos:Concept
  ] ;
  tree:view <> ;
  .

<feed> tree:member <http://vocab.nerc.ac.uk/collection/C30/current/HELCOM/1/> .
<http://vocab.nerc.ac.uk/collection/C30/current/HELCOM/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/C30/current/HELCOM/>;
    dc:modified '2018-11-20T14:37:42'^^xsd:dateTime ;
    skos:altLabel 'HELCOM'^^xsd:string ;
    skos:prefLabel 'Baltic Marine Environment Protection Commission'@en ;
    skos:definition 'Governance for vocabularies and list of terms published and maintained by HELCOM (Baltic Marine Environment Protection Commission - Helsinki Commission) and hosted on the NERC Vocabulary Server. HELCOM is the governing body of the Convention on the Protection of the Marine Environment of the Baltic Sea Area, known as the Helsinki Convention. The Contracting Parties are Denmark, Estonia, the European Union, Finland, Germany, Latvia, Lithuania, Poland, Russia and Sweden.'@en ;
    skos:notation 'SDN:C30::HELCOM'^^xsd:string .
