    dc:modified '2018-07-12T12:45:34'^^xsd:dateTime ;
    skos:altLabel 'OSPAR'^^xsd:string ;
    skos:prefLabel 'OSPAR Commission'@en ;
    skos:definition 'Governance for vocabularies and list of terms published and maintained by the OSPAR Commission, an intergovernmental organisation of 15 governments and the European Union who have agreed to cooperate to protect the marine environment of the North-East Atlantic.'@en ;
