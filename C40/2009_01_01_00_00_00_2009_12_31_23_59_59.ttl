@prefix tree: <https://w3id.org/tree#> .
@prefix ldes: <https://w3id.org/ldes#> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

@base <https://kgfixed.github.io/vocab.nerc.ac.uk/C40/2009_01_01_00_00_00_2009_12_31_23_59_59.ttl> .

<>
    a tree:Node
     .

<feed>
  a ldes:EventStream ;
  ldes:timestampPath dc:modified ;
  ldes:versionOfPath dc:isVersionOf ;
  
  
  tree:shape [
    a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path dc:isVersionOf
    ],
    [
      sh:datatype xsd:dateTime ;
      sh:minCount 1 ;
      sh:path dc:modified
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:altLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:prefLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:definition
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:notation
    ];
    sh:targetClass skos:Concept
  ] ;
  tree:view <> ;
  .

<feed> tree:member <http://vocab.nerc.ac.uk/collection/C40/current/PEAC01/1/> .
<http://vocab.nerc.ac.uk/collection/C40/current/PEAC01/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/C40/current/PEAC01/>;
    dc:modified '2009-09-29T12:12:36'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Doubtful'@en ;
    skos:definition 'The pollution event observation was not from an authoratative source and/or the pollution could not be clearly identified'@en ;
    skos:notation 'SDN:C40::PEAC01'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/C40/current/PEAC02/1/> .
<http://vocab.nerc.ac.uk/collection/C40/current/PEAC02/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/C40/current/PEAC02/>;
    dc:modified '2009-09-29T12:12:36'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Probable'@en ;
    skos:definition 'There is a greater than 50% chance that the pollution event is real given the source of the information and the conditions underwhich it was identified'@en ;
    skos:notation 'SDN:C40::PEAC02'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/C40/current/PEAC03/1/> .
<http://vocab.nerc.ac.uk/collection/C40/current/PEAC03/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/C40/current/PEAC03/>;
    dc:modified '2009-09-29T12:12:36'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Confirmed'@en ;
    skos:definition 'The pollution event was observed directly by a reliable source and could be clearly observed by the human eye'@en ;
    skos:notation 'SDN:C40::PEAC03'^^xsd:string .
