@prefix tree: <https://w3id.org/tree#> .
@prefix ldes: <https://w3id.org/ldes#> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

@base <https://kgfixed.github.io/vocab.nerc.ac.uk/M17/2016_01_01_00_00_00_2016_12_31_23_59_59.ttl> .

<>
    a tree:Node
     .

<feed>
  a ldes:EventStream ;
  ldes:timestampPath dc:modified ;
  ldes:versionOfPath dc:isVersionOf ;
  
  
  tree:shape [
    a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path dc:isVersionOf
    ],
    [
      sh:datatype xsd:dateTime ;
      sh:minCount 1 ;
      sh:path dc:modified
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:altLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:prefLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:definition
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:notation
    ];
    sh:targetClass skos:Concept
  ] ;
  tree:view <> ;
  .

<feed> tree:member <http://vocab.nerc.ac.uk/collection/M17/current/SAMP_BOX/1/> .
<http://vocab.nerc.ac.uk/collection/M17/current/SAMP_BOX/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/M17/current/SAMP_BOX/>;
    dc:modified '2016-05-31T12:38:17'^^xsd:dateTime ;
    skos:altLabel 'Box core sample'^^xsd:string ;
    skos:prefLabel 'Box core sample'@en ;
    skos:definition 'A sample of soft sediment recovered from the seafloor using a sampling technique consisting of a weighted box which penetrates into the seabed to a depth which depends on its descent rate, and has a blade which closes the base of the box after penetration, thus collecting the sample.'@en ;
    skos:notation 'SDN:M17::SAMP_BOX'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/M17/current/SAMP_GRAB/1/> .
<http://vocab.nerc.ac.uk/collection/M17/current/SAMP_GRAB/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/M17/current/SAMP_GRAB/>;
    dc:modified '2016-05-31T12:38:17'^^xsd:dateTime ;
    skos:altLabel 'Grab sample'^^xsd:string ;
    skos:prefLabel 'Grab sample'@en ;
    skos:definition 'A sample of sediment recovered from the seabed using a device which consists of a bucket or pair of buckets or similar containers which rotate on impact with the seabed, either through a spring trigger or through human intervention and scoops out a sample of sediment.'@en ;
    skos:notation 'SDN:M17::SAMP_GRAB'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/M17/current/SAMP_PISTCOR/1/> .
<http://vocab.nerc.ac.uk/collection/M17/current/SAMP_PISTCOR/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/M17/current/SAMP_PISTCOR/>;
    dc:modified '2016-05-31T12:38:17'^^xsd:dateTime ;
    skos:altLabel 'Piston core'^^xsd:string ;
    skos:prefLabel 'Piston core'@en ;
    skos:definition 'A sample of material collected when a metal tube is pushed into the seafloor by a large weight which deploys on contact with the seabed.'@en ;
    skos:notation 'SDN:M17::SAMP_PISTCOR'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/M17/current/SAMP_PIST/1/> .
<http://vocab.nerc.ac.uk/collection/M17/current/SAMP_PIST/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/M17/current/SAMP_PIST/>;
    dc:modified '2016-05-31T12:38:17'^^xsd:dateTime ;
    skos:altLabel 'Piston sample'^^xsd:string ;
    skos:prefLabel 'Piston sample'@en ;
    skos:definition 'A sample of substrate is collected using a thin-walled metal tube with a piston at the tip, deployed at the base of a borehole. The metal tube slides into the substrate while the piston remains above it, creating a vacuum which assists the sample to enter the sampler.'@en ;
    skos:notation 'SDN:M17::SAMP_PIST'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/M17/current/SAMP_VIBR/1/> .
<http://vocab.nerc.ac.uk/collection/M17/current/SAMP_VIBR/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/M17/current/SAMP_VIBR/>;
    dc:modified '2016-05-31T12:38:17'^^xsd:dateTime ;
    skos:altLabel 'Vibrocore'^^xsd:string ;
    skos:prefLabel 'Vibrocore'@en ;
    skos:definition 'A sample collected from the seabed using a sampling technique in which a large diameter tube is vibrated into substrate while oscillating.'@en ;
    skos:notation 'SDN:M17::SAMP_VIBR'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/M17/current/SAMP_CORR/1/> .
<http://vocab.nerc.ac.uk/collection/M17/current/SAMP_CORR/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/M17/current/SAMP_CORR/>;
    dc:modified '2016-05-31T12:38:16'^^xsd:dateTime ;
    skos:altLabel 'Core run'^^xsd:string ;
    skos:prefLabel 'Core run'@en ;
    skos:definition 'A sample which consists of substrate material cut with a bit during drilling of a borehole and stored in a tubular housing known as a core barrel, which is located behind the drill head. The core barrel may consist of up to three layers of tube housing and can be lined with a plastic sleeve to ensure sample integrity. The length of the core run depends on the length of the core barrel.'@en ;
    skos:notation 'SDN:M17::SAMP_CORR'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/M17/current/SAMP_HAM/1/> .
<http://vocab.nerc.ac.uk/collection/M17/current/SAMP_HAM/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/M17/current/SAMP_HAM/>;
    dc:modified '2016-05-31T12:38:16'^^xsd:dateTime ;
    skos:altLabel 'Hammer sample'^^xsd:string ;
    skos:prefLabel 'Hammer sample'@en ;
    skos:definition 'A sample of substrate collected at the base of a borehole using a sampling tube which is attached to a rod with extensions to enable the tube to reach the base of the borehole. Energy through application of blows of a falling hammer to the sampling rods drives the tube into the base of the borehole to allow the sample to be collected.'@en ;
    skos:notation 'SDN:M17::SAMP_HAM'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/M17/current/SAMP_PUSH/1/> .
<http://vocab.nerc.ac.uk/collection/M17/current/SAMP_PUSH/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/M17/current/SAMP_PUSH/>;
    dc:modified '2016-05-31T12:38:16'^^xsd:dateTime ;
    skos:altLabel 'Push sample'^^xsd:string ;
    skos:prefLabel 'Push sample'@en ;
    skos:definition 'A sample of substrate collected at the base of a borehole using a sampling tube with a hydraulic ram which is connected to the deck of the vessel via a flexible umbilical. A steady pushing action then drives the tube into the base of the borehole to allow the sample to be collected.'@en ;
    skos:notation 'SDN:M17::SAMP_PUSH'^^xsd:string .
