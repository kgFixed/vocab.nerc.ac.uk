@prefix tree: <https://w3id.org/tree#> .
@prefix ldes: <https://w3id.org/ldes#> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

@base <https://kgfixed.github.io/vocab.nerc.ac.uk/L12/2008_01_01_00_00_00_2008_12_31_23_59_59.ttl> .

<>
    a tree:Node
     .

<feed>
  a ldes:EventStream ;
  ldes:timestampPath dc:modified ;
  ldes:versionOfPath dc:isVersionOf ;
  
  
  tree:shape [
    a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path dc:isVersionOf
    ],
    [
      sh:datatype xsd:dateTime ;
      sh:minCount 1 ;
      sh:path dc:modified
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:altLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:prefLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:definition
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:notation
    ];
    sh:targetClass skos:Concept
  ] ;
  tree:view <> ;
  .

<feed> tree:member <http://vocab.nerc.ac.uk/collection/L12/current/A/1/> .
<http://vocab.nerc.ac.uk/collection/L12/current/A/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L12/current/A/>;
    dc:modified '2008-11-24T15:38:03'^^xsd:dateTime ;
    skos:altLabel 'Real-time + delayed mode QC'^^xsd:string ;
    skos:prefLabel 'Real-time plus delayed mode validation on the data'@en ;
    skos:definition 'Automatic validation checks were applied to the data as they were collected prior to their initial publication.Validation checks, including both algorithms and manual examination, were applied to the data subsequent to their initial publication.'@en ;
    skos:notation 'SDN:L12::A'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L12/current/R/1/> .
<http://vocab.nerc.ac.uk/collection/L12/current/R/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L12/current/R/>;
    dc:modified '2008-11-24T15:36:58'^^xsd:dateTime ;
    skos:altLabel 'Real-time QC'^^xsd:string ;
    skos:prefLabel 'Real-time validation on the data'@en ;
    skos:definition 'Automatic validation checks have been applied to the data as they were collected prior to their initial publication'@en ;
    skos:notation 'SDN:L12::R'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L12/current/D/1/> .
<http://vocab.nerc.ac.uk/collection/L12/current/D/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L12/current/D/>;
    dc:modified '2008-11-24T15:34:44'^^xsd:dateTime ;
    skos:altLabel 'Delayed mode QC'^^xsd:string ;
    skos:prefLabel 'Delayed mode validation on the data'@en ;
    skos:definition 'Validation checks, including both algorithms and manual examination, were applied to the data subsequent to their initial publication.'@en ;
    skos:notation 'SDN:L12::D'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L12/current/N/1/> .
<http://vocab.nerc.ac.uk/collection/L12/current/N/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L12/current/N/>;
    dc:modified '2008-11-24T15:27:28'^^xsd:dateTime ;
    skos:altLabel 'Unvalidated'^^xsd:string ;
    skos:prefLabel 'No validation on the data'@en ;
    skos:definition 'No validation checks have been made on the data.'@en ;
    skos:notation 'SDN:L12::N'^^xsd:string .
