@prefix tree: <https://w3id.org/tree#> .
@prefix ldes: <https://w3id.org/ldes#> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

@base <https://kgfixed.github.io/vocab.nerc.ac.uk/G11/2012_01_01_00_00_00_2012_12_31_23_59_59.ttl> .

<>
    a tree:Node
     .

<feed>
  a ldes:EventStream ;
  ldes:timestampPath dc:modified ;
  ldes:versionOfPath dc:isVersionOf ;
  
  
  tree:shape [
    a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path dc:isVersionOf
    ],
    [
      sh:datatype xsd:dateTime ;
      sh:minCount 1 ;
      sh:path dc:modified
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:altLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:prefLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:definition
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:notation
    ];
    sh:targetClass skos:Concept
  ] ;
  tree:view <> ;
  .

<feed> tree:member <http://vocab.nerc.ac.uk/collection/G11/current/001/1/> .
<http://vocab.nerc.ac.uk/collection/G11/current/001/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/G11/current/001/>;
    dc:modified '2012-07-04T11:01:43'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'image'@en ;
    skos:definition 'Meaningful numerical representation of a physical parameter that is not the actual value of the physical parameter'@en ;
    skos:notation 'SDN:G11::001'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/G11/current/002/1/> .
<http://vocab.nerc.ac.uk/collection/G11/current/002/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/G11/current/002/>;
    dc:modified '2012-07-04T11:01:43'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'thematicClassification'@en ;
    skos:definition 'Code value with no quantitative meaning, used to represent a physical quantity'@en ;
    skos:notation 'SDN:G11::002'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/G11/current/003/1/> .
<http://vocab.nerc.ac.uk/collection/G11/current/003/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/G11/current/003/>;
    dc:modified '2012-07-04T11:01:43'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'physicalMeasurement'@en ;
    skos:definition 'Value in physical units of the quantity being measured'@en ;
    skos:notation 'SDN:G11::003'^^xsd:string .
