@prefix tree: <https://w3id.org/tree#> .
@prefix ldes: <https://w3id.org/ldes#> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

@base <https://kgfixed.github.io/vocab.nerc.ac.uk/H06/2021_01_01_00_00_00_2021_12_31_23_59_59.ttl> .

<>
    a tree:Node
     .

<feed>
  a ldes:EventStream ;
  ldes:timestampPath dc:modified ;
  ldes:versionOfPath dc:isVersionOf ;
  
  
  tree:shape [
    a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path dc:isVersionOf
    ],
    [
      sh:datatype xsd:dateTime ;
      sh:minCount 1 ;
      sh:path dc:modified
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:altLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:prefLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:definition
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:notation
    ];
    sh:targetClass skos:Concept
  ] ;
  tree:view <> ;
  .

<feed> tree:member <http://vocab.nerc.ac.uk/collection/H06/current/H06AA001/2/> .
<http://vocab.nerc.ac.uk/collection/H06/current/H06AA001/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/H06/current/H06AA001/>;
    dc:modified '2021-04-26T09:55:49'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'transparent/translucent'@en ;
    skos:definition 'Term that qualifies micro-litter particles that allow light to travel through them either almost unaltered (transparent) or with some diffraction (translucent, translucid or semitransparent).'@en ;
    skos:notation 'SDN:H06::H06AA001'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/H06/current/H06AA002/1/> .
<http://vocab.nerc.ac.uk/collection/H06/current/H06AA002/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/H06/current/H06AA002/>;
    dc:modified '2021-04-25T22:28:08'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'opaque'@en ;
    skos:definition 'Term that qualifies micro-litter particles that do not allow the light to travel through them.'@en ;
    skos:notation 'SDN:H06::H06AA002'^^xsd:string .
