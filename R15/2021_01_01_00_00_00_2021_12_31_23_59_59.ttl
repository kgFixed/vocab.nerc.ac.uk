    skos:altLabel '200'^^xsd:string ;
    skos:prefLabel 'DET'@en ;
    skos:definition 'All measurements made at time when float first approaches within 3% of the eventual drift pressure. Float may be transitioning from the surface or from a deep profile. This variable is based on measured or estimated pressure only In the case of a float that overshoots the drift pressure on descent, DET is the time of the overshoot.'@en ;
    skos:notation 'SDN:R15::200'^^xsd:string .
