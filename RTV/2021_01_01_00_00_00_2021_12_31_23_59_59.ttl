    skos:altLabel 'LAST_LOCATION'^^xsd:string ;
    skos:prefLabel 'Last Location Time'@en ;
    skos:definition 'Time of the last location received.'@en ;
    skos:notation 'SDN:RTV::LLT'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/RTV/current/LMT/1/> .
