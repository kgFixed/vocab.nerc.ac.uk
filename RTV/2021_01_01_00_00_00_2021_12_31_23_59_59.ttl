    skos:altLabel 'FIRST_STABILIZATION'^^xsd:string ;
    skos:prefLabel 'First Stabilization Time'@en ;
    skos:definition 'Time at which the float first becomes water-neutral.'@en ;
    skos:notation 'SDN:RTV::FST'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/RTV/current/LLT/1/> .
<http://vocab.nerc.ac.uk/collection/RTV/current/LLT/1/>
