    skos:altLabel 'FIRST_LOCATION'^^xsd:string ;
    skos:prefLabel 'First Location Time'@en ;
    skos:definition 'Time of the first location received.'@en ;
    skos:notation 'SDN:RTV::FLT'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/RTV/current/FMT/1/> .
