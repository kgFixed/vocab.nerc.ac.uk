    skos:notation 'SDN:RTV::TET'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/RTV/current/TST/1/> .
<http://vocab.nerc.ac.uk/collection/RTV/current/TST/1/>
    a skos:Concept ;
