<feed> tree:member <http://vocab.nerc.ac.uk/collection/RTV/current/PET/1/> .
<http://vocab.nerc.ac.uk/collection/RTV/current/PET/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/RTV/current/PET/>;
    dc:modified '2021-11-30T12:47:38'^^xsd:dateTime ;
    skos:altLabel 'PARK_END'^^xsd:string ;
    skos:prefLabel 'Park End Time'@en ;
    skos:definition 'Time at which the float exists from its Park or Drift mission. The float may then rise to the surface or sink to profile depth.'@en ;
    skos:notation 'SDN:RTV::PET'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/RTV/current/PST/1/> .
<http://vocab.nerc.ac.uk/collection/RTV/current/PST/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/RTV/current/PST/>;
