@prefix tree: <https://w3id.org/tree#> .
@prefix ldes: <https://w3id.org/ldes#> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

@base <https://kgfixed.github.io/vocab.nerc.ac.uk/RTV/2021_01_01_00_00_00_2021_12_31_23_59_59.ttl> .

<>
    a tree:Node
     .

<feed>
  a ldes:EventStream ;
  ldes:timestampPath dc:modified ;
  ldes:versionOfPath dc:isVersionOf ;
  
  
  tree:shape [
    a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path dc:isVersionOf
    ],
    [
      sh:datatype xsd:dateTime ;
      sh:minCount 1 ;
      sh:path dc:modified
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:altLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:prefLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:definition
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:notation
    ];
    sh:targetClass skos:Concept
  ] ;
  tree:view <> ;
  .

<feed> tree:member <http://vocab.nerc.ac.uk/collection/RTV/current/AET/1/> .
<http://vocab.nerc.ac.uk/collection/RTV/current/AET/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/RTV/current/AET/>;
    dc:modified '2021-11-30T12:47:38'^^xsd:dateTime ;
    skos:altLabel 'ASCENT_END'^^xsd:string ;
    skos:prefLabel 'Ascent End Time'@en ;
    skos:definition 'Time at which the float reaches the surface.'@en ;
    skos:notation 'SDN:RTV::AET'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/RTV/current/AST/1/> .
<http://vocab.nerc.ac.uk/collection/RTV/current/AST/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/RTV/current/AST/>;
    dc:modified '2021-11-30T12:47:38'^^xsd:dateTime ;
    skos:altLabel 'ASCENT_START'^^xsd:string ;
    skos:prefLabel 'Ascent Start Time'@en ;
    skos:definition 'Time at which the float begins its return to the surface.'@en ;
    skos:notation 'SDN:RTV::AST'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/RTV/current/DAST/1/> .
<http://vocab.nerc.ac.uk/collection/RTV/current/DAST/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/RTV/current/DAST/>;
    dc:modified '2021-11-30T12:47:38'^^xsd:dateTime ;
    skos:altLabel 'DEEP_ASCENT_START'^^xsd:string ;
    skos:prefLabel 'Deep Ascent Start Time'@en ;
    skos:definition 'Time at which the float begins its rise to drift pressure. This variable is typically used for floats that profile on descent.'@en ;
    skos:notation 'SDN:RTV::DAST'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/RTV/current/DDET/1/> .
<http://vocab.nerc.ac.uk/collection/RTV/current/DDET/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/RTV/current/DDET/>;
    dc:modified '2021-11-30T12:47:38'^^xsd:dateTime ;
    skos:altLabel 'DEEP_DESCENT_END'^^xsd:string ;
    skos:prefLabel 'Deep Descent End Time'@en ;
    skos:definition 'Time at which the float first approaches within 3% of the eventual deep drift or profile pressure. This variable is based on pressure only, and can be measured or estimated by fall-rate.'@en ;
    skos:notation 'SDN:RTV::DDET'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/RTV/current/DPST/1/> .
<http://vocab.nerc.ac.uk/collection/RTV/current/DPST/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/RTV/current/DPST/>;
    dc:modified '2021-11-30T12:47:38'^^xsd:dateTime ;
    skos:altLabel 'DEEP_PARK_START'^^xsd:string ;
    skos:prefLabel 'Deep Park Start Time'@en ;
    skos:definition 'Time at which the float transitions to a deep park drift mission. This variable is only defined if the float is expected to enter a deep drift phase; it does not apply to cases of accidental drift at deep pressure, caused by bottom hits or buoyancy issues for example.'@en ;
    skos:notation 'SDN:RTV::DPST'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/RTV/current/DET/1/> .
<http://vocab.nerc.ac.uk/collection/RTV/current/DET/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/RTV/current/DET/>;
    dc:modified '2021-11-30T12:47:38'^^xsd:dateTime ;
    skos:altLabel 'DESCENT_END'^^xsd:string ;
    skos:prefLabel 'Descent End Time'@en ;
    skos:definition 'Time at which the float first approaches within 3% of the eventual drift pressure, whether it is transitioning from the surface or from a deep profile. In case the float overshoots the drift pressure on descent, the Descent End Time (DET) corresponds to the time of the overshoot. This variable is based on pressure only, and can be measured or estimated by fall-rate.'@en ;
    skos:notation 'SDN:RTV::DET'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/RTV/current/DST/1/> .
<http://vocab.nerc.ac.uk/collection/RTV/current/DST/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/RTV/current/DST/>;
    dc:modified '2021-11-30T12:47:38'^^xsd:dateTime ;
    skos:altLabel 'DESCENT_START'^^xsd:string ;
    skos:prefLabel 'Descent Start Time'@en ;
    skos:definition 'Time at which the float leaves the surface and begins the descent.'@en ;
    skos:notation 'SDN:RTV::DST'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/RTV/current/FLT/1/> .
