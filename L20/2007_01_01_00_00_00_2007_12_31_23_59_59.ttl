@prefix tree: <https://w3id.org/tree#> .
@prefix ldes: <https://w3id.org/ldes#> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

@base <https://kgfixed.github.io/vocab.nerc.ac.uk/L20/2007_01_01_00_00_00_2007_12_31_23_59_59.ttl> .

<>
    a tree:Node
     .

<feed>
  a ldes:EventStream ;
  ldes:timestampPath dc:modified ;
  ldes:versionOfPath dc:isVersionOf ;
  
  
  tree:shape [
    a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path dc:isVersionOf
    ],
    [
      sh:datatype xsd:dateTime ;
      sh:minCount 1 ;
      sh:path dc:modified
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:altLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:prefLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:definition
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:notation
    ];
    sh:targetClass skos:Concept
  ] ;
  tree:view <> ;
  .

<feed> tree:member <http://vocab.nerc.ac.uk/collection/L20/current/A/1/> .
<http://vocab.nerc.ac.uk/collection/L20/current/A/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L20/current/A/>;
    dc:modified '2007-05-17T10:47:30'^^xsd:dateTime ;
    skos:altLabel 'ID_uncertain'^^xsd:string ;
    skos:prefLabel 'value phenomenon uncertain'@en ;
    skos:definition 'There is uncertainty in the description of the measured phenomenon associated with the value such as chemical species or biological entity.'@en ;
    skos:notation 'SDN:L20::A'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L20/current/4/1/> .
<http://vocab.nerc.ac.uk/collection/L20/current/4/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L20/current/4/>;
    dc:modified '2007-05-17T10:47:30'^^xsd:dateTime ;
    skos:altLabel 'bad'^^xsd:string ;
    skos:prefLabel 'bad value'@en ;
    skos:definition 'An obviously erroneous data value.'@en ;
    skos:notation 'SDN:L20::4'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L20/current/5/1/> .
<http://vocab.nerc.ac.uk/collection/L20/current/5/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L20/current/5/>;
    dc:modified '2007-05-17T10:47:30'^^xsd:dateTime ;
    skos:altLabel 'changed'^^xsd:string ;
    skos:prefLabel 'changed value'@en ;
    skos:definition 'Data value adjusted during quality control.  Best practice strongly recommends that the value before the change be preserved in the data or its accompanying metadata.'@en ;
    skos:notation 'SDN:L20::5'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L20/current/8/1/> .
<http://vocab.nerc.ac.uk/collection/L20/current/8/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L20/current/8/>;
    dc:modified '2007-05-17T10:47:30'^^xsd:dateTime ;
    skos:altLabel 'interpolated'^^xsd:string ;
    skos:prefLabel 'interpolated value'@en ;
    skos:definition 'This value has been derived by interpolation from other values in the data object.'@en ;
    skos:notation 'SDN:L20::8'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L20/current/0/1/> .
<http://vocab.nerc.ac.uk/collection/L20/current/0/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L20/current/0/>;
    dc:modified '2007-05-17T10:47:30'^^xsd:dateTime ;
    skos:altLabel 'none'^^xsd:string ;
    skos:prefLabel 'no quality control'@en ;
    skos:definition 'No quality control procedures have been applied to the data value. This is the initial status for all data values entering the working archive.'@en ;
    skos:notation 'SDN:L20::0'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L20/current/3/1/> .
<http://vocab.nerc.ac.uk/collection/L20/current/3/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L20/current/3/>;
    dc:modified '2007-05-17T10:47:30'^^xsd:dateTime ;
    skos:altLabel 'probably_bad'^^xsd:string ;
    skos:prefLabel 'probably bad value'@en ;
    skos:definition 'Data value recognised as unusual during quality control that forms part of a feature that is probably inconsistent with real phenomena.'@en ;
    skos:notation 'SDN:L20::3'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L20/current/2/1/> .
<http://vocab.nerc.ac.uk/collection/L20/current/2/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L20/current/2/>;
    dc:modified '2007-05-17T10:47:30'^^xsd:dateTime ;
    skos:altLabel 'probably_good'^^xsd:string ;
    skos:prefLabel 'probably good value'@en ;
    skos:definition 'Data value that is probably consistent with real phenomena but this is unconfirmed or data value forming part of a malfunction that is considered too small to affect the overall quality of the data object of which it is a part.'@en ;
    skos:notation 'SDN:L20::2'^^xsd:string .
