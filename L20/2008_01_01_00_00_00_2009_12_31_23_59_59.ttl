    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:prefLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:definition
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:notation
    ];
    sh:targetClass skos:Concept
  ] ;
  tree:view <> ;
  .

<feed> tree:member <http://vocab.nerc.ac.uk/collection/L20/current/7/2/> .
<http://vocab.nerc.ac.uk/collection/L20/current/7/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L20/current/7/>;
    dc:modified '2009-05-12T09:15:02'^^xsd:dateTime ;
    skos:altLabel 'excess'^^xsd:string ;
    skos:prefLabel 'value in excess'@en ;
    skos:definition 'The level of the measured phenomenon was too large to be quantified by the technique employed to measure it.  The accompanying value is the measurement limit for the technique.'@en ;
    skos:notation 'SDN:L20::7'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L20/current/1/2/> .
<http://vocab.nerc.ac.uk/collection/L20/current/1/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L20/current/1/>;
    dc:modified '2009-05-12T09:11:55'^^xsd:dateTime ;
    skos:altLabel 'good'^^xsd:string ;
    skos:prefLabel 'good value'@en ;
    skos:definition 'Good quality data value that is not part of any identified malfunction and has been verified as consistent with real phenomena during the quality control process.'@en ;
    skos:notation 'SDN:L20::1'^^xsd:string .
