<http://vocab.nerc.ac.uk/collection/M25/current/MEDIN/4/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/M25/current/MEDIN/>;
    dc:modified '2022-04-27T17:03:52'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'MEDIN'@en ;
    skos:definition '{"metadataProfile":"The UK Marine Environmental Data and Information Network (MEDIN) maintain a discovery metadata standard for marine geospatial data. This is a marine-specific profile of UK GEMINI with elements restricted by marine-oriented controlled vocabularies. Further information on MEDIN and the MEDIN profile is available at www.medin.org.uk","profileCurrentVersion":"3.0"}'@en ;
    skos:notation 'SDN:M25::MEDIN'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/M25/current/GEMINI/4/> .
<http://vocab.nerc.ac.uk/collection/M25/current/GEMINI/4/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/M25/current/GEMINI/>;
    dc:modified '2022-04-27T17:03:52'^^xsd:dateTime ;
    skos:altLabel 'GEMINI'^^xsd:string ;
    skos:prefLabel 'UK GEMINI'@en ;
    skos:definition '{"metadataProfile": "UK GEMINI (GEo-spatial Metadata Interoperability iNItiative) is a United Kingdom specification for a set of discovery metadata elements for describing geospatial data resources. It uses the EU INSPIRE subset of ISO 19115. The intellectual property of UK GEMINI is owned by the Association for Geographic Information (AGI) and further information is available at https://www.agi.org.uk/gemini","profileCurrentVersion": "2.3 "}'@en ;
    skos:notation 'SDN:M25::GEMINI'^^xsd:string .
