    skos:prefLabel 'ISO 19115:2003'@en ;
    skos:definition '{"metadataProfile":"Standard published by the International Organisation for Standardisation (ISO) to provide a structure for describing digital geographic data. ISO 19115 was published in May 2003. This concept also accounts for ISO 19115:2003 with corrigenda added in 2006.","profileCurrentVersion":"ISO 19115:2003"}'@en ;
