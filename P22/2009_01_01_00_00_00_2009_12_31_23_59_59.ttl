    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Geology'@en ;
    skos:definition 'Geology characterised according to composition and structure. Includes bedrock, aquifers and geomorphology.'@en ;
    skos:notation 'SDN:P22::13'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P22/current/14/1/> .
<http://vocab.nerc.ac.uk/collection/P22/current/14/1/>
