<feed> tree:member <http://vocab.nerc.ac.uk/collection/P22/current/18/1/> .
<http://vocab.nerc.ac.uk/collection/P22/current/18/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P22/current/18/>;
    dc:modified '2009-07-30T13:25:19'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Human health and safety'@en ;
    skos:definition 'Distribución geográfica de la dominancia de patologías (alergias, cáncer, enfermedades respiratorias, etc.), la información que indique el efecto sobre la salud (marcadores biológicos, declive de la fertilidad, epidemias) o el bienestar humanos (cansancio, estrés, etc.) directamente vinculada con la calidad del medio ambiente (contaminación del aire, productos químicos, enrarecimiento de la capa de ozono, ruido, etc.) o indirectamente vinculada con dicha calidad (alimentos, organismos modificados genéticamente, etc.).'@en ;
    skos:notation 'SDN:P22::18'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P22/current/18/1/> .
