    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P22/current/162/>;
    dc:modified '2009-07-30T13:25:19'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Transport networks'@en ;
    skos:definition 'Redes de carreteras, ferrocarril, transporte aéreo y vías navegables, con sus correspondientes infraestructuras. Se incluirán las conexiones entre redes diferentes. Se incluirá también la red transeuropea de transporte, según la definición de la Decisión no 1692/96/CE del Parlamento Europeo y del Consejo, de 23 de julio de 1996, sobre las orientaciones comunitarias para el desarrollo de la red transeuropea de transporte (1), y de las futuras revisiones de dicha Decisión.'@en ;
    skos:notation 'SDN:P22::162'^^xsd:string .
