    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Coordinate reference systems'@en ;
    skos:definition 'Systems for uniquely referencing spatial information in space as a set of coordinates (x, y, z) and/or latitude and longitude and height, based on a geodetic horizontal and vertical datum.'@en ;
    skos:notation 'SDN:P22::1'^^xsd:string .
