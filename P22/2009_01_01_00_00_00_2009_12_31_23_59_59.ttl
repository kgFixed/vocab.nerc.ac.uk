    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Orthoimagery'@en ;
    skos:definition 'Geo-referenced image data of the Earth\'s surface, from either satellite or airborne sensors.'@en ;
    skos:notation 'SDN:P22::12'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P22/current/13/1/> .
<http://vocab.nerc.ac.uk/collection/P22/current/13/1/>
