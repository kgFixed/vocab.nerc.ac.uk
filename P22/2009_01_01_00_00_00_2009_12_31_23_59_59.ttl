    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Elevation'@en ;
    skos:definition 'Digital elevation models for land, ice and ocean surface. Includes terrestrial elevation, bathymetry and shoreline.'@en ;
    skos:notation 'SDN:P22::10'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P22/current/11/1/> .
