    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Land cover'@en ;
    skos:definition 'Physical and biological cover of the earth\'s surface including artificial surfaces, agricultural areas, forests, (semi-)natural areas, wetlands, water bodies.'@en ;
    skos:notation 'SDN:P22::11'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P22/current/12/1/> .
