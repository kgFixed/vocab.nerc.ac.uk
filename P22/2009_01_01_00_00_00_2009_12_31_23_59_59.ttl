    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Statistical units'@en ;
    skos:definition 'Units for dissemination or use of statistical information.'@en ;
    skos:notation 'SDN:P22::14'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P22/current/15/1/> .
<http://vocab.nerc.ac.uk/collection/P22/current/15/1/>
    a skos:Concept ;
