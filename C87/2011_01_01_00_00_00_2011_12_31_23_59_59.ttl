    dc:modified '2011-12-12T09:37:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Project administrator'@en ;
    skos:definition 'Project secretariat members providing administrative support to the project without management responsibility.'@en ;
    skos:notation 'SDN:C87::PA'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/C87/current/PM/1/> .
<http://vocab.nerc.ac.uk/collection/C87/current/PM/1/>
