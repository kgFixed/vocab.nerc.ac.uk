    dc:modified '2011-12-12T09:37:26'^^xsd:dateTime ;
    skos:altLabel 'RA'^^xsd:string ;
    skos:prefLabel 'Project research assistant'@en ;
    skos:definition 'Persons employed as researchers on a project, usually the line management responsibility of the principal investigator or a co-investigator.'@en ;
