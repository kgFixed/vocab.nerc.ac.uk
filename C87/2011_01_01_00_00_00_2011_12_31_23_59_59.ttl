    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/C87/current/PI/>;
    dc:modified '2011-12-12T09:37:26'^^xsd:dateTime ;
    skos:altLabel 'Project PI'^^xsd:string ;
    skos:prefLabel 'Project principal investigator'@en ;
    skos:definition 'The person or persons responsible for the overall planning, direction and management of the project.  This role is termed the project co-ordinator in EU projects.'@en ;
    skos:notation 'SDN:C87::PI'^^xsd:string .
