<feed> tree:member <http://vocab.nerc.ac.uk/collection/C87/current/MP/1/> .
<http://vocab.nerc.ac.uk/collection/C87/current/MP/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/C87/current/MP/>;
    dc:modified '2011-12-12T09:37:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Project data manager'@en ;
    skos:definition 'Person with particular responsibility for accuracy and completeness of metadata, data quality and the short-term data access and security and assuring the long-term stewardship of the data collected during the project, but has no IPR interest in those data.'@en ;
    skos:notation 'SDN:C87::MP'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/C87/current/PA/1/> .
