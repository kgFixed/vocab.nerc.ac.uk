    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/C87/current/PM/>;
    dc:modified '2011-12-12T09:37:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Project manager'@en ;
    skos:definition 'Project secretariat member with management responsibilities for the project.'@en ;
    skos:notation 'SDN:C87::PM'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/C87/current/RA/1/> .
