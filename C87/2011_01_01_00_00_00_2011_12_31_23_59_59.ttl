    skos:altLabel 'Dataset PI'^^xsd:string ;
    skos:prefLabel 'Project dataset principal investigator'@en ;
    skos:definition 'The person responsible for a specified subset of the data collected during a project and who holds the IPR for that subset of the data.'@en ;
    skos:notation 'SDN:C87::DP'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/C87/current/PG/1/> .
