    dc:modified '2017-07-31T23:45:49'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Cell volume'@en ;
    skos:definition 'The volume of a single cell or the average volume of single cells.'@en ;
    skos:notation 'SDN:S06::S0600081'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600080/2/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600080/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600080/>;
    dc:modified '2017-07-11T18:11:54'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Absorbance'@en ;
    skos:definition 'A measure of the quantity of incident electromagnetic radiation that is absorbed by an object, substance or solution.'@en ;
    skos:notation 'SDN:S06::S0600080'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600079/1/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600079/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600079/>;
    dc:modified '2017-07-11T11:35:55'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Oxidation rate'@en ;
    skos:definition 'The speed at which a chemical species increases its oxidation number by losing electrons or, in organic chemistry, gaining oxygen or losing hydrogen. Oxidation is coupled with reduction in redox reactions.'@en ;
    skos:notation 'SDN:S06::S0600079'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600078/1/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600078/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600078/>;
    dc:modified '2017-07-11T11:33:33'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Reduction rate'@en ;
    skos:definition 'The speed at which a chemical species decreases its oxidation number by gaining electrons or, in organic chemistry, losing oxygen or gaining hydrogen. Reduction is coupled to oxidation in redox reactions.'@en ;
    skos:notation 'SDN:S06::S0600078'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600077/1/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600077/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600077/>;
    dc:modified '2017-07-11T10:57:23'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Dissimilation rate'@en ;
    skos:definition 'The speed with which an organic substance is broken down into simpler molecules in living organisms, releasing energy.'@en ;
    skos:notation 'SDN:S06::S0600077'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600076/1/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600076/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600076/>;
    dc:modified '2017-06-29T14:16:52'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Concentration change rate'@en ;
    skos:definition 'The difference between the concentration of a substance at a given time minus its concentration at an earlier time divided by the time elapsed between the two time points.'@en ;
    skos:notation 'SDN:S06::S0600076'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600075/1/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600075/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600075/>;
    dc:modified '2017-06-29T12:02:18'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Fugacity anomaly (water - air)'@en ;
    skos:definition 'The difference between the fugacity of a gas in a sample in equilibrium with water minus the fugacity of this gas in an air sample.'@en ;
    skos:notation 'SDN:S06::S0600075'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600074/1/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600074/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600074/>;
    dc:modified '2017-06-29T11:58:12'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Fugacity'@en ;
    skos:definition 'The effective partial pressure of a gas allowing for the non-ideal nature of the gas phase.'@en ;
    skos:notation 'SDN:S06::S0600074'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600073/1/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600073/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600073/>;
    dc:modified '2017-06-29T10:55:13'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Mole fraction'@en ;
    skos:definition 'Ratio of the amount expressed in moles of a component divided by the total number of moles of all constituents in a mixture.'@en ;
    skos:notation 'SDN:S06::S0600073'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600072/1/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600072/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600072/>;
    dc:modified '2017-06-29T10:46:11'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Mole fraction in dry air'@en ;
    skos:definition 'Ratio of the amount expressed in moles of a component divided by the total number of moles of all constituents in an air sample after removal of water vapour.'@en ;
    skos:notation 'SDN:S06::S0600072'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600071/1/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600071/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600071/>;
    dc:modified '2017-06-29T10:46:07'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Mole fraction at 100% humidity'@en ;
    skos:definition 'Ratio of the amount expressed in moles of a component divided by the total number of moles of all constituents in an air sample at 100% humidity (sometimes also labelled \'wet air\').'@en ;
    skos:notation 'SDN:S06::S0600071'^^xsd:string .
