    skos:prefLabel 'Wave height'@en ;
    skos:definition 'Distance verticale entre le creux d\'une vague (transition entre la diminution du niveau d\'eau et son augmentation) et la crète de la vague suivante (transition entre l\'augmentation du niveau d\'eau et sa diminution).'@en ;
    skos:notation 'SDN:S06::S0600103'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600103/1/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600103/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600103/>;
    dc:modified '2017-12-07T15:19:02'^^xsd:dateTime ;
    skos:altLabel 'H'^^xsd:string ;
    skos:prefLabel 'hauteur de vague'@en ;
    skos:definition 'Distance verticale entre le creux d\'une vague (transition entre la diminution du niveau d\'eau et son augmentation) et la crète de la vague suivante (transition entre l\'augmentation du niveau d\'eau et sa diminution).'@en ;
    skos:notation 'SDN:S06::S0600103'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600104/1/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600104/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600104/>;
    dc:modified '2017-12-07T15:19:02'^^xsd:dateTime ;
    skos:altLabel 'Hc'^^xsd:string ;
    skos:prefLabel 'Wave crest height'@en ;
    skos:definition 'The vertical distance between a wave crest (transition between increasing water level to decreasing water level) and the calm sea surface.'@en ;
    skos:notation 'SDN:S06::S0600104'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600107/1/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600107/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600107/>;
    dc:modified '2017-12-07T15:19:02'^^xsd:dateTime ;
    skos:altLabel 'Hm0'^^xsd:string ;
    skos:prefLabel 'Spectral significant wave height'@en ;
    skos:definition 'A computationally convenient approximation (square root of the zeroth spectral moment multiplied by 4 or 4 times the wave height standard deviation) to significant wave height. Significant wave height is a statistic computed from wave measurements that correspond to the average height of the highest one third of the waves, where wave height is defined as the vertical distance from a wave trough to the following wave crest.'@en ;
    skos:notation 'SDN:S06::S0600107'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600106/1/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600106/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600106/>;
    dc:modified '2017-12-07T15:19:02'^^xsd:dateTime ;
    skos:altLabel 'Hrms*4'^^xsd:string ;
    skos:prefLabel 'Characteristic wave height'@en ;
    skos:definition 'A computationally convenient approximation (root mean square wave height in sampling period multiplied by 4) to significant wave height. Significant wave height is a statistic computed from wave measurements that correspond to the average height of the highest one third of the waves, where wave height is defined as the vertical distance from a wave trough to the following wave crest.'@en ;
    skos:notation 'SDN:S06::S0600106'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600105/1/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600105/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600105/>;
    dc:modified '2017-12-07T15:19:02'^^xsd:dateTime ;
    skos:altLabel 'Hs'^^xsd:string ;
    skos:prefLabel 'Significant wave height'@en ;
    skos:definition 'A statistic computed from wave measurements that correspond to the average height of the highest one third of the waves, where the height is defined as the vertical distance from a wave trough to the following wave crest.'@en ;
    skos:notation 'SDN:S06::S0600105'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600109/1/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600109/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600109/>;
    dc:modified '2017-12-07T15:19:02'^^xsd:dateTime ;
    skos:altLabel 'Tc'^^xsd:string ;
    skos:prefLabel 'Wave crest period'@en ;
    skos:definition 'Wave period is the time between two successive designated events in the waveform. A wave crest event is the transition between increasing water level to decreasing water level.'@en ;
    skos:notation 'SDN:S06::S0600109'^^xsd:string .
