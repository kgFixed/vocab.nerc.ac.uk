<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600086/2/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600086/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600086/>;
    dc:modified '2018-01-10T16:02:28'^^xsd:dateTime ;
    skos:altLabel 'AFDW'^^xsd:string ;
    skos:prefLabel 'Ash-free dry weight biomass'@en ;
    skos:definition 'An estimate of the weight of organic biomass in a given area , volume or mass of environmental matrix based on the weight of a biological sample after drying minus the weight of the material left behind after total incineration of the sample (mineral fraction).'@en ;
    skos:notation 'SDN:S06::S0600086'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600087/2/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600087/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600087/>;
    dc:modified '2018-01-10T15:59:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Dry weight biomass'@en ;
    skos:definition 'The weight of both organic and inorganic (i.e. mineral) matter of biological organisms in a given area, volume or mass of environmental matrix after all the water has been removed. This is typically done by baking samples at a temperature low enough to avoid combustion (typically around 60 degrees Celsius) followed by a period in a sealed container containing a desiccant.'@en ;
    skos:notation 'SDN:S06::S0600087'^^xsd:string .
