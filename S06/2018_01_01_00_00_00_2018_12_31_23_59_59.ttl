    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Net production rate'@en ;
    skos:definition 'The rate at which the amount of an entity (chemical, biological) changes over time in a system. It is the resultant of the amount produced minus the amount lost or consumed.'@en ;
    skos:notation 'SDN:S06::S0600216'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600215/1/> .
