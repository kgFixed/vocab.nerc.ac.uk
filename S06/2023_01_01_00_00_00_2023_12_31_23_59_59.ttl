    skos:altLabel 'delta(53Cr/52CrNIST-979)'^^xsd:string ;
    skos:prefLabel 'Enrichment with respect to 53Cr/52Cr in NIST SRM 979'@en ;
    skos:definition 'Deviation of the isotope ratio 53Cr/52Cr relative to the international reference material, NIST SRM 979, a chromium isotopic standard.'@en ;
