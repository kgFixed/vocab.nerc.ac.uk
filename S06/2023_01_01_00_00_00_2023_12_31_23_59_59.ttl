    dc:modified '2023-01-23T12:47:38'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Correlation magnitude'@en ;
    skos:definition 'A measure of the pulse to pulse correlation in acoustic pulses from an acoustic doppler current profiler, at the lag used for estimating the doppler phase shift. Used as a quality control indicator.'@en ;
    skos:notation 'SDN:S06::S0600197'^^xsd:string .
