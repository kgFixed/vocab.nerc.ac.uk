<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600312/2/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600312/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600312/>;
    dc:modified '2023-08-14T10:36:12'^^xsd:dateTime ;
    skos:altLabel 'RPSI'^^xsd:string ;
    skos:prefLabel 'Relative Penis Size Index'@en ;
    skos:definition 'An index used to estimate the intensity of imposex, a condition resulting in the development of a penis and vas deferens in female gastropods when exposed to certain pollutants. The index is calculated as the mean length of female penis cubed divided by mean length of male penis cubed multiplied by 100 (Bryan et al 1986, Gibbs et al 1987, Gibbs 1999).'@en ;
    skos:notation 'SDN:S06::S0600312'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600313/1/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600313/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600313/>;
    dc:modified '2023-07-31T13:30:31'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Relative Penis Length Index'@en ;
    skos:definition 'An index used in the monitoring of imposex, a condition resulting in the development of a penis and vas deferens in female gastropods when exposed to certain pollutants. The index is calculated as the mean length of female penis divided by mean length of male penis in a population multiplied by 100 (Bryan et al 1986, Gibbs et al 1987, Gibbs 1999).'@en ;
    skos:notation 'SDN:S06::S0600313'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600314/1/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600314/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600314/>;
    dc:modified '2023-07-31T13:30:31'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Vas Deferens Sequence Index'@en ;
    skos:definition 'An index used in the monitoring of imposex, a condition resulting in the development of a penis and vas deferens in female gastropods when exposed to certain pollutants. The index is based on a sequence of six identified stages (number 1 to 6) in the development of imposex in female gastropods plus an initial stage (number 0). The index is the mean of the stages observed in a population (Gibbs 1999).'@en ;
    skos:notation 'SDN:S06::S0600314'^^xsd:string .
