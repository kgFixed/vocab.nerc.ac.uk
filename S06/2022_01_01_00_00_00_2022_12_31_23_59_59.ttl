<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600294/1/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600294/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600294/>;
    dc:modified '2022-07-11T15:05:55'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Net upward flux (into atmosphere)'@en ;
    skos:definition 'Rate of transfer through a surface in contact with the atmosphere in an upward direction, positive values indicating a net upward flow into the atmosphere and negative values indicating a net downward flow from the atmosphere.'@en ;
    skos:notation 'SDN:S06::S0600294'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600293/1/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600293/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600293/>;
    dc:modified '2022-06-13T16:02:44'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Relative loss rate'@en ;
    skos:definition 'The amount of an entity lost from a system divided by the initial amount of that entity in the system relative to time.'@en ;
    skos:notation 'SDN:S06::S0600293'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600292/1/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600292/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600292/>;
    dc:modified '2022-06-13T15:41:44'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Vertical attenuation'@en ;
    skos:definition 'The proportion of any kind of flux or signal that is lost when absorbed or scattered by a medium along the vertical Z axis.'@en ;
    skos:notation 'SDN:S06::S0600292'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600291/1/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600291/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600291/>;
    dc:modified '2022-06-13T12:27:41'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Net upward flux'@en ;
    skos:definition 'Rate of transfer through a surface or a substance in an upward direction, positive values indicating a net upward flow and negative values indicating a net downward flow.'@en ;
    skos:notation 'SDN:S06::S0600291'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600290/1/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600290/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600290/>;
    dc:modified '2022-06-01T13:23:06'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Density'@en ;
    skos:definition 'The density of a substance or consituent is defined as its mass per unit volume. In some cases, density is also defined as weight per unit volume, although this quantity is referred to as specific weight.'@en ;
    skos:notation 'SDN:S06::S0600290'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600287/1/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600287/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600287/>;
    dc:modified '2022-05-23T22:47:40'^^xsd:dateTime ;
    skos:altLabel 'BOD'^^xsd:string ;
    skos:prefLabel 'Biochemical oxygen demand'@en ;
    skos:definition 'The amount of oxygen needed by aerobic biological organisms to break down organic material present in a water sample at certain temperature over a specific time period.'@en ;
    skos:notation 'SDN:S06::S0600287'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600288/1/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600288/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600288/>;
    dc:modified '2022-05-23T22:47:40'^^xsd:dateTime ;
    skos:altLabel 'COD'^^xsd:string ;
    skos:prefLabel 'Chemical oxygen demand'@en ;
    skos:definition 'The amount of oxygen required to oxidise all dissolved oxidisable chemical material contained in water sample.'@en ;
    skos:notation 'SDN:S06::S0600288'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600289/1/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600289/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600289/>;
    dc:modified '2022-05-23T22:47:40'^^xsd:dateTime ;
    skos:altLabel 'POD'^^xsd:string ;
    skos:prefLabel 'Photochemical oxygen demand'@en ;
    skos:definition 'The amount of oxygen that is needed to oxidise, under the influence of radiant energy (such as light), all dissolved oxidisable chemical material in a water sample.'@en ;
    skos:notation 'SDN:S06::S0600289'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600286/1/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600286/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600286/>;
    dc:modified '2022-05-20T13:30:27'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Mass concentration'@en ;
    skos:definition 'The mass of a substance or consituent divided by the volume of the mixture, expressed as mass per unit volume.'@en ;
    skos:notation 'SDN:S06::S0600286'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600044/3/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600044/3/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600044/>;
    dc:modified '2022-05-17T08:00:44'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Lipid-normalised concentration'@en ;
    skos:definition 'Term deprecated on 17May2022; the property "Concentration" should be used instead and combined with new S02 for lipid-normalised concentrations. Original description was: The amount of a specified substance in a unit amount of another substance or matrix corrected for variation in lipid content.'@en ;
    skos:notation 'SDN:S06::S0600044'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600049/2/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600049/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600049/>;
    dc:modified '2022-04-27T17:00:33'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Excess activity'@en ;
    skos:definition 'Difference between the measured activity of a radioactive isotope and the activity of that isotope predicted from equilibrium in-situ decay of its parent in a decay scheme.  This difference is used as the basis for radiometric dating.'@en ;
    skos:notation 'SDN:S06::S0600049'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600062/3/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600062/3/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600062/>;
    dc:modified '2022-04-27T17:00:33'^^xsd:dateTime ;
    skos:altLabel 'delta(66/64ZnIRMM-3702)'^^xsd:string ;
    skos:prefLabel 'Enrichment with respect to 66Zn/64Zn in IRMM-3702'@en ;
    skos:definition 'Deviation of the isotope ratio zinc-66/zinc-64 relative to the Institute for Reference Materials and Measurements, Belgium (IRMM) 3702 standard. It is defined as delta(66Zn/64Zn)IRMM-3702 =([66Zn/64Zn]sample/[66Zn/64Zn]IRMM-3702)-1)×1000. One delta unit represents a one part per 1,000 deviation from the IRMM-3702 standard composition.'@en ;
    skos:notation 'SDN:S06::S0600062'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600060/3/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600060/3/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600060/>;
    dc:modified '2022-04-27T17:00:33'^^xsd:dateTime ;
    skos:altLabel 'delta(66/64ZnLyon-JMC)'^^xsd:string ;
    skos:prefLabel 'Enrichment with respect to 66Zn/64Zn in Lyon JMC 3-0749'@en ;
    skos:definition 'Deviation of the isotope ratio zinc-66/zinc-64 relative to the Lyon standard JMC 3-0749, a reference material for zinc developed at the Ecole Normale Supérieure of Lyon using Johnson-Matthey Company (JMC) metal stock 3-0749. It is defined as delta(66Zn/64Zn)Lyon-JMC =([66Zn/64Zn]sample/[66Zn/64Zn]Lyon-JMC)-1)×1000. One delta unit represents a one part per 1,000 deviation from the Lyon-JMC standard composition.'@en ;
    skos:notation 'SDN:S06::S0600060'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600228/3/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600228/3/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600228/>;
    dc:modified '2022-04-27T08:58:55'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Likelihood category of death from natural causes'@en ;
    skos:definition 'Term indicating the probability (for example: not/impossible, possible, probable, likely, definitely, unknown) that a biological organism died of natural causes.'@en ;
    skos:notation 'SDN:S06::S0600228'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600229/2/> .
