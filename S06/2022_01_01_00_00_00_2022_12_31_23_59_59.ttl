<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600302/1/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600302/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600302/>;
    dc:modified '2022-11-29T13:17:51'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Horizontal visibility (ESAS code)'@en ;
    skos:definition 'A one-character string used by European Seabirds At Sea (ESAS) to classify ranges of horizontal visibility.'@en ;
    skos:notation 'SDN:S06::S0600302'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600301/2/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600301/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600301/>;
    dc:modified '2022-11-27T09:32:41'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Colour (Pt/Co scale)'@en ;
    skos:definition 'Also called APHA-Hazen scale or APHA-Hazen color or colour, the Platinum-Cobalt scale is a method of measuring the colour of water samples that is specific to the colour yellow. One unit of colour on the scale is defined as the colour produced by 1 milligram of platinum cobalt dissolved in 1 litre of water.'@en ;
    skos:notation 'SDN:S06::S0600301'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600299/2/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600299/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600299/>;
    dc:modified '2022-11-22T06:15:11'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Density (dry bulk)'@en ;
    skos:definition 'Mass of dry matter contained in a sample of soil or sediment divided by the volume of the sample before drying. The total volume includes particle volume, inter-particle void volume, and internal pore volume.'@en ;
    skos:notation 'SDN:S06::S0600299'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600300/2/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600300/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600300/>;
    dc:modified '2022-11-22T06:15:11'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Density (wet bulk)'@en ;
    skos:definition 'Total mass of a fresh sample of soil or sediment (solid plus water) divided by its total volume. The total volume includes particle volume, inter-particle void volume, and internal pore volume.'@en ;
    skos:notation 'SDN:S06::S0600300'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600298/1/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600298/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600298/>;
    dc:modified '2022-10-19T17:05:00'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Electrical conductivity'@en ;
    skos:definition 'The measure of a body of water\'s capability to pass electrical current. It is directly related to the concentration of dissolved ions in the water, such as chlorides, sulfides and carbonate compounds. The more ions that are present, the higher the conductivity of the water. It can be used to calculate practical salinity.'@en ;
    skos:notation 'SDN:S06::S0600298'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600297/1/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600297/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600297/>;
    dc:modified '2022-10-17T14:17:30'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Relative humidity'@en ;
    skos:definition 'The ratio of the amount of water vapour in the air compared to the maximum amount of water vapour that can theoretically be held at the air\'s temperature.'@en ;
    skos:notation 'SDN:S06::S0600297'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600296/1/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600296/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600296/>;
    dc:modified '2022-10-17T14:13:39'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Dew point temperature'@en ;
    skos:definition 'The temperature to which air must cool to become saturated with water vapour.'@en ;
    skos:notation 'SDN:S06::S0600296'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600295/1/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600295/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600295/>;
    dc:modified '2022-10-10T14:39:15'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'POC/Th-234 ratio'@en ;
    skos:definition 'The ratio of particulate organic carbon (POC) concentration to thorium-234 activity. Thorium is insoluble in seawater and is scavenged by particles as they form and/or sink through the water column. This causes a radioactive disequilibrium between 238U and 234Th in the upper water column, which is proportional to the numbers of particles exported. The POC/Th-234 ratio is hence used to estimate particle and elemental export fluxes.'@en ;
    skos:notation 'SDN:S06::S0600295'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600097/2/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600097/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600097/>;
    dc:modified '2022-07-18T07:22:11'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Length (culmen)'@en ;
    skos:definition 'Code deprecated on 2022/07/18; use the term defined in the S12 vocabulary to identify sub-components or body parts of biological entities. Previous description was: A standard measurement in bird biometrics referring to the distance along the main axis of the upper margin of the beak or bill.'@en ;
    skos:notation 'SDN:S06::S0600097'^^xsd:string .
