    skos:altLabel 'Rrs'^^xsd:string ;
    skos:prefLabel 'Remote sensing reflectance'@en ;
    skos:definition 'The water-leaving radiance at a given wavelength, Lw(λ), corrected for bidirectional effects of the air-sea interface and sub-surface light field, and normalised by downwelling solar irradiance, Ed(λ), just above the sea surface (Franz, NASA Goddard Space Flight Center).'@en ;
    skos:notation 'SDN:S06::S0600285'^^xsd:string .
