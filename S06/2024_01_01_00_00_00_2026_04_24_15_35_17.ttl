    dc:modified '2026-01-27T16:19:27'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Turbulence intensity'@en ;
    skos:definition 'The ratio of flow speed (standard deviation) or eddy velocity (root mean square) to mean flow speed over a certain time period. Used in fluid dynamics and wind energy analysis.'@en ;
    skos:notation 'SDN:S06::S0600353'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600352/1/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600352/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600352/>;
    dc:modified '2026-01-26T14:21:11'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Velocity covariance'@en ;
    skos:definition 'The statistical measure of uncertainty and correlation between the northward (V) and eastward (U) velocity components of the total velocity vector. Covariance is obtained by forming: cov(X,Y)=E([X-E(X)][Y-E(Y)] where E(X), E(Y) is the expected value (mean) of variable X and Y respectively.'@en ;
    skos:notation 'SDN:S06::S0600352'^^xsd:string .
