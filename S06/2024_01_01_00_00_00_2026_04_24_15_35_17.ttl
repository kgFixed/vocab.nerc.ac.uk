    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Concentration'@en ;
    skos:definition 'The amount of a specified substance in a unit amount of another substance or matrix. While in chemistry the term "concentration" is always in relation to the total volume of a mixture, in oceanography the term has a broader meaning and it is also used for the amount of substance in the total mass of a mixture like e.g. sea water.'@en ;
    skos:notation 'SDN:S06::S0600045'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600353/1/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600353/1/>
    a skos:Concept ;
