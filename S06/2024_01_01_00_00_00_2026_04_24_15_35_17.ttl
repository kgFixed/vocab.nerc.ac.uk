    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Bathymetric depth'@en ;
    skos:definition 'The measurement of the depth of a body of water, such as an ocean, lake, or river.'@en ;
    skos:notation 'SDN:S06::S0600334'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600323/2/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600323/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600323/>;
    dc:modified '2024-06-13T18:25:22'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Relative humidity'@en ;
    skos:definition 'Deprecated on 13/06/2024: duplicates existing concept. The ratio of the amount of water vapour in the air compared to the maximum amount of water vapour that can theoretically be held at the air\'s temperature.'@en ;
    skos:notation 'SDN:S06::S0600323'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600333/1/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600333/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600333/>;
    dc:modified '2024-05-23T17:19:27'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Vertical displacement'@en ;
    skos:definition 'The change in position of an object or entity along the y-axis, relative to a particular frame of reference.'@en ;
    skos:notation 'SDN:S06::S0600333'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600331/1/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600331/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600331/>;
    dc:modified '2024-05-21T12:08:47'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Duration'@en ;
    skos:definition 'The amount of time something lasts.'@en ;
    skos:notation 'SDN:S06::S0600331'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600330/1/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600330/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600330/>;
    dc:modified '2024-05-07T09:47:56'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Orientation (tilt)'@en ;
    skos:definition 'The angle between true vertical and the vertical axis of the framework to which one or more sensors are attached.'@en ;
    skos:notation 'SDN:S06::S0600330'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600329/1/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600329/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600329/>;
    dc:modified '2024-04-24T15:16:01'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Velocity along z-axis'@en ;
    skos:definition 'The velocity of a phenomenon resolved along the z-axis of a co-ordinate system.'@en ;
    skos:notation 'SDN:S06::S0600329'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600326/1/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600326/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600326/>;
    dc:modified '2024-04-18T10:15:35'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Orientation (roll)'@en ;
    skos:definition 'Rotation around the longitudinal (front-to-back) axis. The roll axis passes through the platform from nose to tail, or from bow to stern. A roll motion is an up and down movement of the wings or sides of the platform.'@en ;
    skos:notation 'SDN:S06::S0600326'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600327/1/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600327/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600327/>;
    dc:modified '2024-04-18T10:15:35'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Orientation (pitch)'@en ;
    skos:definition 'Rotation around the transverse or lateral (side-to-side) axis. The pitch axis passes through the platform from wingtip to wingtip, or from port to starboard. Pitch changes the vertical direction in which the nose or bow of the platform is pointing; for example, a positive pitching motion raises the nose or bow and lowers the tail or stern.'@en ;
    skos:notation 'SDN:S06::S0600327'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600328/1/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600328/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600328/>;
    dc:modified '2024-04-18T10:15:35'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Orientation (horizontal)'@en ;
    skos:definition 'The horizontal angle in which the specified entity is facing, for example the nose or bow of a platform, or the orientation of a sensor or sampling device. In mobile objects this refers to the rotation around the vertical axis which can also be known as yaw or a heading.'@en ;
    skos:notation 'SDN:S06::S0600328'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600325/1/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600325/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600325/>;
    dc:modified '2024-03-21T10:11:32'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Pore size'@en ;
    skos:definition 'The dimension (as a length) of the open spaces in a porous material.'@en ;
    skos:notation 'SDN:S06::S0600325'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600023/2/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600023/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600023/>;
    dc:modified '2024-03-14T08:12:50'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Size'@en ;
    skos:definition 'Term deprecated on 14-03-2024 because of its ambiguity. Use more specific terms to qualify the size of an object. A randomly-oriented measurement of the dimension of an object.'@en ;
    skos:notation 'SDN:S06::S0600023'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600324/1/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600324/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600324/>;
    dc:modified '2024-03-14T07:50:14'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Mesh size'@en ;
    skos:definition 'The dimension (as a length) of the holes or open spaces between the regularly spaced strands of material that make up e.g. a plankton or fishing net, or sieves used for benthos or sediment studies.'@en ;
    skos:notation 'SDN:S06::S0600324'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600322/1/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600322/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600322/>;
    dc:modified '2024-03-14T07:18:21'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Concentration per unit volume'@en ;
    skos:definition 'The mass, mole or volume of a substance in a system or mixture relative to the total volume of the system or mixture. This term is needed for mapping using I-ADOPT properties. DO NOT USE FOR P01 CREATION.'@en ;
    skos:notation 'SDN:S06::S0600322'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600321/1/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600321/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600321/>;
    dc:modified '2024-03-14T07:18:17'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Concentration per unit mass'@en ;
    skos:definition 'The mass, mole or volume of a substance in a system or mixture relative to the total mass of the system or mixture. This term is needed for mapping using I-ADOPT properties. DO NOT USE FOR P01 CREATION.'@en ;
    skos:notation 'SDN:S06::S0600321'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600320/1/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600320/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600320/>;
    dc:modified '2024-02-28T12:25:26'^^xsd:dateTime ;
    skos:altLabel 'Beta(p)'^^xsd:string ;
    skos:prefLabel 'Volume scattering attributable to particles'@en ;
    skos:definition 'The radiant intensity of scattered light from a volume element as a function of angle, with the contribution of pure seawater removed, referred to as Beta(p). Determined by calculating the volume scattering of pure seawater and removing it from the total volume scattering coefficient (Beta) to yield the volume scattering attributable to particles only. Units are m-1 sr-1.'@en ;
    skos:notation 'SDN:S06::S0600320'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600319/1/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600319/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600319/>;
    dc:modified '2024-02-28T12:23:28'^^xsd:dateTime ;
    skos:altLabel 'Beta'^^xsd:string ;
    skos:prefLabel 'Volume scattering coefficient'@en ;
    skos:definition 'The radiant intensity of scattered light from a volume element as a function of angle, referred to as Beta. When output from an optical backscattering instrument, Beta is calculated by subtracting dark counts from the raw counts, then multiplying by the manufacturer\'s supplied calibration scale factor. Units are m-1 sr-1.'@en ;
    skos:notation 'SDN:S06::S0600319'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600318/1/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600318/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S06/current/S0600318/>;
    dc:modified '2024-02-07T20:02:01'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Relative cover'@en ;
    skos:definition 'The proportion of an area covered by an entity (e.g. a given species, a specific habitat) relative to the total area covered by all considered entities (e.g. all species or all habitats) independently of total ground coverage. For example proportion of zostera or eelgrass within a surveyed area compared with contributions from all plants within that area.'@en ;
    skos:notation 'SDN:S06::S0600318'^^xsd:string .
