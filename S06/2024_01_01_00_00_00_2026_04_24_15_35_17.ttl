    dc:modified '2026-04-10T16:31:38'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Speed'@en ;
    skos:definition 'The magnitude (non-negative scalar component) of velocity, it represents how fast something moves independently of direction.'@en ;
