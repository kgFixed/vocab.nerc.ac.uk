    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Length (fork length)'@en ;
    skos:definition 'A standard body length measurement used in fish biometric studies for fishes with forked tails and taken as the distance measured from the tip of the snout in a straight line to the posterior end of the shortest caudal rays in the center of the fork.'@en ;
    skos:notation 'SDN:S06::S0600261'^^xsd:string .
