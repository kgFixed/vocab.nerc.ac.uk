    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Length (second dorsal length)'@en ;
    skos:definition 'A body length measurement used for ratfish in fish biometric studies and taken as the distance measured from the snout to the posterior edge of the posterior lobe of the second dorsal fin.'@en ;
    skos:notation 'SDN:S06::S0600263'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600262/1/> .
<http://vocab.nerc.ac.uk/collection/S06/current/S0600262/1/>
    a skos:Concept ;
