    dc:modified '2020-11-26T14:40:10'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Length (total length)'@en ;
    skos:definition 'A standard body length measurement used in biometric studies and taken as the longest distance along the main axis. In fish biometrics, this is the distance from the tip of the snout in a straight line to the posterior end of the caudal fin.'@en ;
    skos:notation 'SDN:S06::S0600262'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S06/current/S0600261/1/> .
