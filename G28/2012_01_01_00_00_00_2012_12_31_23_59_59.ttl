    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/G28/current/006/>;
    dc:modified '2012-07-04T11:39:51'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'fullSurfaceGraph'@en ;
    skos:definition '2-dimensional topological complex that is isomorphic to a subset of a surface'@en ;
    skos:notation 'SDN:G28::006'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/G28/current/007/1/> .
<http://vocab.nerc.ac.uk/collection/G28/current/007/1/>
    a skos:Concept ;
