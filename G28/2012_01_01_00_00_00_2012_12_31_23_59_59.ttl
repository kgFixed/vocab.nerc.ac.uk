    dc:modified '2012-07-04T11:39:51'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'topology1D'@en ;
    skos:definition '1-dimensional topological complex --  commonly called  chain-node  topology'@en ;
    skos:notation 'SDN:G28::002'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/G28/current/003/1/> .
<http://vocab.nerc.ac.uk/collection/G28/current/003/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/G28/current/003/>;
    dc:modified '2012-07-04T11:39:51'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'planarGraph'@en ;
    skos:definition '1-dimensional topological complex that is planar. (A planar graph is a graph that can be drawn in a plane in such a way that no two edges intersect except at a vertex.)'@en ;
    skos:notation 'SDN:G28::003'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/G28/current/004/1/> .
<http://vocab.nerc.ac.uk/collection/G28/current/004/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/G28/current/004/>;
    dc:modified '2012-07-04T11:39:51'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'fullPlanarGraph'@en ;
    skos:definition '2-dimensional topological complex that is planar. (A 2-dimensional topological complex is commonly called  full topology  in a cartographic 2D environment.)'@en ;
    skos:notation 'SDN:G28::004'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/G28/current/005/1/> .
<http://vocab.nerc.ac.uk/collection/G28/current/005/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/G28/current/005/>;
    dc:modified '2012-07-04T11:39:51'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'surfaceGraph'@en ;
    skos:definition '1-dimensional topological complex that is isomorphic to a subset of a surface. (A geometric complex is isomorphic to a topological complex if their elements are in a one-to-one, dimensional-and boundry-preserving correspondence to one another.)'@en ;
    skos:notation 'SDN:G28::005'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/G28/current/006/1/> .
<http://vocab.nerc.ac.uk/collection/G28/current/006/1/>
