    skos:altLabel 'Hydrophones'^^xsd:string ;
    skos:prefLabel 'Hydrophones'@en ;
    skos:definition 'Devices containing transducers that convert underwater sound waves into electrical signals.'@en ;
    skos:notation 'SDN:GSB::369'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/GSB/current/901/1/> .
