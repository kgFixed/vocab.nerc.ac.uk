    skos:altLabel 'Demand for Housing'^^xsd:string ;
    skos:prefLabel 'Property Demand'@en ;
    skos:definition 'Willingness and ability to purchase property.'@en ;
    skos:notation 'SDN:A04::PropertyDemand'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/Imagery/1/> .
