    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/WindGeneratedWaves/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel 'Wind Waves'^^xsd:string ;
    skos:prefLabel 'Wind Generated Waves'@en ;
    skos:definition 'Las ondas superficiales que se producen en la superficie de los océanos y los mares son resultado del viento, el cual sopla sobre una vasta extensión superficial de dicho fluido. Las olas de los océanos pueden viajar miles de kilómetros antes de llegar a tierra y su tamaño varía desde pequeñas ondulaciones hasta enormes olas de varios metros de altura.'@en ;
    skos:notation 'SDN:A04::WindGeneratedWaves'^^xsd:string .
