<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/Recreation/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/Recreation/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/Recreation/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Recreation'@en ;
    skos:definition 'Recreation is any activity performed during one\'s leisure or free time. Recreational activities are often done for amusement, enjoyment or pleasure . Almost any activity can be considered recreational when voluntarily engaged in during one\'s free time.'@en ;
    skos:notation 'SDN:A04::Recreation'^^xsd:string .
