    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Topography'@en ;
    skos:definition 'The relief features or surface configuration of an area.'@en ;
    skos:notation 'SDN:A04::Topography'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/WaterBasedRecreation/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/WaterBasedRecreation/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/WaterBasedRecreation/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Water Based Recreation'@en ;
    skos:definition 'Those activities which require water for participation (such as boating, swimming, sailing and canoeing).'@en ;
    skos:notation 'SDN:A04::WaterBasedRecreation'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/WaterQuality/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/WaterQuality/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/WaterQuality/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Water Quality'@en ;
    skos:definition 'Can be defined as a measure of the condition of water relative to the requirements of one or more biotic species and or to any human need or purpose. Water quality refers to the physical, chemical and biological characteristics of water. It is most frequently used by reference to a set of standards against which compliance can be assessed. The most common standards used to assess water quality relate to health of ecosystems, safety of human contact and drinking water.'@en ;
    skos:notation 'SDN:A04::WaterQuality'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/WaveHeights/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/WaveHeights/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/WaveHeights/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Wave Heights'@en ;
    skos:definition 'In fluid dynamics, the wave height of a surface wave is the difference between the elevation of the wave crest and a neighbouring trough.'@en ;
    skos:notation 'SDN:A04::WaveHeights'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/WavesAndTides/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/WavesAndTides/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/WavesAndTides/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Waves and Tides'@en ;
    skos:definition 'Waves constitute a moving ridge or swell over the surface of the sea or a lake. Tides are the alternate rising and falling of the sea surface, caused by the gravitational forces acting on the Earth\'s fluid surface primarily by the Moon and the Sun. Tidal peaks usually occur twice in each lunar day at a particular location, though this may vary occasionally due to local conditions.'@en ;
    skos:notation 'SDN:A04::WavesAndTides'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/Wind/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/Wind/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/Wind/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Wind'@en ;
    skos:definition 'Air in natural motion over the Earth\'s oceanic or terrestrial surface.'@en ;
    skos:notation 'SDN:A04::Wind'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/WorldHeritageSites/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/WorldHeritageSites/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/WorldHeritageSites/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'World Heritage Sites'@en ;
    skos:definition 'Sites of great cultural significance and geographic areas of outstanding universal value. They include the Pyramids of Egypt, the Grand Canyon of United States, the Taj Mahal of India, the Great Wall of China, etc.'@en ;
    skos:notation 'SDN:A04::WorldHeritageSites'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/AreaOfOutstandingNaturalBeauty/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/AreaOfOutstandingNaturalBeauty/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/AreaOfOutstandingNaturalBeauty/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel 'AONB'^^xsd:string ;
    skos:prefLabel 'Area of Outstanding Natural Beauty'@en ;
    skos:definition 'An Area of Outstanding Natural Beauty (AONB) is an area of countryside considered to have significant landscape value in England, Wales or Northern Ireland, that has been specially designated by Natural England on behalf of the United Kingdom government; the Countryside Council for Wales on behalf of the Welsh Government; or the Northern Ireland Environment Agency on behalf of the Northern Ireland Executive. The primary purpose of the AONB designation is to conserve and enhance the natural beauty of the landscape, with two secondary aims: meeting the need for quiet enjoyment of the countryside and having regard for the interests of those who live and work there.'@en ;
    skos:notation 'SDN:A04::AreaOfOutstandingNaturalBeauty'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/AreasOfSpecialScientificInterest/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/AreasOfSpecialScientificInterest/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/AreasOfSpecialScientificInterest/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel 'ASSI'^^xsd:string ;
    skos:prefLabel 'Areas of Special Scientific Interest'@en ;
    skos:definition 'An Area of Special Scientific Interest or ASSI is a conservation designation denoting a protected area in Northern Ireland. ASSIs are the equivalent of Sites of Special Scientific Interest (SSSIs) in the rest of the United Kingdom. They are the basic building block of site-based nature conservation legislation and most other legal nature/geological conservation designations in Northern Ireland are based upon them, including National Nature Reserves, Ramsar Sites, Special Protection Areas, and Special Areas of Conservation.'@en ;
    skos:notation 'SDN:A04::AreasOfSpecialScientificInterest'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/AerialImages/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/AerialImages/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/AerialImages/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel 'Aerial Photography'^^xsd:string ;
    skos:prefLabel 'Aerial Images'@en ;
    skos:definition 'Photographs of the ground surface taken from an aircraft,within the Earth\'s atmosphere. Also known as aerophotography.'@en ;
    skos:notation 'SDN:A04::AerialImages'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/AverageWindSpeed/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/AverageWindSpeed/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/AverageWindSpeed/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel 'Average Wind Velocity'^^xsd:string ;
    skos:prefLabel 'Average Wind Speed'@en ;
    skos:definition 'The mean wind speed over a specified period of time.'@en ;
    skos:notation 'SDN:A04::AverageWindSpeed'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/BirdWatchIreland/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/BirdWatchIreland/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/BirdWatchIreland/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel 'BWI'^^xsd:string ;
    skos:prefLabel 'BirdWatch Ireland'@en ;
    skos:definition 'BirdWatch Ireland (BWI) is the current name of the organisation that used to be known as the Irish Wildbird Conservancy. BirdWatch Ireland is the leading voluntary conservation organisation in the Republic of Ireland, devoted to the conservation and protection of the Republic of Ireland\'s wild birds and their habitats.'@en ;
    skos:notation 'SDN:A04::BirdWatchIreland'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/DepthContours/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/DepthContours/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/DepthContours/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel 'Bathymetric Contours'^^xsd:string ;
    skos:prefLabel 'Depth Contours'@en ;
    skos:definition 'A line connecting points of equal depth below the hydrographic datum.'@en ;
    skos:notation 'SDN:A04::DepthContours'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/BlueFlagBeaches/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/BlueFlagBeaches/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/BlueFlagBeaches/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel 'Blue Flags'^^xsd:string ;
    skos:prefLabel 'Blue Flag Beaches'@en ;
    skos:definition 'The blue flag is a global voluntary eco-label, awarded annually to beaches which have excellent water quality, environmental management, safety and a specific range of facilities for users.'@en ;
    skos:notation 'SDN:A04::BlueFlagBeaches'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/DistrictElectoralDivisions/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/DistrictElectoralDivisions/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/DistrictElectoralDivisions/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel 'DED'^^xsd:string ;
    skos:prefLabel 'District Electoral Divisions'@en ;
    skos:definition 'A district electoral division (often abbreviated as DED) is a former name given to a low-level territorial division in Ireland, wherein the population are eligible to vote on a representative for a particular seat in local, regional, and national elections. Also known as electoral divisions. In the Republic of Ireland, DEDs are the smallest legally defined administrative areas in the state for which small area population statistics (SAPS) are published from the Census. There are a total of 3,440 electoral divisions within the Republic of Ireland.'@en ;
    skos:notation 'SDN:A04::DistrictElectoralDivisions'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/DigitalTerrainModel/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/DigitalTerrainModel/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/DigitalTerrainModel/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel 'DTM'^^xsd:string ;
    skos:prefLabel 'Digital Terrain Model'@en ;
    skos:definition 'A Digital Terrain Model (DTM) is a continuous representation of a ground surface landform that is commonly used to produce topographic maps. DTMs are created by integrating data obtained from a wide range of techniques including remote sensing and land surveying.'@en ;
    skos:notation 'SDN:A04::DigitalTerrainModel'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/PropertyDemand/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/PropertyDemand/1/>
