<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/ErosionRisk/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/ErosionRisk/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/ErosionRisk/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Erosion Risk'@en ;
    skos:definition 'The potential for negative erosive affects to impact on current coastal processes and activities.'@en ;
    skos:notation 'SDN:A04::ErosionRisk'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/ErosionTrends/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/ErosionTrends/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/ErosionTrends/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Erosion Trends'@en ;
    skos:definition 'A characteristic of an area whereby there exists a general tendency for solid coastal features and areas to be worn away, or reshaped  through the processes of hydraulic and climatic action.'@en ;
    skos:notation 'SDN:A04::ErosionTrends'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/FloodRisk/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/FloodRisk/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/FloodRisk/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Flood Risk'@en ;
    skos:definition 'Susceptability to inundation by nearby rivers, lakes, and oceanic water bodies.'@en ;
    skos:notation 'SDN:A04::FloodRisk'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/Geology/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/Geology/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/Geology/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Geology'@en ;
    skos:definition 'Geology (from the Greek for "earth" and "study") is the science comprising the study of solid Earth, the rocks of which it is composed, and the processes by which it evolves. Geology gives insight into the history of the Earth, as it provides the primary evidence for plate tectonics, the evolutionary history of life, and past climates. In modern times, geology is commercially important for mineral and hydrocarbon exploration and for evaluating water resources; is publicly important for the prediction and understanding of natural hazards, the remediation of environmental problems, and for providing insights into past climate change; plays a role in geotechnical engineering; and is a major academic discipline.'@en ;
    skos:notation 'SDN:A04::Geology'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/Heritage/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/Heritage/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/Heritage/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Heritage'@en ;
