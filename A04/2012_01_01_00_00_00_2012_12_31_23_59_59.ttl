<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/LandUse/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/LandUse/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/LandUse/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Land Use'@en ;
    skos:definition 'Land use refers to the nature of mankinds activities as they harness and exploit the benefits of land as a resource. Land use involves the management and modification of natural environment or wilderness into environments such as fields, pastures, and settlements. It has also been defined as: the arrangements, activities and inputs people undertake in a certain land cover type to produce, change or maintain it.'@en ;
    skos:notation 'SDN:A04::LandUse'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/Landscape/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/Landscape/1/>
