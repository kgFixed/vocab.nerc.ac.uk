    skos:notation 'SDN:A04::JettiesPiersQuays'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/LANDSAT/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/LANDSAT/1/>
