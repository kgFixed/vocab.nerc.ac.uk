    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Roads'@en ;
    skos:definition 'Hard-surface infrastructure designed to provide routes for transport by vehicles such as cars, vans, trucks and lorries.'@en ;
    skos:notation 'SDN:A04::Roads'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/SatelliteImagery/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/SatelliteImagery/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/SatelliteImagery/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Satellite Imagery'@en ;
    skos:definition 'Raster (images composed of pixels) datasets which record the radiation reflected/emitted at different wavelengths from the Earth\'s surface and received by a sensor on a satellite platform. The different image datasets at each wavelength can be combined to give the familiar RGB (photolike) images we see of the Earth\'s surface from space, or can be used in other ways to study Earth processes.'@en ;
    skos:notation 'SDN:A04::SatelliteImagery'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/SeaLevelChange/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/SeaLevelChange/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/SeaLevelChange/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Sea Level Change'@en ;
    skos:definition 'The rise/fall in average tidal-gauge measured sea surface height over time.'@en ;
    skos:notation 'SDN:A04::SeaLevelChange'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/SeaLevelPosition/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/SeaLevelPosition/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/SeaLevelPosition/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Sea Level Position'@en ;
    skos:definition 'Averaged level of the sea surface, as derived from positionally accurate tide-gauge measurements, or more recently satellite-derived estimates of sea-surface height.'@en ;
    skos:notation 'SDN:A04::SeaLevelPosition'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/Semi-NaturalHabitat/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/Semi-NaturalHabitat/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/Semi-NaturalHabitat/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Semi-Natural Habitat'@en ;
    skos:definition 'Semi-natural habitats are globally considered as any habitat where human induced changes can be detected or that is human managed but which still seems a natural habitat in terms of species diversity and species interrelation complexity.'@en ;
    skos:notation 'SDN:A04::Semi-NaturalHabitat'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/ShippingPorts/1/> .
