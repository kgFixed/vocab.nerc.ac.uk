    skos:notation 'SDN:A04::RainfallDistribution'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/RainfallStations/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/RainfallStations/1/>
