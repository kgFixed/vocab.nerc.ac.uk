    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel 'Growth Rate'^^xsd:string ;
    skos:prefLabel 'Development Rate'@en ;
    skos:definition 'The increase over time in infrastructural, technological and societal advancement and progress.'@en ;
    skos:notation 'SDN:A04::DevelopmentRate'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/HistoricalCoastlines/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/HistoricalCoastlines/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/HistoricalCoastlines/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel 'Historic Coastlines'^^xsd:string ;
    skos:prefLabel 'Historical Coastlines'@en ;
    skos:definition 'The position and form of the ocean-land boundary in the past.'@en ;
    skos:notation 'SDN:A04::HistoricalCoastlines'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/LandCover/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/LandCover/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/LandCover/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel 'Landcover'^^xsd:string ;
    skos:prefLabel 'Land Cover'@en ;
    skos:definition 'The observed biophysical cover of the earth\'s surface. It describes vegetative and and man-made features, and omits bare rock and water. In practice, these elements are often included under this term.'@en ;
    skos:notation 'SDN:A04::LandCover'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/LIDAR/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/LIDAR/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/LIDAR/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel 'Light Detection and Ranging'^^xsd:string ;
    skos:prefLabel 'LIDAR'@en ;
    skos:definition 'Light Detection and Ranging (LiDAR) is an active remote sensing system that can be operated in either a profiling or scanning mode using pulses of light to illuminate the terrain. LiDAR data collection involves mounting an airborne laser scanning system onboard an aircraft along with a kinematic Global Positioning System (GPS) receiver to locate an x and y position and an inertial navigation system to monitor the pitch and roll of the aircraft. By accurately measuring the round trip travel time of the laser pulse from the aircraft to the ground, a highly accurate spot elevation can be calculated. Depending upon the altitude and speed of the aircraft along with the laser repetition rate it is possible to obtain point densities that would likely take months to collect using traditional ground survey methods.'@en ;
    skos:notation 'SDN:A04::LIDAR'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/SitesOfLocalNatureConservation/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/SitesOfLocalNatureConservation/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/SitesOfLocalNatureConservation/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel 'Local nature reserve'^^xsd:string ;
    skos:prefLabel 'Sites of Local Nature Conservation'@en ;
    skos:definition 'Areas (potentially of a small spatial extent) which have been designated as worthy of conservation protections due to their local-scale importance in terms of biodiversity and heritage.'@en ;
    skos:notation 'SDN:A04::SitesOfLocalNatureConservation'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/LowWatermarks/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/LowWatermarks/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/LowWatermarks/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel 'Low-Water Marks'^^xsd:string ;
    skos:prefLabel 'Low Watermarks'@en ;
    skos:definition 'The level reached by seawater at low tide or by other stretches of water at their lowest spring-tide level.'@en ;
    skos:notation 'SDN:A04::LowWatermarks'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/MarineNatureReserves/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/MarineNatureReserves/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/MarineNatureReserves/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel 'MNR'^^xsd:string ;
    skos:prefLabel 'Marine Nature Reserves'@en ;
    skos:definition 'An area of sea and seabed (which can include intertidal areas) designated under the Wildlife and Countryside Act (1981) for the purpose of conserving marine flora and fauna or geological or physiographic features of special interest and/or providing opportunities for study and research. The designation is officially awarded by the government to a marine reserve of national significance and can apply to both the sea and the seabed.'@en ;
    skos:notation 'SDN:A04::MarineNatureReserves'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/Conservation/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/Conservation/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/Conservation/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel 'Marine Conservation'^^xsd:string ;
    skos:prefLabel 'Conservation'@en ;
    skos:definition 'The  prevention of waste, or loss of biological diversity and abundance. Marine conservation, also known as marine resources conservation, is the protection and preservation of ecosystems in oceans and seas. Marine conservation focuses on limiting human-caused damage to marine ecosystems, and on restoring damaged marine ecosystems. Marine conservation also focuses on preserving vulnerable marine species. This is a relatively new discipline. Marine conservationists rely on a combination of scientific principles derived from marine biology, oceanography, and fisheries science, as well as on human factors such as demand for marine resources and marine law, economics and policy in order to determine how to best protect and conserve marine species and ecosystems. Marine conservation can be seen as subdiscipline of conservation biology.'@en ;
    skos:notation 'SDN:A04::Conservation'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/MODIS/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/MODIS/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/MODIS/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel 'Moderate-resolution Imaging Spectroradiometer'^^xsd:string ;
    skos:prefLabel 'MODIS'@en ;
    skos:definition 'The Moderate-resolution Imaging Spectroradiometer (MODIS) is a payload scientific instrument launched into Earth orbit by NASA in 1999 on board the Terra (EOS AM) Satellite, and in 2002 on board the Aqua (EOS PM) satellite. The instruments capture data in 36 spectral bands ranging in wavelength from 0.4 µm to 14.4 µm and at varying spatial resolutions (2 bands at 250 m, 5 bands at 500 m and 29 bands at 1 km). Together the instruments image the entire Earth every 1 to 2 days. They are designed to provide measurements in large-scale global dynamics including changes in Earth\'s cloud cover, radiation budget and processes occurring in the oceans, on land, and in the lower atmosphere. Three on-board calibrators (a solar diffuser combined with a solar diffuser stability monitor, a spectral radiometric calibration assembly, and a black body) provide in-flight calibration. MODIS has used the Marine Optical Buoy for vicarious calibration.'@en ;
    skos:notation 'SDN:A04::MODIS'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/ObliqueImages/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/ObliqueImages/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/ObliqueImages/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel 'Oblique Photographs'^^xsd:string ;
    skos:prefLabel 'Oblique Images'@en ;
    skos:definition 'Aerial photographs taken at an angle off nadir to the Earth\'s surface.'@en ;
    skos:notation 'SDN:A04::ObliqueImages'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/Oceanography/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/Oceanography/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/Oceanography/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel 'Oceanology'^^xsd:string ;
    skos:prefLabel 'Oceanography'@en ;
    skos:definition 'The scientific study and exploration of all aspects pertaining to the Earth\'s oceans and seas.'@en ;
    skos:notation 'SDN:A04::Oceanography'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/PhysicalEnvironment/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/PhysicalEnvironment/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/PhysicalEnvironment/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel 'Physical conditions'^^xsd:string ;
    skos:prefLabel 'Physical Environment'@en ;
    skos:definition 'The surrounding conditions within which a feature, area, or organism exists. Physical environment often refers to conditions such as temperature, exposure, moisture, precipitation, amongst many others.'@en ;
    skos:notation 'SDN:A04::PhysicalEnvironment'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/Railways/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/Railways/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/Railways/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel 'Railroads'^^xsd:string ;
    skos:prefLabel 'Railways'@en ;
    skos:definition 'A railway is a permanent track composed of a line of parallel metal rails fixed to sleepers, for transport of passengers and goods in trains.'@en ;
    skos:notation 'SDN:A04::Railways'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/SpecialAreasOfConservation/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/SpecialAreasOfConservation/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/SpecialAreasOfConservation/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel 'SAC'^^xsd:string ;
    skos:prefLabel 'Special Areas of Conservation'@en ;
    skos:definition 'A Special Area of Conservation (SAC) is defined in the European Union\'s Habitats Directive (92/43/EEC), also known as the Directive on the Conservation of Natural Habitats and of Wild Fauna and Flora. They are to protect the 220 habitats and approximately 1000 species listed in annex I and II of the directive which are considered to be of European interest following criteria given in the directive. They must be chosen from the Sites of Community Importance by the State Members and designated SAC by an act assuring the conservation measures of the natural habitat.'@en ;
    skos:notation 'SDN:A04::SpecialAreasOfConservation'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/SpecialProtectionAreas/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/SpecialProtectionAreas/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/SpecialProtectionAreas/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel 'SPA'^^xsd:string ;
    skos:prefLabel 'Special Protection Areas'@en ;
    skos:definition 'A Special Protection Area or SPA is a designation under the European Union Directive on the Conservation of Wild Birds. Under the Directive, Member States of the European Union (EU) have a duty to safeguard the habitats of migratory birds and certain particularly threatened birds. Together with Special Areas of Conservation (SACs), the SPAs form a network of protected sites across the EU, called Natura 2000.'@en ;
    skos:notation 'SDN:A04::SpecialProtectionAreas'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/SeaSurfaceTemperature/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/SeaSurfaceTemperature/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/SeaSurfaceTemperature/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel 'SST'^^xsd:string ;
    skos:prefLabel 'Sea Surface Temperature'@en ;
    skos:definition 'The temperature of the ocean surface. The term sea surface temperature is generally meant to be representative of the upper millimeters of the ocean.'@en ;
    skos:notation 'SDN:A04::SeaSurfaceTemperature'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/Saltmarshes/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/Saltmarshes/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/Saltmarshes/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel 'Salt Marshes'^^xsd:string ;
    skos:prefLabel 'Saltmarshes'@en ;
    skos:definition 'Marshes in which the water is saline. These particularly occur in coastal wetlands, which have halophyte vegetation and are regularly flooded at high tide. Coastal salt marshes help to preserve the shoreline by accommodating and dissipating the force and impact storm tides, surges, and swells.'@en ;
    skos:notation 'SDN:A04::Saltmarshes'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/CoastalDefenceStructures/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/CoastalDefenceStructures/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/CoastalDefenceStructures/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel 'Sea Defence Structures'^^xsd:string ;
    skos:prefLabel 'Coastal Defence Structures'@en ;
    skos:definition 'Man-made structures designed to reduce the effects of erosion and coastal flooding on coastal areas.'@en ;
    skos:notation 'SDN:A04::CoastalDefenceStructures'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/Shipping/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/Shipping/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/Shipping/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel 'Ship Transport'^^xsd:string ;
    skos:prefLabel 'Shipping'@en ;
    skos:definition 'Water-borne transportation of resources, goods and people. Shipping can also refer to a number of ships utilising a route/corridor, particularly merchant ships, and is often expressed as a whole in terms of tonnage.'@en ;
    skos:notation 'SDN:A04::Shipping'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/SoilTypes/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/SoilTypes/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/SoilTypes/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel 'Soil Classification'^^xsd:string ;
    skos:prefLabel 'Soil Types'@en ;
    skos:definition 'A classification of soil into soil series, usually through sampling and analysis.'@en ;
    skos:notation 'SDN:A04::SoilTypes'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/Shipwrecks/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/Shipwrecks/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/Shipwrecks/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel 'Sunken ship'^^xsd:string ;
    skos:prefLabel 'Shipwrecks'@en ;
    skos:definition 'A shipwreck refers to the physical remains of a ship that has either been sunk or beached. Whatever the cause, a sunken ship or a wrecked ship is a physical remnant of the event: this explains why the two concepts are often overlapping in English.'@en ;
    skos:notation 'SDN:A04::Shipwrecks'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/SwellGeneratedWaves/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/SwellGeneratedWaves/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/SwellGeneratedWaves/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel 'Swell Waves'^^xsd:string ;
    skos:prefLabel 'Swell Generated Waves'@en ;
    skos:definition 'Swell waves are long waves or a succession of waves without crests, generated in the open sea by a meteorological event (e.g. gale) and often continue beyond their source. Swell patterns are superimposed on regular wave activity and can significantly increase wave height.'@en ;
    skos:notation 'SDN:A04::SwellGeneratedWaves'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/SPOT/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/SPOT/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/SPOT/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel 'System for Earth Observation'^^xsd:string ;
    skos:prefLabel 'SPOT'@en ;
    skos:definition 'SPOT (Système Pour l\'Observation de la Terre ) (lit. "System for Earth Observation") is a high-resolution, optical imaging Earth observation satellite system operating from space. It is run by Spot Image based in Toulouse, France. It was initiated by the CNES (Centre national d\'études spatiales - the French space agency) in the 1970s and was developed in association with the SSTC (Belgian scientific, technical and cultural services) and the Swedish National Space Board (SNSB). It has been designed to improve the knowledge and management of the Earth by exploring the Earth\'s resources, detecting and forecasting phenomena involving climatology and oceanography, and monitoring human activities and natural phenomena. The SPOT system includes a series of satellites and ground control resources for satellite control and programming, image production, and distribution. The satellites were launched with the ESA rocket launcher Ariane 2, 3, and 4.'@en ;
    skos:notation 'SDN:A04::SPOT'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/TideGauges/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/TideGauges/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/TideGauges/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel 'Tide Gages'^^xsd:string ;
    skos:prefLabel 'Tide Gauges'@en ;
    skos:definition 'A measuring instrument used to measure the level (and extremes) of tidal movement of sea levels at a point on the Earths surface.'@en ;
    skos:notation 'SDN:A04::TideGauges'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/BuiltUpAreas/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/BuiltUpAreas/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/BuiltUpAreas/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel 'Urban Areas'^^xsd:string ;
    skos:prefLabel 'Built-up Areas'@en ;
    skos:definition 'An urban area (built-up area) is characterised by extensive man-made structures designed to accomodate, or serve higher density human populations in comparison to areas surrounding it. Urban areas may include cities, towns or conurbations, but the term is not commonly extended to rural settlements such as villages and hamlets. Urban areas are created and further developed by the process of urbanisation. Measuring the extent of an urban area helps in analysing population density and urban sprawl, and in determining urban and rural populations.'@en ;
    skos:notation 'SDN:A04::BuiltUpAreas'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/ClimatologicalStations/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/ClimatologicalStations/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/ClimatologicalStations/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel 'Weather Stations'^^xsd:string ;
    skos:prefLabel 'Climatological Stations'@en ;
    skos:definition 'A climatological station is a weather recording facility, either on land or sea, equipped with instruments and devices for observing atmospheric conditions. These provide data and information for weather forecasts and to study the weather and climate. The measurements taken include temperature, barometric pressure, humidity, wind speed, wind direction, and precipitation amounts.'@en ;
    skos:notation 'SDN:A04::ClimatologicalStations'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/RamsarSites/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/RamsarSites/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/RamsarSites/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel 'Wetland of International Importance'^^xsd:string ;
    skos:prefLabel 'Ramsar Sites'@en ;
    skos:definition 'Ramsar sites are wetlands of international importance, designated under the Ramsar Convention. Wetlands are defined as areas of marsh, fen, peatland or water, whether natural or artificial, permanent or temporary, with water that is static or flowing, fresh, brackish or salt, including areas of marine water the depth of which at low tide does not exceed six metres. Ramsar sites may also incorporate riparian (banks of a stream, river, pond or watercourse) and coastal zones adjacent to the wetlands, and islands or bodies of marine water deeper than six metres at low tide lying within the wetlands. Ramsar sites are identified under the Commonwealth\'s Environmental Protection Biodiversity Act as having national environmental significance for which the Commonwealth has a significant responsibility to sustain and protect.'@en ;
    skos:notation 'SDN:A04::RamsarSites'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/WindGeneratedWaves/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/WindGeneratedWaves/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/WindGeneratedWaves/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel 'Wind Waves'^^xsd:string ;
    skos:prefLabel 'Wind Generated Waves'@en ;
    skos:definition 'Surface waves that occur on the free surface of oceans and seas, resulting from the wind blowing over a vast enough stretch of fluid surface. Waves in the oceans can travel thousands of miles before reaching land. Wind waves range in size from small ripples to huge waves over 30 meters high.'@en ;
    skos:notation 'SDN:A04::WindGeneratedWaves'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/CoastalImages/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/CoastalImages/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/CoastalImages/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel 'pictures'^^xsd:string ;
    skos:prefLabel 'Coastal Images'@en ;
    skos:definition 'Images of the coast.'@en ;
    skos:notation 'SDN:A04::CoastalImages'^^xsd:string .
