    skos:notation 'SDN:A04::Coastline'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/CommercialFerryPorts/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/CommercialFerryPorts/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/CommercialFerryPorts/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
