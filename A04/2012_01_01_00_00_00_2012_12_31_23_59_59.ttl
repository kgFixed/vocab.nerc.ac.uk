    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/Semi-NaturalHabitat/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Semi-Natural Habitat'@en ;
    skos:definition 'Semi-natural habitats are globally considered as any habitat where human induced changes can be detected or that is human managed but which still seems a natural habitat in terms of species diversity and species interrelation complexity.'@en ;
    skos:notation 'SDN:A04::Semi-NaturalHabitat'^^xsd:string .
