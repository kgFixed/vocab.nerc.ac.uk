    skos:prefLabel 'Stable Lights'@en ;
    skos:definition 'Built-up and industrial areas, major roads and other infrastructure are illuminated at night. These lights can be detected by a special scanner on board the Defense Meteorological Satellite Program (DMSP) series of satellites.'@en ;
    skos:notation 'SDN:A04::StableLights'^^xsd:string .
