    skos:notation 'SDN:A04::SynopticStations'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/TerrestrialGeology/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/TerrestrialGeology/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/TerrestrialGeology/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Terrestrial Geology'@en ;
    skos:definition 'The dynamics and physical history of landmasses, the rocks of which they are composed, and the physical, chemical, and biological changes that they have undergone or are undergoing. The term also refers to the study of such history and processes.'@en ;
    skos:notation 'SDN:A04::TerrestrialGeology'^^xsd:string .
