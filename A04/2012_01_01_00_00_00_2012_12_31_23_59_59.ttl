    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/ShippingPorts/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Shipping Ports'@en ;
    skos:definition 'Ports engaged in activities directly related to marine cargo loading and unloading, including ship docking and related facilities.'@en ;
    skos:notation 'SDN:A04::ShippingPorts'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/Socio-EconomicActivity/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/Socio-EconomicActivity/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/Socio-EconomicActivity/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Socio-Economic Activity'@en ;
    skos:definition 'Activities resulting from economic change due to societal fluctuations, or conversely activities resulting from societal change due to economic fluctuations.'@en ;
    skos:notation 'SDN:A04::Socio-EconomicActivity'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/Soils/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/Soils/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/Soils/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Soils'@en ;
    skos:definition 'The upper layer of the Earth\'s surface in which plants grow. This typically black or dark brown material, consists of varyiable mixtures of rock particles and fragments, clay, and organic remains and materials. Air spaces and water can often also be considered as constituents.'@en ;
    skos:notation 'SDN:A04::Soils'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/StableLights/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/StableLights/1/>
