<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/BuiltHeritage/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/BuiltHeritage/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/BuiltHeritage/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Built Heritage'@en ;
    skos:definition 'Built heritage is the unique and irreplaceable architecture with historic background that merits preservation for future generations. These can be individual old buildings of historic importance such as houses, churches, castles, military fortifications and other types of buildings, monuments or areas of built heritage value, e.g., town squares, harbours and churchyards. In broadest sense, built heritage does refer not only to ancient history, but also to modern period.'@en ;
    skos:notation 'SDN:A04::BuiltHeritage'^^xsd:string .
