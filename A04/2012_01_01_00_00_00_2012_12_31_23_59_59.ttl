    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Landscape Character Areas'@en ;
    skos:definition 'An area which exhibits a distinct, recognisable and consistent pattern of elements, be it natural (soil, landform) and/or human (for example settlement and development) in the landscape that makes one landscape different from another, rather than better or worse.'@en ;
    skos:notation 'SDN:A04::LandscapeCharacterAreas'^^xsd:string .
