    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/Agriculture/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel 'Farming'^^xsd:string ;
    skos:prefLabel 'Agriculture'@en ;
    skos:definition 'Landuse or occupation concerned with cultivating land, raising  & selling crops, and feeding, breeding, and raising livestock for incorporation into the populations food supply.'@en ;
    skos:notation 'SDN:A04::Agriculture'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/Flooding/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/Flooding/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/Flooding/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel 'Flood'^^xsd:string ;
    skos:prefLabel 'Flooding'@en ;
    skos:definition 'The inundation of land that is normally dry through the overflowing of a body of water over the land (e.g. rivers and storm surges).'@en ;
    skos:notation 'SDN:A04::Flooding'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/CoastalGeology/1/> .
<http://vocab.nerc.ac.uk/collection/A04/current/CoastalGeology/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A04/current/CoastalGeology/>;
    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel 'Geology of the Coast'^^xsd:string ;
    skos:prefLabel 'Coastal Geology'@en ;
    skos:definition 'The nature of physical land-forms, structures, rocks, and sediments with particular emphasis on the coastal zone. The term can also be used to describe the scientific study of such features in the coastal zone.'@en ;
    skos:notation 'SDN:A04::CoastalGeology'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A04/current/DevelopmentRate/1/> .
