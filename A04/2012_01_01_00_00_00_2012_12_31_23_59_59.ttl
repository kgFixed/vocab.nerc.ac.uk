    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Wave Heights'@en ;
    skos:definition 'In fluid dynamics, the wave height of a surface wave is the difference between the elevation of the wave crest and a neighbouring trough.'@en ;
