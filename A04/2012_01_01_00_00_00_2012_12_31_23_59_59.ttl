    dc:modified '2012-06-27T12:15:46'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Natural Coastal Features'@en ;
    skos:definition 'Features along the coastline whose form and composition has been determined by natural processes, and are not man-made in origin.'@en ;
