@prefix tree: <https://w3id.org/tree#> .
@prefix ldes: <https://w3id.org/ldes#> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

@base <https://kgfixed.github.io/vocab.nerc.ac.uk/F02/2017_01_01_00_00_00_2017_12_31_23_59_59.ttl> .

<>
    a tree:Node
     .

<feed>
  a ldes:EventStream ;
  ldes:timestampPath dc:modified ;
  ldes:versionOfPath dc:isVersionOf ;
  
  
  tree:shape [
    a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path dc:isVersionOf
    ],
    [
      sh:datatype xsd:dateTime ;
      sh:minCount 1 ;
      sh:path dc:modified
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:altLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:prefLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:definition
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:notation
    ];
    sh:targetClass skos:Concept
  ] ;
  tree:view <> ;
  .

<feed> tree:member <http://vocab.nerc.ac.uk/collection/F02/current/F0200001/1/> .
<http://vocab.nerc.ac.uk/collection/F02/current/F0200001/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/F02/current/F0200001/>;
    dc:modified '2017-11-20T13:09:10'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Standard beads'@en ;
    skos:definition 'A standard is a reference defined by a user, a laboratory, or any acknowledged authority. Properties of standard beads are accurately known by the manufacturers (i.e. size, material, fluorescence properties). These fluorescent microbeads (or microsphere) are used as an absolute reference for quantitative and qualitative comparisons. Standard beads are analyzed routinely in every flow cytometry analyses in order to have confidence in the instrument performance (alignment and fluidics) and as well as in the results.'@en ;
    skos:notation 'SDN:F02::F0200001'^^xsd:string .
