<feed> tree:member <http://vocab.nerc.ac.uk/collection/GBX/current/HE000008/1/> .
<http://vocab.nerc.ac.uk/collection/GBX/current/HE000008/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/GBX/current/HE000008/>;
    dc:modified '2008-01-04T10:41:27'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'help text - instrument depth'@en ;
    skos:definition '''{"node": {
    "p": [
        "Restrict your search to series with measurements made within a specified range of depths/heights.",
        "First select your reference point, then enter a minimum and/or a maximum depth/height value. Real numbers within the allowed range are accepted. The minimum should be less than the maximum.",
        "Not all series have a measurement depth/height value assigned. Should you wish to add series with measurement depth/height set absent to your selection then click the include unknown box.",
        {
            "strong": "update button",
            "content": [
                "Once you are happy with your selection use the",
                "to submit your search criteria."
            ]
        },
        "The default will match any series irrespective of its instrument depth/height.",
        "You may revisit this section and amend your criteria at any time. To allow you to reuse your previous choices, we have provided a history of your last three selections. Display your earlier choices by hovering over the link(s). To update the form with a saved selection, click on the appropriate link."
    ],
    "ul": {"li": [
        "If you insert a minimum and maximum value then all series containing measurements at depths/heights between your minimum and maximum values are returned.",
        "If you insert a minimum value only then all series containing measurements at depths/heights equal to or more than your specified value are returned.",
        "If you insert a maximum value only then all series containing measurements at depths/heights less than or equal to your specified value are returned."
    ]}
}}'''@en ;
    skos:notation 'SDN:GBX::HE000008'^^xsd:string .
