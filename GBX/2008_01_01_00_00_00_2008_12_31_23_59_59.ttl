    skos:prefLabel 'help text - duration'@en ;
    skos:definition '''{"node": {"p": [
    "To select series which cover a time span greater than a specified duration, for example longer than one month or two years, please enter a number in the duration box and use the pull-down menu to select its units. Your entry must be less than the maximum duration.",
    {
        "strong": "include unknown",
        "content": [
            "Not all series have the duration value assigned. Should you wish to add series with duration unknown to your selection then click the",
            "box."
        ]
    },
    {
