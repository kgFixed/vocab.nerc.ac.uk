    skos:prefLabel 'Help text - Model tagged'@en ;
    skos:definition '''{"node": {"p": [
    "Restrict your search to data affiliated to a particular Model. Click to select the Model of interest. Use Control+click or Shift+click as appropriate to select additional Models. You may also use Control+click to deselect.",
    "Once you have completed your selection use the update button to submit your search criteria.",
    "The default is to match any data irrespective of whether it is affiliated to a particular Model.",
    "You may revisit this section and amend your criteria at any time."
]}}'''@en ;
    skos:notation 'SDN:GBX::H5000002'^^xsd:string .
