    dc:modified '2012-11-10T09:39:11'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Help text - Geographic area tagged'@en ;
    skos:definition '''{"node": {
    "p": [
        "To navigate the map please use the map tool provided or the standard mouse options. For example, Click+drag allows you to pan and Click+mousewheel movement allows zoom in or zoom out. On PCs only, Shift+click or Shift+click and drag a box also provide zoom in.",
        "To specify your coordinates via the map",
        "Alternatively for PCs or Macs, type the coordinates of the required area in the form. Once you are happy with your selection use the update button to submit your search criteria.",
        "You may revisit this section and amend your criteria at any time."
    ],
    "ul": {"li": [
        "For PCs - Use Control+click and drag a box to define your area of interest.",
        "For Macs - Use Shift+click and drag a box to define your area of interest."
    ]}
}}'''@en ;
    skos:notation 'SDN:GBX::H5000008'^^xsd:string .
