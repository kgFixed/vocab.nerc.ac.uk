    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'help text - instrument help'@en ;
    skos:definition '''{"node": {"p": [
    "Restrict your search to series for particular types of instrument.",
    "Click to select a single entry from the list.  Use Control+click or Shift+click to select additional entries as appropriate. You may also use Control+click to deselect.",
    {
        "b": "completed your selection",
        "strong": "update button",
        "content": [
            "Once you have",
            "use the",
            "to submit your search criteria."
        ]
    },
    "The default is to match any series irrespective of the instrument.",
    "You may revisit this section and amend your criteria at any time. To allow you to reuse your previous choices, we have provided a history of your last three selections. Display your earlier choices by hovering over the link(s). To update the form with a saved selection, click on the appropriate link."
]}}'''@en ;
    skos:notation 'SDN:GBX::HE000005'^^xsd:string .
