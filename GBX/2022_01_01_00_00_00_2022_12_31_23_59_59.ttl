<feed> tree:member <http://vocab.nerc.ac.uk/collection/GBX/current/GN000146/4/> .
<http://vocab.nerc.ac.uk/collection/GBX/current/GN000146/4/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/GBX/current/GN000146/>;
    dc:modified '2022-04-27T16:56:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'login page - GEOTRACES IDP sentence 2'@en ;
    skos:definition '''{"node": {"p": [
    "The GEOTRACES Intermediate Data Product (IDP) has been developed for the community. To improve understanding and services we would like to keep track of who is using the product and for what purpose. Please specify",
    {
        "strong": "usage to which the data product will be put",
        "ol": {"li": [
            "Compare with my data",
            "Create compilation with other data for the same element/isotope",
            "Do cross correlations among differnet elements/isotopes",
            "Modelling",
            "Use of data for biological studies",
            "Use of data for paleoproxy research",
            "Other? Please specify"
        ]},
        "content": [
            "the",
            "by copying and pasting one or more of the following options in to the \\"Reason\\" box below."
        ]
    },
    {
        "strong": "any source of funding",
        "content": "that you may have for the intended research or usage of the data product in the \\"Funding\\" box below."
    }
]}}'''@en ;
    skos:notation 'SDN:GBX::GN000146'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/GBX/current/HE000004/3/> .
<http://vocab.nerc.ac.uk/collection/GBX/current/HE000004/3/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/GBX/current/HE000004/>;
    dc:modified '2022-04-27T16:56:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'help text - originator help'@en ;
    skos:definition '''{"node": {"p": [
    "Restrict your search to series which were collected by particular countries and/or organisations.",
    {
        "strong": "narrow button",
        "content": [
            "Click to select a single entry from a list.  Use Control+click or Shift+click to select additional entries as appropriate. You may also use Control+click to deselect.  Once you have chosen from a list press the appropriate",
            ". This will restrict the choices available in the other list."
        ]
    },
    {
        "strong": [
            "completed your selection",
            "update button"
        ],
        "content": [
            "Once you have",
            "use the",
            "to submit to your search criteria."
        ]
    },
    "The default is to match any series irrespective of who has collected the data.",
    "You may revisit this section and amend your criteria at any time. To allow you to reuse your previous choices, we have provided a history of your last three selections. Display your earlier choices by hovering over the link(s). To update the form with a saved selection, click on the appropriate link."
]}}'''@en ;
    skos:notation 'SDN:GBX::HE000004'^^xsd:string .
