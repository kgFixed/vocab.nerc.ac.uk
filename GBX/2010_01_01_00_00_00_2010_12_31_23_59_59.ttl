    skos:prefLabel 'Bulk insert results - file format configuration information'@en ;
    skos:definition '''{"node": {
    "p": [
        "The file submitted is not in the correct format. The file format must contain details for each item, one per line. The data should be organised such that",
        "The input format is a tab-separated ASCII file. Should you wish to omit say, the optional short name, a double tab will ensure that the definition is loaded in the correct field."
    ],
    "ul": {"li": [
        "Column 1 = item key (mandatory) - upto a maximum of 8 characters.",
        "Column 2 = item full name (mandatory) - typically 80 characters.",
        "Column 3 = item short name (optional) - typically 30 characters.",
        "Column 4 = item definition (recommended) - upto a maximum of 4000 characters."
    ]}
}}'''@en ;
    skos:notation 'SDN:GBX::T3000059'^^xsd:string .
