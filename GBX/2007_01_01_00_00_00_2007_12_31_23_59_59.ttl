    skos:prefLabel 'Current meter - Data type help'@en ;
    skos:definition '''{"node": {"p": [
    {
        "b": "completed your selection",
        "strong": "update button",
        "content": [
            "Once you have",
            "use the",
            "to submit your search criteria."
        ]
    },
    "The default is to match any series irrespective of its instrument or platform.",
    "You may revisit this section and amend your criteria at any time. To allow you to reuse your previous choices, we have provided a history of your last three selections. Display your earlier choices by hovering over the link(s). To update the form with a saved selection, click on the appropriate link."
]}}'''@en ;
    skos:notation 'SDN:GBX::HP00001Y'^^xsd:string .
