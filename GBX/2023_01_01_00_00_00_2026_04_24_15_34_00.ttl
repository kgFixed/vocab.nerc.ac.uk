    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'help text - Simulation layers tagged'@en ;
    skos:definition '''{"node": {"p": [
    "This refers to the total number of layers within a simulation, for example the numberof depth levels. Restrict your search to simulations containing specific number oflayers. Click to select the number of layers. Use Control + click or Shift + clickas appropriate to select additional simulations with different numbers of layers. Youmay also use Control + click to deselect.",
    "Once you have completed your selection use the Update button to submit your search criteria.",
    "The default is to match any data irrespective of whether it is affiliated to simulations containing specific numbers of layers.",
    "You may revisit this section and amend your criteria at any time."
]}}'''@en ;
    skos:notation 'SDN:GBX::H5000006'^^xsd:string .
