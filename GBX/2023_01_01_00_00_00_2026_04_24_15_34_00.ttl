    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/GBX/current/T3000058/>;
    dc:modified '2024-12-11T11:29:08'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Bulk insert results- Status code defintions'@en ;
    skos:definition '''{"node": {"table": {"tr": [
    {"th": [
        "CODE",
        {
            "align": "center",
            "content": "Reason"
        }
    ]},
    {"td": [
        200,
        "Success - item inserted"
    ]},
    {"td": [
        400,
        "Specified update already member of list or is currently pending"
    ]},
    {"td": [
        401,
        "User not authorised - login required"
    ]},
    {"td": [
        403,
        "User not authorised - insufficient permissions"
    ]},
    {"td": [
        404,
        "List identifier not a valid list"
    ]},
    {"td": [
        500,
        "Oracle error - please try again (please contact enquiries@bodc.ac.uk if problem persists)"
    ]}
]}}}'''@en ;
    skos:notation 'SDN:GBX::T3000058'^^xsd:string .
