<feed> tree:member <http://vocab.nerc.ac.uk/collection/GBX/current/GN000037/5/> .
<http://vocab.nerc.ac.uk/collection/GBX/current/GN000037/5/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/GBX/current/GN000037/>;
    dc:modified '2024-12-11T11:15:33'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'registration - user info 2'@en ;
    skos:definition '''{"node": {
    "p": [
        "The \'Personal Details\' provided will not be given to any third parties. BODC will make a permanent, secure archive of your personal details, which will only be used to",
        "We will take all reasonable precautions to protect your personal data from loss, misuse or alteration. Only authorised BODC employees will have access to this information."
    ],
    "ul": {"li": [
        "provide you with data and/or information",
        "generate the online licences for when you request data",
        "ensure that we remain compliant with NERC Data Policy",
        "generate anonymised \'performance indicators\' to support future funding of our web development",
        "seek information, to satisfy impact metrics, regarding how you used the data you requested and its impact on your work"
    ]},
    "h2": "Your contact details"
}}'''@en ;
    skos:notation 'SDN:GBX::GN000037'^^xsd:string .
