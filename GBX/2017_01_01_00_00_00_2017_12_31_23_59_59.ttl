<feed> tree:member <http://vocab.nerc.ac.uk/collection/GBX/current/T5000001/5/> .
<http://vocab.nerc.ac.uk/collection/GBX/current/T5000001/5/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/GBX/current/T5000001/>;
    dc:modified '2017-01-09T14:17:12'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Index page - opening paragraphs - tagged'@en ;
    skos:definition '''{"node": {
    "p": [
        {
            "a": {
                "href": "/resources/delivery_formats/cfnetcdf_format/",
                "content": "CF compliant"
            },
            "content": [
                "This index provides access to all numerical model datasets held by BODC. Model data originating from a variety of projects and organisations are stored in our systems and are available for online retrieval. All model data are stored as",
                "netCDF format files."
            ]
        },
        "An interactive search function is provided below to enable you to interrogate BODC\'s numerical model data holdings before choosing which, if any, data to select for download. Once you have chosen your search criteria, click the Search button. The data files held by BODC that match the criteria will be displayed in a table.",
        {
            "img": {
                "src": "/images/icons/plot.gif",
                "alt": "View parameter",
                "title": "View parameter",
                "class": "icon"
            },
            "content": [
                "The data within the selected files can be visualised before final selection. Click the visualisation icon",
                "beside the parameter that you wish to view in the results table."
            ]
        },
        "A demonstration (with audio) of search and visualisation (best viewed with screen resolutions of 1024 x 768 or greater) is available for you to watch.",
        {
            "img": {
                "src": "/images/icons/help_icon.gif",
                "width": 16,
                "alt": "Help",
                "class": "helpImage",
                "height": 16
            },
            "content": [
                "A detailed explanation for each search category is also provided. This information may be viewed via the",
                "button."
            ]
        }
    ],
    "h1": "Numerical model data",
    "h2": "Search categories"
}}'''@en ;
    skos:notation 'SDN:GBX::T5000001'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/GBX/current/T4000017/2/> .
