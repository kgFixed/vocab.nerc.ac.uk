<>
    a tree:Node
     .

<feed>
  a ldes:EventStream ;
  ldes:timestampPath dc:modified ;
  ldes:versionOfPath dc:isVersionOf ;
  
  
  tree:shape [
    a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path dc:isVersionOf
    ],
    [
      sh:datatype xsd:dateTime ;
      sh:minCount 1 ;
      sh:path dc:modified
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:altLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:prefLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:definition
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:notation
    ];
    sh:targetClass skos:Concept
  ] ;
  tree:view <> ;
  .

<feed> tree:member <http://vocab.nerc.ac.uk/collection/R27/current/SBE41/2/> .
<http://vocab.nerc.ac.uk/collection/R27/current/SBE41/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/R27/current/SBE41/>;
    dc:modified '2019-10-16T06:35:48'^^xsd:dateTime ;
    skos:altLabel 'SBE41'^^xsd:string ;
    skos:prefLabel 'Sea-Bird Scientific SBE 41 CTD'@en ;
    skos:definition 'A system comprising temperature, conductivity and pressure sensors with pump-controlled, T-C ducted flow. The unit is designed for deployment on profiling floats. During float ascent, spot samples are taken and transmitted to the float controller.'@en ;
    skos:notation 'SDN:R27::SBE41'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/R27/current/SBE41CP/2/> .
<http://vocab.nerc.ac.uk/collection/R27/current/SBE41CP/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/R27/current/SBE41CP/>;
    dc:modified '2019-10-16T06:35:48'^^xsd:dateTime ;
    skos:altLabel 'SBE41CP'^^xsd:string ;
    skos:prefLabel 'Sea-Bird Scientific SBE 41CP CTD'@en ;
    skos:definition 'A system comprising temperature, conductivity and pressure sensors with pump-controlled, T-C ducted flow. This CTD operates in continuous profiling (CP) mode, thus sampling at 1 Hz during float ascent, logging the data in internal memory and transmitting to the float controller when the float reaches the surface.'@en ;
    skos:notation 'SDN:R27::SBE41CP'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/R27/current/SBE41N/2/> .
<http://vocab.nerc.ac.uk/collection/R27/current/SBE41N/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/R27/current/SBE41N/>;
    dc:modified '2019-10-16T06:35:48'^^xsd:dateTime ;
    skos:altLabel 'SBE41N'^^xsd:string ;
    skos:prefLabel 'Sea-Bird Scientific SBE 41N CTD'@en ;
    skos:definition 'A system comprising temperature, conductivity and pressure sensors with pump-controlled, T-C ducted flow. The unit is designed for deployment on profiling floats hosting multiple biogeochemical (BGC) sensors. This CTD operates in continuous profiling (CP) mode, thus sampling at 1 Hz during float ascent. Data from all the float\'s sensors, including the optional bolt-on ones, are integrated in the data stream and transmitted to the float controller when the float reaches the surface.'@en ;
    skos:notation 'SDN:R27::SBE41N'^^xsd:string .
