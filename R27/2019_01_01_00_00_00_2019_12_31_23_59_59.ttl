    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/R27/current/SBE61/>;
    dc:modified '2019-10-16T06:35:48'^^xsd:dateTime ;
    skos:altLabel 'SBE61'^^xsd:string ;
    skos:prefLabel 'Sea-Bird Scientific SBE 61 CTD'@en ;
    skos:definition 'A system comprising temperature, conductivity and pressure sensors with pump-controlled, T-C ducted flow. The unit is designed for deployment on Deep Argo profiling floats reaching 7000 m depth.'@en ;
    skos:notation 'SDN:R27::SBE61'^^xsd:string .
