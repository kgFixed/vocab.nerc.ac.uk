    skos:altLabel 'SBE41CP_V5.0.1'^^xsd:string ;
    skos:prefLabel 'Sea-Bird Scientific SBE 41CP CTD V5.0.1'@en ;
    skos:definition 'A system comprising temperature, conductivity and pressure sensors with pump-controlled, T-C ducted flow. This CTD operates in continuous profiling (CP) mode, thus sampling at 1 Hz during float ascent, logging the data in internal memory and transmitting to the float controller when the float reaches the surface. This SBE41CP model has firmware version 5.0.1.'@en ;
    skos:notation 'SDN:R27::SBE41CP_V5.0.1'^^xsd:string .
