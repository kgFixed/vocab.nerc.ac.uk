    dc:modified '2021-05-26T09:01:46'^^xsd:dateTime ;
    skos:altLabel 'CTD_F01'^^xsd:string ;
    skos:prefLabel 'Tsurumi-Seiki TSK CTD F01'@en ;
    skos:definition 'A system comprising temperature, conductivity and pressure sensors manufactured by Tsurumi-Seiki, model F01.'@en ;
    skos:notation 'SDN:R27::CTD_F01'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/R27/current/RBR_ARGO/1/> .
<http://vocab.nerc.ac.uk/collection/R27/current/RBR_ARGO/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/R27/current/RBR_ARGO/>;
    dc:modified '2021-05-26T09:01:46'^^xsd:dateTime ;
    skos:altLabel 'RBR_ARGO'^^xsd:string ;
    skos:prefLabel 'RBRargo CTD'@en ;
    skos:definition 'A system comprising temperature, conductivity and pressure sensors with Computational Fluid Dynamic (CFD) optimised flow path, manufactured by RBR. Salinity is measured by induction of water flushing freely through the conductivity cell, and is accurate to within 10 cm of the air-ocean interface. The unit is designed specifically for profiling floats, including those hosting multiple biogeochemical (BGC) sensors. The system supports both spot and continuous sampling modes, with sampling speeds configurable to up to 12 Hz. The depth rating for a standard profile is 2000 dbar, with energy consumption of approximately 700 J.'@en ;
    skos:notation 'SDN:R27::RBR_ARGO'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/R27/current/RBR_ARGO3/1/> .
<http://vocab.nerc.ac.uk/collection/R27/current/RBR_ARGO3/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/R27/current/RBR_ARGO3/>;
    dc:modified '2021-05-26T09:01:46'^^xsd:dateTime ;
    skos:altLabel 'RBR_ARGO3'^^xsd:string ;
    skos:prefLabel 'RBRargo3 CTD'@en ;
    skos:definition 'A system comprising temperature, conductivity and pressure sensors with Computational Fluid Dynamic (CFD) optimised flow path, manufactured by RBR. Salinity is measured by induction of water flushing freely through the conductivity cell, and is accurate to within 10 cm of the air-ocean interface. The unit is designed specifically for profiling floats, including those hosting multiple biogeochemical (BGC) sensors. The system supports both spot and continuous sampling modes, with sampling speeds configurable to up to 8 Hz. The depth rating for a standard profile is 2000 dbar, with energy consumption of approximately 400 J.'@en ;
    skos:notation 'SDN:R27::RBR_ARGO3'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/R27/current/RBR_ARGO3_DEEP4K/1/> .
<http://vocab.nerc.ac.uk/collection/R27/current/RBR_ARGO3_DEEP4K/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/R27/current/RBR_ARGO3_DEEP4K/>;
    dc:modified '2021-05-26T09:01:46'^^xsd:dateTime ;
    skos:altLabel 'RBR_ARGO3_DEEP4K'^^xsd:string ;
    skos:prefLabel 'RBRargo3 CTD deep4k'@en ;
    skos:definition 'A system comprising temperature, conductivity and pressure sensors with Computational Fluid Dynamic (CFD) optimised flow path, manufactured by RBR. Salinity is measured by induction of water flushing freely through the conductivity cell, and is accurate to within 10 cm of the air-ocean interface. The unit is built with a compact titanium housing rated to 4000 dbar, and is specifically designed to be integrated with glass sphere profiling floats part of the Deep Argo program. The system supports both spot and continuous sampling modes, with sampling speeds configurable to up to 8 Hz.'@en ;
    skos:notation 'SDN:R27::RBR_ARGO3_DEEP4K'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/R27/current/RBR_ARGO3_DEEP6K/1/> .
<http://vocab.nerc.ac.uk/collection/R27/current/RBR_ARGO3_DEEP6K/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/R27/current/RBR_ARGO3_DEEP6K/>;
    dc:modified '2021-05-26T09:01:46'^^xsd:dateTime ;
    skos:altLabel 'RBR_ARGO3_DEEP6K'^^xsd:string ;
    skos:prefLabel 'RBRargo3 CTD deep6k'@en ;
    skos:definition 'A system comprising temperature, conductivity and pressure sensors with Computational Fluid Dynamic (CFD) optimised flow path, manufactured by RBR. Salinity is measured by induction of water flushing freely through the conductivity cell, and is accurate to within 10 cm of the air-ocean interface. The unit is built with a compact titanium housing rated to 6000 dbar, and is specifically designed to be integrated with glass sphere profiling floats part of the Deep Argo program. The system supports both spot and continuous sampling modes, with sampling speeds configurable to up to 8 Hz.'@en ;
    skos:notation 'SDN:R27::RBR_ARGO3_DEEP6K'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/R27/current/RBR_CODA_T_ODO/1/> .
<http://vocab.nerc.ac.uk/collection/R27/current/RBR_CODA_T_ODO/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/R27/current/RBR_CODA_T_ODO/>;
    dc:modified '2021-05-26T09:01:46'^^xsd:dateTime ;
    skos:altLabel 'RBR_CODA_T_ODO'^^xsd:string ;
    skos:prefLabel 'RBRcoda T.ODO Temperature and Dissolved Oxygen sensor'@en ;
    skos:definition 'A stand-alone oxygen optode with integrated temperature sensor, manufactured by RBR. This instrument exploits the physio-chemical principle of dynamic fluorescence quenching to measure absolute oxygen concentration and percent saturation. It is available in three variants based on response times: slow (30 s time constant), standard (8 s time constant) and fast (1 s time constant), the latter being optimal for vertical profiling applications. Depth rating: 6000 m; oxygen concentration accuracy of +/- 8 uM or +/- 5 %, and resolution of < 1 uM; air saturation resolution of 0.4 %.'@en ;
    skos:notation 'SDN:R27::RBR_CODA_T_ODO'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/R27/current/SBE43F_IDO/1/> .
<http://vocab.nerc.ac.uk/collection/R27/current/SBE43F_IDO/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/R27/current/SBE43F_IDO/>;
    dc:modified '2021-05-26T09:01:46'^^xsd:dateTime ;
    skos:altLabel 'SBE43F_IDO'^^xsd:string ;
    skos:prefLabel 'Sea-Bird Scientific SBE 43F (frequency output) Integrated Dissolved Oxygen (IDO) sensor'@en ;
    skos:definition 'A through-flow, Clark polarographic membrane dissolved oxygen sensor, manufactured by Sea-Bir Scientific and designed to be integrated into a pumped CTD system. Depth rating: 600 m (plastic housing) or 7000 m (titanium housing); oxygen concentration initial accuracy: 2 % saturation; response time (63 %): 2 s - 5 s for 0.5 mil membrane (profiling applications), or 8 s - 20 s for 1.0 mil membrane (moored applications); output signal: frequency.'@en ;
    skos:notation 'SDN:R27::SBE43F_IDO'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/R27/current/SBE43I/1/> .
<http://vocab.nerc.ac.uk/collection/R27/current/SBE43I/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/R27/current/SBE43I/>;
    dc:modified '2021-05-26T09:01:46'^^xsd:dateTime ;
    skos:altLabel 'SBE43I'^^xsd:string ;
    skos:prefLabel 'Sea-Bird Scientific SBE 43I (integral) dissolved oxygen sensor'@en ;
    skos:definition 'A Clark polarographic membrane dissolved oxygen sensor, manufactured by Sea-Bir Scientific and designed to be integrated into the pumped CTD system of an Argo float. Depth rating: 2000 m; oxygen concentration initial accuracy: 1 % saturation; output signal: frequency.'@en ;
    skos:notation 'SDN:R27::SBE43I'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/R27/current/SBE43_IDO/1/> .
<http://vocab.nerc.ac.uk/collection/R27/current/SBE43_IDO/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/R27/current/SBE43_IDO/>;
    dc:modified '2021-05-26T09:01:46'^^xsd:dateTime ;
    skos:altLabel 'SBE43_IDO'^^xsd:string ;
    skos:prefLabel 'Sea-Bird Scientific SBE 43 Integrated Dissolved Oxygen (IDO) sensor'@en ;
    skos:definition 'A through-flow, Clark polarographic membrane dissolved oxygen sensor, manufactured by Sea-Bir Scientific and designed to be integrated into a pumped CTD system. Depth rating: 600 m (plastic housing) or 7000 m (titanium housing); oxygen concentration initial accuracy: 2 % saturation; response time (63 %): 2 s - 5 s for 0.5 mil membrane (profiling applications), or 8 s - 20 s for 1.0 mil membrane (moored applications); output signal: 0-5 VDC.'@en ;
    skos:notation 'SDN:R27::SBE43_IDO'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/R27/current/SBE63_OPTODE/1/> .
