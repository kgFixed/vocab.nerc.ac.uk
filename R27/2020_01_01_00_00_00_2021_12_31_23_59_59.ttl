    skos:altLabel 'SBE63_OPTODE'^^xsd:string ;
    skos:prefLabel 'Sea-Bird Scientific SBE 63 oxygen optode'@en ;
    skos:definition 'An optical dissolved oxygen sensor, manufactured by Sea-Bir Scientific and designed to be integrated into a pumped CTD system. Depth rating: 600 m (plastic housing) or 7000 m (titanium housing); oxygen concentration initial accuracy: 2 % saturation; response time (63 %): < 6 s; output signal: RS-232.'@en ;
    skos:notation 'SDN:R27::SBE63_OPTODE'^^xsd:string .
