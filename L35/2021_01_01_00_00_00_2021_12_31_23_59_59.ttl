    skos:altLabel 'ELEMT'^^xsd:string ;
    skos:prefLabel 'Elementar'@en ;
    skos:definition 'A German manufacturer of chemical analysers. It originated from a company called Heraeus in 1897 that developed furnaces, quartz glassware and precious metal chemicals for elemental analysis in Hanau, Germany. Isoprime Ltd. Became a member of the elementargroup in 2008.'@en ;
    skos:notation 'SDN:L35::MAN0197'^^xsd:string .
