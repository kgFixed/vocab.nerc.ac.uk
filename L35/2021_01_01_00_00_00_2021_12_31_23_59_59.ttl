<http://vocab.nerc.ac.uk/collection/L35/current/MAN0167/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0167/>;
    dc:modified '2021-03-09T14:32:46'^^xsd:dateTime ;
    skos:altLabel 'KEITHLEY'^^xsd:string ;
    skos:prefLabel 'Keithley Instruments'@en ;
    skos:definition 'A US-based company that develops, manufactures, markets, and sells data acquisition products, as well as complete systems for high-volume production and assembly testing. Keithley Instruments was founded in 1945 and merged with Tektronix Inc. in 2010.'@en ;
    skos:notation 'SDN:L35::MAN0167'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0168/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0168/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0168/>;
    dc:modified '2021-03-09T14:32:46'^^xsd:dateTime ;
    skos:altLabel 'NRCAN GSC'^^xsd:string ;
    skos:prefLabel 'Natural Resources Canada, Geological Survey of Canada'@en ;
    skos:definition 'The Geological Survey of Canada, including the Pacific Geoscience Centre, forms part of the Earth Sciences sector of Natural Resources Canada (NRCan). Founded in 1842, it is Canada\'s national organization for geoscientific information and research.'@en ;
    skos:notation 'SDN:L35::MAN0168'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0165/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0165/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0165/>;
    dc:modified '2021-02-10T09:58:50'^^xsd:dateTime ;
    skos:altLabel 'MORS'^^xsd:string ;
    skos:prefLabel 'Mors Environment'@en ;
    skos:definition 'A manufacturer of underwater acoustic systems (releases for heavy lift, transponders, and surface equipment) and oceanographic instrumentation (current meters, tide gauges, and sound velocimeters), the company provides technical and offshore support in these fields. The United Kingdom division of Mors Environment is Oceano Instruments.'@en ;
    skos:notation 'SDN:L35::MAN0165'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0164/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0164/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0164/>;
    dc:modified '2021-02-10T09:37:56'^^xsd:dateTime ;
    skos:altLabel 'SOLAR LIGHT'^^xsd:string ;
    skos:prefLabel 'Solar Light Company, Inc.'@en ;
    skos:definition 'An American company that manufactures Precision Light Sources, Light Measurement Instrumentation, UV Transmittance Analysers, Meteorological Instrumentation, OEM Instrumentation, and over 135 different types of Sensors. They provide a wide array of services, including accelerated UV materials testing, NIST-traceable spectroradiometric analyses, reflectance and spectral transmittance testing, and calibrations for light meters and light sources. They were founded in 1967.'@en ;
    skos:notation 'SDN:L35::MAN0164'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0163/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0163/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0163/>;
    dc:modified '2021-02-08T16:07:06'^^xsd:dateTime ;
    skos:altLabel 'MoogX'^^xsd:string ;
    skos:prefLabel 'Moog Crossbow'@en ;
    skos:definition 'A company that manufactures and supplies GPS-aided inertial measurements units (IMU), attitude and heading reference systems (AHRS), vertical gyroscopes and inclinometer/tilt sensors. The company was derived from Crossbow Technologies after it was acquired by Moog Inc. in 2011.'@en ;
    skos:notation 'SDN:L35::MAN0163'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0162/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0162/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0162/>;
    dc:modified '2021-02-08T11:30:36'^^xsd:dateTime ;
    skos:altLabel 'PNI'^^xsd:string ;
    skos:prefLabel 'PNI Sensor Coorporation'@en ;
    skos:definition 'A manufacturing company founded in 1987 by George Hsu. It specialises in location and motion tracking sensor systems.'@en ;
    skos:notation 'SDN:L35::MAN0162'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0161/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0161/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0161/>;
    dc:modified '2021-02-08T10:43:30'^^xsd:dateTime ;
    skos:altLabel 'HNYWELL_AERO'^^xsd:string ;
    skos:prefLabel 'Honeywell Aerospace'@en ;
    skos:definition 'A commercial company that operates within the Honeywell International Inc. enterprise. It specialises in avionics, aircraft engines, flight management systems, and service solutions to manufacturers, airlines, airport operations, militaries, and space programs.'@en ;
    skos:notation 'SDN:L35::MAN0161'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0160/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0160/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0160/>;
    dc:modified '2021-02-08T10:20:45'^^xsd:dateTime ;
    skos:altLabel 'HNYWELL'^^xsd:string ;
    skos:prefLabel 'Honeywell'@en ;
    skos:definition 'An engineering company founded in 1906 by Mark Honeywell under the name Honeywell Speciality Company. It operates in four areas of business: aerospace, building technologies, performance materials and technologies (PMT), and safety and productivity solutions (SPS).'@en ;
    skos:notation 'SDN:L35::MAN0160'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0158/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0158/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0158/>;
    dc:modified '2021-02-04T10:36:00'^^xsd:dateTime ;
    skos:altLabel 'MAXIM'^^xsd:string ;
    skos:prefLabel 'Maxim integrated'@en ;
    skos:definition 'An American, publicly traded company, founded in 1983, that designs, manufactures, and sells analog and mixed-signal integrated circuits. Maxim Integrated develops integrated circuits for the automotive, industrial, communications, consumer, and computing markets.'@en ;
    skos:notation 'SDN:L35::MAN0158'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0159/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0159/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0159/>;
    dc:modified '2021-02-04T10:36:00'^^xsd:dateTime ;
    skos:altLabel 'SMARTFIN'^^xsd:string ;
    skos:prefLabel 'Smartfin'@en ;
    skos:definition 'A project that aims to unite the surfing community and the research community by developing oceanographic sensors integrated into surfboard fins. These are provided to researchers and citizen scientists surfers around the world at little to no cost.'@en ;
    skos:notation 'SDN:L35::MAN0159'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0157/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0157/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0157/>;
    dc:modified '2021-02-04T10:20:41'^^xsd:dateTime ;
    skos:altLabel 'ONSET'^^xsd:string ;
    skos:prefLabel 'Onset Computer Corporation'@en ;
    skos:definition 'A company that designs and manufactures data loggers and monitoring solutions which are used to measure, record, and manage data for improving the environment and preserving the quality of temperature-sensitive products. Their HOBO data logger and weather station products are used around the world in a broad range of monitoring applications, from verifying the performance of green buildings and renewable energy systems to agricultural and coastal research. It was founded in 1981.'@en ;
    skos:notation 'SDN:L35::MAN0157'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0156/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0156/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0156/>;
    dc:modified '2021-01-19T13:35:07'^^xsd:dateTime ;
    skos:altLabel 'MMAG'^^xsd:string ;
    skos:prefLabel 'Marine Magnetics'@en ;
    skos:definition 'A Canadian company that specialises in magnetic sensors for marine environments that was founded in 1998.'@en ;
    skos:notation 'SDN:L35::MAN0156'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0155/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0155/1/>
    a skos:Concept ;
