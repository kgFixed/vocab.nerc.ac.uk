    dc:modified '2021-01-19T11:07:27'^^xsd:dateTime ;
    skos:altLabel 'KRN'^^xsd:string ;
    skos:prefLabel 'Krohne'@en ;
    skos:definition 'An instrument manufacturing company that specialises in industrial process measurement. It was founded in 1921 by Ludwig Krohn as LUDWIG KROHNE and SOHN.'@en ;
    skos:notation 'SDN:L35::MAN0155'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0147/3/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0147/3/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0147/>;
    dc:modified '2021-01-11T10:39:54'^^xsd:dateTime ;
    skos:altLabel '4-DEEP'^^xsd:string ;
    skos:prefLabel '4-Deep Inwater Imaging'@en ;
    skos:definition 'A Canadian based company that develops patented holographic technology to create microscopes for research and discovery.'@en ;
    skos:notation 'SDN:L35::MAN0147'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0154/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0154/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0154/>;
    dc:modified '2021-01-08T14:27:10'^^xsd:dateTime ;
    skos:altLabel 'SIMRAD'^^xsd:string ;
    skos:prefLabel 'Kongsberg Simrad'@en ;
    skos:definition 'A subsidiary of the Kongsberg Maritime that specialises in electronic equipment for professional fish-finding and underwater research such as hydrographic echo sounders. It was established in 1946 as Simrad Yachting.'@en ;
    skos:notation 'SDN:L35::MAN0154'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0153/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0153/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0153/>;
    dc:modified '2021-01-08T10:58:32'^^xsd:dateTime ;
    skos:altLabel 'SEATEX'^^xsd:string ;
    skos:prefLabel 'Kongsberg Seatex'@en ;
    skos:definition 'A manufacturing subsidiary of Kongsberg that specialises in navigation; seismic spread; and onshore and space-based systems. It was founded in 1984.'@en ;
    skos:notation 'SDN:L35::MAN0153'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0152/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0152/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0152/>;
    dc:modified '2021-01-06T09:32:22'^^xsd:dateTime ;
    skos:altLabel 'Ifremer-LDCM'^^xsd:string ;
    skos:prefLabel 'Ifremer - Detection, Sensors and Metrology Laboratory'@en ;
    skos:definition 'A laboratory within the Unit of Technology Research and Development (RDT) and Department of Physical Resources and Deep-Sea Ecosystems (REM) at the French Research Institute for Exploitation of the Sea (Ifremer). It is responsible for developing new solutions for marine instruments or in situ measurement sensors, new methods for inhibiting biofilms and marine fouling, and new techniques for chemical and physical analysis.'@en ;
    skos:notation 'SDN:L35::MAN0152'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0151/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0151/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0151/>;
    dc:modified '2021-01-05T16:46:56'^^xsd:dateTime ;
    skos:altLabel 'iSiTEC'^^xsd:string ;
    skos:prefLabel 'iSiTEC GmbH'@en ;
    skos:definition 'A developer and manufacturer of measuring and analysis devices, simulation devices and automatic sampling systems. iSiTEC was founded in Bremerhaven in 1996.'@en ;
    skos:notation 'SDN:L35::MAN0151'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0150/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0150/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0150/>;
    dc:modified '2021-01-05T16:44:04'^^xsd:dateTime ;
    skos:altLabel 'HYDROPTIC'^^xsd:string ;
    skos:prefLabel 'Hydroptic'@en ;
    skos:definition 'A manufacturer and distributor of systems designed for the collection, identification and enumeration of zooplankton and microscopic sediment particles in both fresh and salt water, including the ZooSCAN, UVP and Nemo systems. Established in 2007.'@en ;
    skos:notation 'SDN:L35::MAN0150'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0149/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0149/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0149/>;
    dc:modified '2021-01-05T16:40:15'^^xsd:dateTime ;
    skos:altLabel 'YFT'^^xsd:string ;
    skos:prefLabel 'Yokogawa Fluid Imaging Technologies, Inc.'@en ;
    skos:definition 'A manufacturer of flow imaging particle analysis solutions. Including the flagship product, the FlowCam. Founded in 1999. Fluid Imaging Technologies, Inc. changed its name to Yokogawa Fluid Imaging Technologies, Inc. on April 29, 2020 when it was acquired by Yokogawa Electric Corporation.'@en ;
    skos:notation 'SDN:L35::MAN0149'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0148/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0148/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0148/>;
    dc:modified '2021-01-05T16:33:01'^^xsd:dateTime ;
    skos:altLabel 'CoastalOceanVision'^^xsd:string ;
    skos:prefLabel 'CoastalOceanVision, Inc.'@en ;
    skos:definition 'A designer and manufacturer of advanced underwater measurement and observation systems specialising in plankton imaging systems and cabled seafloor observatories. Founded in 2015.'@en ;
    skos:notation 'SDN:L35::MAN0148'^^xsd:string .
