    skos:altLabel 'IIS'^^xsd:string ;
    skos:prefLabel 'Industrial Instruments and Supplies'@en ;
    skos:definition 'A US-based company providing service, calibration, and rental of industrial instruments. The company offers a wide variety of products such as tools, safety products, electronic productions tools, laboratory instruments and supplies, as well as computer hardware, software and supplies. Founded in 1989.'@en ;
    skos:notation 'SDN:L35::MAN0195'^^xsd:string .
