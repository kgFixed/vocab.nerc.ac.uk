    skos:altLabel 'OPT'^^xsd:string ;
    skos:prefLabel 'Ocean Presence Technologies'@en ;
    skos:definition 'A US company founded in 2006 and based in Santa Cruz, California, USA. Ocean Presence Technologies specialises in the design and manufacture of underwater camera systems with applications in ocean research, environmental monitoring and aquariums.'@en ;
