    skos:altLabel 'SubC'^^xsd:string ;
    skos:prefLabel 'SubC Imaging'@en ;
    skos:definition 'A Canadian company based in Clarenville, Newfoundland and founded in 2010. SubC Imaging specialises in subsea imaging equipment and software for marine research, offshore oil and gas, aquaculture, and fisheries.'@en ;
    skos:notation 'SDN:L35::MAN0259'^^xsd:string .
