    skos:prefLabel 'Royal Eijkelkamp B.V.'@en ;
    skos:definition 'A Dutch company established in 1911 specialising in measurement, monitoring, and sampling equipment for soil and water applications. Eijkelkamp is headquartered in the village of Giesbeek in The Netherlands.'@en ;
    skos:notation 'SDN:L35::MAN0270'^^xsd:string .
