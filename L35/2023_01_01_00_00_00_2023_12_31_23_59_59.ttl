    dc:modified '2023-06-16T14:04:34'^^xsd:dateTime ;
    skos:altLabel 'DEEPSEA'^^xsd:string ;
    skos:prefLabel 'DeepSea Power and Light'@en ;
    skos:definition 'A manufacturer of underwater lights, cameras, pressure-compensated batteries, lasers, and pressure relief valves for the most demanding deep water applications, including: ROVs, AUVs, divers, and manned submersibles, it represents the subsea market as part of SeeScan, Inc. It also offers pressure testing services with chambers rated up to 30 ksi.'@en ;
    skos:notation 'SDN:L35::MAN0263'^^xsd:string .
