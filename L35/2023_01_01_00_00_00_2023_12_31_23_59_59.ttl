    skos:prefLabel 'Canon'@en ;
    skos:definition 'A Japanese multinational corporation headquartered in Ota, Tokyo, specialising in the production of optical, imaging and industrial products, such as lenses, cameras, medical equipment, scanners, printers, and semiconductor manufacturing equipment. Founded in 1933.'@en ;
    skos:notation 'SDN:L35::MAN0260'^^xsd:string .
