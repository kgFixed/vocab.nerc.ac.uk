    skos:altLabel 'Nikon'^^xsd:string ;
    skos:prefLabel 'Nikon Corporation'@en ;
    skos:definition 'A Japanese company founded in 1917 and headquartered in Tokyo. Nikon specialises in the design, manufacture and sale of optical instruments and imaging products, including cameras, camera lenses, binoculars, microscopes, ophthalmic lenses, measurement instruments, and rifle and spotting scopes.'@en ;
    skos:notation 'SDN:L35::MAN0256'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0255/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0255/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0255/>;
    dc:modified '2023-06-02T12:26:28'^^xsd:dateTime ;
    skos:altLabel 'Insite'^^xsd:string ;
    skos:prefLabel 'Insite Pacific Inc.'@en ;
    skos:definition 'A US company founded in 1998 in San Diego, California. Insite Pacific manufactures and supplies a range of advanced video systems, designed for underwater applications and available in underwater housings operating to full ocean depth.'@en ;
    skos:notation 'SDN:L35::MAN0255'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0254/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0254/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0254/>;
    dc:modified '2023-06-02T12:11:32'^^xsd:dateTime ;
    skos:altLabel 'Imenco'^^xsd:string ;
    skos:prefLabel 'Imenco AS'@en ;
    skos:definition 'Imenco AS is a Norwegian company based in Aksdal, founded in 1979 as an engineering company. Imenco is a group of companies working mainly in five business areas: offshore oil and gas, offshore renewables, aquaculture, marine and naval, and industrial. The company specialises in mechanical, hydraulic and electrical engineering, in particular subsea and surface camera, light, laser, and electronic technologies.'@en ;
    skos:notation 'SDN:L35::MAN0254'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0253/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0253/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0253/>;
    dc:modified '2023-05-24T10:35:28'^^xsd:dateTime ;
    skos:altLabel 'SonTek'^^xsd:string ;
    skos:prefLabel 'SonTek'@en ;
    skos:definition 'A US company founded in California in 1992. SonTek was acquired by YSI in 2001, and in 2011 YSI merged with the analytics division of IIT Corp to form a new water company trading under Xylem. SonTek primarily manufactures acoustic doppler current profiling (ADCP) instrumentation for water velocity measurement in water body and laboratory settings.'@en ;
    skos:notation 'SDN:L35::MAN0253'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0252/2/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0252/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0252/>;
    dc:modified '2023-05-19T12:05:59'^^xsd:dateTime ;
    skos:altLabel 'Setra'^^xsd:string ;
    skos:prefLabel 'Setra Systems Inc.'@en ;
    skos:definition 'A US company founded in 1967 based in Boxborough, Massachusetts. Setra is now part of the Fortive group of companies. The company is a manufacturer of premium high accuracy pressure transducers, transmitters, capacitive pressure sensors, and acceleration sensing devices.'@en ;
    skos:notation 'SDN:L35::MAN0252'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0250/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0250/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0250/>;
    dc:modified '2023-02-10T14:55:23'^^xsd:dateTime ;
    skos:altLabel 'FLIR'^^xsd:string ;
    skos:prefLabel 'Teledyne FLIR'@en ;
    skos:definition 'A leading developer and supplier of a wide range of infrared imaging products, including cooled and uncooled infrared detectors, camera cores, and finished cameras. Founded as FLIR Systems in 1978 and acquired by Teledyne Technologies in 2021, FLIR has rebranded as Teledyne FLIR. Teledyne FLIR operates in many locations around the globe and employs a total of over 3000 dedicated employees.'@en ;
    skos:notation 'SDN:L35::MAN0250'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0251/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0251/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0251/>;
    dc:modified '2023-02-10T14:55:23'^^xsd:dateTime ;
    skos:altLabel 'Navitar'^^xsd:string ;
    skos:prefLabel 'Navitar'@en ;
    skos:definition 'A US-based developer and manufacturer of innovative optical solutions for clients and enterprises across the globe. Products range from high magnification motorized zoom imaging systems to fisheye projection lenses used in a wide variety of industries. Founded in 1946 as Egleet Optical and rebranded to Navitar in 1954.'@en ;
    skos:notation 'SDN:L35::MAN0251'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0249/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0249/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0249/>;
    dc:modified '2023-02-10T12:51:49'^^xsd:dateTime ;
    skos:altLabel 'QIAGEN'^^xsd:string ;
    skos:prefLabel 'Qiagen'@en ;
    skos:definition 'QIAGEN (formerly Diagen) offer molecular testing solutions, from DNA, RNA, and protein extraction from biological samples, to testing technologies targeting single or multiple molecular variants, and software to analyse and interpret molecular data to deliver valuable insights. With headquarters in Dusseldorf, Germany it was founded in 1984.'@en ;
    skos:notation 'SDN:L35::MAN0249'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0248/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0248/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0248/>;
    dc:modified '2023-02-10T12:46:07'^^xsd:dateTime ;
    skos:altLabel 'Smart Radio'^^xsd:string ;
    skos:prefLabel 'Smart Radio Holdings Ltd.'@en ;
    skos:definition 'Smart Radio Holdings Limited (formerly Shenzhen Yuantong Telecom Co. Ltd) is a designer and manufacturer of radio communication products for marine AIS, radio telemetry, data, voice, and video communications. It was founded in 2000.'@en ;
    skos:notation 'SDN:L35::MAN0248'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0247/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0247/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0247/>;
    dc:modified '2023-02-09T16:53:30'^^xsd:dateTime ;
    skos:altLabel 'Pacific Gyre'^^xsd:string ;
    skos:prefLabel 'Pacific Gyre Inc.'@en ;
    skos:definition 'A US based manufacturer and designer of products, including environmental sensors, GPS receivers, and satellite telemetry systems; used to track currents and ice motion, collect environmental data, and mark remotely deployed assets. Founded in 2010.'@en ;
    skos:notation 'SDN:L35::MAN0247'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0246/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0246/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0246/>;
    dc:modified '2023-02-02T16:25:36'^^xsd:dateTime ;
    skos:altLabel 'ClearWater'^^xsd:string ;
    skos:prefLabel 'ClearWater Sensors Ltd.'@en ;
    skos:definition 'A UK based manufacturer and designer of marine sensors. They are specialised in in-situ water-quality measurement sensors. Founded in 2019.'@en ;
    skos:notation 'SDN:L35::MAN0246'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0245/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0245/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0245/>;
    dc:modified '2023-01-25T10:34:37'^^xsd:dateTime ;
    skos:altLabel 'JASCO'^^xsd:string ;
    skos:prefLabel 'JASCO Applied Sciences'@en ;
    skos:definition 'A Canadian company which provides consulting and research services for assessing and mitigating underwater noise. The company originates in 1981, and specialises in developing and implementing acoustic technologies with applications in the energy, fisheries and defence sectors.'@en ;
    skos:notation 'SDN:L35::MAN0245'^^xsd:string .
