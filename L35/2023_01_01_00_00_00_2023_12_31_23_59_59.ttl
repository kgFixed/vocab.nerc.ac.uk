    skos:prefLabel 'GoPro, Inc'@en ;
    skos:definition 'An American technology company founded in 2002. It manufactures action cameras and develops mobile apps and video-editing software.'@en ;
    skos:notation 'SDN:L35::MAN0262'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0261/1/> .
