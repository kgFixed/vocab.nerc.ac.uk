    dc:modified '2020-05-06T08:44:54'^^xsd:dateTime ;
    skos:altLabel 'TRMB'^^xsd:string ;
    skos:prefLabel 'Trimble'@en ;
    skos:definition 'A company that specialises in positioning, modeling, connectivity and data analytics technologies for agriculture, construction, geospatial and transportation and logistics applications. It was founded in 1978.'@en ;
    skos:notation 'SDN:L35::MAN0077'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0076/1/> .
