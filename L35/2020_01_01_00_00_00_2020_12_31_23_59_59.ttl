    skos:altLabel 'VAN WALT'^^xsd:string ;
    skos:prefLabel 'Van Walt'@en ;
    skos:definition 'A company providing equipment for groundwater, surface water, soil monitoring and data collection telemetry solutions. Founded in 1982, they have offices in the UK, New Zealand, Spain and South Africa.'@en ;
    skos:notation 'SDN:L35::MAN0110'^^xsd:string .
