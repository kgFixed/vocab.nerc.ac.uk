    skos:prefLabel 'LEMI'@en ;
    skos:definition 'A developer and manufacturer of high quality electromagnetic (EM) sensors for the geophysical industry. Since its foundation in 2008, the company has transferred into a joint venture by Houston, Texas based KMS Technologies in the US.'@en ;
    skos:notation 'SDN:L35::MAN0143'^^xsd:string .
