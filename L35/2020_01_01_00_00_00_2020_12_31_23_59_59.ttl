    skos:definition 'A company that designed and manufactured vehicles and instruments for measuring ocean proporties, based in Marion, Massachusetts. In operation between the 1960s and 1980s.'@en ;
    skos:notation 'SDN:L35::MAN0112'^^xsd:string .
