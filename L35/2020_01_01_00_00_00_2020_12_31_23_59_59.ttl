    skos:altLabel 'REF TEK'^^xsd:string ;
    skos:prefLabel 'Ref Tek'@en ;
    skos:definition 'A developer of seismic monitoring products for the land, marine and oil exploration markets. Founded in 1975 as Refraction Technology Inc, the brand Ref Tek was acquired by Trimble Navigation in 2012. In 2020, it returned to its engineering and customer service roots when it was purchased by Ref Tek Systems Inc, a subsidiary of Xeos Technologies Inc.'@en ;
    skos:notation 'SDN:L35::MAN0145'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0146/1/> .
