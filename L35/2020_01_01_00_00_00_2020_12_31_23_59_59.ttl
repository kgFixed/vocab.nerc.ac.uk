    skos:altLabel 'BLUE ROBOTICS'^^xsd:string ;
    skos:prefLabel 'Blue Robotics'@en ;
    skos:definition 'A US based company specialising in the design and development of affordable marine robotics components and products. Founded in 2014 through Kickstarter.'@en ;
    skos:notation 'SDN:L35::MAN0113'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0112/1/> .
