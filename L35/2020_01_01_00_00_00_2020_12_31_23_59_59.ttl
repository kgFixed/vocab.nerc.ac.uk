    skos:altLabel 'SMRU'^^xsd:string ;
    skos:prefLabel 'Sea Mammal Research Unit'@en ;
    skos:definition 'A marine science research organisation that was established in 1978 by the Natural Environment Research Council (NERC) when the Seals Research Division and Whale Research Unit merged. Originally based in Cambridge, SMRU moved to the University of St Andrews in 1996.'@en ;
    skos:notation 'SDN:L35::MAN0109'^^xsd:string .
