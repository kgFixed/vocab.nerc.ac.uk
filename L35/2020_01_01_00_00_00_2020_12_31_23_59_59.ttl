    dc:modified '2020-05-05T15:26:40'^^xsd:dateTime ;
    skos:altLabel 'ASL'^^xsd:string ;
    skos:prefLabel 'Analytical Sciences'@en ;
    skos:definition 'Analytical Sciences Ltd, based near Cheltenham, England, UK designs and manufactures laboratory instrumentation for the analysis and automated preparation and handling of liquid (aqueous) samples.'@en ;
    skos:notation 'SDN:L35::MAN0076'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0075/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0075/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0075/>;
    dc:modified '2020-04-28T14:36:56'^^xsd:dateTime ;
    skos:altLabel 'HSE'^^xsd:string ;
    skos:prefLabel 'HS Engineers'@en ;
    skos:definition 'A German company that designs and manufacturs technologies for use in the aquatic environment: In lakes, rivers, oceans; for oceanography, limnology, hydrology, coastal protection, civil engineering, etc., including flow meters, multi-parameter probes, and directional sea-state probes. The company was founded in 2001.'@en ;
    skos:notation 'SDN:L35::MAN0075'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0074/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0074/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0074/>;
    dc:modified '2020-04-28T14:26:02'^^xsd:dateTime ;
    skos:altLabel 'edgetech'^^xsd:string ;
    skos:prefLabel 'EdgeTech Ltd.'@en ;
    skos:definition 'EdgeTech is a manufacturer of underwater technology solutions. Its products include: side scan sonars, sub-bottom profilers, bathymetry systems, AUV and ROV-based sonar systems, combined and customized solutions. In addition to the full line of underwater survey products, EdgeTech provides reliable USBL systems, transponder beacons, deep sea acoustic releases, shallow water and long life acoustic releases, MRUs and customized underwater acoustic command and control systems. The company traces its history back to 1965 when it started out as a division of EG&G Marine Instruments. In 1995, EdgeTech became a private company. In 2012 ORE Offshore, a leading provider of acoustic releases, transponders and USBL systems, adopted the EdgeTech name after over ten years operating as an affiliate organization within the company. The company also has a comprehensive suite of in-house testing facilities including test pools, acoustic test tanks, pressure test chambers and two company research vessels used for testing and sea trials. These facilities allow the companies to fully test and calibrate every system.'@en ;
    skos:notation 'SDN:L35::MAN0074'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0073/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0073/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0073/>;
    dc:modified '2020-04-17T11:41:28'^^xsd:dateTime ;
    skos:altLabel 'ZEISS'^^xsd:string ;
    skos:prefLabel 'Carl Zeiss AG'@en ;
    skos:definition 'Carl Zeiss AG, branded as ZEISS, is a German manufacturer of optical systems and optoelectronics, founded in Jena, Germany in 1846 by optician Carl Zeiss. ZEISS Group develops, produces and distributes measuring technology, microscopes, medical technology, eyeglass lenses, camera and cinema lenses, binoculars and semiconductor manufacturing equipment.'@en ;
    skos:notation 'SDN:L35::MAN0073'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0072/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0072/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0072/>;
    dc:modified '2020-04-16T12:39:44'^^xsd:dateTime ;
    skos:altLabel 'ASL ES'^^xsd:string ;
    skos:prefLabel 'ASL Environmental Sciences'@en ;
    skos:definition 'A Canadian company providing oceanographic, acoustic, remote sensing and ice research products, equipment leasing, and scientific consulting services.'@en ;
    skos:notation 'SDN:L35::MAN0072'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0071/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0071/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0071/>;
    dc:modified '2020-04-16T12:31:52'^^xsd:dateTime ;
    skos:altLabel 'Sound Metrics'^^xsd:string ;
    skos:prefLabel 'Sound Metrics'@en ;
    skos:definition 'A company based in Bellevue, Washington, US, that designs and manufactures imaging sonars. The companys line of products can be deployed from vessels, ROVs (remotely operated vehicles), AUVs (autonomous underwater vehicles) and by divers. Founded in 2002.'@en ;
    skos:notation 'SDN:L35::MAN0071'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0070/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0070/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0070/>;
    dc:modified '2020-04-16T12:23:07'^^xsd:dateTime ;
    skos:altLabel 'IS'^^xsd:string ;
    skos:prefLabel 'Impact Subsea Ltd.'@en ;
    skos:definition 'A subsea technology company that designs and manufactures a range of high-performance sensor solutions designed for use on underwater vehicles (such as Remotely Operated and Autonomous Vehicles) and can also be used in a number of other underwater applications. Impact Subsea provides sensor solutions to the Oil and Gas, Renewables, Underwater Research and Defence markets. Established in 2015, the company has developed a portfolio of underwater technology encompassing Sonars; Altimeters; Depth Sensors; Attitude and Heading Reference Systems; Flooded Member Detection Systems and bespoke Pressure Housings.'@en ;
    skos:notation 'SDN:L35::MAN0070'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0069/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0069/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0069/>;
    dc:modified '2020-04-07T16:27:58'^^xsd:dateTime ;
    skos:altLabel 'CUSTOM-MADE'^^xsd:string ;
    skos:prefLabel 'Custom-made'@en ;
    skos:definition 'The instrument, sensor or device has been developed and/or manufactured using bespoke materials and/or designs and is not traceable to a specific manufacturer or organisation.'@en ;
    skos:notation 'SDN:L35::MAN0069'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0068/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0068/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0068/>;
    dc:modified '2020-03-25T16:52:06'^^xsd:dateTime ;
    skos:altLabel 'NORTEK'^^xsd:string ;
    skos:prefLabel 'Nortek'@en ;
    skos:definition 'Nortek designs, develops and produces scientific instruments that apply the Doppler principle to underwater acoustics in order to measure water in motion, such as currents and waves.'@en ;
    skos:notation 'SDN:L35::MAN0068'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0066/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0066/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0066/>;
    dc:modified '2020-03-19T11:00:07'^^xsd:dateTime ;
    skos:altLabel 'HOBI Labs'^^xsd:string ;
    skos:prefLabel 'Hydro-Optics, Biology and Instrumentation Laboratories, Inc.'@en ;
    skos:definition 'A US-based company specialised in sponsored research and instrument manufacturing. HOBI Labs\' main products include spectral optical backscattering, fluorescence and attenuation sensors designed for natural water measurements, as well as hyperspectral radiometers. HOBI Labs was founded in 1997 and ceased operations in 2014; since then, a separate company called Hobi Instrument Services has been providing calibration, repair and limited sales of HOBI Labs instruments.'@en ;
    skos:notation 'SDN:L35::MAN0066'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0067/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0067/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0067/>;
    dc:modified '2020-03-16T14:49:34'^^xsd:dateTime ;
    skos:altLabel 'BioSonics'^^xsd:string ;
    skos:prefLabel 'BioSonics, Inc.'@en ;
    skos:definition 'A US-based company specialised in hydroacoustic technologies for monitoring and assessing aquatic resources. BioSonics was founded in 1978 in Seattle, Washington (USA) by Bill Acker, a former Professor of Engineering at the University of Washington. BioSonics instruments were first utilised by the local scientific community for fisheries research; today, its technologies serve a wide range of costumers worldwide for the monitoring of biological and physical features in any aquatic environment.'@en ;
    skos:notation 'SDN:L35::MAN0067'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0065/1/> .
