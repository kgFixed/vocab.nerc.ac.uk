    skos:altLabel 'OCEAN ECOLOGY'^^xsd:string ;
    skos:prefLabel 'Ocean Ecology'@en ;
    skos:definition 'A UK based company specialising in marine surveys, data analysis and consultancy. They also offer marine survey equipment for hire covering a wide spectrum of offshore marine, coastal and aerial applications. Founded in 2013.'@en ;
    skos:notation 'SDN:L35::MAN0111'^^xsd:string .
