    dc:modified '2020-01-14T15:38:21'^^xsd:dateTime ;
    skos:altLabel 'SPAR_CAN'^^xsd:string ;
    skos:prefLabel 'Sparton of Canada'@en ;
    skos:definition 'A subsidiary company of the Sparton Corporation formed in 1930. At the time, the Sparton Corporation was formally known as Sparks-Withington.'@en ;
    skos:notation 'SDN:L35::MAN0062'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0061/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0061/1/>
    a skos:Concept ;
