    skos:altLabel 'WHOI'^^xsd:string ;
    skos:prefLabel 'Woods Hole Oceanographic Institution'@en ;
    skos:definition 'A US-based marine research and engineering institution founded in 1930.'@en ;
    skos:notation 'SDN:L35::MAN0064'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0063/1/> .
