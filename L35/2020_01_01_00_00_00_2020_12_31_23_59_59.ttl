    dc:modified '2020-01-14T09:08:58'^^xsd:dateTime ;
    skos:altLabel 'LP-RESEARCH'^^xsd:string ;
    skos:prefLabel 'LP-Research'@en ;
    skos:definition 'A company based in Tokyo, Japan specializing in the design and development of life science and research equipment including Inertial Measurement Unit (IMU) Devices.'@en ;
    skos:notation 'SDN:L35::MAN0061'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0059/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0059/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0059/>;
    dc:modified '2020-01-14T09:08:58'^^xsd:dateTime ;
    skos:altLabel 'METEK'^^xsd:string ;
    skos:prefLabel 'Metek'@en ;
    skos:definition 'Metek Meteorologische Messtechnik, Germany, offers a wide range of high-end meteorological instrumentation starting with a family of sonic anemometers and variants of versatile data loggers. Ground based remote sensing techniques provide profiles of wind, temperature, rain rate and cloud droplets in continuous unattended operation. The company was founded in 1989.'@en ;
    skos:notation 'SDN:L35::MAN0059'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0060/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0060/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0060/>;
    dc:modified '2020-01-14T09:08:58'^^xsd:dateTime ;
    skos:altLabel 'SD'^^xsd:string ;
    skos:prefLabel 'Systron Donner Inertial'@en ;
    skos:definition 'Systron Donner Inertial manufactures navigation products including quartz MEMS (Micro Electro Mechanical) Gyroscopes, Accelerometers, Inertial Measurement Units (IMU) and GPS/ Inertial Navigation System (INS) products. Divisions of Systron Donner became part BEI technologies in 1995 before evolving into Systron Donner Inertial in 2002. It was acquired by EMCORE in 2019.'@en ;
    skos:notation 'SDN:L35::MAN0060'^^xsd:string .
