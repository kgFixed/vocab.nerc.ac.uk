    skos:prefLabel 'Naxys'@en ;
    skos:definition 'A developer of high-tech leak detection and condition monitoring systems for subsea installations within the oil and gas industry. Based in Norway, founded in 1999.'@en ;
    skos:notation 'SDN:L35::MAN0144'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0145/1/> .
