    skos:altLabel 'TOPCON'^^xsd:string ;
    skos:prefLabel 'Topcon Positioning Systems'@en ;
    skos:definition 'A company that specialises in developing global positioning products and technologies for geo-businesses and geospatial industries. It was founded in the 1980s in Japan.'@en ;
    skos:notation 'SDN:L35::MAN0079'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0078/1/> .
