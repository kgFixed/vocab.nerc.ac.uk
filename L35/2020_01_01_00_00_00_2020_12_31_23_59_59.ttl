    dc:modified '2020-02-12T16:25:28'^^xsd:dateTime ;
    skos:altLabel 'WHOI+STAR'^^xsd:string ;
    skos:prefLabel 'Woods Hole Oceanographic Institution and Star Engineering'@en ;
    skos:definition 'A developmental collaboration between WHOI and Star Engineering Inc., a provider of Printed Circuit Board Assemblies, Cable Assemblies and Mechanical Box Build Assemblies.'@en ;
    skos:notation 'SDN:L35::MAN0065'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0064/1/> .
