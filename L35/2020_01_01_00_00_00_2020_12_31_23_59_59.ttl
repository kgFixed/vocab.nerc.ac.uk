    skos:altLabel 'SCIFISH'^^xsd:string ;
    skos:prefLabel 'Scientific Fishery Systems'@en ;
    skos:definition 'A US company that specialises in developing products and technologies for fisheries. It was founded in 1992.'@en ;
    skos:notation 'SDN:L35::MAN0078'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0077/1/> .
