    skos:prefLabel 'AMT Analysenmesstechnik GmbH'@en ;
    skos:definition 'A manufacturing company based in Germany that was founded in April 2004. It is a manufacturer of electrochemical measuring and calibration devices for the use in laboratories, industrial applications, research and development and for environmental monitoring in natural waters.'@en ;
    skos:notation 'SDN:L35::MAN0101'^^xsd:string .
