    skos:altLabel 'HYDRO'^^xsd:string ;
    skos:prefLabel 'Hydroid'@en ;
    skos:definition 'A manufacturer of Unmanned Underwater Vehicles (UUVs). It was established in 2001 by the inventors of the REMUS UUV. It became a subsidiary of Kongsberg Maritime in 2008. It has been part of the Huntington Ingalls Industries since 2020.'@en ;
    skos:notation 'SDN:L35::MAN0140'^^xsd:string .
