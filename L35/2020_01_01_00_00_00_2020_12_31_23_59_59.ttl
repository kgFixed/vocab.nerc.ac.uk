    skos:altLabel 'KC'^^xsd:string ;
    skos:prefLabel 'KC Denmark A/S'@en ;
    skos:definition 'A company specialising in development of various types of sampling equipment for oceanographic, environmental and pollution investigations. Supplying equipment to universities, research institutes, municipal authorities and consulting engineers specialising in environmental and pollution affairs. Founded in 1979.'@en ;
    skos:notation 'SDN:L35::MAN0108'^^xsd:string .
