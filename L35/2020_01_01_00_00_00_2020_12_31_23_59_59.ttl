    skos:altLabel 'SA'^^xsd:string ;
    skos:prefLabel 'Silicon Audio'@en ;
    skos:definition 'A Texas, US based company focused on the development and application of advanced sound and vibration transducer technology. These include seismic sensors for energy exploration and scientific monitoring, microphones for consumer communication and hearing device applications, and sensors for measuring wind in extreme flow conditions.'@en ;
    skos:notation 'SDN:L35::MAN0146'^^xsd:string .
