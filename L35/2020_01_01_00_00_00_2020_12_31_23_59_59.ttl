    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0063/>;
    dc:modified '2020-01-14T15:38:21'^^xsd:dateTime ;
    skos:altLabel 'SIPPICAN'^^xsd:string ;
    skos:prefLabel 'Lockheed Martin Sippican'@en ;
    skos:definition 'A subsidiary company of Lockheed Martin that was formed in 2004 from a merger between Lockheed Martin and Sippican Holdings Inc. It specialises in oceanographic and meteorological instrumentation, underwater vehicles, countermeasure, sea-air, and data acquisition systems.'@en ;
    skos:notation 'SDN:L35::MAN0063'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0062/1/> .
