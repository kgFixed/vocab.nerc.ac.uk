    dc:modified '2024-08-14T10:24:16'^^xsd:dateTime ;
    skos:altLabel 'Atlas Hydrographic'^^xsd:string ;
    skos:prefLabel 'Atlas Hydrographic GmbH'@en ;
    skos:definition 'Manufacturer of survey echosounders, radar and radio navigation equipment, and provider of integrated hydrographic and oceanographic system solutions. Was founded in 2003. Acquired by Teledyne Reson in 2014.'@en ;
    skos:notation 'SDN:L35::MAN0241'^^xsd:string .
