    skos:prefLabel '10x Genomics Inc.'@en ;
    skos:definition 'A US biotechnology company founded in 2012 in Pleasanton California. 10x Genomics designs and manufactures gene sequencing technology with applications in scientific research.'@en ;
    skos:notation 'SDN:L35::MAN0278'^^xsd:string .
