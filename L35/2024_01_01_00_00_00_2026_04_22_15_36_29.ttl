    dc:modified '2025-10-23T11:14:56'^^xsd:dateTime ;
    skos:altLabel 'Seatrec'^^xsd:string ;
    skos:prefLabel 'SEATREC'@en ;
    skos:definition 'A US-based company founded in 2016 whose technology originated at NASA Jet Propulsion Laboratory, California Institute of Technology. The headquarters are now based in Vista, California and a satellite office in Gulfport, Mississippi. The company develops and builds power solutions and computational tools for offshore data collection, with a primary focus on harvesting thermal energy.'@en ;
    skos:notation 'SDN:L35::MAN0366'^^xsd:string .
