    skos:altLabel 'WALLAC'^^xsd:string ;
    skos:prefLabel 'Wallac'@en ;
    skos:definition 'An instruments manufacturer for thermal technology, civil engineering and diagnostic screening systems. It was founded in 1950 in Finland as Wallac Oy. It became part of PerkinElmer.'@en ;
    skos:notation 'SDN:L35::MAN0273'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0272/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0272/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0272/>;
    dc:modified '2024-01-25T09:59:20'^^xsd:dateTime ;
    skos:altLabel 'CSDF'^^xsd:string ;
    skos:prefLabel 'Continental Scientific Drilling Facility'@en ;
    skos:definition 'The CSD Facility maintains an array of specialised field equipment to support scientific coring and drilling. Facility equipment includes water samplers, soft sediment coring systems for most environmental settings, and lightweight drills for shallow rock coring. The CSD Facility is part of the University of Minnesota, School of Earth and Environmental Sciences. Funding for the CSD Facility is provided by the National Science Foundation, Division of Earth Sciences, Instrumentation and Facilities Program.'@en ;
    skos:notation 'SDN:L35::MAN0272'^^xsd:string .
