    skos:prefLabel 'Keller America Inc.'@en ;
    skos:definition 'A US-based subsidary of Keller Pressure, based in Newport News, Virginia. Keller America specialises in the design and manufacturing of pressure sensors.'@en ;
    skos:notation 'SDN:L35::MAN0290'^^xsd:string .
