    skos:altLabel 'GO'^^xsd:string ;
    skos:prefLabel 'General Oceanics'@en ;
    skos:definition 'A US-based company establised in Miami, Florida in 1966 that designs and manufactures water sampling products and instruments for the oceanographic community.'@en ;
    skos:notation 'SDN:L35::MAN0306'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0305/1/> .
