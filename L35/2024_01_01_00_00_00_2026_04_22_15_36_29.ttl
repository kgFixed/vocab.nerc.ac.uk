    dc:modified '2025-11-12T10:24:57'^^xsd:dateTime ;
    skos:altLabel 'FSI'^^xsd:string ;
    skos:prefLabel 'Falmouth Scientific Inc.'@en ;
    skos:definition 'A company based in Falmouth, Massachusetts, USA. Falmouth Scientific, Inc. (FSI) was founded in 1989 based on WHOI technology licences, and specialises in sensors for salt and fresh water environments, including seismic, sub-bottom, and side scan sonar imaging systems, current, wave, and tide meters, and acoustic transducers and relocation systems.'@en ;
    skos:notation 'SDN:L35::MAN0324'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0371/1/> .
