    skos:altLabel 'ZXLidars'^^xsd:string ;
    skos:prefLabel 'ZX Lidars (Zephir Ltd.)'@en ;
    skos:definition 'A specialist in wind Lidar technology, providing precise remote wind measurements for onshore and offshore wind energy projects. Founded in 2007 and headquartered in Ledbury, England, ZX Lidars is part of the Fred. Olsen Ltd. group.'@en ;
    skos:notation 'SDN:L35::MAN0317'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0315/1/> .
