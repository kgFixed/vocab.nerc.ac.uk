    skos:altLabel 'ODOM'^^xsd:string ;
    skos:prefLabel 'Teledyne Odom Hydrographic'@en ;
    skos:definition 'A Danish company which is part of the Teledyne Marine Acoustic Imaging Group. Teledyne Odom Hydrographic specialises in subsea imaging and multibeam echosounder solutions.'@en ;
    skos:notation 'SDN:L35::MAN0291'^^xsd:string .
