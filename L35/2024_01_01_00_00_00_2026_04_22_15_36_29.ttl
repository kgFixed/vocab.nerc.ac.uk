    skos:altLabel 'E+E Elektronik'^^xsd:string ;
    skos:prefLabel 'E+E Elektronik Ges.m.b.H.'@en ;
    skos:definition 'An Austrian company specialised in the development and manufacture of sensors and calibration systems for a range of atmospheric parameters, and in providing calibration services from its accredited laboratory. The company was founded in 1979, and has since established offices worldwide.'@en ;
    skos:notation 'SDN:L35::MAN0276'^^xsd:string .
