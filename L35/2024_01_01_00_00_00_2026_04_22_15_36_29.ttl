    skos:altLabel 'LI-COR'^^xsd:string ;
    skos:prefLabel 'LI-COR Biosciences'@en ;
    skos:definition 'LI-COR develops environmental and biotechnology products. It was founded in 1971. It was previously called Lambda Instruments Corporation. It was acquired by Battery Ventures in 2021.'@en ;
    skos:notation 'SDN:L35::MAN0200'^^xsd:string .
