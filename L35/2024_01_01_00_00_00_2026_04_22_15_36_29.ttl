    skos:altLabel 'Nu Instruments'^^xsd:string ;
    skos:prefLabel 'Nu Instruments Ltd'@en ;
    skos:definition 'A UK company based in North Wales specialising in high-end mass spectrometers. Founded in 1995, the company joined AMETEK in July 2016 and became a business unit of the AMETEK Materials Analysis Division.'@en ;
    skos:notation 'SDN:L35::MAN0313'^^xsd:string .
