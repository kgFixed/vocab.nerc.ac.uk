    skos:prefLabel 'Z3 Technology'@en ;
    skos:definition 'USA-based manufacturer of video encoding and IP camera systems. Headquartered in Lincoln, Nebraska with engineering offices in Chicago, Illinois. Founded in 2008.'@en ;
    skos:notation 'SDN:L35::MAN0288'^^xsd:string .
