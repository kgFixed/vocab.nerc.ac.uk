    skos:altLabel 'C and C'^^xsd:string ;
    skos:prefLabel 'C and C Technologies Inc.'@en ;
    skos:definition 'A provider of instrument systems for globally corrected positioning, with applications in hydrographic activities, deepwater seafloor mapping, subsea surveys, and offshore oilfield exloration. C and C Technologies was acquired by Oceaneering International Inc. on April 2nd, 2015.'@en ;
    skos:notation 'SDN:L35::MAN0314'^^xsd:string .
