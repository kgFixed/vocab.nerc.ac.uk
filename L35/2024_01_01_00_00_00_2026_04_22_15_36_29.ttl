    skos:altLabel 'IH Cantabria'^^xsd:string ;
    skos:prefLabel 'University of Cantabria, Environmental Hydraulics Institute'@en ;
    skos:definition 'A Spanish-based joint research institute between the University of Cantabria and the Government of Spain, focused on the sciences and technologies related to the water cycle. Founded in 2007.'@en ;
    skos:notation 'SDN:L35::MAN0274'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0273/1/> .
