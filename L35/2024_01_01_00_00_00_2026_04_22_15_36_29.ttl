    skos:altLabel 'Leica'^^xsd:string ;
    skos:prefLabel 'Leica Geosystems'@en ;
    skos:definition 'A Swiss-based company formerly known as Wild Heerbrugg, acquired by Hexagon AB in 2005. The company manufactures products and systems for surveying and geographical measurement, such as GPS satellite navigation and laser rangefinders. Founded as Kern and Co. in 1819.'@en ;
    skos:notation 'SDN:L35::MAN0326'^^xsd:string .
