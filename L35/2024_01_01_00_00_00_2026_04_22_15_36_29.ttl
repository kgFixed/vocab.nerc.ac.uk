    skos:altLabel 'FAU-HBOI'^^xsd:string ;
    skos:prefLabel 'Florida Atlantic University - Harbor Branch Oceanographic Institute'@en ;
    skos:definition 'A non-profit oceanographic institution operated by Florida Atlantic University in Fort Pierce, Florida, United States. Founded in 1971 as non-profit research organization, the institution was transferred to FAU in 2007.'@en ;
    skos:notation 'SDN:L35::MAN0358'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0357/2/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0357/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0357/>;
    dc:modified '2025-08-14T11:21:01'^^xsd:dateTime ;
    skos:altLabel 'P-ONE'^^xsd:string ;
    skos:prefLabel 'Pacific Ocean Neutrino Experiment'@en ;
    skos:definition 'An international collaboration of researchers spread across 18 universities and institutes including Ocean Networks Canada and Technical University of Munich, Germany. The collaboration plans to build a large-volume neutrino telescope in the NorthEast Pacific Ocean and has 6 member institutes from Canada, 7 from Germany, 1 from Poland, 1 from the United Kingdom, and 3 from the United States of America.'@en ;
    skos:notation 'SDN:L35::MAN0357'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0356/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0356/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0356/>;
    dc:modified '2025-08-14T10:24:44'^^xsd:dateTime ;
    skos:altLabel 'SINTEF'^^xsd:string ;
    skos:prefLabel 'SINTEF Ocean'@en ;
    skos:definition 'A Norwegian-based company that carries out research and innovation connected to the ocean space for national and international industry, with a focus on marine technology and biomarine research. SINTEF was established in 1950 by the Norwegian Institute of Technology (NTH), which was later merged into the Norwegian University of Science and Technology (NTNU).'@en ;
    skos:notation 'SDN:L35::MAN0356'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0355/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0355/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0355/>;
    dc:modified '2025-08-14T09:38:49'^^xsd:dateTime ;
    skos:altLabel 'DGSI'^^xsd:string ;
    skos:prefLabel 'Durham Geo Slope Indicator'@en ;
    skos:definition 'A US-based company bought by Nova Ventures in 2009. Formed from two separate companies in 2000 when Durham Geo-Enterprises bought Slope Indicator, forming DGSI. The corporate headquarters are in Tucker, Georgia, with sales offices in Australia, Canada, and Latin America. The company specialises in geotechnical instrumentation.'@en ;
    skos:notation 'SDN:L35::MAN0355'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0354/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0354/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0354/>;
    dc:modified '2025-08-13T15:42:34'^^xsd:dateTime ;
    skos:altLabel 'BURNS'^^xsd:string ;
    skos:prefLabel 'Burns Electronics Pty Ltd'@en ;
    skos:definition 'Burns Electronics is a designer and manufacturer of hydrophones and associated equipment (e.g. amplifiers and accessories). The company was established in 1984 and is located in Nelson Bay, New South Wales, Australia.'@en ;
    skos:notation 'SDN:L35::MAN0354'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0353/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0353/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0353/>;
    dc:modified '2025-08-13T15:24:01'^^xsd:dateTime ;
    skos:altLabel 'IOS'^^xsd:string ;
    skos:prefLabel 'Institute of Ocean Sciences, Fisheries and Oceans Canada'@en ;
    skos:definition 'The Institute of Ocean Sciences (IOS) is a centre for research on the Northeastern Pacific Ocean, the coastal waters of British Columbia, and fresh waters on the west coast of Canada. The IOS is based in Sidney, British Columbia, and is part of the federal institution - Fisheries and Oceans Canada (DFO).'@en ;
    skos:notation 'SDN:L35::MAN0353'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0352/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0352/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0352/>;
    dc:modified '2025-08-07T16:11:20'^^xsd:dateTime ;
    skos:altLabel 'Sea and Sun Technology'^^xsd:string ;
    skos:prefLabel 'Sea and Sun Technology GmBH'@en ;
    skos:definition 'A German company founded in 1998. Sea and Sun Technology specialise in the production of water measurement probes for use in the maritime sector and limnic sector.'@en ;
    skos:notation 'SDN:L35::MAN0352'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0351/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0351/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0351/>;
    dc:modified '2025-08-07T11:13:17'^^xsd:dateTime ;
    skos:altLabel 'Subsea Data Systems'^^xsd:string ;
    skos:prefLabel 'Subsea Data Systems'@en ;
    skos:definition 'A US company founded in 2020 and currently based in Stuart, Florida. Subsea Data Systems is a partnership between Samara/Data and Ocean Specialists Inc. The company specialise in SMART Cable hardware, software, and data management solutions.'@en ;
    skos:notation 'SDN:L35::MAN0351'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0350/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0350/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0350/>;
    dc:modified '2025-08-07T09:52:05'^^xsd:dateTime ;
    skos:altLabel 'NatureScot'^^xsd:string ;
    skos:prefLabel 'NatureScot'@en ;
    skos:definition 'A public body of the Scottish Government responsible for Scotland\'s natural heritage, especially its natural, genetic and scenic diversity. It advises the Scottish Government on nature conservation, and acts as a government agent in the delivery of conservation designations, i.e. national nature reserves, local nature reserves, national parks, Sites of Special Scientific Interest (SSSIs), Special Areas of Conservation, Special Protection Areas and the national scenic areas. It receives annual funding from the Scottish Government in the form of Grant in Aid to deliver government priorities for Scotland’s natural heritage. Founded in 1992 as Scottish National Heritage.'@en ;
    skos:notation 'SDN:L35::MAN0350'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0349/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0349/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0349/>;
    dc:modified '2025-08-04T13:57:51'^^xsd:dateTime ;
    skos:altLabel 'ICM'^^xsd:string ;
    skos:prefLabel 'Institute of Marine Sciences'@en ;
    skos:definition 'The Institute of Marine Sciences (ICM) is the largest research institution in Spain dedicated to marine research, funded by the Spanish National Research Council (CSIC). The institute changed its name to ICM in 1986, but traces its origins back to 1951 as the Fisheries Research Institute (Instituto de Investigaciones Pesqueras).'@en ;
    skos:notation 'SDN:L35::MAN0349'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0347/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0347/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0347/>;
    dc:modified '2025-07-24T11:19:58'^^xsd:dateTime ;
    skos:altLabel 'BASi'^^xsd:string ;
    skos:prefLabel 'BASi Research Products, Inc'@en ;
    skos:definition 'BASi Research Products, Inc provides instrumentation to the life sciences and electrochemistry markets, with a wide variety of applications, including pharmaceutical development, basic neuroscience research, point-of-care sensing tools, contaminant detection, material characterization, and more. The instruments and consumables are manufactured in West Lafayette, Indiana, United States of America. Founded in 1974. It is a part of Inotiv, Inc a publicly traded, global company headquartered in Indianapolis, Indiana.'@en ;
    skos:notation 'SDN:L35::MAN0347'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0346/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0346/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0346/>;
    dc:modified '2025-07-17T11:38:45'^^xsd:dateTime ;
    skos:altLabel 'Silixa'^^xsd:string ;
    skos:prefLabel 'Silixa Ltd'@en ;
    skos:definition 'A UK-based company founded in 2007 and acquired by Luna Innovations in 2023. Silixa specialise in the production of sensing solutions with focus on energy, defence, and mining.'@en ;
    skos:notation 'SDN:L35::MAN0346'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0345/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0345/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0345/>;
    dc:modified '2025-07-15T11:33:35'^^xsd:dateTime ;
    skos:altLabel 'TA'^^xsd:string ;
    skos:prefLabel 'TA Instruments'@en ;
    skos:definition 'A US-based company founded in 1990 and purchased by Waters Corporation in 1996. The main office is in New Castle, Delaware, but it has offices worldwide. The company specialises in thermal analysis but has expanded into other areas, including rheology, microcalorimetry, and thermal conductivity.'@en ;
    skos:notation 'SDN:L35::MAN0345'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0344/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0344/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0344/>;
    dc:modified '2025-07-10T09:54:32'^^xsd:dateTime ;
    skos:altLabel 'BioTek'^^xsd:string ;
    skos:prefLabel 'BioTek Instruments'@en ;
    skos:definition 'BioTek Instruments was a privately held Vermont-based manufacturer of scientific instruments and associated software used in basic research in the life sciences as well in quality assurance in related industries. It was established in 1968, began manufacturing microplate instrumentation in 1981, and was aquired by Agilent Technologies in 2019.'@en ;
    skos:notation 'SDN:L35::MAN0344'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0343/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0343/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0343/>;
    dc:modified '2025-06-25T14:12:13'^^xsd:dateTime ;
    skos:altLabel 'Tisch Environmental'^^xsd:string ;
    skos:prefLabel 'Tisch Environmental Inc'@en ;
    skos:definition 'A US company founded in 1998 and currently based in Cleves, Ohio. Tisch Environmental Inc (TEI) specialise in high volume air sampling and the manufacture of air pollution monitoring equipment.'@en ;
    skos:notation 'SDN:L35::MAN0343'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0342/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0342/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0342/>;
    dc:modified '2025-06-25T11:23:22'^^xsd:dateTime ;
    skos:altLabel 'Bio-Rad'^^xsd:string ;
    skos:prefLabel 'Bio-Rad Laboratories Inc'@en ;
    skos:definition 'A US company founded in Berkeley, California in 1952. Bio-Rad specialises in developing products for the life science research and clinical diagnostic markets, and is now a global company with offices in 36 countries.'@en ;
    skos:notation 'SDN:L35::MAN0342'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0341/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0341/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0341/>;
    dc:modified '2025-06-25T09:18:03'^^xsd:dateTime ;
    skos:altLabel 'Mirion Technologies'^^xsd:string ;
    skos:prefLabel 'Mirion Technologies'@en ;
    skos:definition 'A US company with headquarters in Atlanta, Georgia, that specialises in radiation safety technologies and expertise. Mirion Technologies has offices worldwide and is part of the larger Mirion group that also includes Mirion Medical.'@en ;
    skos:notation 'SDN:L35::MAN0341'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0340/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0340/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0340/>;
    dc:modified '2025-06-19T12:39:27'^^xsd:dateTime ;
    skos:altLabel 'Suunto'^^xsd:string ;
    skos:prefLabel 'Suunto'@en ;
    skos:definition 'A Finnish-based company that designs and manufactures sports watches, dive computers, compasses and precision instruments. Headquartered in Vantaa, Finland, Suunto employs more than 300 people worldwide, and its products are sold in over 100 countries. Founded in Finland in 1936.'@en ;
    skos:notation 'SDN:L35::MAN0340'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0339/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0339/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0339/>;
    dc:modified '2025-06-13T15:47:30'^^xsd:dateTime ;
    skos:altLabel 'CAMECA'^^xsd:string ;
    skos:prefLabel 'CAMECA SAS'@en ;
    skos:definition 'A company founded in 1929 in France, CAMECA is a company specialising in the provision of scientific instrumentation, particularly for mechanics, optics, and electronics. Specifically, CAMECA pioneered Electron Probe MicroAnalysis (EPMA) in the 1950s and Secondary Ion Mass Spectrometry (SIMS) in the 1960s. CAMECA is headquartered in Gennevilliers, France, and is a business unit of AMETEK Inc following its acquisition from the Carlyle Group in 2007.'@en ;
    skos:notation 'SDN:L35::MAN0339'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0338/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0338/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0338/>;
    dc:modified '2025-06-05T12:22:07'^^xsd:dateTime ;
    skos:altLabel 'VG Elemental'^^xsd:string ;
    skos:prefLabel 'VG Elemental'@en ;
    skos:definition 'A British company based in Winsford, Cheshire, that specialised in analytical instruments and pioneered the development of spectrometers and elemental measurement solutions. The company went through multiple buy-outs and ultimately became part of Thermo Fisher Scientific in 2006.'@en ;
    skos:notation 'SDN:L35::MAN0338'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0337/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0337/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0337/>;
    dc:modified '2025-05-08T12:32:00'^^xsd:dateTime ;
    skos:altLabel 'GARMIN'^^xsd:string ;
    skos:prefLabel 'Garmin'@en ;
    skos:definition 'A US-based multinational technology company that designs, develops, manufactures, markets, and distributes GPS-enabled products and other navigation, communication, sensor-based, and information products to the automotive, aviation, marine, outdoors, and sport markets. Founded in 1989.'@en ;
    skos:notation 'SDN:L35::MAN0337'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0336/3/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0336/3/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0336/>;
    dc:modified '2025-05-08T12:28:16'^^xsd:dateTime ;
    skos:altLabel 'HEMISPHERE'^^xsd:string ;
    skos:prefLabel 'Hemisphere GNSS'@en ;
    skos:definition 'Code deprecated on 08/05/2025 - duplicates existing code. Definition was: A US-based company that designs and manufactures heading and positioning products, services, and technology for use in agriculture, construction and mining, marine, OEM (original equipment manufacturer), L-band correction service markets, and any application that requires high-precision heading and positioning. Hemisphere holds numerous patents and other intellectual property and sells globally with several leading products and services for high-precision applications. Hemisphere is headquartered in Scottsdale, AZ, USA, with offices located around the globe. Founded in 2013.'@en ;
    skos:notation 'SDN:L35::MAN0336'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0335/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0335/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0335/>;
    dc:modified '2025-05-07T17:04:45'^^xsd:dateTime ;
    skos:altLabel 'Isotopx'^^xsd:string ;
    skos:prefLabel 'Isotopx Ltd'@en ;
    skos:definition 'A company founded in 2008, based in Middlewich, UK. Isotopx specialises in the design and manufacture of stable isotope ratio, noble gas, and thermal ionisation mass spectrometry instruments. In 2021, Isotopx was acquired by Techcomp Europe Ltd, a group of European companies involved in the manufacture and distribution of analytical systems, life science equipment and laboratory instruments. Isotopx has origins in the 1970s as VG Micromass, with several subsequent acquisitions by Thermo Electron and Waters.'@en ;
    skos:notation 'SDN:L35::MAN0335'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0334/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0334/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0334/>;
    dc:modified '2025-05-01T10:22:38'^^xsd:dateTime ;
    skos:altLabel 'RST'^^xsd:string ;
    skos:prefLabel 'RST Instruments Ltd'@en ;
    skos:definition 'A Canadian company specialising in monitoring instruments and data acquisition for mining, civil engineering, and geotechnical applications. Founded in 1977, the company joined Orica Digital Solutions in 2024 under the product category of Geosolutions.'@en ;
    skos:notation 'SDN:L35::MAN0334'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0333/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0333/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0333/>;
    dc:modified '2025-05-01T09:41:30'^^xsd:dateTime ;
    skos:altLabel 'METAS'^^xsd:string ;
    skos:prefLabel 'METAS AS'@en ;
    skos:definition 'METAS AS is based in Norway and was established in 2014. They specialise in subsea technology for asset integrity monitoring in the oil and gas industry, offering solutions that enhance safety and response times throughout the lifecycle of subsea systems. Key offerings include Wide Area Active Monitoring (WAAM) systems that detect and measure hydrocarbon and CO2 leaks, subsea video cameras operating at depths up to 6,500 meters, and environmental monitoring stations with soil samplers and various instruments. They also partner with iSeaMC to integrate ROVs and AUVs for deep-sea operations. METAS AS aims to improve the safety and cost-effectiveness of subsea operations through reliable monitoring systems.'@en ;
    skos:notation 'SDN:L35::MAN0333'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0332/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0332/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0332/>;
    dc:modified '2025-04-29T09:23:27'^^xsd:dateTime ;
    skos:altLabel 'ASTORIA'^^xsd:string ;
    skos:prefLabel 'Astoria Pacific'@en ;
    skos:definition 'A US-based company established in Oregon in 1990. The company initially began in the horticultural market and later expanded into the automated wet chemistry and analyser business.'@en ;
    skos:notation 'SDN:L35::MAN0332'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0331/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0331/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0331/>;
    dc:modified '2025-04-25T11:16:51'^^xsd:dateTime ;
    skos:altLabel 'Hanna'^^xsd:string ;
    skos:prefLabel 'Hanna Instruments'@en ;
    skos:definition 'A company founded in Italy in 1978, now headquartered in Rhode Island, USA. Hanna Instruments designs, manufactures, and distributes scientific products used in analytical applications in the laboratory, food and beverage, hydroponics, aquaculture, and wastewater industries.'@en ;
    skos:notation 'SDN:L35::MAN0331'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0330/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0330/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0330/>;
    dc:modified '2025-04-25T10:05:45'^^xsd:dateTime ;
    skos:altLabel 'Idronaut'^^xsd:string ;
    skos:prefLabel 'IDRONAUT'@en ;
    skos:definition 'A company founded in 1982, based in Brugherio Italy. IDRONAUT specialises in sensors and instrumentation to measure physical and chemical water parameters like temperature, depth, salinity, pH, and dissolved oxygen, typically with research applications.'@en ;
    skos:notation 'SDN:L35::MAN0330'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0329/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0329/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0329/>;
    dc:modified '2025-04-16T16:56:50'^^xsd:dateTime ;
    skos:altLabel 'Waters'^^xsd:string ;
    skos:prefLabel 'Waters Corporation'@en ;
    skos:definition 'A US-based company founded in 1958. The main office is in Milford, Massachusetts, but it has offices worldwide. The company specialises in the development and manufacturing of chromatographs, mass spectrometers, and light scattering instruments.'@en ;
    skos:notation 'SDN:L35::MAN0329'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0328/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0328/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0328/>;
    dc:modified '2025-04-09T17:11:17'^^xsd:dateTime ;
    skos:altLabel 'Alseamar'^^xsd:string ;
    skos:prefLabel 'Alseamar Alcen'@en ;
    skos:definition 'A French subsidiary resulting from the merger of three companies in 2014. It brings together Alcen\'s naval and submarine activities, in the defense and security, energy prospecting and oceanography markets.'@en ;
    skos:notation 'SDN:L35::MAN0328'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0327/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0327/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0327/>;
    dc:modified '2025-03-25T11:31:53'^^xsd:dateTime ;
    skos:altLabel 'LECO'^^xsd:string ;
    skos:prefLabel 'LECO Corporation'@en ;
    skos:definition 'A US-based company with international offices all over the world, founded in 1936. Developer and manufacturer of elemental and thermal analysis equipment, mass spectrometers and chromatographs, metallography and optical equipment, and consumables.'@en ;
    skos:notation 'SDN:L35::MAN0327'^^xsd:string .
