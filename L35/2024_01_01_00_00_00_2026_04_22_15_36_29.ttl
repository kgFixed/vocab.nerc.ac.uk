    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0369/>;
    dc:modified '2025-11-11T11:47:33'^^xsd:dateTime ;
    skos:altLabel 'ASU BIOS'^^xsd:string ;
    skos:prefLabel 'Arizona State University Bermuda Institute of Ocean Sciences'@en ;
    skos:definition 'A US-based centre for ocean science, atmospheric research and environmental monitoring and mapping, founded in 1903. It is an incorporated 501(c)(3) not-for-profit marine research and education organisation and a Bermuda registered Charity #116.'@en ;
    skos:notation 'SDN:L35::MAN0369'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0368/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0368/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0368/>;
    dc:modified '2025-11-10T12:59:52'^^xsd:dateTime ;
    skos:altLabel 'Bruker'^^xsd:string ;
    skos:prefLabel 'Bruker Scientific Instruments'@en ;
    skos:definition 'A global manufacturer of high-performance scientific instruments and analytical solutions for molecular and materials research, industrial analysis, and clinical applications. Their technologies include mass spectrometry, Nuclear Magnetic Resonance (NMR), Fourier Transform Infrared Spectroscopy (FTIR), Raman spectroscopy, X-ray diffraction, and micro-CT imaging systems. It was founded in 1960 in Karlsruhe, Germany, and is now headquartered in Massachusetts, USA.'@en ;
    skos:notation 'SDN:L35::MAN0368'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0367/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0367/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0367/>;
    dc:modified '2025-10-24T12:50:26'^^xsd:dateTime ;
    skos:altLabel 'NBOSI'^^xsd:string ;
    skos:prefLabel 'Neil Brown Ocean Sensors Inc.'@en ;
    skos:definition 'A company based in Falmouth, Massachusetts, USA. Neil Brown developed the first salinity measuring device, the salinity/temperature/depth (STD), later called a conductivity/temperature/depth (CTD) device. The company now focuses on CTDs optimised for use on autonomous platforms.'@en ;
    skos:notation 'SDN:L35::MAN0367'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0348/2/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0348/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0348/>;
    dc:modified '2025-10-24T08:31:08'^^xsd:dateTime ;
    skos:altLabel 'SL'^^xsd:string ;
    skos:prefLabel 'SensorLab'@en ;
    skos:definition 'A small company established in 2011 specialising in the development of high-accuracy environmental instruments, with a particular focus on oceanographic research. Its product line includes precision pH sensors and low-power, high-stability spectrophotometric LED light sources. The company also provides customised instrumentation solutions tailored to specific customer requirements.'@en ;
    skos:notation 'SDN:L35::MAN0348'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0366/1/> .
