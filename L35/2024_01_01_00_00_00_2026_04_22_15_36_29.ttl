    skos:altLabel 'GE Healthcare'^^xsd:string ;
    skos:prefLabel 'General Electric Healthcare Technologies Inc.'@en ;
    skos:definition 'A US-based company established in 2023, headquartered in Chicago, Illinois. Formerly a subsidary of General Electric, GE Healthcare specialises in manufacturing and distributing medical technology.'@en ;
    skos:notation 'SDN:L35::MAN0293'^^xsd:string .
