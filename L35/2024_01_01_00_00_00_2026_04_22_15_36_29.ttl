    skos:altLabel 'OCEANINSTRUMENTS'^^xsd:string ;
    skos:prefLabel 'Ocean Instruments, Inc.'@en ;
    skos:definition 'A designer and manufacturer of sampling equipment including box coring and multi-coring equipment worldwide, specialising in custom design and manufacture of marine equipment, miscellaneous sampling devices, and associated hardware and housings. Founded in 1947.'@en ;
    skos:notation 'SDN:L35::MAN0275'^^xsd:string .
