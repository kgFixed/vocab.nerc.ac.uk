    skos:prefLabel 'In Situ Inc.'@en ;
    skos:definition 'A US-based company founded in 1976, headquartered in Fort Collins, Colorado, specialising in the development of water monitoring instrumentation and software.'@en ;
    skos:notation 'SDN:L35::MAN0308'^^xsd:string .
