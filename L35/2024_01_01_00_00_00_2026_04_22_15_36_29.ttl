    skos:prefLabel 'Deep Trekker'@en ;
    skos:definition 'A Canadian company established in 2010, headquartered in Kitchener, Ontario. Deep Trekker is a manufacturer and supplier of remotely operated vehicles (ROVs) for underwater monitoring.'@en ;
    skos:notation 'SDN:L35::MAN0284'^^xsd:string .
