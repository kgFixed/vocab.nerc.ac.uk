    skos:prefLabel 'Point Grey'@en ;
    skos:definition 'A Canadian company founded in 1997, headquartered in Richmond, British Columbia. Point Grey specialises in the design and manufacturing of digital cameras for industrial, scientific, medical, traffic, and security applications.'@en ;
    skos:notation 'SDN:L35::MAN0289'^^xsd:string .
