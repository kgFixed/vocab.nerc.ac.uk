    skos:altLabel 'UGA'^^xsd:string ;
    skos:prefLabel 'University of Georgia'@en ;
    skos:definition 'A public land-grant research university with its main campus in Athens, Georgia, United States. Chartered in 1785, it is one of the oldest public universities in the United States.'@en ;
    skos:notation 'SDN:L35::MAN0279'^^xsd:string .
