    skos:prefLabel 'Klein Marine Systems'@en ;
    skos:definition 'A US-based company founded in 1968, headquartered in Salem, New Hampshire. Klein specialises in the design and manufacturing of high resolution survey solutions for hydrographic and defense applications.'@en ;
    skos:notation 'SDN:L35::MAN0292'^^xsd:string .
