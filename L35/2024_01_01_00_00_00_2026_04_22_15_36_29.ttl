    skos:prefLabel 'Forssea Robotics'@en ;
    skos:definition 'A French manufacturer of fully integrated robotics systems that include subsea engineering, robotics and autonomy, and visual intelligence solutions. Founded in 2016.'@en ;
    skos:notation 'SDN:L35::MAN0285'^^xsd:string .
