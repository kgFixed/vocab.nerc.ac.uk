    skos:altLabel 'Amersham'^^xsd:string ;
    skos:prefLabel 'Amersham plc'@en ;
    skos:definition 'A UK-based company founded in 1946, headquartered in Amersham, Buckinghamshire, specialising in the manufacturing of medical technology. Amersham is now a part of General Electric Healthcare Technologies Inc. following acquisition in 2003. Medical technology is still produced by GE Healthcare under the brand name of Amersham.'@en ;
    skos:notation 'SDN:L35::MAN0294'^^xsd:string .
