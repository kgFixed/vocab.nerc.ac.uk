    skos:definition 'A US-based company founded in 1972, headquartered in Redmond, Washington, specialising in the manufacturing of high precision pressure instrumentation.'@en ;
    skos:notation 'SDN:L35::MAN0302'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0301/1/> .
