    skos:altLabel 'Bell Aerospace'^^xsd:string ;
    skos:prefLabel 'Bell Aerospace'@en ;
    skos:definition 'A US manufacturer of aerospace and defense technology, also known as the Bell Aircraft Corporation. Bell Aerospace was founded in 1935 and purchased in 1960 by Textron, and currently exists as Bell Textron.'@en ;
    skos:notation 'SDN:L35::MAN0295'^^xsd:string .
