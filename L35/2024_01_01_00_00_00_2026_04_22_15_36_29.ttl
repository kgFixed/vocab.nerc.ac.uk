    dc:modified '2024-08-14T16:55:17'^^xsd:dateTime ;
    skos:altLabel 'CTG'^^xsd:string ;
    skos:prefLabel 'Chelsea Technologies Group'@en ;
    skos:definition 'Chelsea Technologies Group (CTG) is a UK limited company specialising in a range of sensors and systems for the oceanographic, maritime, environmental, defence, homeland security, and industrial process control markets. CTG was formerly Chelsea Instruments Ltd until April 2007.'@en ;
    skos:notation 'SDN:L35::MAN0004'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0303/1/> .
