    skos:altLabel 'Xsens'^^xsd:string ;
    skos:prefLabel 'Xsens'@en ;
    skos:definition 'A company founded in 2000 in Enschede, Netherlands. Xsens is a supplier of 3D motion capture and inertial sensors. As of 2017, Xsens is now a brand of Movella, following Movella\'s (formerly mCube) acquisition of Xsens from ON Semiconductor in 2016.'@en ;
    skos:notation 'SDN:L35::MAN0315'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0314/1/> .
