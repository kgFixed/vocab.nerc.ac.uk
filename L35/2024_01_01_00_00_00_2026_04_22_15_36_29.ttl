    dc:modified '2024-08-14T11:19:02'^^xsd:dateTime ;
    skos:altLabel 'Franatech'^^xsd:string ;
    skos:prefLabel 'Franatech'@en ;
    skos:definition 'A company founded in 2006 in Oslo, Norway and now headquartered in Reppenstedt, Germany. Franatech specialises in the development, production, and supply of underwater sensors for dissolved gases.'@en ;
    skos:notation 'SDN:L35::MAN0303'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0241/2/> .
