    skos:altLabel 'NOBSKA'^^xsd:string ;
    skos:prefLabel 'NOBSKA Development Corporation'@en ;
    skos:definition 'A US-based company specialising in the design, manufacture, sale, and service of acoustic current meters. NOBSKA was formed to commercialise the development of Modular Acoustic Velocity Sensors (MAVS), previously developed using National Science Foundation support.'@en ;
    skos:notation 'SDN:L35::MAN0323'^^xsd:string .
