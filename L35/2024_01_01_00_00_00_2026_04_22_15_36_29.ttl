    skos:altLabel 'EPLAB'^^xsd:string ;
    skos:prefLabel 'Eppley Laboratory Inc.'@en ;
    skos:definition 'A US-based company that manufactures and supplies instruments for the measurement of solar and atmospheric irradiance. Founded in Newport, Rhode Island in the US in 1917.'@en ;
    skos:notation 'SDN:L35::MAN0277'^^xsd:string .
