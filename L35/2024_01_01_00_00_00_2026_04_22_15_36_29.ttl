    dc:modified '2024-07-04T16:43:46'^^xsd:dateTime ;
    skos:altLabel 'Dartcom'^^xsd:string ;
    skos:prefLabel 'Dartcom Systems Ltd.'@en ;
    skos:definition 'A British company specialised in the development, manufacture and integration of weather satellite and remote sensing ground stations. Products include specialised software for data ingestion, processing and display.'@en ;
    skos:notation 'SDN:L35::MAN0296'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0295/1/> .
