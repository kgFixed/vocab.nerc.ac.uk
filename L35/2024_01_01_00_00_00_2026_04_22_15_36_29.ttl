    skos:altLabel 'Europa Scientific'^^xsd:string ;
    skos:prefLabel 'Europa Scientific Limited'@en ;
    skos:definition 'A UK-based company founded in 1985 specialising in the manufacturing of isotope ratio analysis instrumentation. The rights to the Europa product line were bought by Sercon Ltd in 2004.'@en ;
    skos:notation 'SDN:L35::MAN0307'^^xsd:string .
