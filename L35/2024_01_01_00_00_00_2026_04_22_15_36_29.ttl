    skos:altLabel 'SMRU Instrumentation'^^xsd:string ;
    skos:prefLabel 'Sea Mammal Research Unit Instrumentation'@en ;
    skos:definition 'The instrumentation group of SMRU, a marine science research organisation based at the University of St Andrews. This manufacturer specialises in the design and manufacture of marine animal mounted telemetry tags.'@en ;
    skos:notation 'SDN:L35::MAN0318'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0316/1/> .
