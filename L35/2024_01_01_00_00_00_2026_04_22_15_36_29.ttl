    skos:altLabel 'NOSAMS'^^xsd:string ;
    skos:prefLabel 'National Ocean Sciences Accelerator Mass Spectrometry Facility (NOSAMS)'@en ;
    skos:definition 'A US-based facility founded at the Woods Hole Oceanographic Institute (WHOI) in 1989, headquartered in Woods Hole, Massachusetts, aimed with making radiocarbon measurements accessible to the ocean and earth sciences community, develop measurement capabilities, and serve as an educational and outreach source.'@en ;
    skos:notation 'SDN:L35::MAN0310'^^xsd:string .
