    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0211/>;
    dc:modified '2022-05-13T10:52:39'^^xsd:dateTime ;
    skos:altLabel 'Systea'^^xsd:string ;
    skos:prefLabel 'Systea S.p.A. Analytical Technologies'@en ;
    skos:definition 'An Italian-based company that develops, manufactures and sells automatic wet chemistry analysers for environmental and industrial markets. Founded in 1988, the company has additional offices in China, India and Germany.'@en ;
    skos:notation 'SDN:L35::MAN0211'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0210/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0210/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0210/>;
    dc:modified '2022-05-13T10:45:22'^^xsd:dateTime ;
    skos:altLabel 'Endress+Hauser'^^xsd:string ;
    skos:prefLabel 'Endress and Hauser Ltd'@en ;
    skos:definition 'A Swiss-based globally operating process and laboratory instrumentation and automation supplier. Founded in 1953 as L Hauser KG, it began operating as Endress+Hauser in 1957.'@en ;
    skos:notation 'SDN:L35::MAN0210'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0125/3/> .
