    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0206/>;
    dc:modified '2022-04-05T10:11:35'^^xsd:dateTime ;
    skos:altLabel 'PME'^^xsd:string ;
    skos:prefLabel 'Precision Measurement Engineering, Inc.'@en ;
    skos:definition 'A designer and manufacturer of reliable and accurate water monitoring systems and instruments for oceanographic and limnologic use, including instruments for high resolution measurement of electrical conductivity, temperature, dissolved oxygen, pressure, fluorescence, and PAR concentration in water. Founded in 1982.'@en ;
    skos:notation 'SDN:L35::MAN0206'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0205/1/> .
