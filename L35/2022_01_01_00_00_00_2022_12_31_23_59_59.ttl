    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0201/>;
    dc:modified '2022-02-15T15:55:35'^^xsd:dateTime ;
    skos:altLabel 'SKYE'^^xsd:string ;
    skos:prefLabel 'Skye Instruments Ltd.'@en ;
    skos:definition 'A designer and manufacturer of instrumentation for environmental monitoring, plant growth and agricultural research since 1983. The company started on the Isle of Skye, Scotland and re-located to Wales in 1986.'@en ;
    skos:notation 'SDN:L35::MAN0201'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0199/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0199/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0199/>;
    dc:modified '2022-02-15T15:11:52'^^xsd:dateTime ;
    skos:altLabel 'GEONICA'^^xsd:string ;
    skos:prefLabel 'Geonica'@en ;
    skos:definition 'A designer and manufacturer of remote ultra-low power dataloggers and data collection platforms for the acquisition and transmission of data and images, compatible with many sensors for the measurement of all types of meteorological, hydrological, physical and environmental parameters. Founded in 1974.'@en ;
    skos:notation 'SDN:L35::MAN0199'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0198/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0198/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0198/>;
    dc:modified '2022-02-04T13:52:43'^^xsd:dateTime ;
    skos:altLabel 'Hydro-Bios'^^xsd:string ;
    skos:prefLabel 'Hydro-Bios'@en ;
    skos:definition 'A German based developer and manufacturer of mechanical samplers for limnology and oceanography. Founded in 1927 as \'Walter Schweder Precision Engineering\', the company became \'HYDRO-BIOS Apparatebau GmbH\' in 1960. In 1963, Hans Fischer joined the company and the company re-located to Kiel-Altenholz.'@en ;
    skos:notation 'SDN:L35::MAN0198'^^xsd:string .
