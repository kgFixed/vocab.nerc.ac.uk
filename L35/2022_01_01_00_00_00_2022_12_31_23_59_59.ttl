    skos:altLabel 'Allied Vision'^^xsd:string ;
    skos:prefLabel 'Allied Vision Technologies'@en ;
    skos:definition 'A supplier and manufacturer of camera technology and image capture solutions for industrial inspection, medical and scientific imaging, traffic monitoring, among other applications. Founded in 1989 in Stadtroda, Germany, it is a subsidiary of TKH Technologie Deutschland AG.'@en ;
    skos:notation 'SDN:L35::MAN0243'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0242/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0242/1/>
    a skos:Concept ;
