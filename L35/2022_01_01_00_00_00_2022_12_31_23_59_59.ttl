    dc:modified '2022-03-22T14:20:42'^^xsd:dateTime ;
    skos:altLabel 'BD'^^xsd:string ;
    skos:prefLabel 'Becton, Dickinson and Company'@en ;
    skos:definition 'A medical technology company that originated in the United States in 1897. It is also known as BD or Becton Dickinson.'@en ;
    skos:notation 'SDN:L35::MAN0205'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0204/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0204/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0204/>;
    dc:modified '2022-03-14T10:29:45'^^xsd:dateTime ;
    skos:altLabel 'SOFAR'^^xsd:string ;
    skos:prefLabel 'Sofar Ocean Technologies'@en ;
    skos:definition 'A manufacturer of ocean sensing and exploration tools for ocean enthusiasts, industry, and conservation. The company was founded in 2016 and is based in San Francisco, California, United States.'@en ;
    skos:notation 'SDN:L35::MAN0204'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0203/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0203/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0203/>;
    dc:modified '2022-03-02T16:40:22'^^xsd:dateTime ;
    skos:altLabel 'SMC'^^xsd:string ;
    skos:prefLabel 'SMC Ship Motion Control'@en ;
    skos:definition 'Ship Motion Control (SMC) manufactures motion reference units for the marine and offshore oil and gas industry. The roll, pitch and heave motion reference units are used in dynamic positioning, active heave compensation, helideck monitoring system, and hydrographic applications. SMC also produces software systems for motion monitoring, helideck monitoring system and weather and met-ocean monitoring on-board offshore platforms and vessels. SMC was established in 2003 and is based out of Gzira, Malta.'@en ;
    skos:notation 'SDN:L35::MAN0203'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0202/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0202/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0202/>;
    dc:modified '2022-03-02T16:33:15'^^xsd:dateTime ;
    skos:altLabel 'SAAB'^^xsd:string ;
    skos:prefLabel 'Saab AB TransponderTech'@en ;
    skos:definition 'A Swedish designer and manufacturer of commercial radio and software products for civil and military customers within the maritime industry, part of the Saab AB group founded in 1937. Saab AB TransponderTech is located in Hackefors, Linkoping.'@en ;
    skos:notation 'SDN:L35::MAN0202'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0201/1/> .
