    dc:modified '2022-04-12T09:31:40'^^xsd:dateTime ;
    skos:altLabel 'CERB'^^xsd:string ;
    skos:prefLabel 'Carlo Erba'@en ;
    skos:definition 'A company that manufactured elemental analysers. Now CE Instruments, part of ThermoFisher.'@en ;
    skos:notation 'SDN:L35::MAN0208'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0207/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0207/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0207/>;
    dc:modified '2022-04-07T12:43:54'^^xsd:dateTime ;
    skos:altLabel 'InnovaSea'^^xsd:string ;
    skos:prefLabel 'InnovaSea Systems Inc.'@en ;
    skos:definition 'A US-based company with offices worldwide, specialising in the design, manufacture and distribution of tracking and telemetry systems for use in aquatic ecosystems. Founded in 2014, InnovaSea acquired Vemco and HTI in 2019.'@en ;
    skos:notation 'SDN:L35::MAN0207'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0206/1/> .
