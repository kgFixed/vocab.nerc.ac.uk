    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0125/>;
    dc:modified '2022-04-27T16:58:54'^^xsd:dateTime ;
    skos:altLabel 'THALES'^^xsd:string ;
    skos:prefLabel 'Thales Group'@en ;
    skos:definition 'A french multinational company that designs and builds electrical systems, providing services for the aerospace, defence, security, and transportation industries. The company is headquartered in Paris, and was founded in 2000.'@en ;
    skos:notation 'SDN:L35::MAN0125'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0209/2/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0209/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0209/>;
    dc:modified '2022-04-21T16:19:32'^^xsd:dateTime ;
    skos:altLabel 'ELAC NAUTIK'^^xsd:string ;
    skos:prefLabel 'L-3 Communications ELAC Nautik GmbH'@en ;
    skos:definition 'A German company based in Kiel that specialised in the development and production of hydroacoustic systems, including sonar systems, echosounders and underwater communication systems with military and commercial applications. L-3 ELAC Nautik was the result of the acquisition of AlliedSignal ELAC Nautik GmbH by L-3 Communications in 1998. L-3 Communications ELAC Nautik GmbH persisted until 2015 when it was sold to Wärtsillä to become Wärtsillä ELAC Nautik GmbH, which was then sold again in 2020 to Cohort plc and renamed ELAC SONAR.'@en ;
    skos:notation 'SDN:L35::MAN0209'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0118/5/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0118/5/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0118/>;
    dc:modified '2022-04-21T16:04:05'^^xsd:dateTime ;
    skos:altLabel 'WÄRTSILLÄ'^^xsd:string ;
    skos:prefLabel 'Wärtsillä ELAC Nautik GmbH'@en ;
    skos:definition 'A German company owned by the Finnish corporation Wärtsillä following their acquisition of ELAC Nautik from L-3 Communications in 2015. Wärtsillä ELAC Nautik specialised in hydroacoustic systems for naval, hydrographic and commercial applications. Founded in 1926 as ELAC (Electroacustic GmbH).'@en ;
    skos:notation 'SDN:L35::MAN0118'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0208/1/> .
