    dc:modified '2022-11-15T11:02:39'^^xsd:dateTime ;
    skos:altLabel 'Marine Microsystems'^^xsd:string ;
    skos:prefLabel 'Marine Microsystems Ltd.'@en ;
    skos:definition 'Manufacturer and designer of marine equipment, known for the creation of a seabed classifier instrument, RoxAnn. Founded in 1987 and dissolved in 1999.'@en ;
    skos:notation 'SDN:L35::MAN0242'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0240/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0240/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0240/>;
    dc:modified '2022-10-31T15:04:56'^^xsd:dateTime ;
    skos:altLabel 'MICROS'^^xsd:string ;
    skos:prefLabel 'Microsemi'@en ;
    skos:definition 'A US provider of semiconductor and system solutions for aerospace and defence, communications, data centre and industrial markets, founded in 1959. It acquired Symmetricom in 2013. It was itself acquired in 2018 by Microchip.'@en ;
    skos:notation 'SDN:L35::MAN0240'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0239/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0239/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0239/>;
    dc:modified '2022-10-26T16:34:01'^^xsd:dateTime ;
    skos:altLabel 'TF'^^xsd:string ;
    skos:prefLabel 'Theodor Friedrichs & Co. Meteorologische Geräte und Systeme GmbH'@en ;
    skos:definition 'A German company which specialises in the design and manufacture of meteorological sensors and systems, and test equipment for meteorological sensor calibration. The company was founded in 1953 in Schenefeld near Hamburg. In March 2022 parts of the company were taken over by the company METEK Meteorologische Messetechnik GmbH.'@en ;
    skos:notation 'SDN:L35::MAN0239'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0238/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0238/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0238/>;
    dc:modified '2022-10-14T10:05:39'^^xsd:dateTime ;
    skos:altLabel 'Mettler Toledo'^^xsd:string ;
    skos:prefLabel 'Mettler Toledo Inc.'@en ;
    skos:definition 'A global company, headquartered in Greifensee, Switzerland that manufactures precision instruments for use in laboratory, industrial, and food retailing applications. Founded as Mettler Toledo Inc. in 1992.'@en ;
    skos:notation 'SDN:L35::MAN0238'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0237/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0237/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0237/>;
    dc:modified '2022-10-12T12:09:23'^^xsd:dateTime ;
    skos:altLabel 'Magnavox'^^xsd:string ;
    skos:prefLabel 'Magnavox Advanced Products and Systems Company'@en ;
    skos:definition 'A USA manufacturer founded in 1984, specialised in satellite navigation systems and military communication systems. The company was owned by Philips Electronics, and is no longer active.'@en ;
    skos:notation 'SDN:L35::MAN0237'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0236/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0236/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0236/>;
    dc:modified '2022-10-11T16:24:39'^^xsd:dateTime ;
    skos:altLabel 'Shipmate'^^xsd:string ;
    skos:prefLabel 'Shipmate (Rauff & Sorensen A/S)'@en ;
    skos:definition 'A Danish manufacturer founded in Stovring, Denmark in 1979, specialised in development and manufacturing of maritime communication and navigation equipment. Shipmate was acquired by Norwegian Simrad in 1994, after which all products were marketed under SIMRAD Shipmate. In 1996, SIMRAD was acquired by the large Norwegian Kongsberg group and then in 2005 went to Navico. Navico stopped all activities in Stovring in 2007.'@en ;
    skos:notation 'SDN:L35::MAN0236'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0235/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0235/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0235/>;
    dc:modified '2022-10-11T16:08:21'^^xsd:dateTime ;
    skos:altLabel 'Navstar S.A.'^^xsd:string ;
    skos:prefLabel 'Navstar S.A.'@en ;
    skos:definition 'A Swiss sales distributor owned by Polytechnic Marine. Polytechnic Marine were a small company owned by a UK military electronics company called Smiths PLC. Navstar S.A. appears to have been dissolved in 2008.'@en ;
    skos:notation 'SDN:L35::MAN0235'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0234/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0234/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0234/>;
    dc:modified '2022-10-11T15:52:55'^^xsd:dateTime ;
    skos:altLabel 'TCL'^^xsd:string ;
    skos:prefLabel 'Thies Clima'@en ;
    skos:definition 'A German company specialising in the development and supply of meteorological and other environmental measuring technology, for the weather forecasting and agricultural sectors, as well for air travel and the emergency services. Founded in 1945.'@en ;
    skos:notation 'SDN:L35::MAN0234'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0233/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0233/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0233/>;
    dc:modified '2022-09-30T10:38:19'^^xsd:dateTime ;
    skos:altLabel 'ICES'^^xsd:string ;
    skos:prefLabel 'ICES'@en ;
    skos:definition 'The International Coucil for Exploration of the Sea is a regional fishery advisory body and the world\'s oldest intergovernmental science organisation. ICES is headquartered in Copenhagen, Denmark, where its multinational secretariat staff of 51 provide scientific, administrative and secretarial support to the ICES community. It was established in 1902 in Copenhagen.'@en ;
    skos:notation 'SDN:L35::MAN0233'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0232/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0232/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0232/>;
    dc:modified '2022-09-30T10:09:42'^^xsd:dateTime ;
    skos:altLabel 'IFREMER'^^xsd:string ;
    skos:prefLabel 'Ifremer'@en ;
    skos:definition 'The French Research Institute for Exploitation of the Sea, Ifremer is a marine research and technology institution based in Brest, France. Founded in 1984.'@en ;
    skos:notation 'SDN:L35::MAN0232'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0231/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0231/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0231/>;
    dc:modified '2022-09-27T16:15:58'^^xsd:dateTime ;
    skos:altLabel 'AEROSOL'^^xsd:string ;
    skos:prefLabel 'Aerosol Co.'@en ;
    skos:definition 'A developer and manufacturer of scientific instrumentation for monitoring carbonaceous aerosols in the air. It is based in Ljubljana, Slovenia and founded in 2007 by the company Magee Scientific.'@en ;
    skos:notation 'SDN:L35::MAN0231'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0230/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0230/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0230/>;
    dc:modified '2022-09-27T10:15:32'^^xsd:dateTime ;
    skos:altLabel 'VARIAN'^^xsd:string ;
    skos:prefLabel 'Varian Inc.'@en ;
    skos:definition 'A manufacturer of scientific instruments for the scientific industry particularly chemical analysis equipment, with a focus on Information Rich Detection and Vacuum technology. It was founded in 1999 and purchased by Agilent Technologies in May 2010.'@en ;
    skos:notation 'SDN:L35::MAN0230'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0229/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0229/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0229/>;
    dc:modified '2022-09-27T10:09:31'^^xsd:dateTime ;
    skos:altLabel 'CARTHE'^^xsd:string ;
    skos:prefLabel 'Consortium for Advanced Research on Transport of Hydrocarbon in the Environment'@en ;
    skos:definition 'A collaboration of over forty scientific researchers, postdocs, students and administrative staff from fourteen universities and research institutions. Funded by the Gulf of Mexico Research Initiative (GoMRI), CARTHE\'s scientific work is based on one of GoMRI\'s intellectual themes and focuses on the physical distribution, dispersion and dilution of petroleum, its constituents and associated contaminants under the action of physical oceanographic processes, air-sea interactions and tropical storms.'@en ;
    skos:notation 'SDN:L35::MAN0229'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0228/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0228/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0228/>;
    dc:modified '2022-09-27T09:57:31'^^xsd:dateTime ;
    skos:altLabel 'OCEANSCIENCE'^^xsd:string ;
    skos:prefLabel 'Teledyne Oceanscience'@en ;
    skos:definition 'A Teledyne Marine brand that designs and manufactures marine sensor platforms and unmanned surface vehicles. It was founded in 1998 as The Oceanscience Group Ltd. which was acquired by Teledyne in October 2014.'@en ;
    skos:notation 'SDN:L35::MAN0228'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0227/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0227/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0227/>;
    dc:modified '2022-09-26T15:40:07'^^xsd:dateTime ;
    skos:altLabel 'PERKE'^^xsd:string ;
    skos:prefLabel 'PerkinElmer'@en ;
    skos:definition 'A company focused on analytical instruments, lab technologies, diagnostic testing, laboratory services, informatics and cord blood banking. It was founded in 1937 by Richard Perkin and Charles Elmer in Manhattan, US.'@en ;
    skos:notation 'SDN:L35::MAN0227'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0226/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0226/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0226/>;
    dc:modified '2022-09-26T15:39:28'^^xsd:dateTime ;
    skos:altLabel 'PKBIO'^^xsd:string ;
    skos:prefLabel 'Packard Bioscience'@en ;
    skos:definition 'A company that develops, manufactures and markets instruments and related consumables and services for use in drug discovery and other life sciences research, such as basic human disease research, genetic analysis and biotechnology. It was acquired by PerkinElmer in 2003.'@en ;
    skos:notation 'SDN:L35::MAN0226'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0225/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0225/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0225/>;
    dc:modified '2022-09-14T17:14:37'^^xsd:dateTime ;
    skos:altLabel 'Knudsen'^^xsd:string ;
    skos:prefLabel 'Knudsen Engineering Limited'@en ;
    skos:definition 'A Canadian company that specialises in the design and manufacturing of echosounders for hydrographic survey and mapping, pre/post dredging survey, ship navigation, oceanographic research, and sub-bottom profiling of the sea bottom sediment layers. It was founded in 1981.'@en ;
    skos:notation 'SDN:L35::MAN0225'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0224/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0224/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0224/>;
    dc:modified '2022-09-13T10:21:59'^^xsd:dateTime ;
    skos:altLabel 'PAL'^^xsd:string ;
    skos:prefLabel 'Plankton Analytics'@en ;
    skos:definition 'A UK-based company specialising in the production of high-speed imaging and analysis instruments that photograph plankton in the size range 100 micron to 20 mm in water.'@en ;
    skos:notation 'SDN:L35::MAN0224'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0223/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0223/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0223/>;
    dc:modified '2022-08-30T18:42:42'^^xsd:dateTime ;
    skos:altLabel 'Consilium'^^xsd:string ;
    skos:prefLabel 'Consilium Marine and Safety AB'@en ;
    skos:definition 'A Swedish company established in 1912 specialising in the design and manufacturing of speed loggers. The marine and safety business area of the company was created in 2009. Consilium Marine and Safety AB now specialises in fire and gas detection, safety management and environmental monitoring systems for marine vessels.'@en ;
    skos:notation 'SDN:L35::MAN0223'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0222/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0222/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0222/>;
    dc:modified '2022-08-30T16:20:03'^^xsd:dateTime ;
    skos:altLabel 'TSS UK'^^xsd:string ;
    skos:prefLabel 'TSS (UK) Ltd.'@en ;
    skos:definition 'A UK-based company that specialised in motion sensor and subsea pipe/cable tracking. In 2000, TSS was merged with S G Brown Ltd. by their parent company, Vosper Thornycroft, to form VT TSS International. This company was later purchased by the Teledyne group in 2008 to form Teledyne TSS.'@en ;
    skos:notation 'SDN:L35::MAN0222'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0221/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0221/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0221/>;
    dc:modified '2022-08-12T14:31:10'^^xsd:dateTime ;
    skos:altLabel 'FT Technologies'^^xsd:string ;
    skos:prefLabel 'FT Technologies'@en ;
    skos:definition 'A UK-based company that designs and manufactures ultrasonic anemometers (wind sensors) for professional markets, principally the offshore wind turbine industry. Founded in 1981.'@en ;
    skos:notation 'SDN:L35::MAN0221'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0219/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0219/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0219/>;
    dc:modified '2022-08-04T16:27:39'^^xsd:dateTime ;
    skos:altLabel 'Biral'^^xsd:string ;
    skos:prefLabel 'Bristol Industrial and Research Associates'@en ;
    skos:definition 'A UK-based company that designs, manufactures and distributes high quality meteorological sensors for professional markets, including aviation, offshore platforms and wind energy. Founded in 1975.'@en ;
    skos:notation 'SDN:L35::MAN0219'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0220/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0220/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0220/>;
    dc:modified '2022-08-04T16:27:39'^^xsd:dateTime ;
    skos:altLabel 'Observator'^^xsd:string ;
    skos:prefLabel 'Observator Instruments'@en ;
    skos:definition 'Part of the Observator Group founded in the Netherlands in 1924, Observator Instruments is the US-based meteorological and hydrological division, responsible for the development of the Obsermet product line (anemometers, rain gauges, data loggers, displays, etc.). The division was founded in Santa Ana, California in 1985.'@en ;
    skos:notation 'SDN:L35::MAN0220'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0218/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0218/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0218/>;
    dc:modified '2022-08-04T16:27:39'^^xsd:dateTime ;
    skos:altLabel 'Safran'^^xsd:string ;
    skos:prefLabel 'Safran Electronics and Defense, Malakoff'@en ;
    skos:definition 'An international high-technology group, that designs, develops and manufactures aircraft engines, rocket engines as well as various aerospace and defense-related equipment and their components. It was formed by a merger between SNECMA and the defense electronics specialist SAGEM in 2005. Headquarters are based in Paris, France.'@en ;
    skos:notation 'SDN:L35::MAN0218'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0217/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0217/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0217/>;
    dc:modified '2022-08-02T16:16:06'^^xsd:dateTime ;
    skos:altLabel 'Plessey'^^xsd:string ;
    skos:prefLabel 'Plessey Environmental Systems'@en ;
    skos:definition 'A UK-based electronics, defence and communications company founded in 1917 as The Plessey Company. The company developed many specialist sub-divisions with many overseas bases. The San Diego division later became Plessey Environmental Systems, which was bought out by Grundy in 1980.'@en ;
    skos:notation 'SDN:L35::MAN0217'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0216/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0216/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0216/>;
    dc:modified '2022-06-27T16:26:56'^^xsd:dateTime ;
    skos:altLabel 'Meinsberg'^^xsd:string ;
    skos:prefLabel 'Sensortechnik Meinsberg'@en ;
    skos:definition 'A developer and manufacturer of a wide range of electrochemical sensors for use in industry, water management and laboratory analysis. Sensortechnik Meinsberg GmbH emerged in 1990 from the production area of Meinsberg research institute which was founded in 1945. Nova Analytics took over Sensortechnik Meinsberg GmbH in 2006, which was then integrated into ITT Analytics in 2010. In 2011, the Fluid Technology division of the ITT Group, to which Sensortechnik Meinsberg GmbH belongs, became the independent, listed company Xylem. Since 2016, Sensortechnik Meinsberg operates as Xylem Analytics Germany Sales GmbH and Co. KG.'@en ;
    skos:notation 'SDN:L35::MAN0216'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0215/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0215/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0215/>;
    dc:modified '2022-06-06T18:58:57'^^xsd:dateTime ;
    skos:altLabel 'NORBIT'^^xsd:string ;
    skos:prefLabel 'NORBIT Subsea'@en ;
    skos:definition 'A Norwegian company founded in 1995, headquartered in Trondheim. NORBIT Subsea specialise in the supply of underwater instrumentation and communication solutions, in particular wide-band multibeam sonar.'@en ;
    skos:notation 'SDN:L35::MAN0215'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0214/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0214/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0214/>;
    dc:modified '2022-06-06T17:36:27'^^xsd:dateTime ;
    skos:altLabel 'APS'^^xsd:string ;
    skos:prefLabel 'Applied Physics Systems'@en ;
    skos:definition 'An American company headquartered in California, originating in 1976. Applied Physics Systems specialises in the design and manufacture of high-performance magnetometers, directional and gamma sensors and complete Measurement While Drilling (MWD) systems, primarily for use in the oil and gas industry, horizontal directional drilling (HDD) and other scientific applications.'@en ;
    skos:notation 'SDN:L35::MAN0214'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0213/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0213/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0213/>;
    dc:modified '2022-05-25T15:38:08'^^xsd:dateTime ;
    skos:altLabel 'Avantes'^^xsd:string ;
    skos:prefLabel 'Avantes B.V.'@en ;
    skos:definition 'Avantes is a manufacturing company based in the Netherlands that specialises in instruments for spectroscopy and fibre optic applications. They have direct offices in the USA and China, and distributors in 35 countries. Founded in 1994.'@en ;
    skos:notation 'SDN:L35::MAN0213'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0212/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0212/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0212/>;
    dc:modified '2022-05-17T12:03:27'^^xsd:dateTime ;
    skos:altLabel 'TriOS'^^xsd:string ;
    skos:prefLabel 'TriOS Mess- und Datentechnik GmbH'@en ;
    skos:definition 'A German company based in Rastede, originating in 1998 as a spin-off from the University of Oldenburg. TriOS specialises in the design and manufacture of instruments for radiometric and fluorometric water analysis.'@en ;
    skos:notation 'SDN:L35::MAN0212'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0211/1/> .
