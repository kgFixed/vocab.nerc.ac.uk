    skos:altLabel 'AXIS'^^xsd:string ;
    skos:prefLabel 'Axis Communications'@en ;
    skos:definition 'A Swedish manufacturer of network cameras, access control, and network audio devices for the physical security and video surveillance industries. Founded in 1983.'@en ;
    skos:notation 'SDN:L35::MAN0244'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0243/1/> .
