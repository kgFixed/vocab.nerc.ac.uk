<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0058/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0058/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0058/>;
    dc:modified '2019-12-10T09:01:41'^^xsd:dateTime ;
    skos:altLabel 'UMBSM'^^xsd:string ;
    skos:prefLabel 'University Marine Biological Station Millport'@en ;
    skos:definition 'The University Marine Biological Station Millport (UMBSM) was a higher education institution located on the island of Great Cumbrae in the Firth of Clyde, Scotland, and run by the University of London. It closed in 2013 and is now the Millport Field Centre, run by the Field Studies Council.'@en ;
    skos:notation 'SDN:L35::MAN0058'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0057/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0057/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0057/>;
    dc:modified '2019-12-06T11:08:17'^^xsd:dateTime ;
    skos:altLabel 'SEQ'^^xsd:string ;
    skos:prefLabel 'Sequoia Scientific'@en ;
    skos:definition 'A manufacturing company in the United States which specialises in technologies for submersible and field measurements of particles and particle size distributions that was founded in 1995. The company is particularly notable for using laser diffraction technology, producing the LISST (Laser In-Situ Scattering and Transmissometry) series of measuring devices.'@en ;
    skos:notation 'SDN:L35::MAN0057'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0055/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0055/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L35/current/MAN0055/>;
    dc:modified '2019-10-18T08:31:46'^^xsd:dateTime ;
    skos:altLabel 'CODAR'^^xsd:string ;
    skos:prefLabel 'CODAR'@en ;
    skos:definition 'A company based in Mountain View, California that conducts research , design, manufacturing and support of high frequency (HF) radar systems primarily for ocean current and wave monitoring. Founded in 1984.'@en ;
    skos:notation 'SDN:L35::MAN0055'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L35/current/MAN0056/1/> .
<http://vocab.nerc.ac.uk/collection/L35/current/MAN0056/1/>
