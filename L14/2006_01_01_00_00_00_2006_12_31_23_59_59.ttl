@prefix tree: <https://w3id.org/tree#> .
@prefix ldes: <https://w3id.org/ldes#> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

@base <https://kgfixed.github.io/vocab.nerc.ac.uk/L14/2006_01_01_00_00_00_2006_12_31_23_59_59.ttl> .

<>
    a tree:Node
     .

<feed>
  a ldes:EventStream ;
  ldes:timestampPath dc:modified ;
  ldes:versionOfPath dc:isVersionOf ;
  
  
  tree:shape [
    a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path dc:isVersionOf
    ],
    [
      sh:datatype xsd:dateTime ;
      sh:minCount 1 ;
      sh:path dc:modified
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:altLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:prefLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:definition
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:notation
    ];
    sh:targetClass skos:Concept
  ] ;
  tree:view <> ;
  .

<feed> tree:member <http://vocab.nerc.ac.uk/collection/L14/current/ON/1/> .
<http://vocab.nerc.ac.uk/collection/L14/current/ON/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L14/current/ON/>;
    dc:modified '2006-08-18T14:33:02'^^xsd:dateTime ;
    skos:altLabel 'operational'^^xsd:string ;
    skos:prefLabel 'operational'@en ;
    skos:definition 'The activity is operational with no date specified for operations to cease.'@en ;
    skos:notation 'SDN:L14::ON'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L14/current/OR/1/> .
<http://vocab.nerc.ac.uk/collection/L14/current/OR/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L14/current/OR/>;
    dc:modified '2006-08-18T14:33:02'^^xsd:dateTime ;
    skos:altLabel 'operational2suspended'^^xsd:string ;
    skos:prefLabel 'operational becoming suspended'@en ;
    skos:definition 'The activity is operational but a date is known when operations will cease.  The intention is that operations will resume after a period of inactivity.'@en ;
    skos:notation 'SDN:L14::OR'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L14/current/OP/1/> .
<http://vocab.nerc.ac.uk/collection/L14/current/OP/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L14/current/OP/>;
    dc:modified '2006-08-18T14:33:02'^^xsd:dateTime ;
    skos:altLabel 'operational2terminated'^^xsd:string ;
    skos:prefLabel 'operational becoming terminated'@en ;
    skos:definition 'The activity is operational but a date is known when operations will cease permanently.'@en ;
    skos:notation 'SDN:L14::OP'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L14/current/PO/1/> .
<http://vocab.nerc.ac.uk/collection/L14/current/PO/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L14/current/PO/>;
    dc:modified '2006-08-18T14:33:02'^^xsd:dateTime ;
    skos:altLabel 'pre-operational'^^xsd:string ;
    skos:prefLabel 'pre-operational'@en ;
    skos:definition 'The activity is under development and not yet in operational use.'@en ;
    skos:notation 'SDN:L14::PO'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L14/current/IA/1/> .
<http://vocab.nerc.ac.uk/collection/L14/current/IA/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L14/current/IA/>;
    dc:modified '2006-08-18T14:33:02'^^xsd:dateTime ;
    skos:altLabel 'terminated'^^xsd:string ;
    skos:prefLabel 'terminated'@en ;
    skos:definition 'The activity is non-operational with no planned resumption of operation.'@en ;
    skos:notation 'SDN:L14::IA'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L14/current/ZZ/1/> .
<http://vocab.nerc.ac.uk/collection/L14/current/ZZ/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L14/current/ZZ/>;
    dc:modified '2006-08-18T14:33:02'^^xsd:dateTime ;
    skos:altLabel 'unknown'^^xsd:string ;
    skos:prefLabel 'unknown'@en ;
    skos:definition 'The status of the activity is not known and not computable by the sender of this data.'@en ;
    skos:notation 'SDN:L14::ZZ'^^xsd:string .
