<feed> tree:member <http://vocab.nerc.ac.uk/collection/M10/current/11/2/> .
<http://vocab.nerc.ac.uk/collection/M10/current/11/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/M10/current/11/>;
    dc:modified '2025-01-06T09:56:19'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Behavioral observation methods'@en ;
    skos:definition 'Elicit values information through observations of behavioural responses by individuals interacting with either actual or computer-simulated environments.'@en ;
