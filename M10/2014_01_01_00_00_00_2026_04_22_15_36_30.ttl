<feed> tree:member <http://vocab.nerc.ac.uk/collection/M10/current/14/2/> .
<http://vocab.nerc.ac.uk/collection/M10/current/14/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/M10/current/14/>;
    dc:modified '2025-01-06T09:56:19'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Averting-behaviour method'@en ;
    skos:definition 'Uses observations on how much people spend to avoid adverse effects, including environmental effects to infer how much they value or are willing to pay for the improvements those expenditures yield. A revealed preference method.'@en ;
    skos:notation 'SDN:M10::14'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/M10/current/25/2/> .
<http://vocab.nerc.ac.uk/collection/M10/current/25/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/M10/current/25/>;
    dc:modified '2025-01-06T09:56:19'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Companion modelling for common pool resources'@en ;
    skos:definition 'Crosses ecosystem benefit indicators, economic methods (CORMAS software, http://cormas.cirad.fr/ComMod/) and decision science valuation methods. The companion modelling approach is a collective learning process that takes place in the interaction between the stakeholders and the models they build together. The implementation of such processes requires to take into account multiple skills and multiple point of view. modelling is used to clarify and formalise the values and to simulate the evolution of the ecosystem studied.'@en ;
    skos:notation 'SDN:M10::25'^^xsd:string .
