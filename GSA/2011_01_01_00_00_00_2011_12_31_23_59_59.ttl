@prefix tree: <https://w3id.org/tree#> .
@prefix ldes: <https://w3id.org/ldes#> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

@base <https://kgfixed.github.io/vocab.nerc.ac.uk/GSA/2011_01_01_00_00_00_2011_12_31_23_59_59.ttl> .

<>
    a tree:Node
     .

<feed>
  a ldes:EventStream ;
  ldes:timestampPath dc:modified ;
  ldes:versionOfPath dc:isVersionOf ;
  
  
  tree:shape [
    a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path dc:isVersionOf
    ],
    [
      sh:datatype xsd:dateTime ;
      sh:minCount 1 ;
      sh:path dc:modified
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:altLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:prefLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:definition
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:notation
    ];
    sh:targetClass skos:Concept
  ] ;
  tree:view <> ;
  .

<feed> tree:member <http://vocab.nerc.ac.uk/collection/GSA/current/FLDM/1/> .
<http://vocab.nerc.ac.uk/collection/GSA/current/FLDM/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/GSA/current/FLDM/>;
    dc:modified '2011-01-28T12:26:26'^^xsd:dateTime ;
    skos:altLabel 'FieldDataMultiFold'^^xsd:string ;
    skos:prefLabel 'Field data: multi-fold'@en ;
    skos:definition 'Multi-fold seismic data ready to be processed. These should adhere to D4.5 specifications: mainly that they should already be demultiplexed and converted to SEG-Y format, but should not have undergone any processing algorithm  yet.'@en ;
    skos:notation 'SDN:GSA::FLDM'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/GSA/current/FLDS/1/> .
<http://vocab.nerc.ac.uk/collection/GSA/current/FLDS/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/GSA/current/FLDS/>;
    dc:modified '2011-01-28T12:26:26'^^xsd:dateTime ;
    skos:altLabel 'FieldDataSingleFold'^^xsd:string ;
    skos:prefLabel 'Field data: single-fold continuous profile'@en ;
    skos:definition 'Single-fold seismic data ready to be processed. These should adhere to GeoSeas D4.5 deliverable specifications, but should not have undergone any processing algorithm  yet.'@en ;
    skos:notation 'SDN:GSA::FLDS'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/GSA/current/MIGR/1/> .
<http://vocab.nerc.ac.uk/collection/GSA/current/MIGR/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/GSA/current/MIGR/>;
    dc:modified '2011-01-28T12:26:26'^^xsd:dateTime ;
    skos:altLabel 'Migrated'^^xsd:string ;
    skos:prefLabel 'Migrated'@en ;
    skos:definition 'Seismic data that have undergone a migration process to improve spatial resolution.'@en ;
    skos:notation 'SDN:GSA::MIGR'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/GSA/current/OTHR/1/> .
<http://vocab.nerc.ac.uk/collection/GSA/current/OTHR/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/GSA/current/OTHR/>;
    dc:modified '2011-01-28T12:26:26'^^xsd:dateTime ;
    skos:altLabel 'Other'^^xsd:string ;
    skos:prefLabel 'Other'@en ;
    skos:definition 'Seismic data that have undergone processing algorithms that do not fall within the other cases. Processing needs to be documented'@en ;
    skos:notation 'SDN:GSA::OTHR'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/GSA/current/PRSS/1/> .
<http://vocab.nerc.ac.uk/collection/GSA/current/PRSS/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/GSA/current/PRSS/>;
    dc:modified '2011-01-28T12:26:26'^^xsd:dateTime ;
    skos:altLabel 'ProcSingleFold'^^xsd:string ;
    skos:prefLabel 'Processed: single-fold continuous profile'@en ;
    skos:definition 'Single-fold seismic data that have undergone processing as gain recovery, filtering, noise reduction, muting, wavelet processing.'@en ;
    skos:notation 'SDN:GSA::PRSS'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/GSA/current/PRSM/1/> .
<http://vocab.nerc.ac.uk/collection/GSA/current/PRSM/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/GSA/current/PRSM/>;
    dc:modified '2011-01-28T12:26:26'^^xsd:dateTime ;
    skos:altLabel 'ProcessedMultiFold'^^xsd:string ;
    skos:prefLabel 'Processed: multi-fold'@en ;
    skos:definition 'Multi-fold seismic data that have undergone processing as gain recovery, filtering, noise reduction, muting, wavelet processing, but should not have undergone stacking algorithm  yet.'@en ;
    skos:notation 'SDN:GSA::PRSM'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/GSA/current/STAK/1/> .
<http://vocab.nerc.ac.uk/collection/GSA/current/STAK/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/GSA/current/STAK/>;
    dc:modified '2011-01-28T12:26:26'^^xsd:dateTime ;
    skos:altLabel 'Stacked'^^xsd:string ;
    skos:prefLabel 'Stacked'@en ;
    skos:definition 'Processed mutli-fold seismic data that have undergone trace summation within CMP and therefore result in zero offset stacked sections.'@en ;
    skos:notation 'SDN:GSA::STAK'^^xsd:string .
