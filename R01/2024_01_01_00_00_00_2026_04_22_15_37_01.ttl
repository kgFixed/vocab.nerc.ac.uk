    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/R01/current/BTRAJ/>;
    dc:modified '2024-09-12T10:07:08'^^xsd:dateTime ;
    skos:altLabel 'BTRAJ'^^xsd:string ;
    skos:prefLabel 'B-Argo trajectory'@en ;
    skos:definition 'Argo float trajectory file containing CTD pressure data and data from one or more biogeochemical (BGC) parameters (dissolved oxygen, nitrate, pH, chlorophyll-a, particle backscatter, irradiance).'@en ;
