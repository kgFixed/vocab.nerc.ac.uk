    dc:modified '2020-04-04T16:03:12'^^xsd:dateTime ;
    skos:altLabel 'MPROF'^^xsd:string ;
    skos:prefLabel 'Argo profile merged'@en ;
    skos:definition 'Argo float vertical profile file containing CTD sensors data (pressure, temperature, conductivity, salinity) and data from one or more biogeochemical (BGC) parameters (dissolved oxygen, nitrate, pH, chlorophyll-a, particle backscatter, irradiance), retaining all vertical sampling schemes.'@en ;
    skos:notation 'SDN:R01::MPROF'^^xsd:string .
