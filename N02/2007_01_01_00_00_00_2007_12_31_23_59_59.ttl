    skos:altLabel 'NumSim'^^xsd:string ;
    skos:prefLabel 'NumSim model description'@en ;
    skos:definition 'NumSim documents consist of one or both of two elements:  (1) An XML description of a model codebase including the model components, and (2) a description of the use of that codebase in an experiment (includes initial and  boundary conditions, and ensemble membership, if any).'@en ;
    skos:notation 'SDN:N02::12'^^xsd:string .
