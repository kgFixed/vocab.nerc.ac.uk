@prefix tree: <https://w3id.org/tree#> .
@prefix ldes: <https://w3id.org/ldes#> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

@base <https://kgfixed.github.io/vocab.nerc.ac.uk/L03/2006_01_01_00_00_00_2006_12_31_23_59_59.ttl> .

<>
    a tree:Node
     .

<feed>
  a ldes:EventStream ;
  ldes:timestampPath dc:modified ;
  ldes:versionOfPath dc:isVersionOf ;
  
  
  tree:shape [
    a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path dc:isVersionOf
    ],
    [
      sh:datatype xsd:dateTime ;
      sh:minCount 1 ;
      sh:path dc:modified
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:altLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:prefLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:definition
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:notation
    ];
    sh:targetClass skos:Concept
  ] ;
  tree:view <> ;
  .

<feed> tree:member <http://vocab.nerc.ac.uk/collection/L03/current/99/1/> .
<http://vocab.nerc.ac.uk/collection/L03/current/99/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L03/current/99/>;
    dc:modified '2006-12-20T11:29:52'^^xsd:dateTime ;
    skos:altLabel 'unknown'^^xsd:string ;
    skos:prefLabel 'unknown'@en ;
    skos:definition 'A regular sampling interval probably exists but is not known to, or computable by, the information provider.'@en ;
    skos:notation 'SDN:L03::99'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L03/current/0/1/> .
<http://vocab.nerc.ac.uk/collection/L03/current/0/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L03/current/0/>;
    dc:modified '2006-12-20T11:26:15'^^xsd:dateTime ;
    skos:altLabel 'indeterminate'^^xsd:string ;
    skos:prefLabel 'indeterminate'@en ;
    skos:definition 'No regular sampling interval exists because measurements are made at irregular and unpredictable times.'@en ;
    skos:notation 'SDN:L03::0'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L03/current/13/1/> .
<http://vocab.nerc.ac.uk/collection/L03/current/13/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L03/current/13/>;
    dc:modified '2006-08-18T14:33:02'^^xsd:dateTime ;
    skos:altLabel 'annual'^^xsd:string ;
    skos:prefLabel 'year to sub-decade'@en ;
    skos:definition 'Sampling interval is one year or longer, but shorter than ten years.  Sampling frequency is yearly or less, but greater than decadal.'@en ;
    skos:notation 'SDN:L03::13'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L03/current/5/1/> .
<http://vocab.nerc.ac.uk/collection/L03/current/5/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L03/current/5/>;
    dc:modified '2006-08-18T14:33:02'^^xsd:dateTime ;
    skos:altLabel 'day2week'^^xsd:string ;
    skos:prefLabel 'day to sub-week'@en ;
    skos:definition 'Sampling interval is one day or longer, but shorter than one week.  Sampling frequency is daily or less, but greater than weekly.'@en ;
    skos:notation 'SDN:L03::5'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L03/current/15/1/> .
<http://vocab.nerc.ac.uk/collection/L03/current/15/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L03/current/15/>;
    dc:modified '2006-08-18T14:33:02'^^xsd:dateTime ;
    skos:altLabel 'decadal'^^xsd:string ;
    skos:prefLabel 'decadal'@en ;
    skos:definition 'Sampling interval is 10 years or more.  Sampling frequency is less than or equal to decadal.'@en ;
    skos:notation 'SDN:L03::15'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L03/current/4/1/> .
<http://vocab.nerc.ac.uk/collection/L03/current/4/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L03/current/4/>;
    dc:modified '2006-08-18T14:33:02'^^xsd:dateTime ;
    skos:altLabel 'hour2day'^^xsd:string ;
    skos:prefLabel 'hour to sub-day'@en ;
    skos:definition 'Sampling interval is one hour or longer, but shorter than one day.  Sampling frequency is hourly or less, but greater than daily.'@en ;
    skos:notation 'SDN:L03::4'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L03/current/3/1/> .
<http://vocab.nerc.ac.uk/collection/L03/current/3/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L03/current/3/>;
    dc:modified '2006-08-18T14:33:02'^^xsd:dateTime ;
    skos:altLabel 'minute2hour'^^xsd:string ;
    skos:prefLabel 'minute to sub-hour'@en ;
    skos:definition 'Sampling interval is one minute or longer, but shorter than one hour.  Sampling frequency is 1/60 hertz or less, but greater than 1/3600 hertz.'@en ;
    skos:notation 'SDN:L03::3'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L03/current/7/1/> .
<http://vocab.nerc.ac.uk/collection/L03/current/7/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L03/current/7/>;
    dc:modified '2006-08-18T14:33:02'^^xsd:dateTime ;
    skos:altLabel 'month2year'^^xsd:string ;
    skos:prefLabel 'month to sub-year'@en ;
    skos:definition 'Sampling interval is one month or longer, but shorter than one year.  Sampling frequency is monthly or less, but greater than yearly.'@en ;
    skos:notation 'SDN:L03::7'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L03/current/2/1/> .
<http://vocab.nerc.ac.uk/collection/L03/current/2/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L03/current/2/>;
    dc:modified '2006-08-18T14:33:02'^^xsd:dateTime ;
    skos:altLabel 'second2minute'^^xsd:string ;
    skos:prefLabel 'second to sub-minute'@en ;
    skos:definition 'Sampling interval is one second or longer, but shorter than one minute.  Sampling frequency is 1 hertz or less, but greater than 1/60 hertz.'@en ;
    skos:notation 'SDN:L03::2'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L03/current/1/1/> .
<http://vocab.nerc.ac.uk/collection/L03/current/1/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L03/current/1/>;
    dc:modified '2006-08-18T14:33:02'^^xsd:dateTime ;
    skos:altLabel 'sub-second'^^xsd:string ;
    skos:prefLabel 'sub-second'@en ;
    skos:definition 'Sampling interval is less than a second.  Sampling frequency is greater than one hertz.'@en ;
    skos:notation 'SDN:L03::1'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L03/current/6/1/> .
<http://vocab.nerc.ac.uk/collection/L03/current/6/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L03/current/6/>;
    dc:modified '2006-08-18T14:33:02'^^xsd:dateTime ;
    skos:altLabel 'week2month'^^xsd:string ;
    skos:prefLabel 'week to sub-month'@en ;
    skos:definition 'Sampling interval is one week or longer, but shorter than one month.  Sampling frequency is weekly or less, but greater than monthly.'@en ;
    skos:notation 'SDN:L03::6'^^xsd:string .
