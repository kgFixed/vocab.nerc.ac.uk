<>
    a tree:Node
     ;
    tree:relation [
      a tree:LessThanRelation ;
      tree:node <https://kgfixed.github.io/vocab.nerc.ac.uk/C98/2006_01_01_00_00_00_2006_12_31_23_59_59.ttl> ;
