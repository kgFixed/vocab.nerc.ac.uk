@prefix tree: <https://w3id.org/tree#> .
@prefix ldes: <https://w3id.org/ldes#> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

@base <https://kgfixed.github.io/vocab.nerc.ac.uk/G01/2012_01_01_00_00_00_2012_12_31_23_59_59.ttl> .

<>
    a tree:Node
     .

<feed>
  a ldes:EventStream ;
  ldes:timestampPath dc:modified ;
  ldes:versionOfPath dc:isVersionOf ;
  
  
  tree:shape [
    a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path dc:isVersionOf
    ],
    [
      sh:datatype xsd:dateTime ;
      sh:minCount 1 ;
      sh:path dc:modified
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:altLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:prefLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:definition
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:notation
    ];
    sh:targetClass skos:Concept
  ] ;
  tree:view <> ;
  .

<feed> tree:member <http://vocab.nerc.ac.uk/collection/G01/current/001/1/> .
<http://vocab.nerc.ac.uk/collection/G01/current/001/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/G01/current/001/>;
    dc:modified '2012-07-04T10:53:50'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'creation'@en ;
    skos:definition 'Date identifies when the resource was brought into existence'@en ;
    skos:notation 'SDN:G01::001'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/G01/current/002/1/> .
<http://vocab.nerc.ac.uk/collection/G01/current/002/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/G01/current/002/>;
    dc:modified '2012-07-04T10:53:50'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'publication'@en ;
    skos:definition 'Date identifies when the resource was issued'@en ;
    skos:notation 'SDN:G01::002'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/G01/current/003/1/> .
<http://vocab.nerc.ac.uk/collection/G01/current/003/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/G01/current/003/>;
    dc:modified '2012-07-04T10:53:50'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'revision'@en ;
    skos:definition 'Date identifies when the resource was examined or re-examined and improved or amended'@en ;
    skos:notation 'SDN:G01::003'^^xsd:string .
