    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'cephalothorax'@en ;
    skos:definition 'The body region formed by the fusion of one or more thoracic segments with the head.'@en ;
    skos:notation 'SDN:S12::S1288'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S12/current/S122/3/> .
