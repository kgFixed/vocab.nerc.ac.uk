    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'temporal replicate'@en ;
    skos:definition 'Samples collected independently over a timeframe, specifically collected to estimate changes to the subject of interest over that timeframe.'@en ;
    skos:notation 'SDN:S29::PE001524'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S29/current/PE001522/2/> .
