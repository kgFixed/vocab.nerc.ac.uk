    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'spatial replicate'@en ;
    skos:definition 'Samples collected independently over some area, specifically collected to estimate statistical information about that area.'@en ;
    skos:notation 'SDN:S29::PE001523'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S29/current/PE001524/1/> .
