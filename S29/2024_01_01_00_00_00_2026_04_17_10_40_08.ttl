    skos:definition 'The lower filter in a cascade or sequential filtration setup designed to exclude material retained by the filter. Only the material collected on the filter is used in the analysis.'@en ;
    skos:notation 'SDN:S29::PE001522'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S29/current/PE001521/1/> .
