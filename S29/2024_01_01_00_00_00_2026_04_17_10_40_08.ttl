    skos:definition 'Equipment used to sort biological or geological material. The material that remain on the sieve are discarded.'@en ;
    skos:notation 'SDN:S29::PE001521'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S29/current/PE001520/1/> .
