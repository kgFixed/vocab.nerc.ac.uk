    dc:modified '2017-12-21T18:56:40'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'waves (wind sea)'@en ;
    skos:definition 'A sample subset comprising waves in the vicinity of the measurement site whose direction is governed by the wind field at that site. They are characterised by short periods and a broad directional spread.'@en ;
