    dc:modified '2018-01-26T17:02:33'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'wind (gust >5 second duration)'@en ;
    skos:definition 'A sudden blast of wind generally regarded as an increase over sustained speed of more than 5 metres per second lasting more than 5 seconds.'@en ;
    skos:notation 'SDN:S29::PE001255'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S29/current/PE001256/1/> .
<http://vocab.nerc.ac.uk/collection/S29/current/PE001256/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S29/current/PE001256/>;
    dc:modified '2018-01-26T17:02:33'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'wind relative to moving platform and heading'@en ;
    skos:definition 'Movement of air in the atmosphere. The speed and direction of the observed phenomenon is measured relative to the moving platform (e.g. a ship) with no correction for the ship speed or direction.'@en ;
    skos:notation 'SDN:S29::PE001256'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S29/current/PE001257/1/> .
<http://vocab.nerc.ac.uk/collection/S29/current/PE001257/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S29/current/PE001257/>;
    dc:modified '2018-01-26T17:02:33'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'wind (gust >30 second duration)'@en ;
    skos:definition 'A sudden blast of wind generally regarded as an increase over sustained speed of more than 5 metres per second lasting more than 30 seconds.'@en ;
    skos:notation 'SDN:S29::PE001257'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S29/current/PE001244/1/> .
<http://vocab.nerc.ac.uk/collection/S29/current/PE001244/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S29/current/PE001244/>;
    dc:modified '2018-01-12T12:47:19'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'waves (swell)'@en ;
    skos:definition 'A sample subset comprising waves that originated a significant distance away from the measurement site whose direction is not governed by the wind field at that site. They are characterised by long periods, low velocity and a limited directional spread.'@en ;
    skos:notation 'SDN:S29::PE001244'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S29/current/PE001238/1/> .
<http://vocab.nerc.ac.uk/collection/S29/current/PE001238/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S29/current/PE001238/>;
    dc:modified '2018-01-11T15:48:34'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'red fluorescence pulse'@en ;
    skos:definition 'The signal detected when a particle containing a red fluorescent material such as chlorophyll-a or phycocyanin for instance, passes in front of a blue to red laser beam.'@en ;
    skos:notation 'SDN:S29::PE001238'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S29/current/PE001239/1/> .
<http://vocab.nerc.ac.uk/collection/S29/current/PE001239/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S29/current/PE001239/>;
    dc:modified '2018-01-11T15:48:34'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'forward light scatter pulse'@en ;
    skos:definition 'The signal generated by photons scattered in a frontal angle by a particle when crossing a laser beam of a flow cytometer.'@en ;
    skos:notation 'SDN:S29::PE001239'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S29/current/PE001240/1/> .
<http://vocab.nerc.ac.uk/collection/S29/current/PE001240/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S29/current/PE001240/>;
    dc:modified '2018-01-11T15:48:34'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'yellow fluorescence pulse'@en ;
    skos:definition 'The signal detected when a particle containing a yellow fluorescent material such as phycoerythrin for instance, passes in front of a blue to green laser beam. Phycoerythrin emits in the yellow and orange bandwidths.'@en ;
    skos:notation 'SDN:S29::PE001240'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S29/current/PE001241/1/> .
<http://vocab.nerc.ac.uk/collection/S29/current/PE001241/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S29/current/PE001241/>;
    dc:modified '2018-01-11T15:48:34'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'green fluorescence pulse'@en ;
    skos:definition 'The signal detected when a particle containing a green fluorescent material such as an artificial dye for example, passes in front of a blue laser beam.'@en ;
    skos:notation 'SDN:S29::PE001241'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S29/current/PE001242/1/> .
<http://vocab.nerc.ac.uk/collection/S29/current/PE001242/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S29/current/PE001242/>;
    dc:modified '2018-01-11T15:48:34'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'orange fluorescence pulse'@en ;
    skos:definition 'The signal detected when a particle containing orange fluorescent material such as phycoerythrin for instance, passes in front of a blue to green laser beam. Phycoerythrin emits in the yellow and orange bandwidths.'@en ;
    skos:notation 'SDN:S29::PE001242'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S29/current/PE001243/1/> .
<http://vocab.nerc.ac.uk/collection/S29/current/PE001243/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S29/current/PE001243/>;
    dc:modified '2018-01-11T15:48:34'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'sideward light scatter pulse'@en ;
    skos:definition 'The signal generated by photons scattered at 90 degrees to the laser beam direction by a particle when crossing a laser beam of a flow cytometer.'@en ;
    skos:notation 'SDN:S29::PE001243'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S29/current/PE001236/1/> .
<http://vocab.nerc.ac.uk/collection/S29/current/PE001236/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S29/current/PE001236/>;
    dc:modified '2018-01-10T14:52:33'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'sample collector (aperture)'@en ;
    skos:definition 'The mouth opening of a sample collecting device such as a plankton net or a trawl.'@en ;
    skos:notation 'SDN:S29::PE001236'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S29/current/PE001237/1/> .
<http://vocab.nerc.ac.uk/collection/S29/current/PE001237/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S29/current/PE001237/>;
    dc:modified '2018-01-10T14:52:33'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'sample collector (mesh)'@en ;
    skos:definition 'The material made of a network of wire or thread that constitutes the filtering interface of sample collecting devices such as plankton nets, trawls, or sieves.'@en ;
    skos:notation 'SDN:S29::PE001237'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S29/current/PE001235/1/> .
