    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S29/current/PE001235/>;
    dc:modified '2018-01-10T14:32:27'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'micro-litter particles'@en ;
    skos:definition 'Microscopic debris originating from human activities or derived from man-made objects that are found in a natural environment.'@en ;
    skos:notation 'SDN:S29::PE001235'^^xsd:string .
