    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S29/current/PE001438/>;
    dc:modified '2021-08-02T15:48:31'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'radial vector relative to instrument and True North'@en ;
    skos:definition 'The linear polar co-ordinate of a vector measurement. The entity is defined relative to the instrument (e.g. a radar) and True North for direction.'@en ;
    skos:notation 'SDN:S29::PE001438'^^xsd:string .
