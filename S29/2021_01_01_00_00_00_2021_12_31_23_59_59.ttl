    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S29/current/PE001436/>;
    dc:modified '2021-07-06T13:30:03'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'glider phase'@en ;
    skos:definition 'The distinct operating stage recognised following the deployment of a glider platform into water and prior to recovery. The term is used for glider platforms capable of sub-surface travel.'@en ;
    skos:notation 'SDN:S29::PE001436'^^xsd:string .
