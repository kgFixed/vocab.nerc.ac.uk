    dc:modified '2021-08-03T12:31:46'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'surface microlayer'@en ;
    skos:definition 'The uppermost layer of water bodies representing a thin boundary layer (or skin) between the hydrosphere (mainly the ocean) and the atmosphere. It is nominally defined as the top 1000 micrometres (or 1 millimetre) of the water\'s surface.'@en ;
    skos:notation 'SDN:S29::PE001439'^^xsd:string .
