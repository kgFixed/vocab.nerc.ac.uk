    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S29/current/PE001437/>;
    dc:modified '2021-08-02T15:48:31'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'water current relative to instrument'@en ;
    skos:definition 'The movement or flow of water. The reference is a physical object that is a tool, an implement or a sampling/measuring device.'@en ;
    skos:notation 'SDN:S29::PE001437'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S29/current/PE001438/1/> .
