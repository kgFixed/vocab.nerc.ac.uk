    skos:altLabel 'Ott chart float gauge'^^xsd:string ;
    skos:prefLabel 'Ott chart float tide gauge'@en ;
    skos:definition 'Mechanical tide gauge with a float installed in a stilling well connected by wire through a set of pulleys that transmit the movement of the float to a continuous pen recorder.'@en ;
    skos:notation 'SDN:L22::TOOL0097'^^xsd:string .
