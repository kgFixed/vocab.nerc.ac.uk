    skos:altLabel 'Metre net'^^xsd:string ;
    skos:prefLabel '1-metre ring net'@en ;
    skos:definition 'Plankton net described as 1-metre ring net; designed with single circular (ring) mouth piece with measurements: mouth diameter (metre)=1; with opening area (square metre)=0.8; with total filtering net length (metre)=not specified; with filtering net shape conical; with additional features: can be used for qualitative sampling or the capture of live animals or quantitative sampling if used with flowmeter; with mesh size (millimetre)=0.333 as a standard but may vary; and equipped with NO closing mechanism.'@en ;
    skos:notation 'SDN:L22::TOOL0988'^^xsd:string .
