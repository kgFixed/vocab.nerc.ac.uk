    skos:altLabel 'DMIKT'^^xsd:string ;
    skos:prefLabel 'Dual Methot Isaacs-Kidd Trawl net'@en ;
    skos:definition 'Pelagic trawl net described as Dual Methot Trawl net ; designed with single rectangular mouth piece with measurements: not specified; with opening area (square metre)=1.5; with total filtering net length (metre)=not specified; with filtering net shape conical; with additional features: dual-net system; with mesh size (millimetre)=1.5; and equipped with an opening-closing mechanism.'@en ;
    skos:notation 'SDN:L22::TOOL0985'^^xsd:string .
