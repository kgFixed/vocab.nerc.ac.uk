    dc:modified '2016-04-04T14:47:13'^^xsd:dateTime ;
    skos:altLabel 'F-Net'^^xsd:string ;
    skos:prefLabel 'British Antarctic Survey Foredeck Net'@en ;
    skos:definition 'The foredeck (also fore-deck) net was designed by Doug Bone (Gear Development, British Antarctic Survey) in 1980. It has a square net mouth of 1 square metre area and is fitted with a 5 millimetre mesh tapering over 3 metre to a solid conical cod end. The foredeck net is towed from the hydrolic crane at a depth near to the sea surface.'@en ;
    skos:notation 'SDN:L22::TOOL0992'^^xsd:string .
