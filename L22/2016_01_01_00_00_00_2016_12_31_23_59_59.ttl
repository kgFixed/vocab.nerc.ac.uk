    skos:altLabel 'Bongo 95+200-um'^^xsd:string ;
    skos:prefLabel 'University of Aberdeen size-resolving Bongo net'@en ;
    skos:definition 'Plankton net described as University of Aberdeen 95+200 micron size-resolving Bongo net; designed with double circular (drum) mouth piece with measurements: diameter (metre)=0.30; with opening area (square metre)=0.071; with total filtering net length (metre)=2; with filtering net shape cylindrical-conical; with additional features: net collar length=0.25 m, cylinder section length=1 m, conical section length=1 m, cod-end diameter=0.080 m; with mesh size (millimetre)=0.095 and 0.200; and equipped with NO closing mechanism.'@en ;
    skos:notation 'SDN:L22::TOOL0984'^^xsd:string .
