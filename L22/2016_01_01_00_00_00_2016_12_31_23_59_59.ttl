    dc:modified '2016-04-04T14:47:13'^^xsd:dateTime ;
    skos:altLabel 'Hand net'^^xsd:string ;
    skos:prefLabel 'Hand-held plankton net'@en ;
    skos:definition 'Plankton net described as an hand-held plankton net; designed with single mouth piece with specifications with specifications unknown or available elsewhere in the supporting metadata; with additional features: qualitative sampling gear operated like a butterfly net either by SCUBA divers or from the side of a fixed dock or a small vessel; net size, shape, colour and mesh size may vary.'@en ;
    skos:notation 'SDN:L22::TOOL0981'^^xsd:string .
