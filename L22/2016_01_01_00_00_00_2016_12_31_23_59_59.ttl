    skos:altLabel 'N113'^^xsd:string ;
    skos:prefLabel 'N113 (modified Indian Ocean standard net) - Foxton (1969)'@en ;
    skos:definition 'Plankton net described as N113 (modified Indian Ocean standard net) - Foxton (1969); designed with single cylindrical mouth piece with measurements: mouth diameter (metre)=1.13, cylindrical non-filtering mouth section length (m)=1, upper cylindrical filtering section length (m)= 1, lower conical filtering section length (m)=3; with opening area (square metre)=1; with total filtering net length (metre)=4; with filtering net shape cylindrical-conical; with additional features: not specified; with mesh size (millimetre)=0.33; and equipped with a catch dividing bucket.'@en ;
    skos:notation 'SDN:L22::TOOL0990'^^xsd:string .
