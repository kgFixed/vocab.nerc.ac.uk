    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0304/>;
    dc:modified '2010-05-18T16:10:58'^^xsd:dateTime ;
    skos:altLabel 'IXSEA PHINS'^^xsd:string ;
    skos:prefLabel 'IXSEA Photonic Inertial Navigation System'@en ;
    skos:definition 'PHINS, or PHotonic Inertial Navigation System (INS) that outputs position, heading, pitch, roll, heave, depth and velocity. The PHINS uses a high accuracy inertial measurement unit and produces positional data with an accuracy ranging from metres to cm, depending on the specific instrumentation setup. INS drift performance is known to be inadequate without a velocity input from an ADCP.'@en ;
    skos:notation 'SDN:L22::TOOL0304'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0193/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0193/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0193/>;
    dc:modified '2010-05-18T16:10:58'^^xsd:dateTime ;
    skos:altLabel 'LI-190 PAR'^^xsd:string ;
    skos:prefLabel 'LI-COR LI-190 PAR sensor'@en ;
    skos:definition 'A non-submersible cosine-corrected PAR sensor sensitive wavelengths from 400-700nm with sharp cut-off due to an interference filter. It may be used as a reference sensor for LI-192 and LI-193 Underwater Quantum Sensor.'@en ;
    skos:notation 'SDN:L22::TOOL0193'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0120/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0120/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0120/>;
    dc:modified '2010-05-18T16:10:58'^^xsd:dateTime ;
    skos:altLabel 'LI-192 PAR'^^xsd:string ;
    skos:prefLabel 'LI-COR LI-192 PAR sensor'@en ;
    skos:definition 'An underwater or atmospheric quantum sensor with cosine correction that can operate down to 560m. Fitted with a blue-enhanced silicon photovoltaic detector.'@en ;
    skos:notation 'SDN:L22::TOOL0120'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0278/1/> .
