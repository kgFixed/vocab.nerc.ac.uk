    skos:altLabel 'Hg RTM'^^xsd:string ;
    skos:prefLabel 'Mercury reversing thermometer'@en ;
    skos:definition 'A generic term for a mercury-in-glass thermometer that freezes the temperature reading when turned upside-down.'@en ;
    skos:notation 'SDN:L22::TOOL0238'^^xsd:string .
