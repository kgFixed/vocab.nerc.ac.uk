    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0265/>;
    dc:modified '2010-05-18T16:10:58'^^xsd:dateTime ;
    skos:altLabel 'Wavescan met package'^^xsd:string ;
    skos:prefLabel 'Fugro Oceanor Wavescan buoy meteorological package'@en ;
    skos:definition 'A meteorological tower with wind, air pressure and air temperature sensors mounted on top of a metocean waverider buoy with on-board data logging and telemetry capability. More information is given in https://www.bodc.ac.uk/data/documents/nodb/64211/'@en ;
    skos:notation 'SDN:L22::TOOL0265'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0264/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0264/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0264/>;
    dc:modified '2010-05-18T16:10:58'^^xsd:dateTime ;
    skos:altLabel 'Wavescan waverider'^^xsd:string ;
    skos:prefLabel 'Fugro Oceanor Wavescan buoy waverider'@en ;
    skos:definition 'A meteocean waverider buoy incorporating directional wave sensors with sophisticated on-board data reduction, data logging and telemetry capability. The buoy may also carry a meteorological tower and a sub-surface sensor package that are considered to be separate data production tools. More information is given in https://www.bodc.ac.uk/data/documents/nodb/64211/'@en ;
    skos:notation 'SDN:L22::TOOL0264'^^xsd:string .
