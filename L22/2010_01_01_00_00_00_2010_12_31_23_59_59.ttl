    dc:modified '2010-05-18T16:10:58'^^xsd:dateTime ;
    skos:altLabel 'anemometer'^^xsd:string ;
    skos:prefLabel 'anemometer'@en ;
    skos:definition 'A generic term for a mechanical device for measuring wind speed and direction designed for use where no information on instrument make, model or measurement principle are obtainable.'@en ;
    skos:notation 'SDN:L22::TOOL0269'^^xsd:string .
