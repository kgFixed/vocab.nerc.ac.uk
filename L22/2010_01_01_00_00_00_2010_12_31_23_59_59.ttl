    skos:altLabel 'PSA-916T Altimeter'^^xsd:string ;
    skos:prefLabel 'Benthos PSA-916T Sonar Altimeter'@en ;
    skos:definition 'A titanium sonar altimeter with 200 kHz operating frequency and 14 deg conical band width. It has a range of 100 m and is depth rated to 6000 m.'@en ;
