    skos:altLabel 'Hygrometer'^^xsd:string ;
    skos:prefLabel 'Hygrometer'@en ;
    skos:definition 'A generic term for a device that measures atmospheric humidity. The term is for use where details of the make, model number and measurement principle are not known.'@en ;
    skos:notation 'SDN:L22::TOOL0282'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0227/1/> .
