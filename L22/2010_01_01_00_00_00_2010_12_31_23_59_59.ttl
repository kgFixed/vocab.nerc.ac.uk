    skos:altLabel 'IOS MkIV BPR'^^xsd:string ;
    skos:prefLabel 'Institute of Oceanographic Sciences MkIV bottom pressure recorder'@en ;
    skos:definition 'A deep water (300-5000m) seafloor pressure gauge designed and built by IOS Bidston (now Proudman Oceanographic Laboratory) with an internal casette tape data logger recording Bell and Howell strain gauges and/or Digiquartz pressure sensors.'@en ;
    skos:notation 'SDN:L22::TOOL0226'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0304/1/> .
