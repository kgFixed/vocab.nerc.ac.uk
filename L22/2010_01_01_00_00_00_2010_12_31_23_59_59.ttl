    dc:modified '2010-05-18T16:10:58'^^xsd:dateTime ;
    skos:altLabel 'NAS-2E nutrient analyser'^^xsd:string ;
    skos:prefLabel 'EnviroTech LLC NAS-2E Nutrient Analyser'@en ;
    skos:definition 'In-situ nutrient analyser for high frequency time-series determination of nutrient concentrations in marine and fresh waters.'@en ;
    skos:notation 'SDN:L22::TOOL0170'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0233/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0233/1/>
    a skos:Concept ;
