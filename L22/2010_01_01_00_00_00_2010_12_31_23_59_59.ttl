    skos:prefLabel 'Hugrun Seamon Mini temperature recorder'@en ;
    skos:definition 'A small underwater temperature sensor and data logger manufactured by Hugrun (subsequently Star-Oddi) and no longer manufactured under that name.'@en ;
    skos:notation 'SDN:L22::TOOL0228'^^xsd:string .
