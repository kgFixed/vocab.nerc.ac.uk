    dc:modified '2010-05-18T16:10:58'^^xsd:dateTime ;
    skos:altLabel 'IOS MkIII BPR'^^xsd:string ;
    skos:prefLabel 'Institute of Oceanographic Sciences MkIII bottom pressure recorder'@en ;
    skos:definition 'A deep water (300-5000m) seafloor pressure gauge designed and built by IOS Bidston (now Proudman Oceanographic Laboratory) with two pressure transducers and PRT sea temperature sensors coupled to a 12-channel commercial data logger in a spherical pressure housing.'@en ;
    skos:notation 'SDN:L22::TOOL0227'^^xsd:string .
