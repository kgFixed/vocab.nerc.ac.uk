<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0359/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0359/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0359/>;
    dc:modified '2010-11-24T09:31:30'^^xsd:dateTime ;
    skos:altLabel 'IFP Flexotir source'^^xsd:string ;
    skos:prefLabel 'Institut Francais du Petrole Flexotir seismic source'@en ;
    skos:definition 'A seismic source whereby small charges (50-150g) are propelled through a rubber hose by water under pressure into an empty, perforated sphere where they are detonated. The holes in the sphere allow the water repelled by the explosion to flow in and out, thus dissipating some of the energy in the bubble effect. Flexotir was commonly used as an energy source for seafloor seismic surveys during the 1970s.'@en ;
    skos:notation 'SDN:L22::TOOL0359'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0360/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0360/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0360/>;
    dc:modified '2010-11-24T09:31:30'^^xsd:dateTime ;
    skos:altLabel 'IFP Geomecanique hydrophones'^^xsd:string ;
    skos:prefLabel 'Institut Francais du Petrole Geomecanique hydrophone array'@en ;
    skos:definition 'A collection of underwater microphones mounted in cable designed to be towed behind a ship.'@en ;
    skos:notation 'SDN:L22::TOOL0360'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0035/6/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0035/6/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0035/>;
    dc:modified '2010-11-18T12:42:13'^^xsd:dateTime ;
    skos:altLabel 'SBE 911 CTD'^^xsd:string ;
    skos:prefLabel 'Sea-Bird SBE 911 CTD'@en ;
    skos:definition 'High precision and accuracy CTD made up from a Sea-Bird SBE 9 underwater unit and a SBE 11 deck unit. The underwater unit comprises protective cage (usually with a rosette) holding a pressure unit and temperature/conductivity unit. The latter is connected to a pump-fed plastic tubing circuit that may include other sensors. All plumbed and non-plumbed instruments (e.g. transmissometers and light meters) on the package are logged by the SBE 11. The unit was replaced by the SBE 911plus in 1997.'@en ;
    skos:notation 'SDN:L22::TOOL0035'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0152/2/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0152/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0152/>;
    dc:modified '2010-11-18T12:39:41'^^xsd:dateTime ;
    skos:altLabel 'AML CT array'^^xsd:string ;
    skos:prefLabel 'Applied Microsystems conductivity and temperature array'@en ;
    skos:definition 'A data logger based on the AML MC7 micro-CTD with 3 remote conductivity plus temperature sensors. The logger can sample on command, at a fixed rate or in burst mode and has a real-time feed.'@en ;
    skos:notation 'SDN:L22::TOOL0152'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0292/2/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0292/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0292/>;
    dc:modified '2010-11-18T12:39:41'^^xsd:dateTime ;
    skos:altLabel 'ASL IPS4 ice profiler'^^xsd:string ;
    skos:prefLabel 'ASL Environmental Sciences IPS4 Ice Profiler Sonar'@en ;
    skos:definition 'The ASL Environmental Sciences ISP4 is an upward looking sonar device for measuring ice keel drafts. Distance between the instrument and ice keel is measured by sonar at an operating frequency of 420 kHz with a beam width of 1.8 degrees and sampling rate of up to 2Hz. Water depth is measured by a pressure sensor and ice draft is calculated by difference. It has a depth range of 175 metres in ice or 225 metres in water and a precision of 0.05 metres.'@en ;
    skos:notation 'SDN:L22::TOOL0292'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0244/2/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0244/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0244/>;
    dc:modified '2010-11-18T12:39:41'^^xsd:dateTime ;
    skos:altLabel 'Alpkem RFA/2 AA'^^xsd:string ;
    skos:prefLabel 'Alpkem RFA/2 colorimetric autoanalyser'@en ;
    skos:definition 'A rapid flow analyser that may be used to measure nutrient concentrations in seawater. It is a continuous flow instrument consisting of a sampler, peristaltic pump, analytical cartridge, heating bath, colorimeter, data station, and printer.'@en ;
    skos:notation 'SDN:L22::TOOL0244'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0006/2/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0006/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0006/>;
    dc:modified '2010-11-18T12:39:41'^^xsd:dateTime ;
    skos:altLabel 'B-B 9006 STD'^^xsd:string ;
    skos:prefLabel 'Bissett-Bermann 9006 STD system'@en ;
    skos:definition 'The Bissett-Bermann 9006 was an STD (salinity, temperature depth) profiler.  Output was analogue, producing plots of salinity and temperature versus depth that were subsequently manually digitised.'@en ;
    skos:notation 'SDN:L22::TOOL0006'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0005/2/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0005/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0005/>;
    dc:modified '2010-11-18T12:39:41'^^xsd:dateTime ;
    skos:altLabel 'B-B 9040 CTD'^^xsd:string ;
    skos:prefLabel 'Bissett-Bermann 9040 CTD system'@en ;
    skos:definition 'This instrument, also known as the Plessey 9040, incorporates pressure, temperature and conductivity sensors whose output may be digitally logged in addition to the derived parameters depth, salinity and sound velocity. An optional dissolved oxygen sensor is available. Salinity accuracy is quoted at +/-0.02 ppt and temperature accuracy is quoted at +/-0.02 C in normal oceanographic conditions.'@en ;
    skos:notation 'SDN:L22::TOOL0005'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0353/2/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0353/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0353/>;
    dc:modified '2010-11-18T12:39:41'^^xsd:dateTime ;
    skos:altLabel 'Bolt Long-Life air gun'^^xsd:string ;
    skos:prefLabel 'Bolt Technology Corporation Long-Life air gun'@en ;
    skos:definition 'A family of air guns with maximum bubble sizes from 125 to 2000 cubic inches. Air guns comprise a towed chamber that rapidly release a single bubble of highly compressed air on command to generate an acoustic shock wave plus sonic oscillations as the bubble collapses. This family has been used as energy sources for seafloor seismic surveys since their introduction in 1992.'@en ;
    skos:notation 'SDN:L22::TOOL0353'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0050/2/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0050/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0050/>;
    dc:modified '2010-11-18T12:39:41'^^xsd:dateTime ;
    skos:altLabel 'CTG 2-pi PAR'^^xsd:string ;
    skos:prefLabel 'Chelsea Technologies Group 2-pi PAR irradiance sensor'@en ;
    skos:definition 'A submersible irradiance sensor designed by Plymouth marine Laboratory and developed commercially by CTG. The collector is designed to measure the amount of light available for photosynthesis over a hemisphere. Sensors are often paired, one facing up the other down, to determine total PAR. Relative Spectral Sensitivity flat to + 3% from 450-700nm, down 8% of 400nm and 36% at 350nm. Casings on commercial instruments are rated to 1000m depth, but operationally deployed prototype instruments from PML were only rated to 500m.'@en ;
    skos:notation 'SDN:L22::TOOL0050'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0043/2/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0043/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0043/>;
    dc:modified '2010-11-18T12:39:41'^^xsd:dateTime ;
    skos:altLabel 'CTG Aqualog CTD'^^xsd:string ;
    skos:prefLabel 'Chelsea Technologies Group Aqualog CTD'@en ;
    skos:definition 'A self-contained unit comprising pressure, temperature and conductivity sensors, an optional dissolved oxygen sensor, a fluorometer and a data logger. The unit could be used in a variety of modes including vertical profiling, towed undulator and short-term moorings.'@en ;
    skos:notation 'SDN:L22::TOOL0043'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0049/4/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0049/4/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0049/>;
    dc:modified '2010-11-18T12:39:41'^^xsd:dateTime ;
    skos:altLabel 'CTG Aquatracka fluorometer'^^xsd:string ;
    skos:prefLabel 'Chelsea Technologies Group Aquatracka fluorometer'@en ;
    skos:definition 'A submersible fluorometer that may be configured for measurement of chlorophyll-a, tracer dye or set up as a nephelometer to measure turbidity. It is manufactured from titanium giving a depth rating of 6000m.'@en ;
    skos:notation 'SDN:L22::TOOL0049'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0109/2/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0109/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0109/>;
    dc:modified '2010-11-18T12:39:41'^^xsd:dateTime ;
    skos:altLabel 'Florida-Bahamas cable -1990'^^xsd:string ;
    skos:prefLabel 'Florida-Bahamas cable to 1990'@en ;
    skos:definition 'Cabling installed on the seabed primarily to provide a telecommunication link between Florida and the Bahamas until 1990 but able to provide information on currents due to resistance variation. More information at http://www.bodc.ac.uk/data/documents/nodb/110738/.'@en ;
    skos:notation 'SDN:L22::TOOL0109'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0110/2/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0110/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0110/>;
    dc:modified '2010-11-18T12:39:41'^^xsd:dateTime ;
    skos:altLabel 'Florida-Bahamas cable 1990-'^^xsd:string ;
    skos:prefLabel 'Florida-Bahamas cable from 1990'@en ;
    skos:definition 'Cabling installed on the seabed primarily to provide a telecommunication link between Florida and the Bahamas from 1990, but able to provide information on currents due to resistance variation. More information at http://www.bodc.ac.uk/data/documents/nodb/110741/.'@en ;
    skos:notation 'SDN:L22::TOOL0110'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0248/2/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0248/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0248/>;
    dc:modified '2010-11-18T12:39:41'^^xsd:dateTime ;
    skos:altLabel 'Nansen bottle'^^xsd:string ;
    skos:prefLabel 'Nansen-Petterson water bottle'@en ;
    skos:definition 'Metal or plastic insulated bottles with an approximate capacity of 1-2 litres designed for deployment on a cable, sealed by with a spring-loaded valve when triggered by dropping a weight down the cable. It was designed to recover an uncontaminated sample from depth within 0.01C of its in-situ temperature. The design is an improvement by Petterson in collaboration with Nansen on an original design by Nansen. Both designs are commonly known as Nansen bottles.'@en ;
    skos:notation 'SDN:L22::TOOL0248'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0002/3/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0002/3/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0002/>;
    dc:modified '2010-11-18T12:39:41'^^xsd:dateTime ;
    skos:altLabel 'Neil Brown MK3 CTD'^^xsd:string ;
    skos:prefLabel 'Neil Brown MK3 CTD'@en ;
    skos:definition 'The Neil Brown MK3 CTD consists of an integral unit containing pressure, temperature and conductivity sensors with an optional dissolved oxygen sensor in a pressure-hardened casing. The most widely used variant in the 1980s and 1990s was the MK3B. The MK3C fitted with an improved pressure sensor to reduce hysteresis was developed to meet the requirements of the WOCE project. The instrument is no longer in production, but is supported (repair and calibration) by General Oceanics.'@en ;
    skos:notation 'SDN:L22::TOOL0002'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0053/2/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0053/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0053/>;
    dc:modified '2010-11-18T12:39:41'^^xsd:dateTime ;
    skos:altLabel 'RBR XR-420 CTD'^^xsd:string ;
    skos:prefLabel 'RBR XR-420 CTD Marine'@en ;
    skos:definition 'A small autonomous data logger designed to monitor conductivity, temperature and depth. Conductivity (accuracy ± 0.003 mS/cm) is measured using a 3-coil closed loop feedback inductive cell for superior temperature compensation. The thermistor (Themometrics) used to record temperature (accuracy ± 0.002°C) is aged and hermetically sealed in the tip of a shock resistant solid glass rod. Pressure (accuracy 0.05% full scale) sensors use reliable semiconductor technology and 316 stainless steel housing developed for long-term stability in harsh environments.'@en ;
    skos:notation 'SDN:L22::TOOL0053'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0211/2/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0211/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0211/>;
    dc:modified '2010-11-18T12:39:41'^^xsd:dateTime ;
    skos:altLabel 'RCM 4/5'^^xsd:string ;
    skos:prefLabel 'Aanderaa RCM 4/5 Recording Current Meter'@en ;
    skos:definition 'Family of self-recording current meters with Savonius Rotors recording averaged speed and a magnetic compass recording spot directions. The meter has a balanced weight vane which aligns it with the current flow and is mounted using shackles between segments of mooring line. Optional temperature, pressure and conductivity sensors may be fitted. The RCM5 has a strengthened casing allowing deployment to 6000m. For more details see http://www.bodc.ac.uk/data/documents/nodb/4872/'@en ;
    skos:notation 'SDN:L22::TOOL0211'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0039/2/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0039/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0039/>;
    dc:modified '2010-11-18T12:39:41'^^xsd:dateTime ;
    skos:altLabel 'SBE 13 DO'^^xsd:string ;
    skos:prefLabel 'Sea-Bird SBE 13 Dissolved Oxygen Sensor'@en ;
    skos:definition 'Dissolved oxygen sensor with either a Beckmann (SBE 13B) or YSI polarographic element (SBE 13Y limited to 2000m depth). Designed to interface with the SBE 9 and 9plus CTD underwater units. An optional plenum to connect into the pumped plumbing system was available but usage with the membrane exposed was possible. Replaced by the SBE 43 in 2001.'@en ;
    skos:notation 'SDN:L22::TOOL0039'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0042/2/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0042/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0042/>;
    dc:modified '2010-11-18T12:39:41'^^xsd:dateTime ;
    skos:altLabel 'SBE 19 SEACAT'^^xsd:string ;
    skos:prefLabel 'Sea-Bird SBE 19 SEACAT CTD'@en ;
    skos:definition 'A self-contained battery powered CTD with precision semiconductor strain gauge pressure sensor. Water was supplied to the conductivity sensor by a pump. Housing was plastic (up to 600m depth), aluminium (up to 6800m depth) or titanium (up to 10500m depth). Optional oxygen, pH, fluorescence, PAR, light transmission and turbidity sensors could be fitted. Primarily designed for profiling applications but may be used on a short (less than 2 weeks) duration mooring. Replaced by the SBE19plus model in 2001.'@en ;
    skos:notation 'SDN:L22::TOOL0042'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0047/4/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0047/4/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0047/>;
    dc:modified '2010-11-18T12:39:41'^^xsd:dateTime ;
    skos:altLabel 'SBE 19+ SEACAT'^^xsd:string ;
    skos:prefLabel 'Sea-Bird SBE 19plus SEACAT CTD'@en ;
    skos:definition 'Self contained self powered CTD profiler. Measures conductivity, temperature and pressure in both profiling (samples at 4 scans/sec) and moored (sample rates of once every 5 seconds to once every 9 hours) mode. Available in plastic or titanium housing with depth ranges of 600m and 7000m respectively. Minature submersible pump provides water to conductivity cell.'@en ;
    skos:notation 'SDN:L22::TOOL0047'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0040/2/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0040/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0040/>;
    dc:modified '2010-11-18T12:39:41'^^xsd:dateTime ;
    skos:altLabel 'SBE 25 Sealogger'^^xsd:string ;
    skos:prefLabel 'Sea-Bird SBE 25 Sealogger CTD'@en ;
    skos:definition 'A compact self-contained CTD comprising a conductivity sensor plumbed into a pumped water supply and separate pressure and temperature sensor modules. The whole unit is mounted in a stainless steel cage with a battery pack, data logger and memory. A dissolved oxygen sensor may be plumbed into the pumped water supply and other sensor modules such as fluorometers and transmissometers may be mounted in the cage and interfaced to the data logger. The instrument may also be used with external power and data logging through an RS-232 interface.'@en ;
    skos:notation 'SDN:L22::TOOL0040'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0094/2/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0094/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0094/>;
    dc:modified '2010-11-18T12:39:41'^^xsd:dateTime ;
    skos:altLabel 'SEBAPULS 20 radar WLR'^^xsd:string ;
    skos:prefLabel 'SEBAPULS 20 radar water level recorder'@en ;
    skos:definition 'Pulse microwave radar measuring the distance between instrument and surface water. This model is able to measure distances up to 20m with an accuracy of plus or minus 5mm.'@en ;
    skos:notation 'SDN:L22::TOOL0094'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0095/2/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0095/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0095/>;
    dc:modified '2010-11-18T12:39:41'^^xsd:dateTime ;
    skos:altLabel 'SEBAPULS 30 radar WLR'^^xsd:string ;
    skos:prefLabel 'SEBAPULS 30 radar water level recorder'@en ;
    skos:definition 'Pulse microwave radar measuring the distance between instrument and surface water. This model is able to measure distances up to 30m with an accuracy of plus or minus 3mm.'@en ;
    skos:notation 'SDN:L22::TOOL0095'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0096/2/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0096/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0096/>;
    dc:modified '2010-11-18T12:39:41'^^xsd:dateTime ;
    skos:altLabel 'SEBAPULS 70 radar WLR'^^xsd:string ;
    skos:prefLabel 'SEBAPULS 70 radar water level recorder'@en ;
    skos:definition 'Pulse microwave radar measuring the distance between instrument and surface water. This model is able to measure distances up to 70m with an accuracy of plus or minus 15mm.'@en ;
    skos:notation 'SDN:L22::TOOL0096'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0003/2/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0003/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0003/>;
    dc:modified '2010-11-18T12:39:41'^^xsd:dateTime ;
    skos:altLabel 'SeaTech transmissometer'^^xsd:string ;
    skos:prefLabel 'SeaTech transmissometer'@en ;
    skos:definition 'SeaTech manufactured a range of transmissometers to measure optical attenuance, usually (but not exclusively) at red (660nm) light wavelengths. Path lengths varied from 5cm for use in turbid waters to 1m for use in the clear deep ocean. The instruments are no longer manufactured and no source of support is known.'@en ;
    skos:notation 'SDN:L22::TOOL0003'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0243/2/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0243/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0243/>;
    dc:modified '2010-11-18T12:39:41'^^xsd:dateTime ;
    skos:altLabel 'Spekker colorimeter'^^xsd:string ;
    skos:prefLabel 'Hilger Spekker colorimeter'@en ;
    skos:definition 'A photoelectric absorbsiometer developed in 1936 and manufactered by Adam Hilger Ltd, London. A light source with a photocell on each side provides a basic means of operation. The instrument is set up with a solution to be measured in the sample light beam and then balance the EMF of the photocells to zero on a galvanometer. It can be used to measure nutrient concentrations in seawater.'@en ;
    skos:notation 'SDN:L22::TOOL0243'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0229/2/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0229/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0229/>;
    dc:modified '2010-11-18T12:39:41'^^xsd:dateTime ;
    skos:altLabel 'Vaisala GM70 CO2 analyser'^^xsd:string ;
    skos:prefLabel 'Vaisala GM70 atmospheric carbon dioxide analyser'@en ;
    skos:definition 'An instrument designed for the measurement of atmospheric carbon dioxide incorporating a probe that connects to a pump aspirator. The probe contains a CARBOCAP sensor comprising three major components - a light source, a Fabry-Perot interferometer and an IR detector. The interferometer allows light of two wavelengths to pass through to the detector - the wavelength at which carbon dioxide absorbs light and a nearby non-absorbing wavelength for comparison purposes. The probe is used in conjunction with a MI70 meter which promotes easy transfer of data to a PC.'@en ;
    skos:notation 'SDN:L22::TOOL0229'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0232/2/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0232/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0232/>;
    dc:modified '2010-11-18T12:39:41'^^xsd:dateTime ;
    skos:altLabel 'Valeport CTD 600'^^xsd:string ;
    skos:prefLabel 'Valeport CTD 600'@en ;
    skos:definition 'A CTD that samples on either time or depth increments based sampling with direct-reading or self-logging modes. Depth rating is 1500m. Available with either a platinum resistance thermometer (accuracy temperature 0.02C, salinity 0.07 PSU) or thermistor (accuracy temperature 0.1C, salinity 0.15 PSU) temperature sensors and inductive coil conductivity sensors. Both types have a resolution of 0.002C for temperature and 0.003 PSU for salinity.'@en ;
    skos:notation 'SDN:L22::TOOL0232'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0357/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0357/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0357/>;
    dc:modified '2010-11-18T12:37:16'^^xsd:dateTime ;
    skos:altLabel 'Bolt 1500-LL air gun'^^xsd:string ;
    skos:prefLabel 'Bolt Technology Corporation 1500-LL air gun'@en ;
    skos:definition 'A towed chamber that rapidly releases a single bubble of highly compressed air on command to generate an acoustic shock wave plus sonic oscillations as the bubble collapses. It is used a an energy source for seafloor seismic surveys. The 1500-LL is designed for chamber volumes ranging from 40 to 1500 cubic inches and has a maximum operating pressure of 2000 psi. Multiple guns can be configured in a cluster to increase energy output.'@en ;
    skos:notation 'SDN:L22::TOOL0357'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0356/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0356/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0356/>;
    dc:modified '2010-11-18T12:37:16'^^xsd:dateTime ;
    skos:altLabel 'Bolt 1900-LLXT air gun'^^xsd:string ;
    skos:prefLabel 'Bolt Technology Corporation 1900-LLXT air gun'@en ;
    skos:definition 'A towed chamber that rapidly releases a single bubble of highly compressed air on command to generate an acoustic shock wave plus sonic oscillations as the bubble collapses. It is used a an energy source for seafloor seismic surveys and is suited to both shallow and deep water work. The 1900-LLXT is designed for chamber volumes ranging from 10 to 380 cubic inches and has been tested at an operating pressure of 3000 psi.'@en ;
    skos:notation 'SDN:L22::TOOL0356'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0355/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0355/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0355/>;
    dc:modified '2010-11-18T12:37:16'^^xsd:dateTime ;
    skos:altLabel 'Bolt 2800-LLX air gun'^^xsd:string ;
    skos:prefLabel 'Bolt Technology Corporation 2800-LLX air gun'@en ;
    skos:definition 'A towed chamber that rapidly releases a single bubble of highly compressed air on command to generate an acoustic shock wave plus sonic oscillations as the bubble collapses. It is used a an energy source for seafloor seismic surveys and is suited to shallow water work. The L2800-LLX is designed for chamber volumes ranging from 5 to 120 cubic inches and has a maximum operating pressure of 2000 psi. It can be configured in 2-3 gun clusters to increase energy output.'@en ;
    skos:notation 'SDN:L22::TOOL0355'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0354/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0354/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0354/>;
    dc:modified '2010-11-18T12:37:16'^^xsd:dateTime ;
    skos:altLabel 'Hydrophone'^^xsd:string ;
    skos:prefLabel 'Hydrophone'@en ;
    skos:definition 'A generic term for an acoustic intensity sensor (microphone) with an acoustic impedence matched to the density of water to optimise sonic detection under water.'@en ;
    skos:notation 'SDN:L22::TOOL0354'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0341/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0341/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0341/>;
    dc:modified '2010-10-14T10:51:49'^^xsd:dateTime ;
    skos:altLabel 'CTG MINIpack CTD-F'^^xsd:string ;
    skos:prefLabel 'Chelsea Technologies Group MINIpack CTD-F'@en ;
    skos:definition 'A single titanium/acetyl housing containing temperature, conductivity, pressure and fluorescence sensors, a data logger and internal batteries. The fluorometer can be configured to measure a variety of pigments or turbidity and the sensor package has a depth rating of 600m. Data can be recorded internally or output in real time. Spare channels are available to interface up to 16 external sensors such as PAR and dissolved oxygen.'@en ;
    skos:notation 'SDN:L22::TOOL0341'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0352/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0352/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0352/>;
    dc:modified '2010-10-01T10:54:41'^^xsd:dateTime ;
    skos:altLabel 'Manchester CAS HTDMA'^^xsd:string ;
    skos:prefLabel 'Manchester Centre for Atmospheric Science Hygroscopic Tandem Differential Mobility Analyser'@en ;
    skos:definition 'The Hygroscopic Tandem Differential Mobility Analyser (HTDMA) measures the changes in aerosol size distribution in response to a change in relative humidity. It uses two Differential Mobility Analysers (DMAs), operated in series. The incoming air sample is dried to <10% relative humidity, and the first DMA selects a monodisperse distribution of a chosen size. The monodisperse subsample is humidified, and the second DMA, coupled to a particle counter, measures the size distribution of the humidified sample.'@en ;
    skos:notation 'SDN:L22::TOOL0352'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0079/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0079/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0079/>;
    dc:modified '2010-09-08T11:20:45'^^xsd:dateTime ;
    skos:altLabel 'Gyro'^^xsd:string ;
    skos:prefLabel 'Gyrocompass'@en ;
    skos:definition 'A compass of unspecified make or model number that finds true north by using a fast-spinning wheel and friction forces to sense the rotation of the Earth.'@en ;
    skos:notation 'SDN:L22::TOOL0079'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0078/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0078/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0078/>;
    dc:modified '2010-09-08T11:18:07'^^xsd:dateTime ;
    skos:altLabel 'GPS'^^xsd:string ;
    skos:prefLabel 'Global Positioning Satellite System'@en ;
    skos:definition 'A location system of unspecified make or model that determines location on the Earth\'s surface using the Global Positioning Satellite Network. Angular co-ordinates are given relative to WGS84 CRS. Other parameters such as platform velocity may be derived from this.'@en ;
    skos:notation 'SDN:L22::TOOL0078'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0074/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0074/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0074/>;
    dc:modified '2010-09-08T10:12:41'^^xsd:dateTime ;
    skos:altLabel 'Underwater PAR'^^xsd:string ;
    skos:prefLabel 'Underwater PAR radiometer'@en ;
    skos:definition 'Underwater PAR radiometer of unknown type. Assumed to have a spectral response of 400-700nm. Could have any type of collector (flat plate cosine collector, spherical or hemispherical).'@en ;
    skos:notation 'SDN:L22::TOOL0074'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0066/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0066/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0066/>;
    dc:modified '2010-09-08T10:09:52'^^xsd:dateTime ;
    skos:altLabel 'BackScat 1302'^^xsd:string ;
    skos:prefLabel 'Dr.Haardt BackScat Fluorometer Model 1302'@en ;
    skos:definition 'Backscatter fluorometer comprising three optical sensors integrated into one housing with a light source of 2 xenon flash tubes and filters for the detection of chlorophyll, yellow substance (gelbstoff) and Mie backscattering.'@en ;
    skos:notation 'SDN:L22::TOOL0066'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0028/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0028/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0028/>;
    dc:modified '2010-09-07T11:26:56'^^xsd:dateTime ;
    skos:altLabel 'RCM 9 IW'^^xsd:string ;
    skos:prefLabel 'Aanderaa RCM 9 IW Recording Current Meter'@en ;
    skos:definition 'The RCM 9 IW is a single-point doppler recording current meter with a medium weight case to operate at depths of up to 2000 metres. Further information may be found on the BODC document server at URL http://www.bodc.ac.uk/data/documents/nodb/106028/'@en ;
    skos:notation 'SDN:L22::TOOL0028'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0027/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0027/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0027/>;
    dc:modified '2010-09-07T11:25:23'^^xsd:dateTime ;
    skos:altLabel 'RCM 9 LW'^^xsd:string ;
    skos:prefLabel 'Aanderaa RCM 9 LW Recording Current Meter'@en ;
    skos:definition 'The RCM 9 LW is a single-point doppler recording current meter with a lightweight case to operate at depths of up to 300 metres. Further information may be found on the BODC document server at URL http://www.bodc.ac.uk/data/documents/nodb/106028/'@en ;
    skos:notation 'SDN:L22::TOOL0027'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0026/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0026/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0026/>;
    dc:modified '2010-09-07T11:22:02'^^xsd:dateTime ;
    skos:altLabel 'RCM 11'^^xsd:string ;
    skos:prefLabel 'Aanderaa RCM 11 Recording Current Meter'@en ;
    skos:definition 'The RCM 11 is a single-point doppler recording current meter pressure cased to operate at depths of up to 6000 metres. Further information may be found on the BODC document server at URL http://www.bodc.ac.uk/data/documents/nodb/106028/'@en ;
    skos:notation 'SDN:L22::TOOL0026'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0093/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0093/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0093/>;
    dc:modified '2010-09-06T17:01:34'^^xsd:dateTime ;
    skos:altLabel 'TSS HRP-2-25 CMS'^^xsd:string ;
    skos:prefLabel 'TSS HRP-2-25 compact motion sensor'@en ;
    skos:definition 'The TSS Compact Motion Sensor is designed to meet the motion measurement requirements of a oceanographic instruments and platforms from single-beam echo-sounders to dynamic positioning systems. The CMS can be used to measure heave, pitch and roll of a vessel. For more information see http://www.bodc.ac.uk/data/documents/nodb/147645/'@en ;
    skos:notation 'SDN:L22::TOOL0093'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0335/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0335/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0335/>;
    dc:modified '2010-09-06T12:45:22'^^xsd:dateTime ;
    skos:altLabel 'Analogue TG'^^xsd:string ;
    skos:prefLabel 'Analogue tide gauge'@en ;
    skos:definition 'Generic term for instruments that transform the damped level of the sea surface into a marking on a chart by a continous pen recorder or an analogue display that may be read and written into a ledger.'@en ;
    skos:notation 'SDN:L22::TOOL0335'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0342/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0342/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0342/>;
    dc:modified '2010-09-06T12:45:22'^^xsd:dateTime ;
    skos:altLabel 'ChemLab AA-II'^^xsd:string ;
    skos:prefLabel 'ChemLab AA-II segmented continuous flow autoanalyser'@en ;
    skos:definition 'A rapid flow analyser that may be used to measure nutrient concentrations in seawater. It is a continuous flow instrument consisting of a sampler, peristaltic pump, analytical cartridge, heating bath, colorimeter, data station, and printer.'@en ;
    skos:notation 'SDN:L22::TOOL0342'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0337/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0337/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0337/>;
    dc:modified '2010-09-06T12:45:22'^^xsd:dateTime ;
    skos:altLabel 'Decca navigation'^^xsd:string ;
    skos:prefLabel 'Decca main chain navigation receiver'@en ;
    skos:definition 'A hyperbolic low-frequency (70 and 130 kHz) signal receiver that determined position based on the phase difference between signals transmitted by groups of a master plus three slave transmitters. Range depended on radio reception conditions but was typically 450km (day) to 750km (night). Accuracy ranged from 50m (day) or 200m (night) in ideal conditions down to 2km near the range limit. The system operated from the WWII until the UK transmitters were switched off at the end of March 2000.'@en ;
    skos:notation 'SDN:L22::TOOL0337'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0348/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0348/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0348/>;
    dc:modified '2010-09-06T12:45:22'^^xsd:dateTime ;
    skos:altLabel 'Fugro SeaSTAR 9200-G2'^^xsd:string ;
    skos:prefLabel 'Fugro SeaSTAR 9200-G2 Differential Navigation System receiver'@en ;
    skos:definition 'A dual-frequency Differential Global Satellite Navigation System (DGSNS) receiver that incorporates both GPS and GLONASS reception capability. It also tracks the Fugro L-Band satellite broadcast of DGNSS corrections and, as backup, can receive these corrections via the internet. This functionality allows the instrument to provide positional information with a horizontal accuracy of 15cm and a vertical accuracy of 20cm.'@en ;
    skos:notation 'SDN:L22::TOOL0348'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0336/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0336/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0336/>;
    dc:modified '2010-09-06T12:45:22'^^xsd:dateTime ;
    skos:altLabel 'Grundy 6620 thermosalinograph'^^xsd:string ;
    skos:prefLabel 'Grundy Environmental 6620 thermosalinograph'@en ;
    skos:definition 'An autoranging instrument taking inputs from a hull or inlet thermometer to give sea temperature plus co-located temperature and conductivity sensors to give salinity. In general use during the 1980s and 1990s.'@en ;
    skos:notation 'SDN:L22::TOOL0336'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0333/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0333/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0333/>;
    dc:modified '2010-09-06T12:45:22'^^xsd:dateTime ;
    skos:altLabel 'Magee AE1 Aethalometer'^^xsd:string ;
    skos:prefLabel 'Magee Scientific AE1 Aethalometer'@en ;
    skos:definition 'The Magee Scientific AE1 Aethalometer determines concentration of light absorbing aerosol particles from measurements of light transmission through a sample. Air is filtered through a quartz fibre filter tape that traps particulate matter. Measurements are taken at user-specified time intervals ranging from one second to several minutes and the instrument outputs a voltage that is indicative of the amount of light absorbed by the sample.'@en ;
    skos:notation 'SDN:L22::TOOL0333'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0331/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0331/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0331/>;
    dc:modified '2010-09-06T12:45:22'^^xsd:dateTime ;
    skos:altLabel 'Radar Water Level Recorder'^^xsd:string ;
    skos:prefLabel 'Radar Water Level Recorder'@en ;
    skos:definition 'A generic term for radar water level recorders (also known as wavemeters) that measure the distance between the instrument and the water surface. They can be used to measure ocean waves or sea level (depending on sampling frequency) and have been employed on structures such as oil platforms.'@en ;
    skos:notation 'SDN:L22::TOOL0331'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0313/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0313/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0313/>;
    dc:modified '2010-09-06T12:45:22'^^xsd:dateTime ;
    skos:altLabel 'Trimble 4000AX GPS'^^xsd:string ;
    skos:prefLabel 'Trimble 4000AX Global Positioning System receiver'@en ;
    skos:definition 'A GPS receiver in use on research vessels in the 1990s. Sampling rate reported in cruise report literature as approximately 1 second'@en ;
    skos:notation 'SDN:L22::TOOL0313'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0340/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0340/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0340/>;
    dc:modified '2010-09-06T12:45:22'^^xsd:dateTime ;
    skos:altLabel 'VACC'^^xsd:string ;
    skos:prefLabel 'University of Leeds Volatile Aerosol Concentration and Composition instrument'@en ;
    skos:definition 'The Volatile Aerosol Concentration and Composition instrument (VACC) indicates the size-resolved chemical composition of an aerosol sample. Air is drawn in through a quartz tube heating element, programmed to cycle over temperatures between 40 and 900 degrees C. Particles are sized by a hybrid optical particle counter. Temperature dependent changes in size spectra are characteristic of the chemical composition of the aerosol particles.'@en ;
    skos:notation 'SDN:L22::TOOL0340'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0166/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0166/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0166/>;
    dc:modified '2010-05-18T16:10:58'^^xsd:dateTime ;
    skos:altLabel 'Aanderaa RDCP 600'^^xsd:string ;
    skos:prefLabel 'Aanderaa RDCP 600 Recording Doppler Current Profiler'@en ;
    skos:definition 'The RDCP 600 is a medium range, 600kHz self-recording Doppler Current Profiler. The standard RDCP 600 can be deployed to a depth of 300m, with a velocity range of 0-500 cm/s, vertical velocity accuracy of 1.0 cm/s and horizontal velocity accuracy of 0.5cm/s.'@en ;
    skos:notation 'SDN:L22::TOOL0166'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0297/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0297/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0297/>;
    dc:modified '2010-05-18T16:10:58'^^xsd:dateTime ;
    skos:altLabel 'Aerodyne HR Tof AMS'^^xsd:string ;
    skos:prefLabel 'Aerodyne High Resolution Time-of-Flight Aerosol Mass Spectrometer'@en ;
    skos:definition 'An in-situ instrument that provides quantitative size and chemical mass loading information in real-time for non-refractory sub-micron atmospheric aerosol particles from high-resolution time-of-flight and mass-spectrometer measurements. The HR-ToF-AMS variant has a detection limit for nitrate of 0.003 (V-mode) or 0.05 (W-mode) ug/m3.'@en ;
    skos:notation 'SDN:L22::TOOL0297'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0283/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0283/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0283/>;
    dc:modified '2010-05-18T16:10:58'^^xsd:dateTime ;
    skos:altLabel 'Air thermometer'^^xsd:string ;
    skos:prefLabel 'Atmospheric thermometer'@en ;
    skos:definition 'A generic term for a device that measures atmospheric temperature. The term is for use where details of the make, model number and measurement principle are not known.'@en ;
    skos:notation 'SDN:L22::TOOL0283'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0240/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0240/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0240/>;
    dc:modified '2010-05-18T16:10:58'^^xsd:dateTime ;
    skos:altLabel 'Autolab salinometer'^^xsd:string ;
    skos:prefLabel 'Autolab bench salinometer'@en ;
    skos:definition 'A laboratory instrument that determines salinity of a water sample by comparison of its electrical conductivity with a standard solution.'@en ;
    skos:notation 'SDN:L22::TOOL0240'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0281/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0281/1/>
    a skos:Concept ;
