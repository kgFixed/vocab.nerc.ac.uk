    skos:altLabel 'HS-2 OBS-fluorometer'^^xsd:string ;
    skos:prefLabel 'HOBI HydroScat-2 Optical Backscatter Fluorometer'@en ;
    skos:definition 'Instrument that measures optical backscatter at 2 wavelengths (420nm and 700nm as standard but can be customised) plus chlorophyll fluorescence. Casings available for 330m, 4000m or custom maximum depth working.'@en ;
    skos:notation 'SDN:L22::TOOL0141'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0238/1/> .
