    skos:altLabel 'Druck 2900 PSIA'^^xsd:string ;
    skos:prefLabel 'Druck 2900 PSIA pressure sensor'@en ;
    skos:definition 'A strain gauge pressure sensor rated to a maximum pressure of 2900 pounds per square inch absolute (2000m depth).'@en ;
    skos:notation 'SDN:L22::TOOL0837'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0835/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0835/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0835/>;
    dc:modified '2015-03-12T12:15:12'^^xsd:dateTime ;
    skos:altLabel 'Neil Brown Smart ACM'^^xsd:string ;
    skos:prefLabel 'Neil Brown Smart acoustic current meter'@en ;
    skos:definition 'An acoustic current meter with temperature sensor that records at user-selectable rates up to 2Hz.  Current speeds were measured with a resolution of 0.1 cm/s and an accuracy of 1 cm/s or 3 per cent of the measured value (whichever is greater). Current direction is measured with a resolution of 0.1 degrees and an accuracy of 5 degrees. Temperature is measured with a resolution of 0.01C and an accuracy of 0.05C. The instrument data sheet is available at https://www.bodc.ac.uk/data/documents/nodb/pdf/sacm3.pdf.'@en ;
    skos:notation 'SDN:L22::TOOL0835'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0830/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0830/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0830/>;
    dc:modified '2015-02-19T10:36:40'^^xsd:dateTime ;
    skos:altLabel 'AML Smart SV+P SVP'^^xsd:string ;
    skos:prefLabel 'AML Oceanographic Smart SV and P sound velocity probe'@en ;
    skos:definition 'A sound velocity probe for use in shallow water applications, multi-beam systems and can also be integrated in AUV and ROV systems. The probe directly measures sound velocity by the time-of flight of an acoustic ping. It also measures pressure using a temperature-compensated strain gauge. It has a range of 1400 m/s - 1600 m/s and an accuracy of +/-0.05 m/s. It has a pressure range up to 6000 m (accuracy +/-0.05% FS).'@en ;
    skos:notation 'SDN:L22::TOOL0830'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0832/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0832/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0832/>;
    dc:modified '2015-02-19T10:36:40'^^xsd:dateTime ;
    skos:altLabel 'Geometrics G882'^^xsd:string ;
    skos:prefLabel 'Geometrics G882 Marine magnetometer'@en ;
    skos:definition 'A magnetometer designed for the detection and mapping of ferrous objects. It uses a self-oscillating, split-beam Cesium Vapor (non-radioactive) sensor. It can be operated from small or large vessels for shallow water and deep tow applications. Operation range: 20,000 to 100,000 nT. Operation depth: upt to 2750 m.'@en ;
    skos:notation 'SDN:L22::TOOL0832'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0833/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0833/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0833/>;
    dc:modified '2015-02-19T10:36:40'^^xsd:dateTime ;
    skos:altLabel 'IXBlue Hydrins'^^xsd:string ;
    skos:prefLabel 'IXBlue Hydrins inertial navigation system'@en ;
    skos:definition 'An inertial navigation system for use in multibeam echo sounder systems. It uses fibre optic gyros and accelorometers to determine heading, attitude and position (via dead reckoning). The unit can accept positional aiding from Global Positioning Systems (GPS) and Doppler Velocity Logs (DVL). There has been more than one generation of the unit, however, the heading accuracy is typically better than 0.02 deg and the roll or pitch accuracy is better than 0.01 deg. The navigation system was first manufactured by IXSea which is now part of IXBlue.'@en ;
    skos:notation 'SDN:L22::TOOL0833'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0829/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0829/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0829/>;
    dc:modified '2015-02-13T14:44:35'^^xsd:dateTime ;
    skos:altLabel 'SAMS C18 HPLC+fluorometer'^^xsd:string ;
    skos:prefLabel 'SAMS C18 high performance liquid chromatograph and fluorometric detector'@en ;
    skos:definition 'A laboratory-developed,  high performance liquid chromatography system used for analysing chlorophyll a. The system comprises an Agilent 1100 autosampler, LDC Analytical Constametric 3500 pump (now Thermo Scientific), reversed-phase 2 cm, 18 carbon alkyl bonded silica column and Gilson Fluorometer model 121 detector. The system is used at the Scottish Association for Marine Science (SAMS).'@en ;
    skos:notation 'SDN:L22::TOOL0829'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0824/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0824/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0824/>;
    dc:modified '2015-01-29T11:24:26'^^xsd:dateTime ;
    skos:altLabel 'Hitachi U3010 spectrophotometer'^^xsd:string ;
    skos:prefLabel 'Hitachi U3010 UV-Visible scanning spectrophotometer'@en ;
    skos:definition 'A bench-top scanning spectrophotometer which operates in the UV-visible wavelegnth range (190 nm - 900 nm). It is fitted with a grating single monochromator (Seya-Namioka mount) which reduces stray light to 0.015%. Sample volumes as small as 5 uL can be analysed.'@en ;
    skos:notation 'SDN:L22::TOOL0824'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0828/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0828/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0828/>;
    dc:modified '2015-01-29T11:24:26'^^xsd:dateTime ;
    skos:altLabel 'MPI PCTD water sampler'^^xsd:string ;
    skos:prefLabel 'Max Planck Institute Pump CTD water sampler'@en ;
    skos:definition 'Free falling system developed by MPI which allows for high resolution sampling of gradients in the water column, as well as sampling large amounts of water without contact with the atmosphere. When the system in at the water surface, the pump is initiated and after at least 10 minutes, water sampling begins. The water sampling has a delay of a few minutes, depending on tube length. Samples can be taken every 1 to 2 seconds.'@en ;
    skos:notation 'SDN:L22::TOOL0828'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0823/2/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0823/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0823/>;
    dc:modified '2015-01-26T17:26:14'^^xsd:dateTime ;
    skos:altLabel 'AML Smart SV+T SVP'^^xsd:string ;
    skos:prefLabel 'AML Oceanographic Smart SV and T sound velocity probe'@en ;
    skos:definition 'A sound velocity probe for use in sound chest applications and can also be integrated in AUV and ROV systems. The probe directly measures sound velocity by the time-of flight of an acoustic ping. It also measures temperature using a precision-aged thermistor. It has a range of 1400 m/s - 1600 m/s and an accuracy of +/-0.05 m/s. It has a temperature range of -2 to 32 deg C (accuracy +/-0.005 deg C).'@en ;
    skos:notation 'SDN:L22::TOOL0823'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0821/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0821/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0821/>;
    dc:modified '2015-01-26T17:03:56'^^xsd:dateTime ;
    skos:altLabel 'AML Micro SV SVP'^^xsd:string ;
    skos:prefLabel 'AML Oceanographic Micro SV sound velocity probe'@en ;
    skos:definition 'A single sensor, sound velocity probe for multi-beam systems. It can also be integrated into AUV and ROV systems. The probe directly measures sound velocity by the time-of-flight of an acoustic ping. It has a range of 1400 m/s - 1600 m/s and an accuracy of +/-0.05 m/s.'@en ;
    skos:notation 'SDN:L22::TOOL0821'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0822/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0822/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0822/>;
    dc:modified '2015-01-26T17:03:56'^^xsd:dateTime ;
    skos:altLabel 'AML SV 2000 SVP'^^xsd:string ;
    skos:prefLabel 'AML Oceanographic SV 2000 Smart Sensor sound velocity probe'@en ;
    skos:definition 'A single sensor, sound velocity probe for use in a multitude of liquids and can be integrated into a variety of platforms. The probe directly measures sound velocity by the time-of-flight of an acoustic ping. It has a range of 500 m/s - 2000 m/s and accuracy of +/- 2 m/s accuracy (+/- 0.25 m/s in water).'@en ;
    skos:notation 'SDN:L22::TOOL0822'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0819/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0819/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0819/>;
    dc:modified '2015-01-09T14:18:23'^^xsd:dateTime ;
    skos:altLabel 'Gridded quadrat'^^xsd:string ;
    skos:prefLabel 'Gridded quadrat'@en ;
    skos:definition 'A square or rectangular rigid frame of known area, often home-made, with the total area divided into sub-areas by a graticule made up of threads or wires connecting opposite sides of the quadrat spaced at equal intervals. It is placed on the substrate to mark a fixed area for sampling flora or fauna. The subdivision by the graticule increases the accuracy of coverage estimates.'@en ;
    skos:notation 'SDN:L22::TOOL0819'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0818/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0818/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0818/>;
    dc:modified '2015-01-09T14:18:23'^^xsd:dateTime ;
    skos:altLabel 'Point quadrat'^^xsd:string ;
    skos:prefLabel 'Point quadrat'@en ;
    skos:definition 'A square or rectangular rigid frame of known area, often home-made, with a series of needles or nails at set distances throughout the quadrat. When placed on the substrate to be sampled the quadrat marks a fixed area and the needles or nails mark fixed sampling points within that area.'@en ;
    skos:notation 'SDN:L22::TOOL0818'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0817/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0817/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0817/>;
    dc:modified '2015-01-09T14:18:23'^^xsd:dateTime ;
    skos:altLabel 'Quadrat'^^xsd:string ;
    skos:prefLabel 'Quadrat'@en ;
    skos:definition 'A square or rectangular rigid frame of known area, often home-made, that is placed on the substrate to be sampled to mark a fixed area for sampling flora or fauna.'@en ;
    skos:notation 'SDN:L22::TOOL0817'^^xsd:string .
