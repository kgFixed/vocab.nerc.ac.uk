    skos:prefLabel 'Paine 3000 PSIA pressure sensor'@en ;
    skos:definition 'A strain gauge pressure sensor rated to a maximum pressure of 3000 pounds per square inch absolute (2000m depth).'@en ;
    skos:notation 'SDN:L22::TOOL0838'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0837/1/> .
