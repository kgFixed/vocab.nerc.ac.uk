    skos:prefLabel 'Custom-made ceramic tile settlement plate'@en ;
    skos:definition 'An artificial colonisation substrate made of ceramic tiles. It is used to determine the extent of colonisation and/or the diversity of settled organisms in a marine or artificial environment.'@en ;
    skos:notation 'SDN:L22::TOOL1415'^^xsd:string .
