<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0658/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0658/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0658/>;
    dc:modified '2013-12-09T12:30:16'^^xsd:dateTime ;
    skos:altLabel 'Baumer OADM 20I4560/S14C laser'^^xsd:string ;
    skos:prefLabel 'Baumer OADM 20I4560/S14C laser distance sensor'@en ;
    skos:definition 'Laser line sensor for measuring distances to rough surfaces using traingulation from a pulsed red laser diode light source (laser class 2, 675 nm) and detection by a photoelectric array. The sensing range is 30 - 130 mm (resolution < 0.06 mm, linearity error +/- 0.2 mm, response time < 10 ms). The sensor has 5 pin connector and is analogue output (4 - 20 mA / 0 - 10 VDC).'@en ;
    skos:notation 'SDN:L22::TOOL0658'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0657/2/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0657/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0657/>;
    dc:modified '2013-12-06T10:33:01'^^xsd:dateTime ;
    skos:altLabel 'Konica Minolta CM-2600d'^^xsd:string ;
    skos:prefLabel 'Konica Minolta CM-2600d Spectrophotometer'@en ;
    skos:definition 'A portable, sphere type spectrophotometer which measures reflectance over the 360 nm - 740 nm wavelength range (at 10 nm half-bandwidths). It comprises a d/8 (diffused illumination, 8-degree viewing angle) iluminating/viewing system. It is equipped with two interchangeable measurement apertures (MAV: 8mm dia., SAV: 3mm dia.). The operating range is 0 to 175 % reflectance (0.01 % resolution). Spectral reflectance repeatability is within 0.1 % S.D. (0.2 % S.D. between 360 nm - 380 nm).'@en ;
    skos:notation 'SDN:L22::TOOL0657'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0656/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0656/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0656/>;
    dc:modified '2013-12-02T12:24:49'^^xsd:dateTime ;
    skos:altLabel 'Bartington MS2E'^^xsd:string ;
    skos:prefLabel 'Bartington Magnetic Susceptibility MS2E point sensor'@en ;
    skos:definition 'A portable, 2 kHz, MS2 magnetic susceptability point meter used to analyse the flat surface of split drill or soft sediment cores at high spatial resolution. The MS2E has a sensing area mounted on a ceramic tube which allows the sensor to be placed directly on the flat surface of a split core. The area of response from the probe is 3.8 mm x 10.5 mm (at 50% maximum response) allowing for high spatial resolution measurements along the core surface. The sensor operates by generating a low intensity (approx. 80 A/m RMS), non-saturating, alternating current magnetic field. The MS2 family of sensors have a volume specific maximum resolution of 2 x 10^-6 SI (2 x 10^-7 CGS).'@en ;
    skos:notation 'SDN:L22::TOOL0656'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0655/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0655/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0655/>;
    dc:modified '2013-12-02T12:24:49'^^xsd:dateTime ;
    skos:altLabel 'Geotek Geoscan IV'^^xsd:string ;
    skos:prefLabel 'GEOTEK Geoscan IV line scan camera'@en ;
    skos:definition 'A 3 x 2048 pixel CCD, digital line-scan camera fitted with a standard Nikon lens mount which is used for imaging cores. Images can be collected at up to 400 lines per centimetre, resulting in a down-core resolution of 25 micron pixel.'@en ;
    skos:notation 'SDN:L22::TOOL0655'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0653/2/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0653/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0653/>;
    dc:modified '2013-11-26T08:11:24'^^xsd:dateTime ;
    skos:altLabel 'Van Veen grab'^^xsd:string ;
    skos:prefLabel 'Van Veen grab'@en ;
    skos:definition 'A simple clam-shell sediment grab penetrating approximately 20cm with a typical sampling area of 0.1m2 (but grab sizes can vary). On descent two levers with buckets at their ends are spread like open scissors that unlock on hitting the seabed. When pulled upwards the two buckets close and grab a sample. This is subject to more disturbance than by Craib or box corers.'@en ;
    skos:notation 'SDN:L22::TOOL0653'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0652/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0652/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0652/>;
    dc:modified '2013-11-19T10:00:04'^^xsd:dateTime ;
    skos:altLabel 'CEFAS 4m beam trawl'^^xsd:string ;
    skos:prefLabel 'CEFAS 4m survey beam trawl'@en ;
    skos:definition 'This is the standard net used by the CEFAS fisheries laboratory for beam trawl surveys in UK coastal waters. The net is held open by a 4m (measured inside the end plates) metal beam with a chain mat attached to the beam to increase seabed disturbance. 75mm cod ends were optionally fitted with 40mm liners. Post-1991 80mm (post-1991) cod ends were always fitted with 40mm liners.'@en ;
    skos:notation 'SDN:L22::TOOL0652'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0651/2/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0651/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0651/>;
    dc:modified '2013-11-19T09:51:15'^^xsd:dateTime ;
    skos:altLabel 'Beam trawl'^^xsd:string ;
    skos:prefLabel 'Unknown beam trawl'@en ;
    skos:definition 'A net that is held open by a solid wooden or metal beam, attached to plates at the ends that act as runners over the seabed. The beam can vary in length from 2-12m. A chain mat may be fitted to the beam to increase seabed disturbance. The net is towed on the seabed and the resulting disturbance causes fish and shellfish to swim up and get caught in the net.'@en ;
    skos:notation 'SDN:L22::TOOL0651'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0650/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0650/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0650/>;
    dc:modified '2013-11-12T13:16:41'^^xsd:dateTime ;
    skos:altLabel 'Unknown HPLC'^^xsd:string ;
    skos:prefLabel 'Unknown high-performance liquid chromatograph'@en ;
    skos:definition 'A high-performance liquid chromatograph that separates and analyses compounds present in a liquid sample. Separation results from the difference in the relative distribution ratios of the solutes between a solid stationary phase packed into a column and a liquid mobile phase. The separated compound bands which elute from the column are then measured using a detector. HPLC forces the mobile phase under high pressures which is distinguished from traditional liquid chromatography which relies on the force of gravity. The HPLC also has better separation of the components due to the smaller particle size of the column packing material. HPLC instruments usually consist of a reservoir of mobile phase, a pump, an injector, a separation column and a detector.'@en ;
    skos:notation 'SDN:L22::TOOL0650'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0649/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0649/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0649/>;
    dc:modified '2013-10-14T14:10:43'^^xsd:dateTime ;
    skos:altLabel 'Agilent 6890N GC'^^xsd:string ;
    skos:prefLabel 'Agilent 6890 networked gas chromatograph'@en ;
    skos:definition 'A networked gas chromatograph that separates and analyses gas mixtures in water or air. The instrument includes a dual channel design supporting two inlets and two detectors. An automatic liquid sampling system is integrated into the mainframe control. Atmospheric pressure and temperature compensation is standard. The instrument supports 6 column oven ramps with 7 plateaus. The 6890N is customisable depending on the application, with choices of inlets, columns, detectors and sampling systems. All detectors include electronic pneumatics control and electronic on/off for all detector gases. Carrier and makeup gas settings are selectable for He, H2, N2, and argon/methane. The instrument has a 7683 ALS interface and incorporates local area network technology as standard. The Agilent 6890N replaced the HP Agilent 5890, and is no longer in production having itself been replaced by the 7890.'@en ;
    skos:notation 'SDN:L22::TOOL0649'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0647/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0647/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0647/>;
    dc:modified '2013-09-30T14:21:04'^^xsd:dateTime ;
    skos:altLabel 'CS215 Temperature and Relative Humidity Probe'^^xsd:string ;
    skos:prefLabel 'Campbell Scientific 215 Temperature and Relative Humidity Probe'@en ;
    skos:definition 'A meteorological sensor that uses the Sensirion SHT75 combined temperature and relative humidity element based on Sensiria combined temperature and humidity element called the Sensirion\'s CMOSens technology. This sensor comes pre-calibrated, is field-replacable and outputs an SDI-12 signal that can be measured by most Campbell Scientific dataloggers.'@en ;
    skos:notation 'SDN:L22::TOOL0647'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0646/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0646/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0646/>;
    dc:modified '2013-09-30T14:19:16'^^xsd:dateTime ;
    skos:altLabel 'CS 50Y Temperature and Relative Humidity Probe'^^xsd:string ;
    skos:prefLabel 'Campbell Scientific 50Y Temperature and Relative Humidity Probe'@en ;
    skos:definition 'A meteorological probe that uses a 1000 ohm platinum resistance thermometer to measure temperature and a Vaisala (INTERCAP) capacitive humidity sensor to measure relative humidity. The instrument has a total operating range of -40 degC to +60 degC for temperature and a range of 0 to 100 percent for relative humidity.'@en ;
    skos:notation 'SDN:L22::TOOL0646'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0644/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0644/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0644/>;
    dc:modified '2013-09-24T15:49:25'^^xsd:dateTime ;
    skos:altLabel 'SBE 7 microstructure conductivity sensor'^^xsd:string ;
    skos:prefLabel 'Sea-Bird SBE 7 microstructure conductivity sensor'@en ;
    skos:definition 'Microstructure conductivity sensor designed for use on marine profiling applications to characterise small scale ocean conductivity features. The sensor is primarily used for the determination of conductivity gradients but it is configured to respond to absolute conductivity as well. The SBE 7 has an accuracy typically within 0.005 S m^-1 over periods of several hours and has a high speed micro-scale resolution of 3 dbar at 100 cycles ^-1 (-3 dbar at 1000 Hz). The sensor has aluminium housing and a depth rating of 6800 m.'@en ;
    skos:notation 'SDN:L22::TOOL0644'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0638/2/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0638/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0638/>;
    dc:modified '2013-08-29T15:54:12'^^xsd:dateTime ;
    skos:altLabel 'Valeport 208 CM'^^xsd:string ;
    skos:prefLabel 'Valeport BFM 208 current meter'@en ;
    skos:definition 'A current meter with styrene impeller current sensor and relatively low resolution (6-bit) compass. In self-recording mode the compass and rotor count were read every 5 seconds and summed over the required sampling interval. A 5-second data stream including corrected vector data was output via a connector to facilitate use as a direct reading instrument. Further information may be found in http://www.bodc.ac.uk/data/documents/nodb/95303/ .'@en ;
    skos:notation 'SDN:L22::TOOL0638'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0637/2/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0637/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0637/>;
    dc:modified '2013-08-22T15:37:19'^^xsd:dateTime ;
    skos:altLabel 'SeaTech 57S fluorometer'^^xsd:string ;
    skos:prefLabel 'SeaTech 57S fluorometer'@en ;
    skos:definition 'A linear-response submersible chlorophyll-a fluorometer fitted to CTD packages in the early 1990s.'@en ;
    skos:notation 'SDN:L22::TOOL0637'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0635/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0635/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0635/>;
    dc:modified '2013-08-14T15:42:08'^^xsd:dateTime ;
    skos:altLabel 'Automated coulometer'^^xsd:string ;
    skos:prefLabel 'Automated Coulometer (Robinson and Williams, 1992)'@en ;
    skos:definition 'An automated coulometric titration system used for the continual measurement of dissolved inorganic carbon (TCO2), developed by Robinson and Williams (1992). The instrument consists of a sampling pipette, CO2 extractor-stripper, scrubbers and a coulometer interfaced with a PC. The equivalence point is detected photometrically with thymolphthalein as the indicator. It is based on the Johnson et al. (1987) 5011 coulometer manufactured by UIC, but with a number of improvements, including: improved analytical time of 6 minutes; solid state optical liquid-level switches; a three-way mixer valve to allow interchange between sample and standard input; and replacement of PTFE tubing with stainless steel. The Robinson and Williams (1992) coulometer achieves an analytical precision (1 SD) of +/-0.5-1.0 umol/kg (0.025-0.05 percent) and accuracy of 0.15 percent.'@en ;
    skos:notation 'SDN:L22::TOOL0635'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0242/3/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0242/3/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0242/>;
    dc:modified '2013-08-01T09:53:30'^^xsd:dateTime ;
    skos:altLabel 'Guildline 8410 salinometer'^^xsd:string ;
    skos:prefLabel 'Guildline Portasal 8410 series salinometer'@en ;
    skos:definition 'A portable instrument for laboratory or field use that determines salinity of a water sample by comparison of its electrical conductivity with a standard solution. The system employs a continuous flow system, where the sample is drawn into the unit under low air pressure. A high stability temperature control bath and heat exchanger maintain the sample at a precisely defined, user selected temperature during analysis. The instrument can operate over a conductivity range of 0.004 to 76 mS/cm with a resolution of 0.0003 mS/cm (15 deg C and 35 PSU) or 0.0003 Equivalent PSU, and an accuracy of ± 0.003 Equivalent PSU (same set point temperature as standardization and within -2 deg C and +4 deg C of ambient). The series consists of 2 known models: 8410 and 8410A. The models have the same specifications although the 8410A has an RS232 interface. The reference number 8410N refers to an operational manual update only.'@en ;
    skos:notation 'SDN:L22::TOOL0242'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0633/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0633/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0633/>;
    dc:modified '2013-07-31T14:01:26'^^xsd:dateTime ;
    skos:altLabel 'Metrohm 716'^^xsd:string ;
    skos:prefLabel 'Metrohm 716 DMS Titrino'@en ;
    skos:definition 'A titrator used for dynamic and monotonic titrations. The instrument consists of an exchange unit, a magnetic stirer, and a live display. It measures pH in the range -20 to 20, voltage in the range -2000 to 2000 mV, and current in the range -200 to 200 uA. Temperature is measured by either Pt1000 or Pt100 in the range -150 to 450 degC.'@en ;
    skos:notation 'SDN:L22::TOOL0633'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0632/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0632/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0632/>;
    dc:modified '2013-07-31T12:02:32'^^xsd:dateTime ;
    skos:altLabel 'Beckman LS 6000 Scintillation system'^^xsd:string ;
    skos:prefLabel 'Beckman Coulter LS 6000 Series Scintillation System'@en ;
    skos:definition 'A benchtop liquid scintillation analyser for counting the level of radioactive decay in a sample. Typically the instrument features a Multichannel Analyzer and a quench monitor.  Sample capacity is either 336 standard vials, or 648 miniature vials. It has an operating ambient temperature range of 15-35 degC.'@en ;
    skos:notation 'SDN:L22::TOOL0632'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0630/2/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0630/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0630/>;
    dc:modified '2013-07-29T16:31:23'^^xsd:dateTime ;
    skos:altLabel 'SIS DOA'^^xsd:string ;
    skos:prefLabel 'SIS Dissolved Oxygen Analyser'@en ;
    skos:definition 'A PC-controlled instrument for determining dissolved oxygen using the Winkler (1888) titration method. The system consists of a transportable box containing a motor burette, an alternating light photometer and a stand with stirrer for the sample flask. The titration endpoint is determined by eye. The photometer is connected to a PC by an interface cable via an RS 232 serial link.'@en ;
    skos:notation 'SDN:L22::TOOL0630'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0631/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0631/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0631/>;
    dc:modified '2013-07-29T16:29:24'^^xsd:dateTime ;
    skos:altLabel 'CHN analyser'^^xsd:string ;
    skos:prefLabel 'CHN elemental analyser'@en ;
    skos:definition 'A laboratory instrument that primarily determines total carbon, hydrogen and nitrogen in a sample but may also measure total sulphur and oxygen. Flash combustion is used to convert all organic and inorganic substances into combustion products. The resulting combustion gases pass through a reduction furnace and are then swept into the chromatographic column by a carrier gas where they are separated and detected.'@en ;
    skos:notation 'SDN:L22::TOOL0631'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0031/2/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0031/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0031/>;
    dc:modified '2013-07-25T16:07:40'^^xsd:dateTime ;
    skos:altLabel 'WLR 7'^^xsd:string ;
    skos:prefLabel 'Aanderaa WLR 7 Water Level Recorder'@en ;
    skos:definition 'A bottom pressure recorder for measuring sea level in shallow waters with optional Fenwall thermistor temperature sensor logging to an internal solid-state data storage unit. More information is available in http://www.bodc.ac.uk/data/documents/nodb/225584/.'@en ;
    skos:notation 'SDN:L22::TOOL0031'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0629/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0629/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0629/>;
    dc:modified '2013-07-25T15:31:48'^^xsd:dateTime ;
    skos:altLabel 'WLR 5'^^xsd:string ;
    skos:prefLabel 'Aanderaa WLR 5 Water Level Recorder'@en ;
    skos:definition 'A bottom pressure recorder for measuring sea level in shallow waters with optional Fenwall thermistor temperature sensor logging to an internal magnetic tape unit. More information is available in http://www.bodc.ac.uk/data/documents/nodb/67867/.'@en ;
    skos:notation 'SDN:L22::TOOL0629'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0628/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0628/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0628/>;
    dc:modified '2013-07-02T16:03:17'^^xsd:dateTime ;
    skos:altLabel 'Focal Technologies OPC'^^xsd:string ;
    skos:prefLabel 'Focal Technologies Corporation optical plankton counter'@en ;
    skos:definition 'An in-situ instrument with a sampling tunnel that causes particles (presumed to be plankton) to pass through a collimated light beam that measures their effective spherical diameters. Counts are produced over the sampling interval (typically 30 seconds) of the number of particles in each of 128 equal size classes within a size range of 0-5500 microns. More information may be found in http://www.bodc.ac.uk/data/documents/nodb/104842/.'@en ;
    skos:notation 'SDN:L22::TOOL0628'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0627/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0627/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0627/>;
    dc:modified '2013-06-12T15:43:27'^^xsd:dateTime ;
    skos:altLabel 'Aanderaa 4319B'^^xsd:string ;
    skos:prefLabel 'Aanderaa conductivity sensor 4319B'@en ;
    skos:definition 'An inductive conductivity sensor designed to operate over a range of 0-7.5 S/m with a resolution of 0.0002 S/m and an accuracy of +/- 0.0018 S/m. The instrument includes a temperature sensor with a range of -5 to 40 degC, a resolution of 0.01 degC and an accuracy of +/-0.1 degC. The shallow water (SW) version of the instrument is rated to 300 m, the intermediate water (IW) version to 2000 m and the deep water (DW) version to 6000 m. The instrument has a titanium casing and can be interfaced with the Aanderaa RCM9/11 or RDCP, or used for standalone operations. Unlike the Aanderaa 3919A, the 4319A incorporates SmartGuard data logger connectivity, and updated AADI protocol.'@en ;
    skos:notation 'SDN:L22::TOOL0627'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0626/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0626/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0626/>;
    dc:modified '2013-06-12T15:42:34'^^xsd:dateTime ;
    skos:altLabel 'Aanderaa 4319A'^^xsd:string ;
    skos:prefLabel 'Aanderaa conductivity sensor 4319A'@en ;
    skos:definition 'An inductive conductivity sensor designed to operate over a range of 0-7.5 S/m with a resolution of 0.0002 S/m and an accuracy of +/- 0.005 S/m. The instrument includes a temperature sensor with a range of -5 to 40 degC, a resolution of 0.01 degC and an accuracy of +/-0.1 degC. The shallow water (SW) version of the instrument is rated to 300 m, the intermediate water (IW) version to 2000 m and the deep water (DW) version to 6000 m. The instrument has a titanium casing and can be interfaced with the Aanderaa RCM9/11 or RDCP, or used for standalone operations. Unlike the Aanderaa 3919A, the 4319A incorporates SmartGuard data logger connectivity, and updated AADI protocol.'@en ;
    skos:notation 'SDN:L22::TOOL0626'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0623/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0623/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0623/>;
    dc:modified '2013-06-10T15:51:02'^^xsd:dateTime ;
    skos:altLabel 'Kongsberg Seatex DPS 116'^^xsd:string ;
    skos:prefLabel 'Kongsberg Seatex Differential Positioning Sensor 116'@en ;
    skos:definition 'A 14-channel, all-in-view, L1 GPS receiver which primarily utilises the free, WAAS, EGNOS and MSAS Satellite Based Augmentation Systems (SBAS) for differential corrections (DGPS). It is also capable of simultaneous DGPS from a wide variety of other reference stations (Multiref), resulting in improved accuracy. Positional accuracy is < 1.5 m, 95% CEP (SBAS service) and < 1 m, 95% CEP (Multiref). Output rate is 1 Hz.'@en ;
    skos:notation 'SDN:L22::TOOL0623'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0622/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0622/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0622/>;
    dc:modified '2013-06-05T14:58:36'^^xsd:dateTime ;
    skos:altLabel 'Cary Porter tide gauge'^^xsd:string ;
    skos:prefLabel 'Cary Porter tide gauge'@en ;
    skos:definition 'An analogue instrument that measured sea level by a float in a stilling well that was mechanically coupled to a pen recording on a rotating drum.'@en ;
    skos:notation 'SDN:L22::TOOL0622'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0621/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0621/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0621/>;
    dc:modified '2013-06-04T16:11:11'^^xsd:dateTime ;
    skos:altLabel 'Teleost BPR'^^xsd:string ;
    skos:prefLabel 'Teleost Pressure Recorder'@en ;
    skos:definition 'A pressure recorder developed by the Institute of Oceanographic Sciences Bidston Laboratory in the late 1970s to measure sea level at offshore locations. It comprised a Bell and Howell strain gauge or a Digiquartz pressure transducer with an optional platinum resistance thermometer. Data were logged by an adapted Aanderaa current meter logger. More information is available at http://www.bodc.ac.uk/data/documents/nodb/27840/.'@en ;
    skos:notation 'SDN:L22::TOOL0621'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0620/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0620/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0620/>;
    dc:modified '2013-05-09T16:22:25'^^xsd:dateTime ;
    skos:altLabel 'Steedman CM01 ACM'^^xsd:string ;
    skos:prefLabel 'Steedman Science and Engineering CM01 Acoustic Current Meter'@en ;
    skos:definition 'A recording current meter fitted with two orthogonal acoustic transducers and a flux-gate compass. The water velocity is measured using an acoustic phase shift technique and the resulting current vectors are averaged over a user-specified interval. Further information may be found in http://www.bodc.ac.uk/data/documents/nodb/148626/.'@en ;
    skos:notation 'SDN:L22::TOOL0620'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0619/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0619/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0619/>;
    dc:modified '2013-05-09T14:54:45'^^xsd:dateTime ;
    skos:altLabel 'VIZ 1223 Radiosonde'^^xsd:string ;
    skos:prefLabel 'VIZ 1223 Radiosonde'@en ;
    skos:definition 'An instrument package in common use in the 1970s and 1980s comprising a rod thermistor (for air temperature measurements), a carbon hygristor (for humidity measurements) and an aneroid pressure sensor with a radio data transmitter. The package was attached to a balloon filled with hydrogen or helium and released to measure an atmospheric profile on the ascent and, if fitted with a parachute, the descent. The radio retransmitted LORAN-C signals allowing the balloon to be tracked giving measurements of winds.'@en ;
    skos:notation 'SDN:L22::TOOL0619'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0618/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0618/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0618/>;
    dc:modified '2013-04-23T12:30:40'^^xsd:dateTime ;
    skos:altLabel 'Rotronic Hygromet series'^^xsd:string ;
    skos:prefLabel 'Rotronic Instruments Hygromet (MP1xxH) humidity and temperature probe series'@en ;
    skos:definition 'An analogue atmospheric humidity and temperature probe. The instrument operates within 0-100 percent relative humidity, with an accuracy of +/-0.8 percent. The temperature range varies between -50 to 80 degC and has an accuracy of +/- 0.1 degC.'@en ;
    skos:notation 'SDN:L22::TOOL0618'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0617/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0617/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0617/>;
    dc:modified '2013-04-23T12:30:38'^^xsd:dateTime ;
    skos:altLabel 'Rotronic MP100 series'^^xsd:string ;
    skos:prefLabel 'Rotronic Instruments MP1xxA humidity and temperature probe series'@en ;
    skos:definition 'An analogue, linear response atmospheric humidity and temperature probe. The instrument operates within 0-100 percent relative humidity (0 to 1 volts), with an accuracy of +/-1 percent. The temperature range varies between -40 to 60 degC (-0.4 to 0.6 volts) depending on the specific model and has an accuracy of +/-0.3 degC.'@en ;
    skos:notation 'SDN:L22::TOOL0617'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0614/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0614/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0614/>;
    dc:modified '2013-04-23T11:31:40'^^xsd:dateTime ;
    skos:altLabel 'Burkard SFA 2000'^^xsd:string ;
    skos:prefLabel 'Burkard Scientific SFA 2000 colorimetric AA-II segmented flow analyser'@en ;
    skos:definition 'A colorimetric segmented flow nutrient AA-II analyser. The standard high sensitivity colorimetric and UV detectors use filter technology and flow through cells with a range of path lengths from 3-50mm.'@en ;
    skos:notation 'SDN:L22::TOOL0614'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0613/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0613/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0613/>;
    dc:modified '2013-04-16T10:43:05'^^xsd:dateTime ;
    skos:altLabel 'Hydrolab DS3'^^xsd:string ;
    skos:prefLabel 'Hydrolab DataSonde 3 Water Quality Multiple Probe Logger'@en ;
    skos:definition 'The DS3 multiparameter DataSonde is a multiprobe logger which allows simultaneous measurement of water quality parameters. The measured/calculated parameters are surface elevation, dissolved oxygen (0-20 mg/L) and oxygen saturation, conductivity, salinity (0-70 PSU), temperature (-5 to 50 degC), turbidity, depth (0-100 m), pH and oxidation/reduction potential.'@en ;
    skos:notation 'SDN:L22::TOOL0613'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0612/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0612/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0612/>;
    dc:modified '2013-04-11T16:07:16'^^xsd:dateTime ;
    skos:altLabel 'IOS SBWR'^^xsd:string ;
    skos:prefLabel 'Institute of Oceanographic Sciences shipborne wave recorder'@en ;
    skos:definition 'A vessel-mounted wave recorder comprising a pair of heave transducers (accelerometers), a pair of pressure transducers, a signal processing unit and a data recorder. One heave transducer (measures long-period waves) and one pressure transducer (measures short-period waves) are mounted together on each side of the vessel close to the centre of pitch and 1-3m below the water-line to reduce the influence of pitch and roll. Waves of up to 30m height and 25 seconds period can be measured; the lower detectable limit depends on the installation depth of the pressure units. More information may be found in http://www.bodc.ac.uk/data/documents/nodb/45603/.'@en ;
    skos:notation 'SDN:L22::TOOL0612'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0611/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0611/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0611/>;
    dc:modified '2013-04-10T17:01:43'^^xsd:dateTime ;
    skos:altLabel 'Suber SLS21 VACM'^^xsd:string ;
    skos:prefLabel 'Suber SLS21 vector-averaging current meter'@en ;
    skos:definition 'A current meter fitted with a Savonius rotor magnetically coupled to a reed switch counter, a vane on tungsten carbide bearings magnetically coupled to a compass and solid-state crystal clock. Current vectors were continuously measured and then averaged after a specified time interval (generally 10 minutes) by an on-board minicomputer to produce the logged data values. Accuracy was 2 per cent for speed, 4 degrees for direction and 2 seconds per day for the clock. Casings were available for operating depths of 1000m, 3000m and 6000m.More information may be found in http://www.bodc.ac.uk/data/documents/nodb/19202/'@en ;
    skos:notation 'SDN:L22::TOOL0611'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0610/2/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0610/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0610/>;
    dc:modified '2013-04-10T16:41:24'^^xsd:dateTime ;
    skos:altLabel 'Neyrpic bubbler'^^xsd:string ;
    skos:prefLabel 'Neyrpic bubbler pressure gauge'@en ;
    skos:definition 'An early tide gauge comprising a seabed-mounted gas outlet and a manometer to measure the compressed gas pressure necessary to force gas through this outlet. The manometer comprised a stainless steel float in a tube that was connected through pulleys to a clockwork chart recorder. Chart advance speed was 2.5, 5, 10 or 20 mm/hour (10 mm/hour was generally used for tidal measurements) and pressure ranges corresponding to depth scales of 0-3m, 0-6m, 0-9m, 0-12m or 0-18m were available. More information may be found in http://www.bodc.ac.uk/data/documents/nodb/27190/'@en ;
    skos:notation 'SDN:L22::TOOL0610'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0609/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0609/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0609/>;
    dc:modified '2013-03-22T16:47:03'^^xsd:dateTime ;
    skos:altLabel 'Biral VPF-730 sensor'^^xsd:string ;
    skos:prefLabel 'Biral HSS VPF-730 Visibility and Present Weather Sensor'@en ;
    skos:definition 'An infrared forward scatter meter  which measures horizontal visibility and precipitation. The sensor measures the amount of light scattered by small suspended particulates (i.e. fog, haze and smoke aerosols) or larger particles (i.e. rain, snow, ice pellets, drizzle and mist) passing through the sample volume. The sensor calculates the atmosphere EXtinction COefficient (EXCO) from which the Meteorological Optical Range (MOR) is calculated. Using an infra-red light source and intelligent sensing technology the measurements are unaffected by other light-sources.'@en ;
    skos:notation 'SDN:L22::TOOL0609'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0608/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0608/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0608/>;
    dc:modified '2013-03-22T16:42:24'^^xsd:dateTime ;
    skos:altLabel 'Eliasson CBME80 cloud ceilometer'^^xsd:string ;
    skos:prefLabel 'Eliasson CBME80 infrared laser diode cloud ceilometer'@en ;
    skos:definition 'An infrared laser diode measuring the cloud base height or vertical visibility and cloud amount. The design is based on the LIDAR principle. The light emitting component is a low power diode laser with the output power limited to eye-safe level. Real time digitising technique is used in signal detection and the 80C186 microprocessor is used in signal processing.'@en ;
    skos:notation 'SDN:L22::TOOL0608'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0607/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0607/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0607/>;
    dc:modified '2013-03-22T16:36:45'^^xsd:dateTime ;
    skos:altLabel 'Munro SO/8 anemometer'^^xsd:string ;
    skos:prefLabel 'Munro SO/8 cup and vane anemometer'@en ;
    skos:definition 'A cup and vane anemometer measuring horizontal wind speed and direction.'@en ;
    skos:notation 'SDN:L22::TOOL0607'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0606/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0606/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0606/>;
    dc:modified '2013-03-22T16:34:21'^^xsd:dateTime ;
    skos:altLabel 'Muir Matheson OMC-150'^^xsd:string ;
    skos:prefLabel 'Muir Matheson OMC-150 Combined Wind Speed and Direction Sensor'@en ;
    skos:definition 'A cup and vane anemometer measuring horizontal wind speed and direction that is suitable for hazardous environments.'@en ;
    skos:notation 'SDN:L22::TOOL0606'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0603/3/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0603/3/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0603/>;
    dc:modified '2013-03-13T16:11:10'^^xsd:dateTime ;
    skos:altLabel 'WERA HF Radar'^^xsd:string ;
    skos:prefLabel 'Helzel Messtechnik WERA HF Radar'@en ;
    skos:definition 'A shore based remote sensing HF radar system used for near real-time mapping of ocean surface currents, waves and wind direction using short radio wave radar. It is a long-range, high resolution monitoring sytem which can detect signals from ranges of more than 200 km.'@en ;
    skos:notation 'SDN:L22::TOOL0603'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0058/3/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0058/3/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0058/>;
    dc:modified '2013-03-13T15:55:10'^^xsd:dateTime ;
    skos:altLabel 'SBE 911+ CTD'^^xsd:string ;
    skos:prefLabel 'Sea-Bird SBE 911plus CTD'@en ;
    skos:definition 'High precision and accuracy CTD comprising an SBE 9plus underwater unit (SBE 3 temperature and SBE 4 conductivity sensors) and an SBE 11plus deck unit. Sensors may be connected to a pump-fed plastic tubing circuit (usually temperature, salinity and oxygen) or stand-alone. All instruments (8 channels available) on the package are logged by the SBE 11. The unit is the production off the shelf version of the SBE 911 (each 911 was custom built to individual specification).'@en ;
    skos:notation 'SDN:L22::TOOL0058'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0214/3/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0214/3/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0214/>;
    dc:modified '2013-03-13T15:55:10'^^xsd:dateTime ;
    skos:altLabel 'SBE 917+ CTD'^^xsd:string ;
    skos:prefLabel 'Sea-Bird SBE 917plus CTD'@en ;
    skos:definition 'High precision and accuracy CTD comprising an SBE 9plus underwater unit (SBE 3 temperature and SBE 4 conductivity sensors) and an SBE 17plus SEARAM data logger. Sensors may be connected to a pump-fed plastic tubing circuit (usually temperature, salinity and oxygen) or stand-alone. All instruments (8 channels available) on the package are logged by the SBE 17+, which provides battery power, has memory for CTD data recording, and provides autonomous carousel water sampler control.'@en ;
    skos:notation 'SDN:L22::TOOL0214'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0601/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0601/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0601/>;
    dc:modified '2013-02-27T15:52:20'^^xsd:dateTime ;
    skos:altLabel 'LAIPAC GD30L GPS'^^xsd:string ;
    skos:prefLabel 'LAIPAC GD30L MMC Global Positioning System logger'@en ;
    skos:definition 'A high performance Global Positioning System (GPS) recorder and vehicle tracking system for passive tracking applications. The maximum sampling interval selectable is 3 seconds, with a minimum sampling interval of 30 minutes. The recorded data includes date, time, longitude, latitude, speed, trajectory, and number of tracking satellites.'@en ;
    skos:notation 'SDN:L22::TOOL0601'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0599/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0599/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0599/>;
    dc:modified '2013-02-07T15:47:04'^^xsd:dateTime ;
    skos:altLabel 'POL 250kHz ADCP'^^xsd:string ;
    skos:prefLabel 'Proudman Oceanographic Laboratory 250kHz ADCP'@en ;
    skos:definition 'An ADCP with a range of 100 m, designed to measure currents in up to 24 bins. Data from bins in the shallowest 25 percent of the depth range (ie: closest to the transducer) and in the deepest 10 percent (furthest from the transducer) are unreliable due to interference. The instrument uses two orthogonal beams and a built-in compass to resolve northward and eastward components of current.'@en ;
    skos:notation 'SDN:L22::TOOL0599'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0600/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0600/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0600/>;
    dc:modified '2013-02-07T15:46:44'^^xsd:dateTime ;
    skos:altLabel 'POL 1MHz ADCP'^^xsd:string ;
    skos:prefLabel 'Proudman Oceanographic Laboratory 1MHz ADCP'@en ;
    skos:definition 'An ADCP with a range of 30 m, designed to measure currents in up to 24 bins. Data from bins in the shallowest 15 percent of the depth range (ie: closest to the transducer) and in the deepest 10 percent (furthest from the transducer) are unreliable due to interference. The instrument uses two orthogonal beams and a built-in compass to resolve northward and eastward components of current.'@en ;
    skos:notation 'SDN:L22::TOOL0600'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0598/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0598/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0598/>;
    dc:modified '2013-02-07T15:46:03'^^xsd:dateTime ;
    skos:altLabel 'POL 75kHz ADCP'^^xsd:string ;
    skos:prefLabel 'Proudman Oceanographic Laboratory 75kHz ADCP'@en ;
    skos:definition 'An ADCP designed to use low-frequency sound (actually 79-80 kHz) for optimum performance in water depths between 500 and 1000 m. The instrument was originally built with two orthogonal beams, but following the initial, 2-week deployment, it was modified to include a third beam.'@en ;
    skos:notation 'SDN:L22::TOOL0598'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0597/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0597/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0597/>;
    dc:modified '2013-01-31T15:26:40'^^xsd:dateTime ;
    skos:altLabel 'Bangor OCS'^^xsd:string ;
    skos:prefLabel 'Bangor Ocean Colour Sensor'@en ;
    skos:definition 'An ocean colour sensor set measuring upwelling irradiance at 440, 490, 570 and 670 nm that was designed and built by the School of Ocean Sciences, Bangor University.  Data were integrated over a 30-second period and logged every 10 or 30 minutes.'@en ;
    skos:notation 'SDN:L22::TOOL0597'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0596/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0596/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0596/>;
    dc:modified '2013-01-31T15:12:27'^^xsd:dateTime ;
    skos:altLabel 'STABLE2'^^xsd:string ;
    skos:prefLabel 'Sediment Transport and Boundary Layer Equipment Mark II'@en ;
    skos:definition 'A pop-up benthic lander with four Savonius rotor current sensors between 0.2 and 2 metres above the bed, a current vane and compass for current direction, a digiquartz pressure sensor and a data logger with an integral temperature sensor. Further information may be found in http://www.bodc.ac.uk/data/documents/nodb/68616/'@en ;
    skos:notation 'SDN:L22::TOOL0596'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0454/2/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0454/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0454/>;
    dc:modified '2013-01-25T12:33:29'^^xsd:dateTime ;
    skos:altLabel '8400 salinometer'^^xsd:string ;
    skos:prefLabel 'Guildline 8400 bench salinometer'@en ;
    skos:definition 'A laboratory instrument that determines salinity of a water sample by comparison of its electrical conductivity with a standard solution. The system employs a continuous flow system, where the sample is drawn into the unit under low air pressure. A high stability temperature control bath and heat exchanger maintain the sample at a precisely defined, user selected temperature during analysis. The instrument can operate over a salinity range of 0.005 to 42 with a resolution of < 0.0002 and an accuracy of < +/- 0.002. There are two models: 8400A and 8400B. The 8400A has an external interface as an optional extra.  The 8400B has improved stability over long periods and the external interface is fitted as standard.'@en ;
    skos:notation 'SDN:L22::TOOL0454'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0595/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0595/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0595/>;
    dc:modified '2013-01-25T11:59:48'^^xsd:dateTime ;
    skos:altLabel 'Metrohm 794 Basic Titrino'^^xsd:string ;
    skos:prefLabel 'Metrohm 794 Basic Titrino Titrator'@en ;
    skos:definition 'A titrator used for dynamic and monotonic titrations. The instrument consists of an exchange unit, a magnetic or propellor stirrer, a small display and remote control. The instrument measures pH in the range -20 to 20 (resolution 0.01), voltage in the range -2000 to 2000 mV (resolution 1 mV), current in the range -200 to 200 uA (resolution 1 uA), and temperature in the range -150 to 450 degC (resolution 1 degC).'@en ;
    skos:notation 'SDN:L22::TOOL0595'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0568/2/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0568/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0568/>;
    dc:modified '2013-01-25T11:58:57'^^xsd:dateTime ;
    skos:altLabel 'Metrohm 848 Titrino Plus'^^xsd:string ;
    skos:prefLabel 'Metrohm 848 Titrino Plus Titrator'@en ;
    skos:definition 'A titrator used for dynamic and monotonic titrations. The instrument consists of an exchange unit, a magnetic or propellor stirrer, and a large, live display. It measures pH in the range -13 to 20 (resolution 0.001), voltage in the range -1200 to 1200 mV (resolution 0.1 mV), and current in the range -120 to 120 uA (resolution 1 uA). Teperature is measured by either Pt1000 (range -150 to 250 degC, resolution 0.1 degC, accuracy +/- 0.2 degC), or NTC (range -5 to 250 degC, resolution 0.1 degC, accuracy +/- 0.6 degC).'@en ;
    skos:notation 'SDN:L22::TOOL0568'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0594/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0594/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0594/>;
    dc:modified '2013-01-23T09:58:33'^^xsd:dateTime ;
    skos:altLabel 'IOS MkII BPR'^^xsd:string ;
    skos:prefLabel 'Institute of Oceanographic Sciences MkII bottom pressure recorder'@en ;
    skos:definition 'The instrument comprised a strain gauge, vibrating wire or quartz pressure sensor and a temperature sensor in a self-contained housing connected to release and senor electronics, a data logger and battery pack located in an aluminium sphere. The logger was able to sample at intervals between 1.875 and 60 minutes with the inputs sampled continuously to give data values integrated over virtually the whole sampling interval.'@en ;
    skos:notation 'SDN:L22::TOOL0594'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0593/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0593/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0593/>;
    dc:modified '2013-01-23T09:30:18'^^xsd:dateTime ;
    skos:altLabel 'FSI Excell TSG'^^xsd:string ;
    skos:prefLabel 'Falmouth Scientific Instruments Excell thermosalinograph'@en ;
    skos:definition 'The instrument comprises an FSI internal field conductivity sensor (NXIC cell) and two precision platinum resistance thermometers to provide salinity mounted in a urethane through-flow housing.  The temperature sensors are located at the inlet and outlet to provide an integrated temperature measurement across the conductivity sensor.  The salinity range is 2 to 42 PSU  and the accuracy id +- 0.03 PSU.  Sea temperature is measured by an independently-supplied remote PRT or thermistor located in the hull or seawater inlet.'@en ;
    skos:notation 'SDN:L22::TOOL0593'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0591/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0591/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0591/>;
    dc:modified '2013-01-18T15:13:47'^^xsd:dateTime ;
    skos:altLabel 'Sippican XCTD-1'^^xsd:string ;
    skos:prefLabel 'Lockheed Martin Sippican XCTD-1 probe'@en ;
    skos:definition 'An expendable free-fall CTD profiling system which provides a profile of measured temperature and conductivity against depth calculated using a fall-rate model. This instrument can be used within a maximum depth of 1000 m and may be deployed with a ship speed of up to 12 knots.'@en ;
    skos:notation 'SDN:L22::TOOL0591'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0592/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0592/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0592/>;
    dc:modified '2013-01-18T15:13:47'^^xsd:dateTime ;
    skos:altLabel 'Sippican XCTD-2'^^xsd:string ;
    skos:prefLabel 'Lockheed Martin Sippican XCTD-2 probe'@en ;
    skos:definition 'An expendable free-fall CTD profiling system which provides a profile of measured temperature and conductivity against depth calculated using a fall-rate model. This instrument can be used within a maximum depth of 1850 m and may be deployed with a  ship speed of up to 3.5 knots.'@en ;
    skos:notation 'SDN:L22::TOOL0592'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0590/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0590/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0590/>;
    dc:modified '2013-01-17T10:07:40'^^xsd:dateTime ;
    skos:altLabel 'AA CTR7 TC chain'^^xsd:string ;
    skos:prefLabel 'Aanderaa CTR7 thermistor conductivity chain'@en ;
    skos:definition 'An instrument with up to 5 induction conductivity and thermistor temperature sensor pairs along a string held vertically in the water column and connected to a 12-channel Aanderaa DL7 data logger. The twelfth channel may be used for an optional pressure sensor housed in one of the senor pairs Overall accuracy (+/-) 0.1C for temperature and 0.3 mS/cm for conductivity.  Further information may be found in http://www.bodc.ac.uk/data/documents/nodb/78767/.'@en ;
    skos:notation 'SDN:L22::TOOL0590'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0589/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0589/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0589/>;
    dc:modified '2013-01-17T10:07:40'^^xsd:dateTime ;
    skos:altLabel 'AA T chain'^^xsd:string ;
    skos:prefLabel 'Aanderaa thermistor chain'@en ;
    skos:definition 'An instrument with 11 Fenwal 2K iso-curve thermistors mounted along a string from 10 to 400m long held vertically in the water column and connected to a 12-channel Aanderaa TR or SeaData data logger rated to 2000m depth.  The twelfth channel was used for an internal reference number,  a Bourdon tube pressure sensor (Aanderaa) or an additional thermistor (SeaData) housed in the logger.  Overall accuracy (+/-) is between 0.1 and 0.2C.  Further information may be found in http://www.bodc.ac.uk/data/documents/nodb/67001/.'@en ;
    skos:notation 'SDN:L22::TOOL0589'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0588/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0588/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0588/>;
    dc:modified '2013-01-15T15:43:48'^^xsd:dateTime ;
    skos:altLabel 'Tedlar bag'^^xsd:string ;
    skos:prefLabel 'Tedlar atmospheric sampling bag'@en ;
    skos:definition 'A generic term for atmospheric sampling bags manufactured from Tedlar (DuPont trade name for the chemically inert plastic polyvinyl fluoride) film, fitted with a polypropylene or stainless steel valve and available with capacities ranging from 1-100 litres.  Samples are taken by either pumping air into the bag or evacuating the bag and opening the valve at the sampling site. Filled bags are connected directly to measuring equipment for analysis. Bags are available from several manufactureres and suppliers'@en ;
    skos:notation 'SDN:L22::TOOL0588'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0587/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0587/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0587/>;
    dc:modified '2013-01-14T09:34:23'^^xsd:dateTime ;
    skos:altLabel 'Valeport 308 RCM'^^xsd:string ;
    skos:prefLabel 'Valeport 308 recording current meter'@en ;
    skos:definition 'A self-recording instrument with speed and direction sensors as standard and optional conductivity, temperature and pressure sensors. Speed is measured by a neutrally-buoyant styrene impeller mounted in a jewelled main thrust bearing and PTFE radial guides. Two magnets are fitted to the impeller and a reed switch fitted inside the pressure housing counts the rotations of the impeller.  Direction is sensed using a Valeport two axis, gimballed flux-gate compass.  Temperature is sensed by a Valeport platinum resistance thermometer (PRT) or thermistor, depending on the response and specification required.  Conductivity is sensed by Valeport Inductive coils and pressure by a strain-gauge transducer.   Sensor accuracy is 1.5% for speed, +/- 0.25 degrees for direction, +/-0.02C for PRT temperature, +/-0.1C for thermistor temperature, +/-0.003mS/cm for conductivity and 0.1% to 0.005% full-scale for pressure depending on sensor range.    The vector average is based on a 5 second period during which impeller counts are measured and a single compass reading is made. An average period can be any multiple of 5 seconds up to a maximum of 30 minutes. For the optional parameters, the sample is taken at the end of the sample period and averaged over the averaging period. Further information may be found in http://www.bodc.ac.uk/data/documents/nodb/49777/ .'@en ;
    skos:notation 'SDN:L22::TOOL0587'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0586/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0586/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0586/>;
    dc:modified '2013-01-10T10:16:08'^^xsd:dateTime ;
    skos:altLabel 'NBA DNC-2M RCM'^^xsd:string ;
    skos:prefLabel 'NBA DNC-2M recording current meter'@en ;
    skos:definition 'A self-logging instrument measuring current speed with an impeller directly coupled to an electronic reed switch counter and current direction with a digital magnetic compass with 8-bit optical encoder. Provision is included for three optional sensors each mesuring temperature, pressure or conductivity.  Accuracy quoted as +/- 2 per cent for speed, +/- 5 degrees for direction, +/- 0.2C for temperature, +/- 0.5 per cent for pressure and +/- 2mmho/cm for conductivity. Further information may be found in http://www.bodc.ac.uk/data/documents/nodb/50504/ . Manufacturer went into liquidation in November 2012.'@en ;
    skos:notation 'SDN:L22::TOOL0586'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0585/2/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0585/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0585/>;
    dc:modified '2013-01-10T10:12:44'^^xsd:dateTime ;
    skos:altLabel 'NBA DNC-2B RCM'^^xsd:string ;
    skos:prefLabel 'NBA DNC-2B recording current meter'@en ;
    skos:definition 'A self-logging instrument measuring current speed with an impeller directly coupled to an electronic reed switch counter and current direction with a digital magnetic compass with 7-bit optical encoder. Provision is included for two optional sensors each mesuring temperature, pressure or conductivity.  Accuracy quoted as +/- 2 per cent for speed, +/- 3 degrees for direction, +/- 0.25C for temperature, +/- 1 per cent for pressure and +/- 4 per cent for conductivity. Further information may be found in http://www.bodc.ac.uk/data/documents/nodb/508/ . Manufacturer went into liquidation in November 2012.'@en ;
    skos:notation 'SDN:L22::TOOL0585'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0584/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0584/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0584/>;
    dc:modified '2013-01-10T09:56:58'^^xsd:dateTime ;
    skos:altLabel 'NBA DNC-2 RCM'^^xsd:string ;
    skos:prefLabel 'NBA DNC-2 recording current meter'@en ;
    skos:definition 'A self-logging instrument measuring current speed with an impeller directly coupled to an electronic reed switch counter and current direction with a digital magnetic compass with 7-bit optical encoder. Accuracy quoted as +/- 2 per cent for speed and +/- 3 degrees for direction. Further information may be found in http://www.bodc.ac.uk/data/documents/nodb/508/ . Manufacturer went into liquidation in November 2012.'@en ;
    skos:notation 'SDN:L22::TOOL0584'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0583/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0583/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0583/>;
    dc:modified '2013-01-10T09:41:46'^^xsd:dateTime ;
    skos:altLabel 'NBA DNC-3 DRCM'^^xsd:string ;
    skos:prefLabel 'NBA DNC-3 direct reading current meter'@en ;
    skos:definition 'A direct-reading instrument measuring current speed with an impeller directly coupled to an optical sensor and current direction with a precision double-mounted compass. Accuracy quoted as +/- 0.05 m/s for speed and +/- 10 degrees for direction. Instrument providied continuous readings of instantaneous speed and direction to either analogue/digital gauges or an independent data logger. Manufacturer went into liquidation in November 2012.'@en ;
    skos:notation 'SDN:L22::TOOL0583'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0582/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0582/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0582/>;
    dc:modified '2013-01-09T13:07:22'^^xsd:dateTime ;
    skos:altLabel 'VI H301 psychrometer'^^xsd:string ;
    skos:prefLabel 'Vector Instruments H301 psychrometer'@en ;
    skos:definition 'A precision instrument for the measurement of air temperature and humidity by the wet and dry bulb method.  A pair of 100 Ohm 4-terminal platinum resistance elements were enclosed in a double-walled enclosure with an optional radiation shield to minimise thermal radiation errors.  The wet bulb element was enclosed by a wick leading to a 500 ml water reservoir (sufficient for 7 days) in a fan-driven airflow.  Accuracy was quoted by the manufacturer as 0.2C with a response time of 50 seconds.  The instrument was discontinued in 2010.'@en ;
    skos:notation 'SDN:L22::TOOL0582'^^xsd:string .
