<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0816/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0816/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0816/>;
    dc:modified '2014-12-18T14:00:40'^^xsd:dateTime ;
    skos:altLabel 'LGR N2O+CO 23d analyser'^^xsd:string ;
    skos:prefLabel 'Los Gatos Research N2O and CO 23d ICOS Analyser'@en ;
    skos:definition 'A continuous gas analyser capable of real-time, continuous measurements of ambient N2O,CO and H2O using off-axis integrated cavity output spectroscopy (OA ICOS) - laser absorption. Sub ppb precision (N2O,CO) in less than one second. Maximum Drift 0.1 ppb(CO, N2O) and 50 ppm or 1% of reading (H2O). Precision of 0.1 ppb/0.050 ppb (CO,N2O), 50 ppm/10 ppm (H2O). Operating Temperatures 10 to 35 deg C standard model or 0 to 45 deg C for enhanced model.'@en ;
    skos:notation 'SDN:L22::TOOL0816'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0815/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0815/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0815/>;
    dc:modified '2014-12-10T11:29:01'^^xsd:dateTime ;
    skos:altLabel 'Sperry Marine SRD 500'^^xsd:string ;
    skos:prefLabel 'Sperry Marine SRD 500 Doppler speed log'@en ;
    skos:definition 'A dual-axis Doppler speedlLog operating at 307kHz. This instrument measures speeds in the -20 to 50 knot range  with accuracy of +/- 0.1 (for speeds <2 knots) in bottom tracking mode and +/-0.1 (for speeds <10 knots) in water tracking mode.'@en ;
    skos:notation 'SDN:L22::TOOL0815'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0814/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0814/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0814/>;
    dc:modified '2014-12-10T10:15:48'^^xsd:dateTime ;
    skos:altLabel 'EA501P echosounder'^^xsd:string ;
    skos:prefLabel 'Simrad EA501P echosounder'@en ;
    skos:definition 'A single-beam, single-frequency, portable echosounder for bottom detection. It is housed in an aluminium casing and can be fitted with one of several transducer at differing frequencies (38, 49, 120, 200 and 710 kHz). Maximum depth detection is 1900 m in sewater and 3000 m in freshwater.'@en ;
    skos:notation 'SDN:L22::TOOL0814'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0813/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0813/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0813/>;
    dc:modified '2014-12-09T16:36:40'^^xsd:dateTime ;
    skos:altLabel 'Sperry Marine MK-27F'^^xsd:string ;
    skos:prefLabel 'Sperry Marine MK-27F Gyrocompass'@en ;
    skos:definition 'Fibre optic gyrocompass for heading and attitude. It is designed for millitary applications. Sensor can be either deck or pedestal mounted in sheltered or non-sheltered environment.  Heading accuracy is 0.35 degree secant latitude. Pitch and roll accuracy is 0.1 degrees.'@en ;
    skos:notation 'SDN:L22::TOOL0813'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0812/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0812/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0812/>;
    dc:modified '2014-12-09T14:23:19'^^xsd:dateTime ;
    skos:altLabel 'Eppley TUVR'^^xsd:string ;
    skos:prefLabel 'Eppley Total Ultraviolet Radiometer'@en ;
    skos:definition 'The Eppley Total Ultraviolet Radiometer (TUVR) measures total short-wave solar radiation (295 to 385 nm) with sensitivity of approx. 150 microV/Wm-2. The unit is of brass construction and includes adjustable leveling screws and a circular spirit level. The instrument utilizes a hermetically sealed selenium barrier-layer cell which is protected by a quartz window. An encapsulated narrow bandpass (interference) filter limits the spectral response of the photocell.'@en ;
    skos:notation 'SDN:L22::TOOL0812'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0810/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0810/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0810/>;
    dc:modified '2014-12-08T15:22:19'^^xsd:dateTime ;
    skos:altLabel 'RAMSES ACC-UV radiometer'^^xsd:string ;
    skos:prefLabel 'TriOS RAMSES ACC-UV Hyperspectral UVA and UVB Radiometer'@en ;
    skos:definition 'This is a spectral radiometer measuring over the UV band range (280-500 nm) with a cosine-response to measure irradiance. It is fitted with a 256 channel silicon photodiode array with channels giving 2.2 nm/pixel and a spectral accuracy of 02 nm. Typical saturation (4ms integration time) is 20 W/m2/nm/sr (at 300 nm), 17 W/m2/nm/sr (at 360nm), 18W W/m2/nm/sr (at 500nm). Typical NEI (8ms integration time) is 0.85 microW/m2/nm/sr (at 300nm), 0.75 microW/m2/nm/sr (at 360nm), 0.80 microW/m2/nm/sr (at 500nm). Accuracy is quoted as being better than 6-10 per cent depending on spectral range.'@en ;
    skos:notation 'SDN:L22::TOOL0810'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0809/2/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0809/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0809/>;
    dc:modified '2014-11-19T14:11:16'^^xsd:dateTime ;
    skos:altLabel 'RBR TGR-2050 TG'^^xsd:string ;
    skos:prefLabel 'RBR TGR-2050 submersible tide gauge'@en ;
    skos:definition 'A small (265mm x 38mm OD) self-contained, submersible temperature and pressure logger designed to monitor tide levels without interference from wave action by averaging pressure data sampled at 4 Hz. This operating mode differentiates it from the similar TDR-2050. Temperature channel is calibrated to ±0.002C. Depth channel is calibrated to an accuracy of ±0.05% full scale.'@en ;
    skos:notation 'SDN:L22::TOOL0809'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0808/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0808/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0808/>;
    dc:modified '2014-11-19T12:51:04'^^xsd:dateTime ;
    skos:altLabel 'ST2401 TP'^^xsd:string ;
    skos:prefLabel 'Rosemount ST2401 temperature probe'@en ;
    skos:definition 'A platinum resistor thermometer with a serial interface primarily used for air temperature measurements in meteorological packages but also used as a shipboard hull thermometer.'@en ;
    skos:notation 'SDN:L22::TOOL0808'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0807/3/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0807/3/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0807/>;
    dc:modified '2014-11-12T11:31:22'^^xsd:dateTime ;
    skos:altLabel 'NIOZ 10.5cm steel corer'^^xsd:string ;
    skos:prefLabel 'NIOZ Steel 10.5cm manual sediment corer'@en ;
    skos:definition 'A manual sediment corer produced by NIOZ for sampling sediments in shallow waters from a small boat.  It comprises a 10.5cm diameter (core area 0.009 m2) steel core with a closure at the top attached to a 2m aluminium pole. It is manually pushed approximately 25 cm into the sediment, the top is closed and then it is pulled out complete with the sediment sample.'@en ;
    skos:notation 'SDN:L22::TOOL0807'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0806/2/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0806/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0806/>;
    dc:modified '2014-11-12T11:31:22'^^xsd:dateTime ;
    skos:altLabel 'NIOZ 15cm PVC corer'^^xsd:string ;
    skos:prefLabel 'NIOZ PVC 15cm manual sediment corer'@en ;
    skos:definition 'A manual sediment corer produced by NIOZ for sampling sediments exposed at low tide. It comprises a 1m-long PVC tube with a diameter of 15 cm (core area 0.0175 m2) that has a closure the top. It is manually pushed approximately 25 cm into the sediment, the top is closed and then it is pulled out complete with the sediment sample.'@en ;
    skos:notation 'SDN:L22::TOOL0806'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0640/2/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0640/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0640/>;
    dc:modified '2014-11-12T11:29:50'^^xsd:dateTime ;
    skos:altLabel 'SBE 3F temperature sensor'^^xsd:string ;
    skos:prefLabel 'Sea-Bird SBE 3F temperature sensor'@en ;
    skos:definition 'Water temperature sensor primarily designed for use on the SBE 25 and 25plus Sealogger CTD systems but can be used as a component in custom oceanographic profiling systems or high-accuracy temperature-monitoring applications. The sensor operates over the range -5 to +35 degC and has an initial accuracy of +/-0.001 degC. The sensor has a depth rating of 6800 m (aluminium housing) or 10500 m (titanium housing). The SBE 3F is an enhanced version of the SBE 3 temperature sensor.'@en ;
    skos:notation 'SDN:L22::TOOL0640'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0416/4/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0416/4/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0416/>;
    dc:modified '2014-11-12T11:29:50'^^xsd:dateTime ;
    skos:altLabel 'SBE 3P temperature sensor'^^xsd:string ;
    skos:prefLabel 'Sea-Bird SBE 3plus (SBE 3P) temperature sensor'@en ;
    skos:definition 'Water temperature sensor designed for use on the SBE 9plus CTD system. The sensor operates over the range -5 to +35 °C, a resolution of 0.0003 °C at 24 Hz and an initial accuracy of ± 0.001 °C. The typical sampling rate is 24 Hz, and the sensor has a depth rating of 6800 meters (aluminium housing) or 10500 meters (titanium housing).'@en ;
    skos:notation 'SDN:L22::TOOL0416'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0417/7/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0417/7/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0417/>;
    dc:modified '2014-11-12T11:29:50'^^xsd:dateTime ;
    skos:altLabel 'SBE 4C conductivity sensor'^^xsd:string ;
    skos:prefLabel 'Sea-Bird SBE 4C conductivity sensor'@en ;
    skos:definition 'Water conductivity sensor designed for use on the SBE 9plus or SBE 25 CTD system. The sensor operates over the range 0 to 7 S/m, with a resolution of 0.00004 S/m at 24 Hz and an initial accuracy of 0.0003 S/m. The typical sampling rate is 24 Hz, and the sensor has a depth rating of 3400 meters or 6800 meters (aluminium housing), or 10500 meters (titanium housing).'@en ;
    skos:notation 'SDN:L22::TOOL0417'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/NETT0118/2/> .
<http://vocab.nerc.ac.uk/collection/L22/current/NETT0118/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/NETT0118/>;
    dc:modified '2014-11-12T11:29:50'^^xsd:dateTime ;
    skos:altLabel 'Sameoto neuston sampler'^^xsd:string ;
    skos:prefLabel 'Neuston sampler - Sameoto and Jaroszynski (1969)'@en ;
    skos:definition 'Has a 102 cm x 102 cm square mouth opening aluminium box frame 152 cm long equipped with foam floatation on top, a pair of fins on the side, and a fin on the bottom.  Attached to the back is a net 104 cm x 104 cm at the mouth and 927 cm long made from 0.308 mm nylon mesh. A two-part towing bridle was attached to one side and the sampler kited out away from the side of the vessel beyond the ships wake. Towing speeds 8 to 11 knots [Wiebe and Benfield 2003 Plate 20 E].'@en ;
    skos:notation 'SDN:L22::NETT0118'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0804/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0804/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0804/>;
    dc:modified '2014-11-12T10:38:36'^^xsd:dateTime ;
    skos:altLabel 'Aaanderaa PR'^^xsd:string ;
    skos:prefLabel 'Aanderaa pressure recorder'@en ;
    skos:definition 'An early (1970s) pressure recorder that used a Digiquartz type 2-300a quartz crystal pressure transducer. The pressure sensor consisted of a convoluted bellows linked to a 40kHz quartz crystal resonator coupled by piezoelectric action to an electronic resonator. Data were recorded onto 0.25 inch magnetic tape on an Aanderaa data logger in the same case. A quartz crystal clock was used for controlling the sampling interval. The data were recorded as 10 bit binary words in serial form with the frequency count from the sensor stored as the most and least significant counts.'@en ;
    skos:notation 'SDN:L22::TOOL0804'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0797/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0797/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0797/>;
    dc:modified '2014-09-18T15:18:31'^^xsd:dateTime ;
    skos:altLabel 'Furuno FE 700 echo sounder'^^xsd:string ;
    skos:prefLabel 'Furuno FE 700 echo sounder'@en ;
    skos:definition 'The Furuno FE-700 is an echo sounder for shallow or deep water applications. This instrument uses ultrasonic pulses to detect the seabed and other underwater objects. The operating frequency is 50 kHz, 200 kHz or 50/200 kHz alternating transmit. Echo sounding data is displayed on a 6.5-inch colour TFT (Thin Film Transistor) LCD display. It has an operating range of 800 m (2500 ft, minimum range is 0.5 m (200 kHz), 2.0 m (50 kHz)). Accuracy is +/-2.5%.'@en ;
    skos:notation 'SDN:L22::TOOL0797'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0798/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0798/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0798/>;
    dc:modified '2014-09-18T15:18:31'^^xsd:dateTime ;
    skos:altLabel 'Furuno GP36 GPS+DGPS'^^xsd:string ;
    skos:prefLabel 'Furuno Navigator GP36 Global Positioning System receivers'@en ;
    skos:definition 'The Furuno GP-36 is a 12 parallel channel, all-in-view GPS system with a built in differential GPS (DGPS) receiver. It is has a 4.5 inch monochrome LCD video display. Accuracy is approx. 50 m (GPS), or approx. 5 m (DGPS), 95% of the time. This model superseded the Furuno GP-35.'@en ;
    skos:notation 'SDN:L22::TOOL0798'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0799/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0799/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0799/>;
    dc:modified '2014-09-18T15:18:31'^^xsd:dateTime ;
    skos:altLabel 'Furuno GP37 GPS'^^xsd:string ;
    skos:prefLabel 'Furuno Navigator GP37 Global Positioning System receivers'@en ;
    skos:definition 'The Furuno GP-37 is a 12-parallel channel, all-in-view GPS receiver designed for coastal ships, and fishing boats. It is equipped with WAAS (Wide Area Augmentation System) and DGPS (differential GPS) receivers. It has a 4.5 inch monochrome LCD display. The unit offers position fixes with accuracy of 10m for basic GPS, 3m where a WAAS service is available, and 5m with DGPS.'@en ;
    skos:notation 'SDN:L22::TOOL0799'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0800/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0800/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0800/>;
    dc:modified '2014-09-18T15:18:31'^^xsd:dateTime ;
    skos:altLabel 'Furuno GP500 GPS'^^xsd:string ;
    skos:prefLabel 'Furuno Navigator GP500 Global Positioning System receivers'@en ;
    skos:definition 'The Furuno GP-500 is a dual channel (up to 5 satellites multiplex tracked) GPS receiver. It has an LCD readout display. Accuracy is better than 15 m rms (HDOP < 3).'@en ;
    skos:notation 'SDN:L22::TOOL0800'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0801/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0801/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0801/>;
    dc:modified '2014-09-18T15:18:31'^^xsd:dateTime ;
    skos:altLabel 'Furuno GP80 and GP80D GPS'^^xsd:string ;
    skos:prefLabel 'Furuno Navigator GP80 and GP80D Global Positioning System receivers'@en ;
    skos:definition 'The Furuno GP-80 is an 8-parallel channel, all-in-view GPS receiver designed for every type of vessel. It has a 6 inch monochrome LCD display.  The GP-80 is a DGPS-ready receiver that can be linked with an external differential beacon receiver. The GP-80D has a built-in DGPS receiver. Accuracy is GPS: 10 m approx. (95 % of the time SA off), DGPS: approx. 5 m (95% of the time).'@en ;
    skos:notation 'SDN:L22::TOOL0801'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0802/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0802/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0802/>;
    dc:modified '2014-09-18T15:18:31'^^xsd:dateTime ;
    skos:altLabel 'Furuno GP90 and GP90D GPS'^^xsd:string ;
    skos:prefLabel 'Furuno Navigator GP90 and GP90D Global Positioning System receivers'@en ;
    skos:definition 'The Furuno GP-90 is a 12-parallel channel, all-in-view GPS receiver designed for SOLAS ships. It has a 6 inch monochrome LCD display. It is equipped with WAAS (Wide Area Augmentation System). The GP-90 is a DGPS-ready receiver that can be linked with an external differential beacon receiver. The GP-90D has a built-in DGPS receiver. Accuracy is GPS: 10 m approx. (95 % of the time SA off), DGPS: approx. 5 m (95% of the time), WAAS: 3 m (95% of the time).'@en ;
    skos:notation 'SDN:L22::TOOL0802'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0793/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0793/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0793/>;
    dc:modified '2014-09-17T10:29:32'^^xsd:dateTime ;
    skos:altLabel 'Furuno DS 50 speed log'^^xsd:string ;
    skos:prefLabel 'Furuno DS 50 and DS 50T Doppler speed log'@en ;
    skos:definition 'The Furuno DS-50 is a 3-beam Doppler speed log providing display of speed over a wide range from -10.0 to 40kt. Speeds are detected relative to ground or water both fore/aft and athwartship. This model operates at 440kHz, and has speed accuracy of 0.1kt. The DS 50T is supplied with an additional transceiver unit.'@en ;
    skos:notation 'SDN:L22::TOOL0793'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0794/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0794/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0794/>;
    dc:modified '2014-09-17T10:29:32'^^xsd:dateTime ;
    skos:altLabel 'Furuno DS 80 speed log'^^xsd:string ;
    skos:prefLabel 'Furuno DS 80 Doppler speed log'@en ;
    skos:definition 'The Furuno DS-80 is a pair-beam Doppler speed log providing display of speed over a wide range from 0 to 40kt. Speeds are detected relative to ground or water both fore/aft and athwartship. this model operates at 1 MHz and has speed accuracy of 0.1kt for water depth of more than 3m.'@en ;
    skos:notation 'SDN:L22::TOOL0794'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0796/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0796/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0796/>;
    dc:modified '2014-09-17T10:29:32'^^xsd:dateTime ;
    skos:altLabel 'Furuno FCV 582 fish finder'^^xsd:string ;
    skos:prefLabel 'Furuno FCV 582 video echosounder fish finder'@en ;
    skos:definition 'The Furuno FCV-582 is dual-frequency (50kHz and 200kHz) color video sounder designed for smaller vessels. Its 8 or 16 color presentation gives information on fish density and the nature of the ocean floors. This device has six pulse lengths from 0.2 to 3.6ms for performance on both shallow and deep ranges. It has a colour CRT display and has an operational range of 500 m (1500 ft).'@en ;
    skos:notation 'SDN:L22::TOOL0796'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0789/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0789/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0789/>;
    dc:modified '2014-09-16T10:06:36'^^xsd:dateTime ;
    skos:altLabel 'GE Druck 1830 and 1840 pressure sensors'^^xsd:string ;
    skos:prefLabel 'GE Druck PTX and PCDR 1830 and 1840 series level pressure sensors'@en ;
    skos:definition 'The PDCR 1830/1840 transducer (mV output) and PTX 1830/1840 transmitter (4-20 mA output) are fully submersible sensors  for the measurement of hydrostatic liquid levels. IP68 rated for indefinite immersion in 700 mH2O. Range is from 0.75 mH2O to 600 mH2O with an accuracy of +/-0.06%. Operating temperatures between -20 deg C and 60 deg C.'@en ;
    skos:notation 'SDN:L22::TOOL0789'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0788/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0788/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0788/>;
    dc:modified '2014-09-12T17:20:07'^^xsd:dateTime ;
    skos:altLabel 'Gunther grab'^^xsd:string ;
    skos:prefLabel 'Gunther grab'@en ;
    skos:definition 'A light sediment grab, 12.5 cm wide and weighing 1kg. The grab is equipped with 8kg weights and nylon gauze sacks (0.5mm mesh size) for the sediment storage. The surface of the grab is 270 cm squared. Note that sizes and depths may vary. A full description is available in https://www.bodc.ac.uk/data/documents/nodb/pdf/Gunther_1963.pdf.'@en ;
    skos:notation 'SDN:L22::TOOL0788'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/NETT0174/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/NETT0174/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/NETT0174/>;
    dc:modified '2014-09-12T17:20:07'^^xsd:dateTime ;
    skos:altLabel 'KC Denmark 25 cm small plankton net'^^xsd:string ;
    skos:prefLabel 'KC Denmark AS small plankton net'@en ;
    skos:definition 'Construction has an upper cylindrical net made of strong Beaver Nylon with a diameter of 25 cm and a length of 15 cm. Below is a conical mesh net bag made of Monodur Nytal (Nylon) and is 40 cm deep.  The net is ended with a 35 ml or 80 ml (fitted with mesh windows) sample cylinder.'@en ;
    skos:notation 'SDN:L22::NETT0174'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/NETT0175/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/NETT0175/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/NETT0175/>;
    dc:modified '2014-09-12T17:20:07'^^xsd:dateTime ;
    skos:altLabel 'Lindahl sampling hose'^^xsd:string ;
    skos:prefLabel 'Lindahl dividable phytoplankton sampling hose'@en ;
    skos:definition 'A rubber hose (material may vary) comprising length sections which integrate water samples from selected depth intervals. The division of the hose is adapted as needed. The hose inner diameter is >12 mm. The hose end is weighted. The hose is slowly lowered into the water (20 m/min). The top valve is closed when the hose has reached maximum depth. Sections are sequentially closed with valves as they appear during ascent. A full description is available in https://www.bodc.ac.uk/data/documents/nodb/pdf/Lindahl_1986.pdf.'@en ;
    skos:notation 'SDN:L22::NETT0175'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0787/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0787/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0787/>;
    dc:modified '2014-09-01T08:09:10'^^xsd:dateTime ;
    skos:altLabel 'PARFLUX Mark8-13'^^xsd:string ;
    skos:prefLabel 'McLane PARFLUX Mark8-13'@en ;
    skos:definition 'A sediment trap designed for mid-water mooring deployment (maximum depth 6500m) with a conical collector passing settled particles into one of a set of bottles mounted in a carousel. The bottles are changed after a user-selected period of time.  An optional wet sample particle divider may be fitted to divide wet specimens into 5-10 equal parts. Compass/tilt and pressure sensors may also be fitted. This model carries 13 bottles (250 or 500 ml) and is 1.16m tall and 0.66m diameter. The reduced size eases handling at sea.'@en ;
    skos:notation 'SDN:L22::TOOL0787'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0786/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0786/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0786/>;
    dc:modified '2014-09-01T08:07:46'^^xsd:dateTime ;
    skos:altLabel 'PARFLUX Mark78HW-13'^^xsd:string ;
    skos:prefLabel 'McLane PARFLUX Mark78HW-13 Sediment Traps'@en ;
    skos:definition 'A sediment trap designed for mid-water mooring deployment (maximum depth 6500m) with a conical collector passing settled particles into one of a set of bottles mounted in a carousel. The bottles are changed after a user-selected period of time.  An optional wet sample particle divider may be fitted to divide wet specimens into 5-10 equal parts. Compass/tilt and pressure sensors may also be fitted. This model carries 13 wide bottles (250 or 500 ml) and is 1.64m tall and 0.91m diameter.'@en ;
    skos:notation 'SDN:L22::TOOL0786'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0785/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0785/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0785/>;
    dc:modified '2014-09-01T08:06:25'^^xsd:dateTime ;
    skos:altLabel 'PARFLUX Mark78H-21'^^xsd:string ;
    skos:prefLabel 'McLane PARFLUX Mark78H-21 Sediment Traps'@en ;
    skos:definition 'A sediment trap designed for mid-water mooring deployment (maximum depth 6500m) with a conical collector passing settled particles into one of a set of bottles mounted in a carousel. The bottles are changed after a user-selected period of time.  An optional wet sample particle divider may be fitted to divide wet specimens into 5-10 equal parts. Compass/tilt and pressure sensors may also be fitted.  This model carries 21 bottles (250 or 500 ml) and is 1.64m tall and 0.91m diameter.'@en ;
    skos:notation 'SDN:L22::TOOL0785'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0784/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0784/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0784/>;
    dc:modified '2014-08-28T09:27:27'^^xsd:dateTime ;
    skos:altLabel 'SMBA multicorer'^^xsd:string ;
    skos:prefLabel 'Barnett-Watson multiple corer'@en ;
    skos:definition 'A corer designed at SMBA (current name Scottish Association for Marine Science) that collects multiple undisturbed samples of the upper sediment, flocculent material and overlying water. This is achieved by a hydraulically-damped controlled descent of the open core liners once the frame has landed on the seabed. Rubber seals at the top and bottom of the core liner prevent sample loss during recovery. The outer framework supports weighted arrays of polycarbonate liners (4 split liners of 10cm internal diameter and 8 split liners of 6 cm internal diameter) hanging from a water-filled dashpot.'@en ;
    skos:notation 'SDN:L22::TOOL0784'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0783/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0783/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0783/>;
    dc:modified '2014-08-26T15:43:04'^^xsd:dateTime ;
    skos:altLabel 'Forel-Ule Vials'^^xsd:string ;
    skos:prefLabel 'Liquid Vial Forel-Ule Colour Comparator'@en ;
    skos:definition 'A set of 21 glass vials in a frame containing standard solutions made with differing proportions of distilled water, ammonia, copper sulphate, potassium chromate and cobalt sulphate. The formulations result in a colour palette that covers naturally occurring water bodies, which are visually compared in-situ with the vials and assigned the number (1-21) of the nearest colour match.'@en ;
    skos:notation 'SDN:L22::TOOL0783'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0782/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0782/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0782/>;
    dc:modified '2014-08-26T15:37:47'^^xsd:dateTime ;
    skos:altLabel 'Atelier VIX Forel-Ule filters'^^xsd:string ;
    skos:prefLabel 'Atelier VIX plastic Forel-Ule colour comparator'@en ;
    skos:definition 'A set of 21 plastic filters that match the colours of the standard Forel-Ule vials. Natural water bodies are colour matched in-situ by visual comparison with the filters and assigned the number (1-21) of the nearest match. The filters were designed by scientists at NIOZ and are manufactured by  Altelier VIX.  More information is available at DOI: http://dx.doi.org/10.2971/jeos.2014.14025.'@en ;
    skos:notation 'SDN:L22::TOOL0782'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0781/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0781/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0781/>;
    dc:modified '2014-08-26T15:31:50'^^xsd:dateTime ;
    skos:altLabel 'Datawell waverider'^^xsd:string ;
    skos:prefLabel 'Datawell waverider buoy'@en ;
    skos:definition 'A non-directional waverider system with an accelerometer mounted in a loose tethered buoy (0.7 or 0.9m in diameter) that measures the vertical accelerations of the buoy as it moves with the water surface.  The accelerations are integrated twice within the buoy and the displacement signal so obtained is then transmitted to a shore station where it is processed to provide wave data statistics.'@en ;
    skos:notation 'SDN:L22::TOOL0781'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0778/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0778/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0778/>;
    dc:modified '2014-08-26T15:01:04'^^xsd:dateTime ;
    skos:altLabel 'Olympus IMT-2'^^xsd:string ;
    skos:prefLabel 'Olympus IMT-2 series inverted microscope'@en ;
    skos:definition 'An inverted (the light source illuminates the specimen from above) optical microscope series with a fixed stage and focus adjustment by vertical movement of the nosepiece.  Different stages - some incorporating high accuracy micrometers, condensers and light sources are available for a wide range of applications including Koehler illumination, phase contrast and fluorescence microscopy.'@en ;
    skos:notation 'SDN:L22::TOOL0778'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0777/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0777/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0777/>;
    dc:modified '2014-08-20T12:41:30'^^xsd:dateTime ;
    skos:altLabel 'FlowQuest 75'^^xsd:string ;
    skos:prefLabel 'FlowQuest 75 Ultra long-range Acoustic Current Profiler'@en ;
    skos:definition 'FlowQuest 75 Ultra long-range Acoustic Current Profiler with an operating frequency of 75 kHz. Standard depth of 800 meters with a temperature range of -5 degC to 45 degC. Velocity accuracy of +/- 1 percent +/- 5mm/s and a maximum measuring range of 900 meters.'@en ;
    skos:notation 'SDN:L22::TOOL0777'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0775/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0775/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0775/>;
    dc:modified '2014-08-18T12:53:59'^^xsd:dateTime ;
    skos:altLabel 'RAMSES-ACC-VIS radiometer'^^xsd:string ;
    skos:prefLabel 'TriOS RAMSES-ACC-VIS Hyperspectral UV-VIS Radiometer'@en ;
    skos:definition 'This is a spectral radiometer measuring over the visual and UV bands (320-950 nm) with a cosine-response to measure irradiance. It is fitted with a 256-channel silicon photodiode array with 190 usable channels giving 3.3 nm per pixel and a spectral accuracy of 0.3 nm. Typical saturation (4 ms integration time) is 10 W m-2 nm-1 (at 400nm), 8 W m-2 nm-1 (at 500nm) and 14 W m-2 nm-1 (at 700nm). Typical NEI (8 sec integration time) is 0.4 µW m-2 nm-1 (at 400nm), 0.4 µW m-2 nm-1 (at 500nm) and 0.6 µW m-2 nm-1 (at 700nm). Accuracy is quoted as better than 6-10 per cent (depending on spectral range). The accompanying software is capable of providing PAR and UV integrations and converting the energy measurements into photon fluxes. More information is available at http://www.trios.de/.'@en ;
    skos:notation 'SDN:L22::TOOL0775'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0774/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0774/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0774/>;
    dc:modified '2014-08-18T12:52:46'^^xsd:dateTime ;
    skos:altLabel 'RAMSES-ARC radiometer'^^xsd:string ;
    skos:prefLabel 'TriOS RAMSES-ARC Hyperspectral UV-VIS Radiometer'@en ;
    skos:definition 'This is a spectral radiometer measuring over the visual and UV bands (320-950 nm) with the sensor mounted at the base of a black tube to measure radiance. It is fitted with a 256-channel silicon photodiode array with 190 usable channels giving 3.3 nm per pixel and a spectral accuracy of 0.3 nm. Typical saturation (at 200nm) is 1 W m-2 nm-1 sr -1. The field of view is 7 degrees in air (but this can be optimized) and the accuracy is better than 6% (depending on spectral range). The accompanying software is capable of providing PAR and UV integrations and converting the energy measurements into photon fluxes. More information is available at http://www.trios.de/.'@en ;
    skos:notation 'SDN:L22::TOOL0774'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0761/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0761/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0761/>;
    dc:modified '2014-08-15T11:24:21'^^xsd:dateTime ;
    skos:altLabel 'Northstar 826'^^xsd:string ;
    skos:prefLabel 'Northstar 826 navigation system'@en ;
    skos:definition 'The 826 navigation system was designed and manufactured by Northstar. This instrument has been discontinued.'@en ;
    skos:notation 'SDN:L22::TOOL0761'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0764/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0764/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0764/>;
    dc:modified '2014-08-15T11:24:21'^^xsd:dateTime ;
    skos:altLabel 'Northstar 941X'^^xsd:string ;
    skos:prefLabel 'Northstar 941X GPS receiver'@en ;
    skos:definition 'The Northstar 941X combines 12-channels GPS navigation with Differential GPS capability, high definition display, loran compatibility, built-in tide data up to year 2010, and other navigation features. This instrument has been discontinued.'@en ;
    skos:notation 'SDN:L22::TOOL0764'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0765/1/> .
<http://vocab.nerc.ac.uk/collection/L22/current/TOOL0765/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0765/>;
    dc:modified '2014-08-15T11:24:21'^^xsd:dateTime ;
    skos:altLabel 'Northstar 941XD'^^xsd:string ;
    skos:prefLabel 'Northstar 941XD GPS receiver'@en ;
    skos:definition 'The Northstar 941XD combines a 12-channel GPS navigation with Differential GPS capability, high definition display, loran compatibility, built-in tide data up to year 2010, and other navigation features. This model contains an internal DGPS (differential GPS) receiver. This provides accuracy in the 2-5m range.'@en ;
    skos:notation 'SDN:L22::TOOL0765'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L22/current/TOOL0766/1/> .
