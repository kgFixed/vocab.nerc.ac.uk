    dc:modified '2017-02-24T16:45:15'^^xsd:dateTime ;
    skos:altLabel 'Contaminants'^^xsd:string ;
    skos:prefLabel 'Contaminants do not produce pollution effects'@en ;
    skos:definition 'Concentrations of contaminants are at levels not giving rise to pollution effects'@en ;
    skos:notation 'SDN:C45::D8'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/C45/current/D7/2/> .
