    skos:altLabel 'Marine litter'^^xsd:string ;
    skos:prefLabel 'Properties and quantities of marine litter do not cause harm'@en ;
    skos:definition 'Properties and quantities of marine litter do not cause harm to the coastal and marine environment'@en ;
    skos:notation 'SDN:C45::D10'^^xsd:string .
