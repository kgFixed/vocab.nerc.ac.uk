    dc:modified '2017-02-24T16:43:39'^^xsd:dateTime ;
    skos:altLabel 'Commercial fish and shellfish'^^xsd:string ;
    skos:prefLabel 'Commercial fish and shellfish populations are healthy'@en ;
    skos:definition 'Populations of all commercially exploited fish and shellfish are within safe biological limits, exhibiting a population age and size distribution that is indicative of a healthy stock'@en ;
    skos:notation 'SDN:C45::D3'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/C45/current/D1/2/> .
<http://vocab.nerc.ac.uk/collection/C45/current/D1/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/C45/current/D1/>;
    dc:modified '2017-02-24T16:43:15'^^xsd:dateTime ;
    skos:altLabel 'Biodiversity'^^xsd:string ;
    skos:prefLabel 'Biological diversity maintained'@en ;
    skos:definition 'Biological diversity is maintained. The quality and occurrence of habitats and the distribution and abundance of species are in line with prevailing physiographic, geographic and climate conditions'@en ;
    skos:notation 'SDN:C45::D1'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/C45/current/D4/2/> .
<http://vocab.nerc.ac.uk/collection/C45/current/D4/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/C45/current/D4/>;
    dc:modified '2017-02-24T16:42:37'^^xsd:dateTime ;
    skos:altLabel 'Food webs'^^xsd:string ;
    skos:prefLabel 'Marine food webs are at normal abundance and diversity'@en ;
    skos:definition 'All elements of the marine food webs, to the extent that they are known, occur at normal abundance and diversity and levels capable of ensuring the long-term abundance of the species and the retention of their full reproductive capacity'@en ;
    skos:notation 'SDN:C45::D4'^^xsd:string .
