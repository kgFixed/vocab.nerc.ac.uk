    dc:modified '2017-02-24T16:44:57'^^xsd:dateTime ;
    skos:altLabel 'Hydrographical conditions'^^xsd:string ;
    skos:prefLabel 'Hydrographical conditions are not altered'@en ;
    skos:definition 'Permanent alteration of hydrographical conditions does not adversely affect marine ecosystems'@en ;
    skos:notation 'SDN:C45::D7'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/C45/current/D6/2/> .
<http://vocab.nerc.ac.uk/collection/C45/current/D6/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/C45/current/D6/>;
    dc:modified '2017-02-24T16:44:41'^^xsd:dateTime ;
    skos:altLabel 'Sea-floor integrity'^^xsd:string ;
    skos:prefLabel 'Sea-floor integrity supports ecosystem'@en ;
    skos:definition 'Sea-floor integrity is at a level that ensures that the structure and functions of the ecosystems are safeguarded and benthic ecosystems, in particular, are not adversely affected'@en ;
    skos:notation 'SDN:C45::D6'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/C45/current/D5/2/> .
<http://vocab.nerc.ac.uk/collection/C45/current/D5/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/C45/current/D5/>;
    dc:modified '2017-02-24T16:44:25'^^xsd:dateTime ;
    skos:altLabel 'Eutrophication'^^xsd:string ;
    skos:prefLabel 'Eutrophication is minimised'@en ;
    skos:definition 'Human-induced eutrophication is minimised, especially adverse effects thereof, such as losses in biodiversity, ecosystem degradation, harmful algal blooms and oxygen deficiency in bottom water'@en ;
    skos:notation 'SDN:C45::D5'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/C45/current/D3/2/> .
