    dc:modified '2017-02-24T16:41:10'^^xsd:dateTime ;
    skos:altLabel 'Non-indigenous species'^^xsd:string ;
    skos:prefLabel 'Non-indigenous species do not adversely affect ecosystem'@en ;
    skos:definition 'Non-indigenous species introduced by human activities are at levels that do not adversely alter the ecosystem'@en ;
