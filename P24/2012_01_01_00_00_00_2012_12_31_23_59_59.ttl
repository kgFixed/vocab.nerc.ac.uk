@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

@base <https://kgfixed.github.io/vocab.nerc.ac.uk/P24/2012_01_01_00_00_00_2012_12_31_23_59_59.ttl> .

<>
    a tree:Node
     ;
    tree:relation [
      a tree:LessThanRelation ;
      tree:node <https://kgfixed.github.io/vocab.nerc.ac.uk/P24/2011_01_01_00_00_00_2011_12_31_23_59_59.ttl> ;
      tree:path dc:modified ;
      tree:value '2012-12-31T23:59:59'^^xsd:dateTime
    ]
     .

<feed>
  a ldes:EventStream ;
  ldes:timestampPath dc:modified ;
  ldes:versionOfPath dc:isVersionOf ;
  
  
  tree:shape [
    a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path dc:isVersionOf
    ],
    [
      sh:datatype xsd:dateTime ;
      sh:minCount 1 ;
      sh:path dc:modified
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:altLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:prefLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:definition
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:notation
    ];
    sh:targetClass skos:Concept
  ] ;
  tree:view <> ;
  .

<feed> tree:member <http://vocab.nerc.ac.uk/collection/P24/current/AREAPERTIME/1/> .
<http://vocab.nerc.ac.uk/collection/P24/current/AREAPERTIME/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P24/current/AREAPERTIME/>;
    dc:modified '2012-07-25T12:57:26'^^xsd:dateTime ;
    skos:altLabel '[L*L]/[T]'^^xsd:string ;
    skos:prefLabel '[length*length]/[time]'@en ;
    skos:definition 'The square of the fundamental dimension of distance known as area per the fundamental dimension of time'@en ;
    skos:notation 'SDN:P24::AREAPERTIME'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P24/current/POWAREA/1/> .
