    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P24/current/POWAREA/>;
    dc:modified '2012-06-12T10:31:22'^^xsd:dateTime ;
    skos:altLabel '[[M]*[L*L]/[T*T*T]]/[L*L]'^^xsd:string ;
    skos:prefLabel '[[mass]*[length*length]/[time*time*time]]/[length*length]'@en ;
    skos:definition 'Energy (mass per unit are per unit time squared) per unit time (known as power) per unit area.'@en ;
    skos:notation 'SDN:P24::POWAREA'^^xsd:string .
