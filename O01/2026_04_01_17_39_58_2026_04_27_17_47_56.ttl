    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:definition
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:notation
    ];
    sh:targetClass skos:Concept
  ] ;
  tree:view <> ;
  .

<feed> tree:member <http://vocab.nerc.ac.uk/collection/O01/current/O01003/1/> .
<http://vocab.nerc.ac.uk/collection/O01/current/O01003/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/O01/current/O01003/>;
    dc:modified '2026-04-01T17:59:57'^^xsd:dateTime ;
    skos:altLabel 'ASAP'^^xsd:string ;
    skos:prefLabel 'Automated Shipboard Aerological Programme'@en ;
    skos:definition 'The ASAP (Automated Shipboard Aerological Programme) network is upper atmosphere soundings made using balloons equipped with the required instruments and data telecommunication system. Acquisition of the data is made on-board the ships and the data are transmitted to shore by satellite.'@en ;
    skos:notation 'SDN:O01::O01003'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/O01/current/O01010/1/> .
<http://vocab.nerc.ac.uk/collection/O01/current/O01010/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/O01/current/O01010/>;
    dc:modified '2026-04-01T17:59:57'^^xsd:dateTime ;
    skos:altLabel 'AniBOS'^^xsd:string ;
    skos:prefLabel 'Animal Borne Ocean Sensors'@en ;
    skos:definition 'Animal Borne Ocean Sensors (AniBOS) is a global network providing CTD profiles and other oceanographic data collected through bio-logging - satellite-linked sensors attached on marine animals.'@en ;
    skos:notation 'SDN:O01::O01010'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/O01/current/O01004/1/> .
<http://vocab.nerc.ac.uk/collection/O01/current/O01004/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/O01/current/O01004/>;
    dc:modified '2026-04-01T17:59:57'^^xsd:dateTime ;
    skos:altLabel 'Argo'^^xsd:string ;
    skos:prefLabel 'Argo'@en ;
    skos:definition 'Argo is an international program that collects information from the sub-surface ocean using a fleet of robotic instruments that drift with the ocean currents, descend to a mid-water level (Core and BGC) or to the bottom (Deep), rise to the sea surface sampling the ocean, obtain a geolocalisation, transmit their data by satellite and immediately descend to their drift depth.'@en ;
    skos:notation 'SDN:O01::O01004'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/O01/current/O01014/1/> .
<http://vocab.nerc.ac.uk/collection/O01/current/O01014/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/O01/current/O01014/>;
    dc:modified '2026-04-01T17:59:57'^^xsd:dateTime ;
    skos:altLabel 'FVON'^^xsd:string ;
    skos:prefLabel 'Fishing Vessel Ocean Observing Network'@en ;
    skos:definition 'The Fishing Vessel Ocean Observing Network (FVON) is a global ocean observing network dedicated to collecting coastal subsurface data in partnership with the fishing industry. FVON outfits fishing gear with sensors that automatically collect and transmit data with the aim of powering a sustainable and inclusive blue economy that benefits fishers, coastal communities, and the blue economy.'@en ;
    skos:notation 'SDN:O01::O01014'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/O01/current/O01007/1/> .
<http://vocab.nerc.ac.uk/collection/O01/current/O01007/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/O01/current/O01007/>;
    dc:modified '2026-04-01T17:59:57'^^xsd:dateTime ;
    skos:altLabel 'GDA'^^xsd:string ;
    skos:prefLabel 'Global Drifter Array'@en ;
    skos:definition 'The Global Drifter Array (GDA) includes all drifting platforms, including drifting buoy with and without drogue, and wave drifters.'@en ;
    skos:notation 'SDN:O01::O01007'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/O01/current/O01013/1/> .
<http://vocab.nerc.ac.uk/collection/O01/current/O01013/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/O01/current/O01013/>;
    dc:modified '2026-04-01T17:59:57'^^xsd:dateTime ;
    skos:altLabel 'GLOSS'^^xsd:string ;
    skos:prefLabel 'Global Sea Level Observing System'@en ;
    skos:definition 'Global Sea Level Observing System (GLOSS) aims to develop a high-quality in-situ sea level observing network to support research and operational needs. The data help assess climate change impacts on sea levels, support storm surge forecasting, tsunami warnings, and ocean circulation studies, and serve scientific, economic, and social purposes at global to local scales.'@en ;
    skos:notation 'SDN:O01::O01013'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/O01/current/O01009/1/> .
<http://vocab.nerc.ac.uk/collection/O01/current/O01009/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/O01/current/O01009/>;
    dc:modified '2026-04-01T17:59:57'^^xsd:dateTime ;
    skos:altLabel 'GO-SHIP'^^xsd:string ;
    skos:prefLabel 'Global Ocean Ship-Based Hydrographic Investigations Programme'@en ;
    skos:definition 'GO-SHIP maintains around 50 coast-to-coast or coast-to-ice reference lines, sampled by research vessels at least once per decade, obtaining high-quality, high spatial and vertical resolution measurements of a suite of physical, chemical, and biological parameters over the full water column.'@en ;
    skos:notation 'SDN:O01::O01009'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/O01/current/O01011/1/> .
<http://vocab.nerc.ac.uk/collection/O01/current/O01011/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/O01/current/O01011/>;
    dc:modified '2026-04-01T17:59:57'^^xsd:dateTime ;
    skos:altLabel 'HF Radar'^^xsd:string ;
    skos:prefLabel 'Global High Frequency Radar Network'@en ;
    skos:definition 'The Global High Frequency Radar Network (HF Radar) is a vision for a global operational system measuring ocean surface currents to support monitoring of marine and coastal ecosystems.'@en ;
    skos:notation 'SDN:O01::O01011'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/O01/current/O01006/1/> .
<http://vocab.nerc.ac.uk/collection/O01/current/O01006/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/O01/current/O01006/>;
    dc:modified '2026-04-01T17:59:57'^^xsd:dateTime ;
    skos:altLabel 'MBN'^^xsd:string ;
    skos:prefLabel 'Moored Buoy Network'@en ;
    skos:definition 'Moored Buoy Network consists of buoys anchored at fixed locations and regularly collect atmospheric and surface oceanographic observations sensors. The atmospheric and marine surface observation measurements are considered under DBCP (Data Buoy Cooperation Panel) umbrella, while ocean subsurface measurements are under OceanSites. Wave buoys, coastal moorings and tropical moored buoys are included in the moored buoy network.'@en ;
    skos:notation 'SDN:O01::O01006'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/O01/current/O01012/1/> .
<http://vocab.nerc.ac.uk/collection/O01/current/O01012/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/O01/current/O01012/>;
    dc:modified '2026-04-01T17:59:57'^^xsd:dateTime ;
    skos:altLabel 'OceanGliders'^^xsd:string ;
    skos:prefLabel 'OceanGliders'@en ;
    skos:definition 'OceanGliders is an international glider-based ocean observation network, integrating autonomous underwater gliders with real-time telemetry, interoperable standards, and open access data to provide continuous, high-resolution profiles of the ocean’s physical, biogeochemical, and ecosystem properties.'@en ;
    skos:notation 'SDN:O01::O01012'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/O01/current/O01005/1/> .
<http://vocab.nerc.ac.uk/collection/O01/current/O01005/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/O01/current/O01005/>;
    dc:modified '2026-04-01T17:59:57'^^xsd:dateTime ;
    skos:altLabel 'OceanSITES'^^xsd:string ;
    skos:prefLabel 'OceanSITES'@en ;
    skos:definition 'OceanSITES is a worldwide system of long-term, open-ocean reference stations measuring dozens of variables and monitoring the full depth of the ocean from air-sea interactions down to the seafloor. It is a network of stations or observatories measuring many aspects of the ocean\'s surface and water column using, where possible, automated systems with advanced sensors and telecommunications systems, yielding high time resolution, often in real-time, while building a long record. Observations cover meteorology, physical oceanography, transport of water, biogeochemistry, and parameters relevant to the carbon cycle, ocean acidification, the ecosystem, and geophysics.'@en ;
    skos:notation 'SDN:O01::O01005'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/O01/current/O01016/1/> .
<http://vocab.nerc.ac.uk/collection/O01/current/O01016/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/O01/current/O01016/>;
    dc:modified '2026-04-01T17:59:57'^^xsd:dateTime ;
    skos:altLabel 'SMART Cables'^^xsd:string ;
    skos:prefLabel 'SMART Cables'@en ;
    skos:definition 'SMART Cables is a global network integrating temperature, pressure, and seismic sensors into subsea telecom infrastructure to enable real-time ocean and Earth observations. It supports climate monitoring, tsunami warning, and international scientific collaboration across multiple ocean basins.'@en ;
    skos:notation 'SDN:O01::O01016'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/O01/current/O01015/1/> .
<http://vocab.nerc.ac.uk/collection/O01/current/O01015/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/O01/current/O01015/>;
    dc:modified '2026-04-01T17:59:57'^^xsd:dateTime ;
    skos:altLabel 'SOCONET'^^xsd:string ;
    skos:prefLabel 'Surface Ocean CO2 Observing Network'@en ;
    skos:definition 'A formalized and coordinated surface ocean CO2 reference network (SOCONET), integrated within relevant elements of IOC-UNESCO and WMO, is the backbone of monitoring, reporting and verification (MRV) efforts to properly incorporate ocean sinks in global carbon assessments and stocktakes. The climate quality observational data feeds directly into carbon monitoring systems to aid in accurate and timely assessments of surface ocean carbon levels, carbon uptake by the ocean, and changes thereof. Uniquely designed and distributed surface ocean CO2 reference network is a tightly coordinated activity aimed at creating monthly air-CO2 flux maps, assess surface ocean health as it pertains to ocean acidification; and to quantify ocean mitigation potential to reduce atmospheric CO2 increases.'@en ;
    skos:notation 'SDN:O01::O01015'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/O01/current/O01017/1/> .
<http://vocab.nerc.ac.uk/collection/O01/current/O01017/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/O01/current/O01017/>;
    dc:modified '2026-04-01T17:59:57'^^xsd:dateTime ;
    skos:altLabel 'SUN Fleet'^^xsd:string ;
    skos:prefLabel 'Surface UNcrewed Fleet'@en ;
    skos:definition 'The Surface Uncrewed Fleet (SUN Fleet) is an ocean observing network operating globally across remote and high-impact regions to collect high-resolution data at the air-sea interface, with a focus on surface fluxes, carbon exchange and extreme events. USVs collect unprecedented co-located variables using suites of meteorological and oceanographic instrumentation. USVs transmit data in near real-time to fill critical observing gaps, support weather and climate prediction, and connect industry platforms with scientific priorities to expand the reach and impact of the Global Ocean Observing System.'@en ;
    skos:notation 'SDN:O01::O01017'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/O01/current/O01008/1/> .
<http://vocab.nerc.ac.uk/collection/O01/current/O01008/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/O01/current/O01008/>;
    dc:modified '2026-04-01T17:59:57'^^xsd:dateTime ;
    skos:altLabel 'TSB'^^xsd:string ;
    skos:prefLabel 'Tsunami Buoys'@en ;
    skos:definition 'Tsunami buoys consists of buoys measuring and transmitting water level variations as tsunami waves pass.'@en ;
    skos:notation 'SDN:O01::O01008'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/O01/current/O01001/1/> .
<http://vocab.nerc.ac.uk/collection/O01/current/O01001/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/O01/current/O01001/>;
    dc:modified '2026-04-01T17:59:57'^^xsd:dateTime ;
    skos:altLabel 'VOS'^^xsd:string ;
    skos:prefLabel 'Voluntary Observing Ships'@en ;
    skos:definition 'Voluntary Observing Ships (VOS) are recruited to collect and share weather observations. The ship crew or automated weather stations measure variables at the sea surface (e.g. temperature, waves) and in the atmosphere (e.g. clouds, air pressure). Data are shared globally for use by meteorologists, numerical weather prediction models, ship routeing services, climatological and research activities.'@en ;
    skos:notation 'SDN:O01::O01001'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/O01/current/O01002/1/> .
<http://vocab.nerc.ac.uk/collection/O01/current/O01002/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/O01/current/O01002/>;
    dc:modified '2026-04-01T17:59:57'^^xsd:dateTime ;
    skos:altLabel 'XBT SOOP'^^xsd:string ;
    skos:prefLabel 'XBT Ship of Opportunity Programme'@en ;
    skos:definition 'eXpendable BathyThermograph (XBT) probes are used on board Ships of Opportunity to collect ocean temperature profiles to ~850m. The profiles are collected on repeat transects across ocean basins in decades-long time series\' with specific emphasis on the under-observed boundary current regions. The data are used in studies of ocean currents, heat content and heat flux.'@en ;
    skos:notation 'SDN:O01::O01002'^^xsd:string .
