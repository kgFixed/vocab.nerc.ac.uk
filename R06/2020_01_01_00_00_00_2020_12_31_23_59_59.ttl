@prefix tree: <https://w3id.org/tree#> .
@prefix ldes: <https://w3id.org/ldes#> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

@base <https://kgfixed.github.io/vocab.nerc.ac.uk/R06/2020_01_01_00_00_00_2020_12_31_23_59_59.ttl> .

<>
    a tree:Node
     .

<feed>
  a ldes:EventStream ;
  ldes:timestampPath dc:modified ;
  ldes:versionOfPath dc:isVersionOf ;
  
  
  tree:shape [
    a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path dc:isVersionOf
    ],
    [
      sh:datatype xsd:dateTime ;
      sh:minCount 1 ;
      sh:path dc:modified
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:altLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:prefLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:definition
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:notation
    ];
    sh:targetClass skos:Concept
  ] ;
  tree:view <> ;
  .

<feed> tree:member <http://vocab.nerc.ac.uk/collection/R06/current/0A/1/> .
<http://vocab.nerc.ac.uk/collection/R06/current/0A/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/R06/current/0A/>;
    dc:modified '2020-04-04T15:05:33'^^xsd:dateTime ;
    skos:altLabel '0A'^^xsd:string ;
    skos:prefLabel 'Level 0, class A processing stage'@en ;
    skos:definition 'Data are the raw output from instruments, without calibration, and not necessarily converted to engineering units (Level 0). Moreover, no scrutiny, value judgement or intercomparisons were performed on the data; the records are derived directly from the input with no filtering or sub-sampling (Class A).'@en ;
    skos:notation 'SDN:R06::0A'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/R06/current/1A/1/> .
<http://vocab.nerc.ac.uk/collection/R06/current/1A/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/R06/current/1A/>;
    dc:modified '2020-04-04T15:05:33'^^xsd:dateTime ;
    skos:altLabel '1A'^^xsd:string ;
    skos:prefLabel 'Level 1, class A processing stage'@en ;
    skos:definition 'Data have been converted to values independent of detailed instrument knowledge; automated calibrations may have been done; data may not have full geospatial and temporal referencing, but have sufficient information to uniquely reference the data to the point of measurement (Level 1). Moreover, no scrutiny, value judgement or intercomparisons were performed on the data; the records are derived directly from the input with no filtering or sub-sampling (Class A).'@en ;
    skos:notation 'SDN:R06::1A'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/R06/current/2B/1/> .
<http://vocab.nerc.ac.uk/collection/R06/current/2B/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/R06/current/2B/>;
    dc:modified '2020-04-04T15:05:33'^^xsd:dateTime ;
    skos:altLabel '2B'^^xsd:string ;
    skos:prefLabel 'Level 2, class B processing stage'@en ;
    skos:definition 'Data have complete geospatial and temporal references; information may have been sub-sampled, averaged or compressed in other ways, but no assumptions of scales and variability or thermodynamic relationships have been used in the processing (Level 2). Moreover, the data have been scrutinized and evaluated against a defined and documented set of measures; the process is often automated, and the measures are published and widely available (Class B).'@en ;
    skos:notation 'SDN:R06::2B'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/R06/current/2BP/1/> .
<http://vocab.nerc.ac.uk/collection/R06/current/2BP/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/R06/current/2BP/>;
    dc:modified '2020-04-04T15:05:33'^^xsd:dateTime ;
    skos:altLabel '2B+'^^xsd:string ;
    skos:prefLabel 'Level 2, class B, subclass + processing stage'@en ;
    skos:definition 'Data have complete geospatial and temporal references; information may have been sub-sampled, averaged or compressed in other ways, but no assumptions of scales and variability or thermodynamic relationships have been used in the processing (Level 2). Moreover, the data have been scrutinized and evaluated against a defined and documented set of measures; the process is often automated, and the measures are published and widely available (Class B). In addition, the measures have been tested on independent data sets for completeness and robustness, and are widely accepted (Subclass +).'@en ;
    skos:notation 'SDN:R06::2BP'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/R06/current/2C/1/> .
<http://vocab.nerc.ac.uk/collection/R06/current/2C/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/R06/current/2C/>;
    dc:modified '2020-04-04T15:05:33'^^xsd:dateTime ;
    skos:altLabel '2C'^^xsd:string ;
    skos:prefLabel 'Level 2, class C processing stage'@en ;
    skos:definition 'Data have complete geospatial and temporal references; information may have been sub-sampled, averaged or compressed in other ways, but no assumptions of scales and variability or thermodynamic relationships have been used in the processing (Level 2). Moreover, the data have been scrutinized fully including intra-record and intra-dataset comparison and consistency checks; scientists have been involved in the evaluation, and brought latest knowledge to bear; the procedures are published, widely available and widely accepted (Class C).'@en ;
    skos:notation 'SDN:R06::2C'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/R06/current/2CP/1/> .
<http://vocab.nerc.ac.uk/collection/R06/current/2CP/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/R06/current/2CP/>;
    dc:modified '2020-04-04T15:05:33'^^xsd:dateTime ;
    skos:altLabel '2C+'^^xsd:string ;
    skos:prefLabel 'Level 2, class C, subclass + processing stage'@en ;
    skos:definition 'Data have complete geospatial and temporal references; information may have been sub-sampled, averaged or compressed in other ways, but no assumptions of scales and variability or thermodynamic relationships have been used in the processing (Level 2). Moreover, the data have been scrutinized fully including intra-record and intra-dataset comparison and consistency checks; scientists have been involved in the evaluation, and brought latest knowledge to bear; the procedures are published, widely available and widely accepted (Class C). In addition, the data are fully quality controlled and peer-reviewed, and are widely accepted as valid; documentation is complete and widely available.'@en ;
    skos:notation 'SDN:R06::2CP'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/R06/current/3B/1/> .
<http://vocab.nerc.ac.uk/collection/R06/current/3B/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/R06/current/3B/>;
    dc:modified '2020-04-04T15:05:33'^^xsd:dateTime ;
    skos:altLabel '3B'^^xsd:string ;
    skos:prefLabel 'Level 3, class B processing stage'@en ;
    skos:definition 'Data have been processed with assumptions about the scales of variability or thermodynamic relationships; the data are normally reduced to regular space, time intervals with enhanced signal to noise (Level 3). Moreover, the data have been scrutinized and evaluated against a defined and documented set of measures; the process is often automated, and the measures are published and widely available (Class B).'@en ;
    skos:notation 'SDN:R06::3B'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/R06/current/3C/1/> .
<http://vocab.nerc.ac.uk/collection/R06/current/3C/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/R06/current/3C/>;
    dc:modified '2020-04-04T15:05:33'^^xsd:dateTime ;
    skos:altLabel '3C'^^xsd:string ;
    skos:prefLabel 'Level 3, class C processing stage'@en ;
    skos:definition 'Data have been processed with assumptions about the scales of variability or thermodynamic relationships; the data are normally reduced to regular space, time intervals with enhanced signal to noise (Level 3). Moreover, the data have been scrutinized fully including intra-record and intra-dataset comparison and consistency checks; scientists have been involved in the evaluation, and brought latest knowledge to bear; the procedures are published, widely available and widely accepted (Class C).'@en ;
    skos:notation 'SDN:R06::3C'^^xsd:string .
