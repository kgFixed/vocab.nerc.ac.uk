    skos:prefLabel 'in-situ Beckmann probe (second sensor)'@en ;
    skos:definition 'A particular type of polarographic sensor for measuring dissolved oxygen concentrations in place in the field. Deployed on a package of instruments or sensors as the second sensor of this type.'@en ;
    skos:notation 'SDN:S04::S04417'^^xsd:string .
