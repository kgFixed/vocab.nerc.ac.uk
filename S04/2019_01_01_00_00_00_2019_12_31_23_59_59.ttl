    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'in-situ linear-response phycoerythrin fluorometer'@en ;
    skos:definition 'A fluorometer set-up to measure fluorescence directly in the water column and output a signal that is linearly proportional to the concentration of phycoerythrin.'@en ;
    skos:notation 'SDN:S04::S041163'^^xsd:string .
