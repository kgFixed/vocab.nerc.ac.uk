    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'semi-fixed moored in-situ pressure sensor'@en ;
    skos:definition 'An underwater pressure sensor that is mounted in an instrument on a semi-rigid mooring, such as a wire between an anchor and a sub-surface buoy. Data from the instrument are used for measuring the depth of the instrument monitor aspects of mooring performance such as knockdown.'@en ;
    skos:notation 'SDN:S04::S04314'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04135/3/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04135/3/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04135/>;
    dc:modified '2019-06-16T15:46:35'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'cold vapour atomic fluorescence spectroscopy'@en ;
    skos:definition 'This is an analytical technique for volatile heavy metals such as mercury in which vaporised metal atoms in an argon carrier at room temperature are irradiated by ultra-violet light causing them to fluoresce. The level of emitted radiation at designated wavelengths is used to quantify the amount of metal present.'@en ;
    skos:notation 'SDN:S04::S04135'^^xsd:string .
