    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S041134/>;
    dc:modified '2018-02-01T18:01:14'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'oxygen sensor (second sensor)'@en ;
    skos:definition 'Code designed to allow differentiation between multiple equivalent sensors.'@en ;
    skos:notation 'SDN:S04::S041134'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S046/2/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S046/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S046/>;
    dc:modified '2018-01-11T16:21:42'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'flow cytometry and protein fluorescence'@en ;
    skos:definition 'Flow cytometry is the analysis of biological material by detection of the light-absorbing or fluorescing properties of cells or sub-cellular fractions such as chromosomes passing in a narrow stream through a laser beam. It is automated to sort successive droplets of the stream into different fractions depending on the fluorescence emitted by each droplet. Protein fluorescence is a technique to quantify protein biomass.'@en ;
    skos:notation 'SDN:S04::S046'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S045/2/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S045/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S045/>;
    dc:modified '2018-01-11T16:20:49'^^xsd:dateTime ;
    skos:altLabel 'FCM'^^xsd:string ;
    skos:prefLabel 'flow cytometry'@en ;
    skos:definition 'Flow cytometry is the analysis of biological material by detection of the light-absorbing or fluorescing properties of cells or sub-cellular fractions such as chromosomes passing in a narrow stream through a laser beam. It is automated to sort successive droplets of the stream into different fractions depending on the fluorescence emitted by each droplet.'@en ;
    skos:notation 'SDN:S04::S045'^^xsd:string .
