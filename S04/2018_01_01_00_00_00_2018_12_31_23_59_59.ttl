    skos:altLabel 'CDRS'^^xsd:string ;
    skos:prefLabel 'cavity ring-down spectrometry'@en ;
    skos:definition 'A highly sensitive optical spectroscopic technique that enables measurement of absolute optical extinction by samples that scatter and absorb light.'@en ;
    skos:notation 'SDN:S04::S041071'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S041135/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S041135/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S041135/>;
    dc:modified '2018-04-16T17:29:30'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'nephelometry using an infrared light source'@en ;
    skos:definition 'Method for measuring turbidity using a nephelometer (instrument that measures scattered light at an angle of 90°) equipped with an infrared light source. Nephelometers are calibrated using formazine solutions (reference standard). This method is used as part of the ISO 7027 standard for turbidity measurements.'@en ;
    skos:notation 'SDN:S04::S041135'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S041134/1/> .
