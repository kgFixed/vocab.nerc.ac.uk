<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S041139/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S041139/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S041139/>;
    dc:modified '2018-09-04T11:57:25'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'in-situ flume experiment'@en ;
    skos:definition 'A benthic annular flume is used to induce and detect fluid flow in intertidal and subtidal settings. The flume is equipped with optical backscatter sensors, a rotation lid with paddles and an electromagnetic flow meter. Erodibility is inferred from the rate of change in suspended sediment concentration detected in the annulus.'@en ;
    skos:notation 'SDN:S04::S041139'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S041138/3/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S041138/3/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S041138/>;
    dc:modified '2018-06-26T14:20:20'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'in-situ optical turbidity measurement'@en ;
    skos:definition 'A technique that determines turbidity by either the absorbance (or attenuation) of passing light or the portion of light scattered at an angle from the the incident beam of light passing through water. The instrument is located in the water column.'@en ;
    skos:notation 'SDN:S04::S041138'^^xsd:string .
