    skos:altLabel ''^^xsd:string ;
    skos:prefLabel '20 or 25cm path length transmissometer (second sensor)'@en ;
    skos:definition 'An instrument that emits light of unspecified wavelength and measures how much of it reaches a receptor accurately located either 20 or 25 cm away from the transmitter. Deployed on a package of instruments or sensors as the second sensor of this type.'@en ;
    skos:notation 'SDN:S04::S041153'^^xsd:string .
