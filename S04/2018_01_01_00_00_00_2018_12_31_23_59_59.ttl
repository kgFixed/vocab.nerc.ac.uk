    skos:definition 'A linear response single channel fluorometer that measures CDOM (coloured dissolved organic matter) fluorescence (excitation wavelength 370 nm).'@en ;
    skos:notation 'SDN:S04::S041137'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S041071/2/> .
