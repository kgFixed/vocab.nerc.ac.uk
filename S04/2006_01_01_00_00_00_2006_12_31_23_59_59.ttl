    skos:prefLabel 'gamma spectroscopy (high-purity Ge detector)'@en ;
    skos:definition 'Measurement of the quantity of radiation as a function of energy or wavelength in the gamma waveband (energy >10keV) using a pure germanium detector to obtain high spectral resolution.'@en ;
    skos:notation 'SDN:S04::S04188'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04189/1/> .
