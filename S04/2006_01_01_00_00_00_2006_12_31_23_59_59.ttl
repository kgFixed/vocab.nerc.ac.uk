    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'CO2 quantification by gas analyser'@en ;
    skos:definition 'The accurate determination of the proportion of carbon dioxide in a mixture of gases using an instrument designed for the purpose, usually based on infra-red absorption.'@en ;
    skos:notation 'SDN:S04::S0455'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S0456/1/> .
