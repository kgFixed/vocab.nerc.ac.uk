    dc:modified '2006-10-06T13:47:30'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'CTD (sensor 2)'@en ;
    skos:definition 'An additional sensor package on a CTD logger incorporating a temperature sensor, an electrical conductivity sensor and a pressure sensor. Salinity is computed from conductivity and temperature. Depth below the sea surface is computed from pressure.'@en ;
    skos:notation 'SDN:S04::S04379'^^xsd:string .
