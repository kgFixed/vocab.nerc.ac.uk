    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'WET Labs optical backscatter meter'@en ;
    skos:definition 'A specific type of instrument to quantify the abundance of suspended particles based on measuring the returned proportion of light transmitted into a fixed volume of water. Often included on CTD packages.'@en ;
    skos:notation 'SDN:S04::S04107'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04108/1/> .
