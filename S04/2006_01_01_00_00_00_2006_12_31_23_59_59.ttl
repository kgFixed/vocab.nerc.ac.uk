    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'thermomètre à renversement'@en ;
    skos:definition 'Thermomètre capable d\'enregistrer la température à laquelle l\'instrument est renversé et de l\'afficher jusqu\'à ce que l\'instrument soit ré-initialisé.'@en ;
    skos:notation 'SDN:S04::S04307'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04308/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04308/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04308/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'scatterometer'@en ;
    skos:definition 'A radar system that infers wind speed by measuring the backscattering cross section or normalized radar cross section.'@en ;
    skos:notation 'SDN:S04::S04308'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04309/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04309/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04309/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'scattering photometer'@en ;
    skos:definition 'An instrument that illuminates a sample with specified laser light wavelengths and determines the degree to which this is scattered by dissolved molecules or suspended particulate material.'@en ;
    skos:notation 'SDN:S04::S04309'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04310/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04310/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04310/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'scintillation counting'@en ;
    skos:definition 'A technique for assaying beta or gamma radiation by quantitative detection of visible light produced by the passage of rays or particles through a suitable scintillant. The scintillant may either be incorporated with the sample (liquid scintillation counting) or incorporated with a photomultiplier into a detector.'@en ;
    skos:notation 'SDN:S04::S04310'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04312/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04312/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04312/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'semi-fixed moored SBE MicroCAT'@en ;
    skos:definition 'A specific make of CTD mounted on a mooring that allows restricted vertical movement in the water column. Depth data are therefore a mooring performance indicator rather than a measurement of waves or tides.'@en ;
    skos:notation 'SDN:S04::S04312'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04313/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04313/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04313/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'semi-fixed moored SonTek current meter'@en ;
    skos:definition 'A particular type of current meter that measures water velocity by determining Doppler shift of sound reflected off particulates in the water column mounted on a subsurface mooring that allow limited vertical movement (e.g. suspended on a wire between an anchor and a subsurface buoy).'@en ;
    skos:notation 'SDN:S04::S04313'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04316/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04316/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04316/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'settling velocity tube experiment'@en ;
    skos:definition 'A technique where a water sample is placed in a long vertical tube from which samples are drawn from the bottom at intervals to determine particle setting velocities and the properties of particles settling as a function of time.'@en ;
    skos:notation 'SDN:S04::S04316'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04318/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04318/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04318/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'shipborne acoustic doppler current profiler (ADCP)'@en ;
    skos:definition 'A type of current meter capable of simultaneous measurement of current velocity at a number of different depths based on determining Doppler shift of transmitted sound. Instrument mounted on a moving platform such that the signal is transmitted downwards toward the seabed. Note that unless the ship is firmly anchored currents are not measured directly and need to be computed by differencing ship\'s velocities relative to land and water.'@en ;
    skos:notation 'SDN:S04::S04318'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04319/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04319/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04319/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'shipborne electro-magnetic log'@en ;
    skos:definition 'A sensor fitted to the hull that measures the velocity of the ship relative to the water.'@en ;
    skos:notation 'SDN:S04::S04319'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S0432/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S0432/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S0432/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel '1m path length red light transmissometer'@en ;
    skos:definition 'An instrument that emits red (usually 660nm wavelength) light and measures how much of it reaches a receptor accurately located 1 m away from the transmitter.'@en ;
    skos:notation 'SDN:S04::S0432'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04320/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04320/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04320/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'shipborne wave recorder'@en ;
    skos:definition 'A device for measuring height and period of sea-surface waves with two accelerometer and pressure sensor (inlet 1-2 m below the waterline) pairs mounted either side of the hull of a ship. The accelerometers measure vertical movement of the ship as it tries to follow each wave and the pressure sensors measure change in water height along the hull due to the ship\'s failure to follow the wave accurately. Combining the two gives the true wave height. Sensor pairs allow correction for rolling.'@en ;
    skos:notation 'SDN:S04::S04320'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04322/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04322/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04322/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'sound velocity profiler'@en ;
    skos:definition 'An instrument for the measurement of the velocity of sound in the water column in place in the field.'@en ;
    skos:notation 'SDN:S04::S04322'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04323/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04323/1/>
