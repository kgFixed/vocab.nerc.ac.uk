    skos:prefLabel 'barometer'@en ;
    skos:definition 'An instrument that measures atmospheric pressure.'@en ;
    skos:notation 'SDN:S04::S04122'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04124/1/> .
