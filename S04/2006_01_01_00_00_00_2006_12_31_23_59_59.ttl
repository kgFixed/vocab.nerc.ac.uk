    dc:modified '2006-10-06T13:47:30'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'ion-exchange chromatography and U-Th mass spectrometry using 229Th-236U spike standard'@en ;
    skos:definition 'A U/Th dating technique in which the target ions are extracted by passing solution over an ion-exchange resin and then quantified with a spike standard by mass spectrometry.'@en ;
    skos:notation 'SDN:S04::S04393'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04394/1/> .
