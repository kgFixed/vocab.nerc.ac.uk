    skos:prefLabel 'multibeam echo sounder central beam'@en ;
    skos:definition 'Water depth measurement by determining the time taken for the seabed echo to return from the central, vertical sound pulse beam of a fan-shaped multibeam array.'@en ;
    skos:notation 'SDN:S04::S04396'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04397/1/> .
