    skos:prefLabel 'formaldoxime 460nm colorimetric autoanalysis'@en ;
    skos:definition 'A method of chemical analysis where the analyte is quantitatively coloured by reaction with formaldoxime. The resulting colour strength is assayed by absorption of light of 460nm wavelength.'@en ;
    skos:notation 'SDN:S04::S04186'^^xsd:string .
