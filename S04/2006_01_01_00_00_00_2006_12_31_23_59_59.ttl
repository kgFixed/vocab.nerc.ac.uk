    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'not specified'@en ;
    skos:definition 'There is no information available on the analytical protocol used to obtain the phenomenon measurement .'@en ;
    skos:notation 'SDN:S04::S0421'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04211/1/> .
