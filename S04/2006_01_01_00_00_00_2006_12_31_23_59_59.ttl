    skos:prefLabel 'Winkler titration'@en ;
    skos:definition 'Technique de référence absolue pour déterminer l\'oxygène dissous par transformation de l\'oxygène en iode, laquelle est dosée grâce à du thiosulfate.'@en ;
    skos:notation 'SDN:S04::S04108'^^xsd:string .
