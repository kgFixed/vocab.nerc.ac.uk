    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'spectrophotometric absorbance at two different wavelengths of CO2-equilibrated fixed alkalinity dye solution'@en ;
    skos:definition 'A technique for measuring carbonate system parameters based on spectrophotometric quantification of degree of stain fixation by carbon dioxide.'@en ;
    skos:notation 'SDN:S04::S04323'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04325/1/> .
