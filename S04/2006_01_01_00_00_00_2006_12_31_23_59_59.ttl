    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'in-situ Beckmann probe'@en ;
    skos:definition 'A particular type of polarographic sensor for measuring dissolved oxygen concentrations in place in the field.'@en ;
    skos:notation 'SDN:S04::S04211'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04213/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04213/1/>
    a skos:Concept ;
