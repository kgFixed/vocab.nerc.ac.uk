    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'bathythermograph'@en ;
    skos:definition 'An instrument that records a profile of water column temperature as a function of depth.'@en ;
    skos:notation 'SDN:S04::S04124'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04125/1/> .
