    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'time series analysis of gut pigment content'@en ;
    skos:definition 'Multiple determinations of gut pigment content separated by predetermined periods of time.'@en ;
    skos:notation 'SDN:S04::S0429'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04290/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04290/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04290/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'pre-GPS satellite navigation'@en ;
    skos:definition 'Position location based on the incomplete satellite coverage available prior to the deployment of the Global Positioning Satellite network.'@en ;
    skos:notation 'SDN:S04::S04290'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04293/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04293/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04293/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'profiling pressure sensor'@en ;
    skos:definition 'An underwater pressure sensor that is mounted to an instrument or vehicle that is able to move freely in the water column. The data are used to determine the depth of the sensor below the sea surface.'@en ;
    skos:notation 'SDN:S04::S04293'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04296/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04296/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04296/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'protocol of Slawyk and Raimbault (1995)'@en ;
    skos:definition 'Nitrogen analysis as described in Slawyk G., Raimbault P. (1995) A simple procedure for the simultaneous recovery of dissolved inorganic and organic nitrogen in 15N-tracer experiments on oceanic waters improving the mass balance. Mar. Ecol. Prog. Ser.,124: 289-299.'@en ;
    skos:notation 'SDN:S04::S04296'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04297/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04297/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04297/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'psychrometer'@en ;
    skos:definition 'A psychrometer consists of two thermometers, one dry the other wrapped in water-soaked muslin, which give the dry and wet bulb air temperatures used to calculate relative humidity and dew point.'@en ;
    skos:notation 'SDN:S04::S04297'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04298/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04298/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04298/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'psychrometer dry bulb'@en ;
    skos:definition 'The thermometer in a psychrometer (instrument designed to determine the moisture content of air) that is dry and therefore measures ambient air temperature.'@en ;
    skos:notation 'SDN:S04::S04298'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04299/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04299/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04299/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'in-situ pump and probe chlorophyll fluorometer'@en ;
    skos:definition 'A double flash fluorometer containing two excitation channels and one emission channel. One excitation channel provides a weak, probe flash used for measuring the fluorescence yield of Photosystem II. The other provides a pump flash, which is used for closing the reaction centres of PS II. Light from the flashlamps is collected by condensers and a set of blue-green excitation filters. Emission signal is collected by a condenser and a red filter before striking the photodetector.'@en ;
    skos:notation 'SDN:S04::S04299'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S0430/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S0430/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S0430/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel '10cm path length red light transmissometer'@en ;
    skos:definition 'An instrument that emits red (usually 660nm wavelength) light and measures how much of it reaches a receptor accurately located 10 cm away from the transmitter.'@en ;
    skos:notation 'SDN:S04::S0430'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04300/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04300/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04300/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'pyranometer'@en ;
    skos:definition 'The standard instrument for measuring solar radiation incident on a horizontal surface by measuring the temperature of a black body target that has been calibrated in terms of radiative flux. Sensitive to wavelengths between 300 and 3000 nm.'@en ;
    skos:notation 'SDN:S04::S04300'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04301/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04301/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04301/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'radiance sensor'@en ;
    skos:definition 'A sensor that measures radiance - the amount of light energy or photons measured in a specified time period in a unit area from a given direction. Usually this direction is vertically downwards or vertically upwards. Physically, the sensors consist of a radiometer sensor at the base of a tube.'@en ;
    skos:notation 'SDN:S04::S04301'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04302/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04302/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04302/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'radiometer'@en ;
    skos:definition 'An instrument that measures the intensity of electromagnetic radiation.'@en ;
    skos:notation 'SDN:S04::S04302'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04303/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04303/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04303/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'barometric altimeter'@en ;
    skos:definition 'An aneroid barometer calibrated to convert atmospheric pressure into altitude.'@en ;
    skos:notation 'SDN:S04::S04303'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04304/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04304/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04304/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'aneroid barometer'@en ;
    skos:definition 'An instrument for measuring atmospheric pressure in which a needle, attached to the top of an evacuated box, is deflected as changes in atmospheric pressure cause the top of the box to bend in or out.'@en ;
    skos:notation 'SDN:S04::S04304'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04305/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04305/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04305/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'red light transmissometer'@en ;
    skos:definition 'An instrument that emits red (usually 660nm wavelength) light and measures how much of it reaches a receptor accurately located a fixed but unspecified distance away from the transmitter.'@en ;
    skos:notation 'SDN:S04::S04305'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04306/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04306/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04306/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'redox electrode'@en ;
    skos:definition 'A redox electrode is an electrode made from electron-conductive material and characterized by high chemical stability in the solution under test. It is used for measuring the redox potential of a specific redox system in solution.'@en ;
    skos:notation 'SDN:S04::S04306'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04307/1/> .
