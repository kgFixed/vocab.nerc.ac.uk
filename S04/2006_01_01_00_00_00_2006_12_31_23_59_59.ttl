    skos:prefLabel 'LORAN navigation'@en ;
    skos:definition 'Long-range Navigation (LORAN) is a terrestrial navigation system using low frequency radio transmitters that use the time interval between radio signals received from three or more stations to determine the position of a ship or aircraft.'@en ;
    skos:notation 'SDN:S04::S0473'^^xsd:string .
