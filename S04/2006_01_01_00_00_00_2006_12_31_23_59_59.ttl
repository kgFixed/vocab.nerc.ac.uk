    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'physical measurement and stratigraphic dating'@en ;
    skos:definition 'Technique for determination of sediment accumulation rate. The sediment thickness accumulated is measured using a ruler and the time taken for sediment accumulation is determined by stratigraphic dating techniques such as horizon identification and micropalaeontology.'@en ;
    skos:notation 'SDN:S04::S04283'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04286/1/> .
