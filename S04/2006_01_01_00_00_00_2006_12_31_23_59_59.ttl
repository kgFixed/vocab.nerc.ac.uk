<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04110/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04110/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04110/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'X-ray diffraction'@en ;
    skos:definition 'An analytical technique used to identify crystalline solids by measuring the characteristic spaces between layers of atoms or molecules in a crystal.'@en ;
    skos:notation 'SDN:S04::S04110'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04111/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04111/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04111/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'X-ray fluorescence'@en ;
    skos:definition 'A method for identifying the elemental constituents of a sample from the spectrum of electromagnetic radiation emitted by the atoms in the sample when excited by X-ray radiation.'@en ;
    skos:notation 'SDN:S04::S04111'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04112/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04112/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04112/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'YSI profiling oxygen and temperature probe'@en ;
    skos:definition 'A specific measurement system comprising a pontoon or surface buoy-mounted winch that periodically lowers a package with dissolved oxygen and water temperature sensors down through the water column to a predetermined depth and back again.'@en ;
    skos:notation 'SDN:S04::S04112'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04113/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04113/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04113/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'acidification weight loss'@en ;
    skos:definition 'Determination of the mass of a sample on an analytical balance before and after treatment with a strong acid. Generally used to determine inorganic carbon (carbonate and/or bicarbonate).'@en ;
    skos:notation 'SDN:S04::S04113'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04115/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04115/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04115/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'acoustic triangulation from sonar moorings'@en ;
    skos:definition 'A method of navigational positioning based on acoustic determination of distance of a target from each of a network of sonar moorings often used for the location of neutrally buoyant floats.'@en ;
    skos:notation 'SDN:S04::S04115'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04116/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04116/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04116/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'advanced very high resolution radiometer (AVHRR)'@en ;
    skos:definition 'The AVHRR is a multiband (4 wavelength on AVHRR/1, 5 on AVHRR/2 and 6 on AVHRR/2) scanning radiometer mounted on aircraft or more usually satellites. Main oceanographic application is the measurement of sea surface temperature using a wavelength between 11.5 and 12.5 microns, but the instrument can also map clouds, snow/ice fields and land/sea boundaries. Resolution of the AVHRR/3 is 1.09km at Nadir.'@en ;
    skos:notation 'SDN:S04::S04116'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04117/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04117/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04117/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'alpha plus beta spectroscopy'@en ;
    skos:definition 'Measurement of the quantity of radiation as a function of energy from both alpha and beta particles.'@en ;
    skos:notation 'SDN:S04::S04117'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04118/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04118/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04118/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'alpha spectroscopy'@en ;
    skos:definition 'Measurement of the quantity of radiation as a function of energy from alpha particles.'@en ;
    skos:notation 'SDN:S04::S04118'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04119/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04119/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04119/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'atomic absorption spectroscopy'@en ;
    skos:definition 'An analytical technique in which the sample is volatilised, usually by an oxy-acetylene flame, and the resultant vapour illuminated by a light source having an emission spectrum matched to the analyte of interest. The radiation absorbed by chemically unbound atoms is determined by analysing the transmitted energy relative to the incident energy at each frequency, which is proportional to the elemental concentrations.'@en ;
    skos:notation 'SDN:S04::S04119'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04119/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04119/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04119/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'spectrométrie d\'absorption atomique (SAA)'@en ;
    skos:definition 'An analytical technique in which the sample is volatilised, usually by an oxy-acetylene flame, and the resultant vapour illuminated by a light source having an emission spectrum matched to the analyte of interest. The radiation absorbed by chemically unbound atoms is determined by analysing the transmitted energy relative to the incident energy at each frequency, which is proportional to the elemental concentrations.'@en ;
    skos:notation 'SDN:S04::S04119'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04119/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04119/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04119/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'atomic absorption spectroscopy'@en ;
    skos:definition 'Technique analytique par laquelle l\'échantillon est vaporisé grâce à une flamme issue d\'un mélange de gaz. La vapeur résultante est éclairée par une lumière dont le spectre d\'émission correspond à l\'analyte d\'intérêt. La radiation absorbée par les atomes à l\'état fondamental est déterminée par comparaison de l\'énergie transmise par rapport à l\'énergie incidente pour chaque fréquence. La quantité de radiation absorbée est proportionnelle à la concentration de l\'élément.'@en ;
    skos:notation 'SDN:S04::S04119'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04119/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04119/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04119/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'spectrométrie d\'absorption atomique (SAA)'@en ;
    skos:definition 'Technique analytique par laquelle l\'échantillon est vaporisé grâce à une flamme issue d\'un mélange de gaz. La vapeur résultante est éclairée par une lumière dont le spectre d\'émission correspond à l\'analyte d\'intérêt. La radiation absorbée par les atomes à l\'état fondamental est déterminée par comparaison de l\'énergie transmise par rapport à l\'énergie incidente pour chaque fréquence. La quantité de radiation absorbée est proportionnelle à la concentration de l\'élément.'@en ;
    skos:notation 'SDN:S04::S04119'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04121/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04121/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04121/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'autoranging chlorophyll fluorometer'@en ;
    skos:definition 'A linear-response fluorometer, set up to measure chlorophyll fluorescence (transmit violet, receive red), that enhances sensitivity at low chlorophyll concentrations by automatically selecting one of a set of discrete signal gain levels.'@en ;
    skos:notation 'SDN:S04::S04121'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04122/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04122/1/>
    a skos:Concept ;
