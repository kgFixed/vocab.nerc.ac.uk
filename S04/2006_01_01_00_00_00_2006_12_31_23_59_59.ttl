    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'spectrophotometry'@en ;
    skos:definition 'Measurement of the amount of light absorbed by a sample at one or more specified wavelengths, generally within the visible waveband.'@en ;
    skos:notation 'SDN:S04::S04325'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04325/1/> .
