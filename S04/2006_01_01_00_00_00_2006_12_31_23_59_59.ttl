    skos:definition 'A specific type of Global Positioning System navigation receiver.'@en ;
    skos:notation 'SDN:S04::S0453'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S0455/1/> .
