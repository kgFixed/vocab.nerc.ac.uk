    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'humidity sensor'@en ;
    skos:definition 'An instrument that directly measures the water content of the atmosphere.'@en ;
    skos:notation 'SDN:S04::S04208'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04209/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04209/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04209/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'hydride generation inductively-coupled plasma atomic emission spectroscopy'@en ;
    skos:definition 'Volatile hydrides of the target analytes are generated and passed into an inductively-coupled gas plasma (8-10000 K)) where it is dried, melted, evaporated, atomized, then excited. When the excited atoms pass through the cooler part of the plasma they de-excite releasing photons at specific wavelengths dependent on the element. The wavelength emissions are passed to the optical system which measures their intensities, which are directly proportional to the concentrations of the analytes.'@en ;
    skos:notation 'SDN:S04::S04209'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S0421/1/> .
