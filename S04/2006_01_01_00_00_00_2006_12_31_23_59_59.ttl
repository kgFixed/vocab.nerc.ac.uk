    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Coulter particle counter'@en ;
    skos:definition 'An instrument that quantifies number, volume, mass and surface area size distributions of particles suspended in a fluid using an electrical sensing zone method known as the Coulter principle.'@en ;
    skos:notation 'SDN:S04::S0460'^^xsd:string .
