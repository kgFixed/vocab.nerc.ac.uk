    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'thermomètre à renversement'@en ;
    skos:definition 'A thermometer that records the temperature at which the instrument is inverted, retaining that temperature reading until the instrument is reset.'@en ;
    skos:notation 'SDN:S04::S04307'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04307/1/> .
