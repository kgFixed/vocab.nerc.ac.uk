    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'in-situ suspended particulate material (SPM) meter'@en ;
    skos:definition 'An instrument, generally a calibrated transmissometer, for giving direct measurements of suspended particulate material concentration in place in the field.'@en ;
    skos:notation 'SDN:S04::S04213'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04214/1/> .
