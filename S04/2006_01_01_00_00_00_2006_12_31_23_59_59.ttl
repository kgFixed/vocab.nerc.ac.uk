    skos:prefLabel 'in-situ thermistor'@en ;
    skos:definition 'A semiconductor with large linear changes of resistance as a function of temperature located in the medium of measurement (water column or atmosphere) to measure temperature.'@en ;
    skos:notation 'SDN:S04::S04231'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04232/1/> .
