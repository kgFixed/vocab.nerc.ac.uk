    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'fluorometer temperature sensor'@en ;
    skos:definition 'A sensor to measure temperature incorporated into a fluorometer.'@en ;
    skos:notation 'SDN:S04::S04183'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04185/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04185/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04185/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'fluorometry'@en ;
    skos:definition 'An analytical technique for identifying and characterizing minute amounts of a substance by excitation of the substance with a beam of light, usually ultraviolet, and detection and measurement of the characteristic wavelength of fluorescent light emitted.'@en ;
    skos:notation 'SDN:S04::S04185'^^xsd:string .
