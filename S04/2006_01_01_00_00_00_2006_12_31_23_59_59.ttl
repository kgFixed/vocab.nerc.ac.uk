    skos:prefLabel 'colorimetric autoanalysis'@en ;
    skos:definition 'A method of chemical analysis where the analyte is quantitatively converted to a coloured compound that is assayed by absorption of light of a specified wavelength in a system with a production line that automatically ingests the sample, generates the coloured compound and measures the strength of the colour.'@en ;
    skos:notation 'SDN:S04::S04137'^^xsd:string .
