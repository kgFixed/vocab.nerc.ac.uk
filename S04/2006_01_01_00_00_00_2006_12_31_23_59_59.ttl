    skos:definition 'A particular make of instrument that emits light of unknown wavelength and measures how much of it reaches a receptor accurately located at fixed but unknown distance away from the transmitter.'@en ;
    skos:notation 'SDN:S04::S04105'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04106/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04106/1/>
    a skos:Concept ;
