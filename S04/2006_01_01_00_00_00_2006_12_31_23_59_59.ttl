    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04125/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'bench fluorometer'@en ;
    skos:definition 'A linear-response fluorometer, by default assumed to be set up to measure chlorophyll fluorescence (transmit violet, receive red), that analyses discrete in-vitro samples.'@en ;
    skos:notation 'SDN:S04::S04125'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04126/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04126/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04126/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'bench salinometer'@en ;
    skos:definition 'A laboratory instrument for precise, accurate determination of salinity by relative conductivity measurement with certified standard seawater.'@en ;
    skos:notation 'SDN:S04::S04126'^^xsd:string .
