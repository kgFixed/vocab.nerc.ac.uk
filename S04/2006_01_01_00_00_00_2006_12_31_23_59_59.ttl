    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'CO2 quantification by indicator photometry'@en ;
    skos:definition 'The accurate determination of the proportion of carbon dioxide in a mixture of gases based on titration with a pH indicator and photometric end-point detection.'@en ;
    skos:notation 'SDN:S04::S0456'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S0457/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S0457/1/>
    a skos:Concept ;
