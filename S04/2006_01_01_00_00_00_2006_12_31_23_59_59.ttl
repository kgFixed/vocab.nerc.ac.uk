    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Western dot blot'@en ;
    skos:definition 'A technique which transfers proteins electrophoretically separated in a polyacrylamide gel to a nitrocellulose membrane and uses specific antibodies to bind, locate, and visualise the protein of interest.'@en ;
    skos:notation 'SDN:S04::S04106'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04107/1/> .
