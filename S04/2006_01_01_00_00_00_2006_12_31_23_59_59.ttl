    skos:prefLabel 'in-situ acoustic current meter'@en ;
    skos:definition 'A type of current meter that determines current velocity in the water column in place in the field based on determining Doppler shift of transmitted sound.'@en ;
    skos:notation 'SDN:S04::S04214'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04215/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04215/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04215/>;
