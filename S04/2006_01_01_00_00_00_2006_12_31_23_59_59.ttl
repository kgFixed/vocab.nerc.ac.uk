<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04392/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04392/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04392/>;
    dc:modified '2006-10-06T13:47:30'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'ion probe analysis'@en ;
    skos:definition 'A technique in which the specimen is bombarded by a focused beam of ions (diameter less than 10mm) causing ions to be ejected from the specimen.  These are identified and quantified by passage through a mass spectrometer.'@en ;
    skos:notation 'SDN:S04::S04392'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04393/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04393/1/>
    a skos:Concept ;
