    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'bench salinometer'@en ;
    skos:definition 'Instrument de laboratoire utilisé pour déterminer la salinité de manière exacte (juste et fidèle) de l\'échantillon en mesurant sa conductivité relative (instrument étalonné avec une eau de mer "normale" certifiée).'@en ;
    skos:notation 'SDN:S04::S04126'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04126/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04126/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04126/>;
