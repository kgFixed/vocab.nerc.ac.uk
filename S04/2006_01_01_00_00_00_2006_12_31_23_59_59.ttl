    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04154/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'counting liberated gas'@en ;
    skos:definition 'Determination of the level of radioactivity in gas liberated from the sample (usually CO2 released by sample acidification)'@en ;
    skos:notation 'SDN:S04::S04154'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04155/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04155/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04155/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'counting residue'@en ;
    skos:definition 'Determination of the level of radioactivity in the material trapped on the filter paper after a sample has been filtered.'@en ;
    skos:notation 'SDN:S04::S04155'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04156/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04156/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04156/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'current meter high-resolution thermistor'@en ;
    skos:definition 'A high quality temperature sensor (generally capable of resolving temperature differences of 0.01 Celsius or better) incorporated into a current meter instrument package.'@en ;
    skos:notation 'SDN:S04::S04156'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04157/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04157/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04157/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'dead reckoning based on GPS and em-log or ADCP'@en ;
    skos:definition 'The estimation of position based upon interpolation between satellite fixes from the GPS network using measurements of ship\'s velocity through the water.'@en ;
    skos:notation 'SDN:S04::S04157'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04158/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04158/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04158/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'determined as ammonium'@en ;
    skos:definition 'Quantification of an analyte chemically converted to ammonium (e.g. amines by oxidation) by determination of the amount of ammonium produced using an unspecified analytical technique.'@en ;
    skos:notation 'SDN:S04::S04158'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04159/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04159/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04159/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'differential pulse polarography'@en ;
    skos:definition 'Polarography is an electrochemical method of analysing solutions of reducible or oxidisable substances. Voltage is varied in a regular manner between two sets of electrodes (indicator and reference) while the current is monitored. The shape of a polarogram depends on the method of analysis selected, the type of indicator electrode used, and the potential ramp that is applied. In Differential Pulse Polarography the potential ramp is a series of discrete potential steps.'@en ;
    skos:notation 'SDN:S04::S04159'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04160/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04160/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04160/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'digital thermometer'@en ;
    skos:definition 'An instrument to measure temperature that delivers the measurement directly on a numeric display.'@en ;
    skos:notation 'SDN:S04::S04160'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04161/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04161/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04161/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'direct reading current meter'@en ;
    skos:definition 'An instrument to measure current speed in the water column that delivers the measurement directly on a dial or a numeric display.'@en ;
    skos:notation 'SDN:S04::S04161'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04162/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04162/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04162/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'downward-looking acoustic doppler current profiler (ADCP)'@en ;
    skos:definition 'A type of current meter capable of simultaneous measurement of current velocity at a number of different depths based on determining Doppler shift of transmitted sound. Instrument has been mounted so that the signal is transmitted towards the seafloor .'@en ;
    skos:notation 'SDN:S04::S04162'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04163/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04163/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04163/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'dry bulb thermometer'@en ;
    skos:definition 'An instrument to measure air temperature.'@en ;
    skos:notation 'SDN:S04::S04163'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04164/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04164/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04164/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'echo sounder'@en ;
    skos:definition 'An instrument that measures the depth of water by transmitting pulses of sound and determining the time taken for the seabed echo to return.'@en ;
    skos:notation 'SDN:S04::S04164'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04165/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04165/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04165/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'echo sounder (SV=1500m/s)'@en ;
    skos:definition 'An instrument that measures the depth of water by transmitting pulses of sound and determining the time taken for the seabed echo to return. Distance is computed assuming that sound travels in sea water at 1500 metres per second.'@en ;
    skos:notation 'SDN:S04::S04165'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04166/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04166/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04166/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'echo sounder (SV=4800ft/s)'@en ;
    skos:definition 'An instrument that measures the depth of water by transmitting pulses of sound and determining the time taken for the seabed echo to return. Distance is computed assuming that sound travels in sea water at 4800 feet per second.'@en ;
    skos:notation 'SDN:S04::S04166'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04168/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04168/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04168/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'inclinometer'@en ;
    skos:definition 'An instrument to measure the orientation of an object relative to the Earth\'s gravitational field.'@en ;
    skos:notation 'SDN:S04::S04168'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04169/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04169/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04169/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'expendable bathythermograph (XBT)'@en ;
    skos:definition 'A disposable probe that is thrown overboard with a thin wire umbilical returning temperature measurements until it hits the seabed or the umbilical breaks. Depth is estimated from elapsed time based on fall-rate equations.'@en ;
    skos:notation 'SDN:S04::S04169'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S0417/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S0417/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S0417/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'method of Lowry et al. (1951) modified by Rutter (1967)'@en ;
    skos:definition 'Protein determination described in Lowry, OH, Rosebrough, NJ, Farr, AL, and Randall, RJ (1951) Protein measurement with the Folin phenol reagent. J. Biol. Chem. 193, 265-275. Modifications described in Rutter, WJ (1967) Protein determinations in embryos in Methods in Environmental Biology, pp671-684, NY Academic Press.'@en ;
    skos:notation 'SDN:S04::S0417'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04170/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04170/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04170/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'ferrospectral 550nm colorimetric autoanalysis'@en ;
    skos:definition 'A method of chemical analysis where the analyte is quantitatively coloured by reaction with ferrospectral reagent. The resulting colour strength is assayed by absorption of light of 550nm wavelength.'@en ;
    skos:notation 'SDN:S04::S04170'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04172/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04172/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04172/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'firefly enzyme luminescence'@en ;
    skos:definition 'A technique to quantify adenylates by addition of an enzyme that emits light in proportion to their concentration.'@en ;
    skos:notation 'SDN:S04::S04172'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04173/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04173/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04173/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'flame photometry'@en ;
    skos:definition 'Analytical technique where sample solution is sprayed as a fine mist into a flame causing vaporisation and atomic excitation resulting in emission of light energy at characteristic wavelengths. A detector quantifies the strength of the emissions.'@en ;
    skos:notation 'SDN:S04::S04173'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04173/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04173/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04173/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'photométrie de flamme'@en ;
    skos:definition 'Analytical technique where sample solution is sprayed as a fine mist into a flame causing vaporisation and atomic excitation resulting in emission of light energy at characteristic wavelengths. A detector quantifies the strength of the emissions.'@en ;
    skos:notation 'SDN:S04::S04173'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04173/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04173/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04173/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'flame photometry'@en ;
    skos:definition 'Technique analytique dans laquelle une flamme est aspergée par de fines goutelettes de la solution d\'intérêt. La solution est alors vaporisée et les atomes excités. Ceci entraine une émission de lumière à des longueurs d\'ondes caractéristiques. L\'intensité de ces émissions est mesurée par un détecteur.'@en ;
    skos:notation 'SDN:S04::S04173'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04173/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04173/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04173/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'photométrie de flamme'@en ;
    skos:definition 'Technique analytique dans laquelle une flamme est aspergée par de fines goutelettes de la solution d\'intérêt. La solution est alors vaporisée et les atomes excités. Ceci entraine une émission de lumière à des longueurs d\'ondes caractéristiques. L\'intensité de ces émissions est mesurée par un détecteur.'@en ;
    skos:notation 'SDN:S04::S04173'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04176/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04176/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04176/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'flow meter'@en ;
    skos:definition 'An instrument that detects the rate of flow of a liquid (usually water) through a plumbing system, net, plankton recorder or similar device.'@en ;
    skos:notation 'SDN:S04::S04176'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04177/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04177/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04177/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'flow-injection analysis'@en ;
    skos:definition 'The input of a sample or reagent into an analytical device by introduction into a continuous stream by use of a rapid delivery device.'@en ;
    skos:notation 'SDN:S04::S04177'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04178/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04178/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04178/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'flow-injection chemiluminescence'@en ;
    skos:definition 'The input of a sample or reagent into a chemiluminescence analyser (an instrument that quantitatively detects light emitted during a chemical reaction) by introduction into a continuous stream by use of a rapid delivery device.'@en ;
    skos:notation 'SDN:S04::S04178'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04179/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04179/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04179/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'flow-injection fluorometry'@en ;
    skos:definition 'The input of a sample or reagent into a fluorometer (an instrument that quantitatively detects light emitted following excitation by irradiation) by introduction into a continuous stream by use of a rapid delivery device.'@en ;
    skos:notation 'SDN:S04::S04179'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S0418/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S0418/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S0418/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'method of Mackas and Bohrer (1976)'@en ;
    skos:definition 'A protocol for the determination of zooplankton gut pigment content described in Mackas and Bohrer (1976) Journal of Experimental Marine Biology and Ecology, 25, 77-85.'@en ;
    skos:notation 'SDN:S04::S0418'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04180/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04180/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04180/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'flow-injection gas diffusion'@en ;
    skos:definition 'A technique where aliquots of sample and reagent generating a gaseous product are injected into a continuous carrier stream. This donor stream is separated from an acceptor stream by a micro-porous membrane through which the gaseous product diffuses to be taken for analysis by the acceptor stream.'@en ;
    skos:notation 'SDN:S04::S04180'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04182/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04182/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04182/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'fluorescence high performance liquid chromatography (HPLC)'@en ;
    skos:definition 'A chromatographic technique for separating and analysing mixtures of substances, using a packed column containing microspheres coated with the stationary phase and where the mobile phase is pumped through the column with a high pressure pump. The emergence of each component of the sample under analysis from the column is monitored using a fluorescence detector.'@en ;
    skos:notation 'SDN:S04::S04182'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04182/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04182/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04182/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'chromatographie liquide haute performance (HPLC) - spectrométrie de fluorescence moléculaire'@en ;
    skos:definition 'A chromatographic technique for separating and analysing mixtures of substances, using a packed column containing microspheres coated with the stationary phase and where the mobile phase is pumped through the column with a high pressure pump. The emergence of each component of the sample under analysis from the column is monitored using a fluorescence detector.'@en ;
    skos:notation 'SDN:S04::S04182'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04182/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04182/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04182/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'fluorescence high performance liquid chromatography (HPLC)'@en ;
    skos:definition 'Technique chromatographique visant à séparer et analyser des mélanges de substances en utilisant une colonne garnie contenant des microsphères enrobées d\'une phase stationnaire. La phase mobile est pompée au travers de la colonne à l\'aide d\'une pompe à haute pression. L\'émergence de chacune des composantes de l\'échantillon est examinée à l\'aide d\'un détecteur de fluorescence.'@en ;
    skos:notation 'SDN:S04::S04182'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04182/1/> .
