    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'bottom photography'@en ;
    skos:definition 'Photography of the seabed using a camera in a pressure-resistant waterproof housing.'@en ;
    skos:notation 'SDN:S04::S04129'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S0413/1/> .
