    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'multi-beam echo sounder'@en ;
    skos:definition 'A system for determining water depth along a swath either side of the platform by measuring the time taken for the seabed echoes to return from a fan-shaped array of  beams of sound pulses.'@en ;
    skos:notation 'SDN:S04::S04395'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04396/1/> .
