    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'radar water level recorder'@en ;
    skos:definition 'A precision water level measuring instrument based on radar that can be used to measure waves or sea level depending on sampling frequency and averaging intervals.'@en ;
    skos:notation 'SDN:S04::S04397'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04398/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04398/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04398/>;
    dc:modified '2006-10-06T13:47:30'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'shipborne acoustic doppler current profiler (ADCP) beam 1'@en ;
    skos:definition 'Current measurement from one transmitter on a type of current meter capable of simultaneous measurement of current velocity at a number of different depths based on determining Doppler shift of transmitted sound. Instrument mounted on a moving platform such that the signal is transmitted downwards toward the seabed. Note that unless the ship is firmly anchored currents are not measured directly and need to be computed by differencing ship\'s velocities relative to land and water.'@en ;
    skos:notation 'SDN:S04::S04398'^^xsd:string .
