    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'chromatographie en phase gaseuse (GC)'@en ;
    skos:definition 'A technique to separate gases, volatile substances or substances dissolved in a volatile solvent by transport by an inert gas through a column packed with a sorbent to one of several types of detector.'@en ;
    skos:notation 'SDN:S04::S04189'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04189/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04189/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04189/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'gas chromatography'@en ;
    skos:definition 'Technique de séparation de gaz, de substances volatiles, ou de substances dissoutes dans un solvent volatile via leur transport, par un gaz inerte, au travers d\'une colonne garnie d\'un sorbant. Les composantes de l\'échantillon, une fois séparées, sont passées dans un ou plusieurs détecteurs.'@en ;
    skos:notation 'SDN:S04::S04189'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04189/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04189/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04189/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'chromatographie en phase gaseuse (GC)'@en ;
    skos:definition 'Technique de séparation de gaz, de substances volatiles, ou de substances dissoutes dans un solvent volatile via leur transport, par un gaz inerte, au travers d\'une colonne garnie d\'un sorbant. Les composantes de l\'échantillon, une fois séparées, sont passées dans un ou plusieurs détecteurs.'@en ;
    skos:notation 'SDN:S04::S04189'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S0419/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S0419/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S0419/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'microscopy'@en ;
    skos:definition 'Identification and quantification of biological entities or other small objects using an unspecified type of microscope.'@en ;
    skos:notation 'SDN:S04::S0419'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04190/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04190/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04190/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'gas chromatography-atomic absorption spectroscopy'@en ;
    skos:definition 'A technique to separate gases, volatile substances or substances dissolved in a volatile solvent by transport by an inert gas through a column packed with a sorbent. The separated components are then analysed by volatilisation in a flame and quantification of light absorption by the vapour at predetermined wavelengths.'@en ;
    skos:notation 'SDN:S04::S04190'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04191/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04191/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04191/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'gas chromatography-atomic emission detection'@en ;
    skos:definition 'A technique to separate gases, volatile substances or substances dissolved in a volatile solvent by transport by an inert gas through a column packed with a sorbent. The separated components are then analysed by microwave irradiation and quantification of the resultant emission spectrum.'@en ;
    skos:notation 'SDN:S04::S04191'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04192/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04192/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04192/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'gas chromatography-electron capture detection'@en ;
    skos:definition 'Separation of gases, volatile substances or substances dissolved in a volatile solvent by inert gas transport through a sorbent-packed column. Separated components exposed to a detector that ionizes some carrier gas to produce a current between a biased pair of electrodes. Organic molecules with electronegative functional groups, such as halogens, phosphorous, and nitro groups capture electrons and are quantified by measuring the reduction of the current measured between the electrodes.'@en ;
    skos:notation 'SDN:S04::S04192'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04192/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04192/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04192/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Chromatographie en phase gazeuse/ détecteur capture d\'électrons (GC/ECD)'@en ;
    skos:definition 'Separation of gases, volatile substances or substances dissolved in a volatile solvent by inert gas transport through a sorbent-packed column. Separated components exposed to a detector that ionizes some carrier gas to produce a current between a biased pair of electrodes. Organic molecules with electronegative functional groups, such as halogens, phosphorous, and nitro groups capture electrons and are quantified by measuring the reduction of the current measured between the electrodes.'@en ;
    skos:notation 'SDN:S04::S04192'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04192/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04192/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04192/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'gas chromatography-electron capture detection'@en ;
    skos:definition 'Technique de séparation de gaz, de substances volatiles, ou de substances dissoutes dans un solvent volatile via leur transport, par un gaz inerte, au travers d\'une colonne garnie d\'un sorbant. Les composantes de l\'échantillon, une fois séparées, sont exposées à un détecteur. Celui-ci ionise une partie du gaz porteur pour produire un courant entre une paire d\'électrodes. Les composés hautement electronégatifs (e.g. les halogènes, le groupe nitro) capturent des électrons. La baisse de courant mesurée entre les électrodes permet alors de quantifier ces composés.'@en ;
    skos:notation 'SDN:S04::S04192'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04192/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04192/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04192/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Chromatographie en phase gazeuse/ détecteur capture d\'électrons (GC/ECD)'@en ;
    skos:definition 'Technique de séparation de gaz, de substances volatiles, ou de substances dissoutes dans un solvent volatile via leur transport, par un gaz inerte, au travers d\'une colonne garnie d\'un sorbant. Les composantes de l\'échantillon, une fois séparées, sont exposées à un détecteur. Celui-ci ionise une partie du gaz porteur pour produire un courant entre une paire d\'électrodes. Les composés hautement electronégatifs (e.g. les halogènes, le groupe nitro) capturent des électrons. La baisse de courant mesurée entre les électrodes permet alors de quantifier ces composés.'@en ;
    skos:notation 'SDN:S04::S04192'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04193/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04193/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04193/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'gas chromatography-flame ionisation detection'@en ;
    skos:definition 'A technique to separate gases, volatile substances or substances dissolved in a volatile solvent by transport by an inert gas through a column packed with a sorbent. The separated components are exposed to a detector that uses a flame to decompose the neutral solute molecules into charged particles and measures any changes in conductivity.'@en ;
    skos:notation 'SDN:S04::S04193'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04193/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04193/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04193/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'chromatographie en phase gazeuse/détecteur ionisation à flamme (GC/FID)'@en ;
    skos:definition 'A technique to separate gases, volatile substances or substances dissolved in a volatile solvent by transport by an inert gas through a column packed with a sorbent. The separated components are exposed to a detector that uses a flame to decompose the neutral solute molecules into charged particles and measures any changes in conductivity.'@en ;
    skos:notation 'SDN:S04::S04193'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04193/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04193/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04193/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'gas chromatography-flame ionisation detection'@en ;
    skos:definition 'Technique de séparation de gaz, de substances volatiles, ou de substances dissoutes dans un solvent volatile via leur transport, par un gaz inerte, au travers d\'une colonne garnie d\'un sorbant. Les composantes de l\'échantillon, une fois séparées, sont exposéés à un détecteur muni d\'une flamme pour décomposer les solutés en particules chargées avant de mesurer les changements de conductivité resultants.'@en ;
    skos:notation 'SDN:S04::S04193'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04193/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04193/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04193/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'chromatographie en phase gazeuse/détecteur ionisation à flamme (GC/FID)'@en ;
    skos:definition 'Technique de séparation de gaz, de substances volatiles, ou de substances dissoutes dans un solvent volatile via leur transport, par un gaz inerte, au travers d\'une colonne garnie d\'un sorbant. Les composantes de l\'échantillon, une fois séparées, sont exposéés à un détecteur muni d\'une flamme pour décomposer les solutés en particules chargées avant de mesurer les changements de conductivité resultants.'@en ;
    skos:notation 'SDN:S04::S04193'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04194/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04194/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04194/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'gas chromatography-mass spectrometry'@en ;
    skos:definition 'A technique to separate gases, volatile substances or substances dissolved in a volatile solvent by transport by an inert gas through a column packed with a sorbent. The separated components are then passed to a mass spectrometer for identification and quantification.'@en ;
    skos:notation 'SDN:S04::S04194'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04194/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04194/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04194/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'chromatographie en phase gaseuse - spectrométrie de masse (GC-MS)'@en ;
    skos:definition 'A technique to separate gases, volatile substances or substances dissolved in a volatile solvent by transport by an inert gas through a column packed with a sorbent. The separated components are then passed to a mass spectrometer for identification and quantification.'@en ;
    skos:notation 'SDN:S04::S04194'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04194/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04194/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04194/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'gas chromatography-mass spectrometry'@en ;
    skos:definition 'Technique de séparation de gaz, de substances volatiles, ou de substances dissoutes dans un solvent volatile via leur transport, par un gaz inerte, au travers d\'une colonne garnie d\'un sorbant. Les composantes de l\'échantillon, une fois séparées, sont passées dans un spectromètre de masse permettant leur identification et quantification. .'@en ;
    skos:notation 'SDN:S04::S04194'^^xsd:string .
