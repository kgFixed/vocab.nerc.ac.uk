    skos:prefLabel 'port-mounted cosine-collector radiometer'@en ;
    skos:definition 'An instrument attached to the port (left) side of a ship to measure the intensity of the component normal to the sensor of electromagnetic radiation.'@en ;
    skos:notation 'SDN:S04::S04287'^^xsd:string .
