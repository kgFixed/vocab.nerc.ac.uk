    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'reversing thermometer'@en ;
    skos:definition 'Thermomètre capable d\'enregistrer la température à laquelle l\'instrument est renversé et de l\'afficher jusqu\'à ce que l\'instrument soit ré-initialisé.'@en ;
    skos:notation 'SDN:S04::S04307'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04307/1/> .
