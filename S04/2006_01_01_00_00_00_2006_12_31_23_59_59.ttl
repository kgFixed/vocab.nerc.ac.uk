    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'laser ablation and mass spectrometry'@en ;
    skos:definition 'The process of removing material from a solid by irradiation with a pulsed laser for subsequent identification and quantification by determining ion mass-to-charge ratio in a mass spectrometer.'@en ;
    skos:notation 'SDN:S04::S04394'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04395/1/> .
