    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'fixed in-situ pressure sensor'@en ;
    skos:definition 'An underwater pressure sensor that is rigidly mounted to either the seabed or some type of structure. Data from the instrument may be used to determine wave or sea level parameters depending on sampling frequency and subsequent data reduction.'@en ;
    skos:notation 'SDN:S04::S04127'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04129/1/> .
