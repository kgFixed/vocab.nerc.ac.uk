    skos:prefLabel 'in-situ sonic anemometer'@en ;
    skos:definition 'An instrument for measuring wind speed and direction in place in the field by means of the properties of wind-borne sound waves.'@en ;
    skos:notation 'SDN:S04::S04230'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04231/1/> .
