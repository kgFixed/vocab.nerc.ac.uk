    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'in-situ chlorophyll fluorometer'@en ;
    skos:definition 'An instrument that determines the amount of chlorophyll in place in the field by measuring the quantity of red light (around 685nm) emitted by the target water volume following excitation by pulses of blue light (around 460-470nm).'@en ;
    skos:notation 'SDN:S04::S04134'^^xsd:string .
