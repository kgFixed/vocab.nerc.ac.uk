    skos:prefLabel 'green light transmissometer'@en ;
    skos:definition 'An instrument that emits green light and measures how much of it reaches a receptor accurately located a fixed but unspecified distance away from the transmitter.'@en ;
    skos:notation 'SDN:S04::S04197'^^xsd:string .
