    skos:prefLabel 'coulometry'@en ;
    skos:definition 'An electroanalytical chemistry technique that determines the amount of matter transformed during an electrolysis reaction by measuring the amount of electricity consumed or produced.'@en ;
    skos:notation 'SDN:S04::S04150'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04152/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04152/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04152/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'counting filtrate'@en ;
    skos:definition 'Determination of the level of radioactivity in the liquid passing through the filter paper after a sample has been filtered.'@en ;
    skos:notation 'SDN:S04::S04152'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04153/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04153/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04153/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'counting filtrate and residue'@en ;
    skos:definition 'Separate determination of the levels of radioactivity in the liquid passing through the filter paper and the material trapped on the filter paper after a sample has been filtered.'@en ;
    skos:notation 'SDN:S04::S04153'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04154/1/> .
