    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04282/>;
    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'physical measurement and radiocarbon dating'@en ;
    skos:definition 'Technique for determination of sediment accumulation rate. The sediment thickness accumulated is measured using a ruler and the time taken for sediment accumulation is determined by two or more carbon dates along the sediment profile.'@en ;
    skos:notation 'SDN:S04::S04282'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04283/1/> .
