    skos:definition 'A method of chemical analysis where the analyte is quantitatively coloured by reaction with methylene blue. The resulting colour strength is assayed by absorption of light of a specified wavelength.'@en ;
    skos:notation 'SDN:S04::S04262'^^xsd:string .
