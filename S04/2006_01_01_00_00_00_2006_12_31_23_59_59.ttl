    dc:modified '2006-10-02T18:26:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Winkler titration'@en ;
    skos:definition 'The \'gold standard\' wet chemical technique for determining dissolved oxygen by conversion of oxygen to iodine that is assayed by titration against thiosulphate.'@en ;
    skos:notation 'SDN:S04::S04108'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04108/1/> .
