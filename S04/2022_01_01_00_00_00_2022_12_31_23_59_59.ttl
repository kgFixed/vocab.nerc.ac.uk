<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S041179/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S041179/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S041179/>;
    dc:modified '2022-05-25T14:30:16'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'model prediction of Visible Infrared Imaging Radiometer Suite (VIIRS) output'@en ;
    skos:definition 'The value was obtained using a numerical model to simulate the output of a Visible Infrared Imaging Radiometer Suite (VIIRS) instrument, a 22-band satellite-mounted radiometer with a spectral range of 0.412 to 12.01 um and a swath width of 3060 km.'@en ;
    skos:notation 'SDN:S04::S041179'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S041178/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S041178/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S041178/>;
    dc:modified '2022-05-25T14:30:14'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'model prediction of Medium Resolution Imaging Spectrometer (MERIS) output'@en ;
    skos:definition 'The value was obtained using a numerical model to simulate the output of the Medium Resolution Imaging Spectrometer (MERIS), a 15-band satellite-mounted spectrometer with a spectral range of 390 to 1040 nm, a spectral resolution of 1.8 nm and a swath width of 1150 km.'@en ;
    skos:notation 'SDN:S04::S041178'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S041177/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S041177/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S041177/>;
    dc:modified '2022-05-24T15:24:21'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'model prediction of fluorescence'@en ;
    skos:definition 'The value was obtained using a numerical model to simulate fluorescence, which is calculated by simulating the absorption of a substance (pigment, protein) in a cell followed by release in all directions at the emission wavelengths.'@en ;
    skos:notation 'SDN:S04::S041177'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S041090/2/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S041090/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S041090/>;
    dc:modified '2022-04-27T16:57:41'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'single turnover fast repetition rate (FRR) fluorometry'@en ;
    skos:definition 'An active fluorescence technique using the fast repetition rate method with a single turnover flash protocol that uses a sequence of short flashes (e.g. <200 microseconds flashlets) to reach maximum fluorescence; each flashlet only allows one single reduction of the primary electron acceptors of PSII, Qa.'@en ;
    skos:notation 'SDN:S04::S041090'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S041091/2/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S041091/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S041091/>;
    dc:modified '2022-04-27T16:57:41'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'multiple turnover pulse-amplitude modulation (PAM) fluorometry'@en ;
    skos:definition 'An active fluorescence technique using the pulse-amplitude modulated method with a multiple turnover flash protocol that uses a long single saturating flash (e.g. 200-10,000 milliseconds) to achieve maximum fluorescence and allow repeated charge separation processes (multiple turnover) until all the electron acceptors of PSII are reduced.'@en ;
    skos:notation 'SDN:S04::S041091'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S041136/2/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S041136/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S041136/>;
    dc:modified '2022-04-27T16:57:41'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'in-situ UV Aquatracka fluorometer'@en ;
    skos:definition 'A linear response fluorometer (output voltage proportional to fluorescent substance concentration) that detects UV fluorescence emitted whendissolved compounds that are of a fluorescent nature absorb UV light and re-emit a fraction as fluorescence; used for the monitoring of CDOM, and refined and crude hydrocarbons.'@en ;
    skos:notation 'SDN:S04::S041136'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S041157/2/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S041157/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S041157/>;
    dc:modified '2022-04-27T16:57:41'^^xsd:dateTime ;
    skos:altLabel 'HRGC/HRMS'^^xsd:string ;
    skos:prefLabel 'high resolution gas chromatography-high resolution mass spectrometry'@en ;
    skos:definition 'A gas chromatography-mass spectrometry technique conceived to achieve high selectivity and mass resolution to reduce potential interferences and achieve low levels of chemicaldetection.'@en ;
    skos:notation 'SDN:S04::S041157'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S041176/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S041176/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S041176/>;
    dc:modified '2022-03-30T14:26:52'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'model prediction of Moderate Resolution Imaging Spectroradiometer (MODIS) output'@en ;
    skos:definition 'The value was obtained using a numerical model to simulate the output of the Moderate Resolution Imaging Spectroradiometer (MODIS), a 36-band satellite-mounted radiometer measuring from 0.4 um to 14.4 um and at varying spatial resolutions (2 bands at 250 m, 5 bands at 500 m and 29 bands at 1 km).'@en ;
    skos:notation 'SDN:S04::S041176'^^xsd:string .
