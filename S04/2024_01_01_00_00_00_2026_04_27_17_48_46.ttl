    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'nephelometry using a tungsten halogen light source'@en ;
    skos:definition 'Method for measuring turbidity using a nephelometer (instrument that measures scattered light at an angle of 90°) equipped with a tungsten halogen light source. This method is used as part of the US EPA method 180.1 standard for turbidity measurements.'@en ;
    skos:notation 'SDN:S04::S041202'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S041201/1/> .
