    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'profiling pressure sensor (second sensor)'@en ;
    skos:definition 'An underwater pressure sensor that is mounted to an instrument or vehicle that is able to move freely in the water column. The data are used to determine the depth of the sensor below the sea surface. Deployed on a package of instruments or sensors as the second sensor of this type.'@en ;
    skos:notation 'SDN:S04::S041201'^^xsd:string .
