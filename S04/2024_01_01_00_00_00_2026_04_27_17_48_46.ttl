    dc:modified '2025-07-14T09:53:46'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'single turnover active fluorometry'@en ;
    skos:definition 'An active fluorescence technique with a single turnover protocol that uses a solid excitation pulse; each pulse only allows one single reduction of the primary electron acceptors of PSII, Qa.'@en ;
    skos:notation 'SDN:S04::S041203'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S041202/1/> .
