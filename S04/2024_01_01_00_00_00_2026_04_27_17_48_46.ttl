    dc:modified '2025-10-30T14:07:35'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'nanomolar ammonium fluorometry after Kerouel and Aminot (1997)'@en ;
    skos:definition 'Nanomolar ammonium analysis protocol described in Kerouel, R., Aminot, A. (1997). Marine Chemistry 57: 265-275. The protocol is slightly different to the standard method when working at nanomolar ranges, and is described on p.267.'@en ;
    skos:notation 'SDN:S04::S04501'^^xsd:string .
