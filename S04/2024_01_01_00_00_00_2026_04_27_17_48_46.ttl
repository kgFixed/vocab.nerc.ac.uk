<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04276/2/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04276/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S04276/>;
    dc:modified '2026-03-25T10:10:51'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'oxygen sensor'@en ;
    skos:definition 'An instrument that may be incorporated into a sensor package to measure dissolved oxygen concentrations in place in the field or within experimental setups.'@en ;
    skos:notation 'SDN:S04::S04276'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S041209/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S041209/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S041209/>;
    dc:modified '2026-02-24T14:42:12'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'gas chromatography-thermal conductivity detection'@en ;
    skos:definition 'A technique to separate gases, volatile substances or substances dissolved in a volatile solvent by transport by an inert gas through a column packed with a sorbent. Each component has a different capacity to conduct heat and different gas compositions cause heat to be conducted away from a heated filament at different rates. The changes in filament temperature and electrical resistance are used to identify components.'@en ;
    skos:notation 'SDN:S04::S041209'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S041023/2/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S041023/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S041023/>;
    dc:modified '2025-10-30T15:14:00'^^xsd:dateTime ;
    skos:altLabel 'AgNO3 titration'^^xsd:string ;
    skos:prefLabel 'titration against silver nitrate (AgNO3)'@en ;
    skos:definition 'Quantitative incremental addition of silver nitrate solution to extract all halide anions from the sample as indicated by an indicator colour change (usually potassium chromate from yellow to red). Often referred to as \'Knudsen titration\' after Knudsen, M., 1901. Hydrographical Tables Copenhagen, G.E.C. Gad, 63 pp.'@en ;
    skos:notation 'SDN:S04::S041023'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S041208/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S041208/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S041208/>;
    dc:modified '2025-10-30T14:47:24'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'ammonium fluorometry after Kerouel and Aminot (1997)'@en ;
    skos:definition 'Ammonium analysis protocol described in Kerouel, R., Aminot, A. (1997). Marine Chemistry 57: 265-275. This describes the standard protocol when not working at nanomolar ranges.'@en ;
    skos:notation 'SDN:S04::S041208'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S041207/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S041207/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S041207/>;
    dc:modified '2025-10-30T14:46:31'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'hydrometry'@en ;
    skos:definition 'A technique used to measure the density or salinity of a liquid using a hydrometer, a floating device that will sink to a greater or lesser extent depending on the density, salinity and temperature of the liquid.'@en ;
    skos:notation 'SDN:S04::S041207'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S041206/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S041206/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S041206/>;
    dc:modified '2025-10-30T14:45:19'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'refractometry'@en ;
    skos:definition 'A technique used to measure the concentration of dissolved substances (such as salt) in liquids by determining the refractive index of the liquid (how much light bends through the liquid). Both analogue and digital refractometers can be used.'@en ;
    skos:notation 'SDN:S04::S041206'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04501/2/> .
