<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S041062/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S041062/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S041062/>;
    dc:modified '2011-05-13T15:27:05'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'maximum thermometer'@en ;
    skos:definition 'A liquid-in-glass thermometer with a constriction in the tube. As the air temperature rises, the liquid moves freely past the constriction but sticks when the air temperature begins to drop. Reset by shaking.'@en ;
    skos:notation 'SDN:S04::S041062'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S041061/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S041061/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S041061/>;
    dc:modified '2011-05-13T15:22:04'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'minimum thermometer'@en ;
    skos:definition 'A liquid-in-glass thermometer that contains a barbell-shaped marker within the liquid. As the air temperature drops, the liquid and marker move down the thermometer tube. At minimum temperature, the liquid and the marker stop moving; as the temperature starts to rise, the liquid moves back up the tube, but the marker remains stationary marking the minimum temperature. Reset by tipping upside-down'@en ;
    skos:notation 'SDN:S04::S041061'^^xsd:string .
