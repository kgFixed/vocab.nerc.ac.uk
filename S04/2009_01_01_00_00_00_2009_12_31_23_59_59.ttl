<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S041022/1/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S041022/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S04/current/S041022/>;
    dc:modified '2009-12-08T10:21:32'^^xsd:dateTime ;
    skos:altLabel 'bench FRRF'^^xsd:string ;
    skos:prefLabel 'bench fast repetition rate fluorometer (FRRF)'@en ;
    skos:definition 'A fluorometer designed to measure variable fluorescence of living communities of marine phytoplankton in the laboratory. It outputs high frequency (200 kHz) flashes enabling the measurement of the absorption cross section of Photosystem II, the rate of photosynthetic electron transport and the level of photochemical quenching. Some types have dual sample chambers allowing comparisons to be made of ambiently-irradiated and dark adapted phytoplankton samples.'@en ;
    skos:notation 'SDN:S04::S041022'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S04/current/S04218/2/> .
<http://vocab.nerc.ac.uk/collection/S04/current/S04218/2/>
    a skos:Concept ;
