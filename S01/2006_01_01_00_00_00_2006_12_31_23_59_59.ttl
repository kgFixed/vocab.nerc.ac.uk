@prefix tree: <https://w3id.org/tree#> .
@prefix ldes: <https://w3id.org/ldes#> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

@base <https://kgfixed.github.io/vocab.nerc.ac.uk/S01/2006_01_01_00_00_00_2006_12_31_23_59_59.ttl> .

<>
    a tree:Node
     .

<feed>
  a ldes:EventStream ;
  ldes:timestampPath dc:modified ;
  ldes:versionOfPath dc:isVersionOf ;
  
  
  tree:shape [
    a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path dc:isVersionOf
    ],
    [
      sh:datatype xsd:dateTime ;
      sh:minCount 1 ;
      sh:path dc:modified
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:altLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:prefLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:definition
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:notation
    ];
    sh:targetClass skos:Concept
  ] ;
  tree:view <> ;
  .

<feed> tree:member <http://vocab.nerc.ac.uk/collection/S01/current/S014/1/> .
<http://vocab.nerc.ac.uk/collection/S01/current/S014/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S01/current/S014/>;
    dc:modified '2006-02-17T11:19:39'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'parameter entity'@en ;
    skos:definition 'Portion of the BODC parameter semantic model specifying the type of measurement.  It is a subcomponent of the what theme'@en ;
    skos:notation 'SDN:S01::S014'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S01/current/S015/1/> .
<http://vocab.nerc.ac.uk/collection/S01/current/S015/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S01/current/S015/>;
    dc:modified '2006-02-17T11:19:39'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'biological entity'@en ;
    skos:definition 'Portion of the BODC parameter semantic model describing a biological taxon or part thereof.  It is a subcomponent of either the what theme or the where theme'@en ;
    skos:notation 'SDN:S01::S015'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S01/current/S016/1/> .
<http://vocab.nerc.ac.uk/collection/S01/current/S016/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S01/current/S016/>;
    dc:modified '2006-02-17T11:19:39'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'chemical entity'@en ;
    skos:definition 'Portion of the BODC parameter semantic model describing a chemical substance.  It is a subcomponent of the what theme'@en ;
    skos:notation 'SDN:S01::S016'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S01/current/S017/1/> .
<http://vocab.nerc.ac.uk/collection/S01/current/S017/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S01/current/S017/>;
    dc:modified '2006-02-17T11:19:39'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'physical entity'@en ;
    skos:definition 'Portion of the BODC parameter semantic model describing a physical phenomenon that is not considered to be a type of measurement.  It is a subcomponent of the what theme.'@en ;
    skos:notation 'SDN:S01::S017'^^xsd:string .
