    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'solid'@en ;
    skos:definition 'Bounded, connected 3-dimensional geometric primitive, representing the continuous image of a region of space'@en ;
    skos:notation 'SDN:G14::005'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/G14/current/006/1/> .
<http://vocab.nerc.ac.uk/collection/G14/current/006/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/G14/current/006/>;
    dc:modified '2012-07-04T11:03:50'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'surface'@en ;
