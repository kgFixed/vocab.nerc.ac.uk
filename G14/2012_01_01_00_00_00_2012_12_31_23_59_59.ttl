@prefix tree: <https://w3id.org/tree#> .
@prefix ldes: <https://w3id.org/ldes#> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

@base <https://kgfixed.github.io/vocab.nerc.ac.uk/G14/2012_01_01_00_00_00_2012_12_31_23_59_59.ttl> .

<>
    a tree:Node
     .

<feed>
  a ldes:EventStream ;
  ldes:timestampPath dc:modified ;
  ldes:versionOfPath dc:isVersionOf ;
  
  
  tree:shape [
    a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path dc:isVersionOf
    ],
    [
      sh:datatype xsd:dateTime ;
      sh:minCount 1 ;
      sh:path dc:modified
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:altLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:prefLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:definition
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:notation
    ];
    sh:targetClass skos:Concept
  ] ;
  tree:view <> ;
  .

<feed> tree:member <http://vocab.nerc.ac.uk/collection/G14/current/001/1/> .
<http://vocab.nerc.ac.uk/collection/G14/current/001/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/G14/current/001/>;
    dc:modified '2012-07-04T11:03:50'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'complex'@en ;
    skos:definition 'Set of geometric primitives such that their boundaries can be represented as a union of other primitives'@en ;
    skos:notation 'SDN:G14::001'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/G14/current/002/1/> .
<http://vocab.nerc.ac.uk/collection/G14/current/002/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/G14/current/002/>;
    dc:modified '2012-07-04T11:03:50'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'composite'@en ;
    skos:definition 'Connected set of curves, solids or surfaces'@en ;
    skos:notation 'SDN:G14::002'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/G14/current/003/1/> .
<http://vocab.nerc.ac.uk/collection/G14/current/003/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/G14/current/003/>;
    dc:modified '2012-07-04T11:03:50'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'curve'@en ;
    skos:definition 'Bounded, 1-dimensional geometric primitive, representing the continuous image of a line'@en ;
    skos:notation 'SDN:G14::003'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/G14/current/004/1/> .
<http://vocab.nerc.ac.uk/collection/G14/current/004/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/G14/current/004/>;
    dc:modified '2012-07-04T11:03:50'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'point'@en ;
    skos:definition 'Zero-dimensional geometric primitive, representing a position but not having an extent'@en ;
    skos:notation 'SDN:G14::004'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/G14/current/005/1/> .
<http://vocab.nerc.ac.uk/collection/G14/current/005/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/G14/current/005/>;
