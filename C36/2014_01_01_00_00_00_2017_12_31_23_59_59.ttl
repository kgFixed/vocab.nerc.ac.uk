    skos:altLabel 'AIE'^^xsd:string ;
    skos:prefLabel 'EC Access to Information on the Environment (AIE) Regulations'@en ;
    skos:definition 'The European Communities (Access to Information on the Environment) Regulations 2007 (S.I. 133 of 2007), give legal rights to those seeking access to information on the environment from public authorities.'@en ;
