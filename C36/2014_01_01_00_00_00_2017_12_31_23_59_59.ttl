    skos:altLabel 'EMFF'^^xsd:string ;
    skos:prefLabel 'EU European Maritime Fisheries Fund'@en ;
    skos:definition 'The EMFF is the fund for the EU\'s maritime and fisheries policies for 2014-2020.'@en ;
    skos:notation 'SDN:C36::LEGL0083'^^xsd:string .
