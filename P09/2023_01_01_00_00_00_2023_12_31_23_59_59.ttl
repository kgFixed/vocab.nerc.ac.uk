<>
    a tree:Node
     ;
    tree:relation [
      a tree:LessThanRelation ;
      tree:node <https://kgfixed.github.io/vocab.nerc.ac.uk/P09/2022_01_01_00_00_00_2022_12_31_23_59_59.ttl> ;
      tree:path dc:modified ;
