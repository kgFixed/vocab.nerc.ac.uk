    dc:modified '2018-06-20T11:09:59'^^xsd:dateTime ;
    skos:altLabel 'ISOTOPIC DEUTERIUM RATIO'^^xsd:string ;
    skos:prefLabel 'The isotopic enrichment of 2H in the hydrogen of water molecules'@en ;
    skos:definition 'The isotopic enrichment (1000*(sample 2/1 ratio - natural ratio)/(natural ratio)) of 2H in the hydrogen of water molecules in a body of salt or fresh water.'@en ;
