    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'mass_concentration_of_particulate_organic_matter_dry_aerosol_in_air'@en ;
    skos:definition 'Mass concentration means mass per unit volume and is used in the construction mass_concentration_of_X_in_Y, where X is a material constituent of Y.  A chemical species denoted by X may be described by a single term such as \'nitrogen\' or a phrase such as \'nox_expressed_as_nitrogen\'. "Aerosol" means the suspended liquid or solid particles in air (except cloud droplets).  Aerosol takes up ambient water (a process known as hygroscopic growth) depending on the relative humidity and the composition of the aerosol. "Dry aerosol" means aerosol without water. The term "particulate_organic_matter_dry_aerosol" means all particulate organic matter dry aerosol except black carbon. It is the sum of primary_particulate_organic_matter_dry_aerosol and secondary_particulate_organic_matter_dry_aerosol.'@en ;
    skos:notation 'SDN:P07::CF12N306'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CF12N312/2/> .
<http://vocab.nerc.ac.uk/collection/P07/current/CF12N312/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P07/current/CF12N312/>;
    dc:modified '2015-01-07T15:23:06'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'mass_concentration_of_primary_particulate_organic_matter_dry_aerosol_in_air'@en ;
    skos:definition 'Mass concentration means mass per unit volume and is used in the construction mass_concentration_of_X_in_Y, where X is a material constituent of Y.  A chemical species denoted by X may be described by a single term such as \'nitrogen\' or a phrase such as \'nox_expressed_as_nitrogen\'. "Aerosol" means the suspended liquid or solid particles in air (except cloud droplets).  Aerosol takes up ambient water (a process known as hygroscopic growth) depending on the relative humidity and the composition of the aerosol. "Dry aerosol" means aerosol without water. "Primary particulate organic matter " means all organic matter emitted directly to the atmosphere as particles except black carbon. The sum of primary_particulate_organic_matter_dry_aerosol and secondary_particulate_organic_matter_dry_aerosol is particulate_organic_matter_dry_aerosol.'@en ;
    skos:notation 'SDN:P07::CF12N312'^^xsd:string .
