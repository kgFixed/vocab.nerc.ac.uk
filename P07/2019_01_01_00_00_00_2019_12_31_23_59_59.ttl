    skos:prefLabel 'effective_radius_of_convective_cloud_snow_particles'@en ;
    skos:definition 'The effective radius of a size distribution of particles, such as aerosols, cloud droplets or ice crystals, is the area weighted mean radius of particle size. It is calculated as the ratio of the third to the second moment of the particle size distribution. Convective cloud is that produced by the convection schemes in an atmosphere model.'@en ;
    skos:notation 'SDN:P07::9M3C9WFF'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/9XXE61KE/1/> .
<http://vocab.nerc.ac.uk/collection/P07/current/9XXE61KE/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P07/current/9XXE61KE/>;
    dc:modified '2019-05-14T17:27:19'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'effective_radius_of_stratiform_cloud_ice_particles'@en ;
    skos:definition 'The effective radius of a size distribution of particles, such as aerosols, cloud droplets or ice crystals, is the area weighted mean radius of particle size. It is calculated as the ratio of the third to the second moment of the particle size distribution. In an atmosphere model, stratiform cloud is that produced by large-scale convergence (not the convection schemes).'@en ;
    skos:notation 'SDN:P07::9XXE61KE'^^xsd:string .
