    dc:modified '2019-03-04T17:29:46'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'tendency_of_sea_water_alkalinity_expressed_as_mole_equivalent_due_to_biological_processes'@en ;
    skos:definition 'The phrase "tendency_of_X" means derivative of X with respect to time. sea_water_alkalinity_expressed_as_mole_equivalent is the total alkalinity equivalent concentration (including carbonate, nitrogen, silicate, and borate components). The specification of a physical process by the phrase "due_to_" process means that the quantity named is a single term in a sum of terms which together compose the general quantity named by omitting the phrase.'@en ;
    skos:notation 'SDN:P07::CF14N122'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CF14N27/2/> .
