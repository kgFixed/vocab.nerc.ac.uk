    dc:modified '2019-05-14T17:27:19'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'ocean_double_sigma_coordinate'@en ;
    skos:definition 'See Appendix D of the CF convention for information about parametric vertical coordinates.'@en ;
    skos:notation 'SDN:P07::90AFXCPV'^^xsd:string .
