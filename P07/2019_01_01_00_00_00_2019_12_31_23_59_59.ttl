<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0757/2/> .
<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0757/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0757/>;
