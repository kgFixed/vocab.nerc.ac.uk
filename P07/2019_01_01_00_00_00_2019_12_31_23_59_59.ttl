    skos:prefLabel 'atmosphere_ln_pressure_coordinate'@en ;
    skos:definition '"ln_X" means natural logarithm of X. X must be dimensionless. See Appendix D of the CF convention for information about parametric vertical coordinates.'@en ;
    skos:notation 'SDN:P07::CFSN0757'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0766/2/> .
