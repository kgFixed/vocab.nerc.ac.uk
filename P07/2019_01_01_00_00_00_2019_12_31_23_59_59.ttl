    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'mole_fraction_of_carbon_tetrachloride_in_air'@en ;
    skos:definition '"Mole fraction" is used in the construction "mole_fraction_of_X_in_Y", where X is a material constituent of Y. The chemical formula of carbon tetrachloride is CCl4. The IUPAC name for carbon tetrachloride is tetrachloromethane.'@en ;
    skos:notation 'SDN:P07::CFV8N16'^^xsd:string .
