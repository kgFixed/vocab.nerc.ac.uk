    dc:modified '2010-07-26T09:53:35'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'thickness_of_large_scale_snowfall_amount'@en ;
    skos:definition '\'Amount\' means mass per unit area. The construction thickness_of_[X_]snowfall_amount means the accumulated \'depth\' of snow which fell i.e. the thickness of the layer of snow at its own density. There are corresponding standard names for liquid water equivalent (lwe) thickness.'@en ;
    skos:notation 'SDN:P07::CFSN0142'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0292/1/> .
