    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'land_ice_lwe_calving_rate'@en ;
    skos:definition '"Land ice" means glaciers, ice-caps and ice-sheets resting on bedrock and also includes ice-shelves.  The land ice calving rate is the rate at which ice is lost per unit area through calving into the ocean.  "lwe" means liquid water equivalent.'@en ;
    skos:notation 'SDN:P07::CFSN0582'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0584/2/> .
