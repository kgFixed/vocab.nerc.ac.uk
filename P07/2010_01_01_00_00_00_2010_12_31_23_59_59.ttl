    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'land_ice_calving_rate'@en ;
    skos:definition '"Land ice" means glaciers, ice-caps and ice-sheets resting on bedrock and also includes ice-shelves.  The land ice calving rate is the rate at which ice is lost per unit area through calving into the ocean.'@en ;
    skos:notation 'SDN:P07::CFSN0580'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0581/2/> .
<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0581/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0581/>;
    dc:modified '2010-03-11T14:48:28'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'land_ice_lwe_basal_melt_rate'@en ;
    skos:definition '"Land ice" means glaciers, ice-caps and ice-sheets resting on bedrock and also includes ice-shelves.  The land ice basal melt rate is the rate at which ice is lost per unit area at the base of the ice.  "lwe" means liquid water equivalent.'@en ;
    skos:notation 'SDN:P07::CFSN0581'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0582/2/> .
