    skos:prefLabel 'surface_carbon_dioxide_mole_flux'@en ;
    skos:definition 'The surface called \'surface\' means the lower boundary of the atmosphere. In accordance with common usage in geophysical disciplines, \'flux\' implies per unit area, called \'flux density\' in physics.'@en ;
    skos:notation 'SDN:P07::CFSN0292'^^xsd:string .
