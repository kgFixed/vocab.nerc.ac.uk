    skos:prefLabel 'land_ice_sigma_coordinate'@en ;
    skos:definition '"Land ice" means glaciers, ice-caps and ice-sheets resting on bedrock and also includes ice-shelves.'@en ;
    skos:notation 'SDN:P07::CFSN0584'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0587/2/> .
