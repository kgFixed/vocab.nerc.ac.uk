    dc:modified '2010-07-26T09:53:35'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'snow_thermal_energy_content'@en ;
    skos:definition '\'Content\' indicates a quantity per unit area. Thermal energy is the total vibrational energy, kinetic and potential, of all the molecules and atoms in a substance.'@en ;
    skos:notation 'SDN:P07::CFSN0342'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0495/1/> .
<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0495/1/>
    a skos:Concept ;
