    dc:modified '2010-07-26T09:53:35'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'snow_temperature'@en ;
    skos:definition 'Snow temperature is the bulk temperature of the snow, not the surface (skin) temperature.'@en ;
    skos:notation 'SDN:P07::CFSN0341'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0342/1/> .
<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0342/1/>
    a skos:Concept ;
