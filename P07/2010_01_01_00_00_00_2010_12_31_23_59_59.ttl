    dc:modified '2010-03-11T14:48:28'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'tendency_of_land_ice_thickness'@en ;
    skos:definition '"Land ice" means glaciers, ice-caps and ice-sheets resting on bedrock and also includes ice-shelves.  "Thickness" means the vertical extent of a layer.  "tendency_of_X" means derivative of X with respect to time.'@en ;
    skos:notation 'SDN:P07::CFSN0165'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0577/2/> .
<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0577/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0577/>;
    dc:modified '2010-03-11T14:48:28'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'land_ice_basal_melt_rate'@en ;
    skos:definition '"Land ice" means glaciers, ice-caps and ice-sheets resting on bedrock and also includes ice-shelves.  The land ice basal melt rate is the rate at which ice is lost per unit area at the base of the ice.'@en ;
    skos:notation 'SDN:P07::CFSN0577'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0580/2/> .
