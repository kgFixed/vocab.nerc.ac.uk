    dc:modified '2010-07-26T09:53:35'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'water_vapor_pressure'@en ;
    skos:definition 'Vapor pressure is the partial pressure of a constituent of air, such as water, which exists as liquid or solid under \'normal\' conditions. \'Water\' is specified when the term is being applied to water.'@en ;
    skos:notation 'SDN:P07::CFSN0032'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0033/1/> .
<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0033/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0033/>;
    dc:modified '2010-07-26T09:53:35'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'water_vapor_saturation_deficit'@en ;
    skos:definition 'Water vapor saturation deficit is the difference between the saturation water vapor pressure and the actual water vapor pressure.'@en ;
    skos:notation 'SDN:P07::CFSN0033'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0141/1/> .
<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0141/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0141/>;
    dc:modified '2010-07-26T09:53:35'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'thickness_of_large_scale_rainfall_amount'@en ;
    skos:definition '\'Amount\' means mass per unit area. The construction thickness_of_[X_]rainfall_amount means the accumulated \'depth\' of rainfall i.e. the thickness of a layer of liquid water having the same mass per unit area as the rainfall amount.'@en ;
    skos:notation 'SDN:P07::CFSN0141'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0142/1/> .
<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0142/1/>
    a skos:Concept ;
