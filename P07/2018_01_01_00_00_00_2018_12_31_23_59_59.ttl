    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'surface_radioactivity_content_of_95Y'@en ;
    skos:definition 'The surface called "surface" means the lower boundary of the atmosphere. "Content" indicates a quantity per unit area. "Radioactivity" means the number of radioactive decays of a material per second. "Y" means the element "yttrium" and "95Y" is the isotope "yttrium-95" with a half-life of 7.29e-03 days.'@en ;
    skos:notation 'SDN:P07::3RM538QU'^^xsd:string .
