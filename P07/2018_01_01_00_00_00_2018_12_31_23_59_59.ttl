    skos:prefLabel 'convective_precipitation_amount'@en ;
    skos:definition '"Amount" means mass per unit area. "Precipitation" in the earth\'s atmosphere means precipitation of water in all phases. Convective precipitation is that produced by the convection schemes in an atmosphere model.'@en ;
    skos:notation 'SDN:P07::CFSN0713'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0714/2/> .
<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0714/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0714/>;
    dc:modified '2018-08-06T12:15:46'^^xsd:dateTime ;
