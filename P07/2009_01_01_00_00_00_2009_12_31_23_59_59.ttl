    skos:prefLabel 'tendency_of_moles_of_methane_in_middle_atmosphere'@en ;
    skos:definition '"tendency_of_X" means derivative of X with respect to time.  "moles_of_X_in_middle_atmosphere" means the total number of moles of X contained in the troposphere and stratosphere, i.e, summed over that part of the atmospheric column and over the entire globe.  The chemical formula of methane is CH4.'@en ;
    skos:notation 'SDN:P07::CFV8N106'^^xsd:string .
