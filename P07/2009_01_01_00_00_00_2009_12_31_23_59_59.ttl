    dc:modified '2009-07-06T15:41:29'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'atmosphere_number_content_of_cloud_droplets'@en ;
    skos:definition '"Content" indicates a quantity per unit area.  The "atmosphere content" of a quantity refers to the vertical integral from the surface to the top of the atmosphere. For the content between specified levels in the atmosphere, standard names including content_of_atmosphere_layer are used.'@en ;
    skos:notation 'SDN:P07::CF12N182'^^xsd:string .
