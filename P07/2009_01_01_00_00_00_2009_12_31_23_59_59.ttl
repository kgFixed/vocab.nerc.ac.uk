    dc:modified '2009-07-06T15:41:29'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'atmosphere_moles_of_ethane'@en ;
    skos:definition 'The construction "atmosphere_moles_of_X" means the total number of moles of X in the entire atmosphere, i.e. summed over the atmospheric column and over the entire globe. The chemical formula for ethane is C2H6. Ethane is a member of the group of hydrocarbons known as alkanes.  There are standard names for the alkane group as well as for some of the individual species.'@en ;
    skos:notation 'SDN:P07::CF12N135'^^xsd:string .
