    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P07/current/CF12N502/>;
    dc:modified '2009-07-06T15:41:29'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'mole_concentration_of_phosphate_in_sea_water'@en ;
    skos:definition 'Mole concentration means number of moles per unit volume, also called "molarity", and is used in the construction mole_concentration_of_X_in_Y, where X is a material constituent of Y.  A chemical species denoted by X may be described by a single term such as \'nitrogen\' or a phrase such as \'nox_expressed_as_nitrogen\'.'@en ;
    skos:notation 'SDN:P07::CF12N502'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CF12N503/1/> .
<http://vocab.nerc.ac.uk/collection/P07/current/CF12N503/1/>
