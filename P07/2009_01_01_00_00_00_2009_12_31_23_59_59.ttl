    dc:modified '2009-07-06T15:41:29'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'atmosphere_mass_content_of_oxygenated_hydrocarbons'@en ;
    skos:definition '"Content" indicates a quantity per unit area.  The "atmosphere content" of a quantity refers to the vertical integral from the surface to the top of the atmosphere. For the content between specified levels in the atmosphere, standard names including content_of_atmosphere_layer are used.   "Oxygenated" means containing oxygen. "Hydrocarbon" means a compound containing hydrogen and carbon.'@en ;
    skos:notation 'SDN:P07::CF12N89'^^xsd:string .
