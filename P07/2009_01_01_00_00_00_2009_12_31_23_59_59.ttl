    skos:prefLabel 'mass_concentration_of_suspended_matter_in_sea_water'@en ;
    skos:definition 'Mass concentration means mass per unit volume and is used in the construction mass_concentration_of_X_in_Y, where X is a material constituent of Y.  A chemical species denoted by X may be described by a single term such as \'nitrogen\' or a phrase such as \'nox_expressed_as_nitrogen\'.'@en ;
    skos:notation 'SDN:P07::CF12S23'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CF12S28/1/> .
<http://vocab.nerc.ac.uk/collection/P07/current/CF12S28/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P07/current/CF12S28/>;
    dc:modified '2009-07-06T16:21:17'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'mole_concentration_of_mesozooplankton_expressed_as_nitrogen_in_sea_water'@en ;
    skos:definition 'Mole concentration means number of moles per unit volume, also called "molarity", and is used in the construction mole_concentration_of_X_in_Y, where X is a material constituent of Y.  A chemical species denoted by X may be described by a single term such as \'nitrogen\' or a phrase such as \'nox_expressed_as_nitrogen\'. The phrase \'expressed_as\' is used in the construction A_expressed_as_B, where B is a chemical constituent of A. It means that the quantity indicated by the standard name is calculated in terms of B alone, neglecting all other chemical constituents of A.'@en ;
    skos:notation 'SDN:P07::CF12S28'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CF12S29/1/> .
<http://vocab.nerc.ac.uk/collection/P07/current/CF12S29/1/>
    a skos:Concept ;
