    skos:prefLabel 'atmosphere_moles_of_acetic_acid'@en ;
    skos:definition 'The construction "atmosphere_moles_of_X" means the total number of moles of X in the entire atmosphere, i.e. summed over the atmospheric column and over the entire globe. The chemical formula for acetic_acid is CH3COOH. The IUPAC name for acetic acid is ethanoic acid.'@en ;
    skos:notation 'SDN:P07::CF12N109'^^xsd:string .
