    dc:modified '2017-09-18T17:41:19'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'surface_northward_sea_water_velocity'@en ;
    skos:definition 'The surface called "surface" means the lower boundary of the atmosphere. A velocity is a vector quantity. "Northward" indicates a vector component which is positive when directed northward (negative southward).'@en ;
    skos:notation 'SDN:P07::CFSN0242'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0266/2/> .
<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0266/2/>
