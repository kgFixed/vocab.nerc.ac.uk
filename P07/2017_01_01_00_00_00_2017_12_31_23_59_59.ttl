    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'surface_eastward_sea_water_velocity'@en ;
    skos:definition 'The surface called "surface" means the lower boundary of the atmosphere. A velocity is a vector quantity. "Eastward" indicates a vector component which is positive when directed eastward (negative westward).'@en ;
    skos:notation 'SDN:P07::CFSN0266'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0727/2/> .
<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0727/2/>
    a skos:Concept ;
