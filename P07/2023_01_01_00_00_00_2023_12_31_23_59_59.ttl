    skos:prefLabel 'moles_of_dissolved_phosphorus_per_unit_mass_in_sea_water'@en ;
    skos:definition 'The construction "moles_of_X_per_unit_mass_in_Y" is also called "molality" of X in Y, where X is a material constituent of Y. A chemical species or biological group denoted by X may be described by a single term such as "nitrogen" or a phrase such as "nox_expressed_as_nitrogen". "Phosphorus" means phosphorus in all chemical forms, commonly referred to as "total phosphorus". The equivalent term in the NERC P01 Parameter Usage Vocabulary may be found at http://vocab.nerc.ac.uk/collection/P01/current/TPHSDSZZ/6/.'@en ;
    skos:notation 'SDN:P07::2NMYVULV'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/3719FJJR/1/> .
