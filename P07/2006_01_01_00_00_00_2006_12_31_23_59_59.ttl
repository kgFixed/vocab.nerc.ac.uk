    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'mole_fraction_of_ozone_in_air'@en ;
    skos:definition 'Mole fraction is used in the construction mole_fraction_of_X_in_Y, where X is a material constituent of Y.'@en ;
    skos:notation 'SDN:P07::CFSN0513'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0514/1/> .
