    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'depth'@en ;
    skos:definition 'Depth is the vertical distance below the surface.'@en ;
    skos:notation 'SDN:P07::CFSN0721'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0729/1/> .
