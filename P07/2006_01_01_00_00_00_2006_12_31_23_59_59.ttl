    skos:prefLabel 'convective_cloud_base_height'@en ;
    skos:definition 'cloud_base refers to the base of the lowest cloud. Height is the vertical distance above the surface. Convective cloud is that produced by the convection schemes in an atmosphere model.'@en ;
    skos:notation 'SDN:P07::CFSN0710'^^xsd:string .
