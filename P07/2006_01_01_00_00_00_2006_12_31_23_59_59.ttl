    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0363/>;
    dc:modified '2006-09-26T18:12:43'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'sound_intensity_in_water'@en ;
    skos:definition 'Sound intensity is the sound energy per unit time per unit area.'@en ;
    skos:notation 'SDN:P07::CFSN0363'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0377/1/> .
<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0377/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0377/>;
    dc:modified '2006-09-26T18:12:43'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'sea_surface_swell_wave_period'@en ;
    skos:definition 'A period is an interval of time, or the time-period of an oscillation. Swell waves are waves on the ocean surface.'@en ;
    skos:notation 'SDN:P07::CFSN0377'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0382/1/> .
<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0382/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0382/>;
    dc:modified '2006-09-26T18:12:43'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'sea_surface_wave_directional_variance_spectral_density'@en ;
    skos:definition 'Sea surface wave directional variance spectral density is the variance of the amplitude of the waves within given ranges of direction and wave frequency.'@en ;
    skos:notation 'SDN:P07::CFSN0382'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0387/1/> .
<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0387/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0387/>;
    dc:modified '2006-09-26T18:12:43'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'sea_surface_wave_variance_spectral_density'@en ;
    skos:definition 'Sea surface wave variance spectral density is the variance of wave amplitude within a range of wave frequency.'@en ;
    skos:notation 'SDN:P07::CFSN0387'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0389/1/> .
<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0389/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0389/>;
    dc:modified '2006-09-26T18:12:43'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'sea_surface_wind_wave_period'@en ;
    skos:definition 'A period is an interval of time, or the time-period of an oscillation. Wind waves are waves on the ocean surface. Wind is defined as a two-dimensional (horizontal) air velocity vector, with no vertical component. (Vertical motion in the atmosphere has the standard name upward_air_velocity.)'@en ;
    skos:notation 'SDN:P07::CFSN0389'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0393/1/> .
<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0393/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0393/>;
    dc:modified '2006-09-26T18:12:43'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'sea_water_density'@en ;
    skos:definition 'Sea water density is the in-situ density (not the potential density). If 1000 kg m-3 is subtracted, the standard name sea_water_sigma_t should be chosen instead.'@en ;
    skos:notation 'SDN:P07::CFSN0393'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0396/1/> .
<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0396/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0396/>;
    dc:modified '2006-09-26T18:12:43'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'product_of_northward_wind_and_upward_air_velocity'@en ;
    skos:definition '\'product_of_X_and_Y\' means X*Y. A velocity is a vector quantity. \'Northward\' indicates a vector component which is positive when directed northward (negative southward). \'Upward\' indicates a vector component which is positive when directed upward (negative downward). Wind is defined as a two-dimensional (horizontal) air velocity vector, with no vertical component. (Vertical motion in the atmosphere has the standard name upward_air_velocity.) Upward air velocity is the vertical component of the 3D air velocity vector.'@en ;
    skos:notation 'SDN:P07::CFSN0396'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0401/1/> .
<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0401/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0401/>;
    dc:modified '2006-09-26T18:12:43'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'product_of_upward_air_velocity_and_specific_humidity'@en ;
    skos:definition '\'product_of_X_and_Y\' means X*Y. \'specific\' means per unit mass. A velocity is a vector quantity. \'Upward\' indicates a vector component which is positive when directed upward (negative downward). Specific humidity is the mass fraction of water vapor in (moist) air. Upward air velocity is the vertical component of the 3D air velocity vector.'@en ;
    skos:notation 'SDN:P07::CFSN0401'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0402/1/> .
<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0402/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0402/>;
    dc:modified '2006-09-26T18:12:43'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'projection_x_coordinate'@en ;
    skos:definition '\'x\' indicates a vector component along the grid x-axis, when this is not true longitude, positive with increasing x. Projection coordinates are distances in the x- and y-directions on a plane onto which the surface of the Earth has been projected according to a map projection. The relationship between the projection coordinates and latitude and longitude is described by the grid_mapping.'@en ;
    skos:notation 'SDN:P07::CFSN0402'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0403/1/> .
<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0403/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0403/>;
    dc:modified '2006-09-26T18:12:43'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'projection_y_coordinate'@en ;
    skos:definition '\'y\' indicates a vector component along the grid y-axis, when this is not true latitude, positive with increasing y. Projection coordinates are distances in the x- and y-directions on a plane onto which the surface of the Earth has been projected according to a map projection. The relationship between the projection coordinates and latitude and longitude is described by the grid_mapping.'@en ;
    skos:notation 'SDN:P07::CFSN0403'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0407/1/> .
<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0407/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0407/>;
    dc:modified '2006-09-26T18:12:43'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'radiation_wavelength'@en ;
    skos:definition 'The radiation wavelength can refer to any electromagnetic wave, such as light, heat radiation and radio waves.'@en ;
    skos:notation 'SDN:P07::CFSN0407'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0408/1/> .
<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0408/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0408/>;
    dc:modified '2006-09-26T18:12:43'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'rainfall_amount'@en ;
    skos:definition '\'Amount\' means mass per unit area.'@en ;
    skos:notation 'SDN:P07::CFSN0408'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0409/1/> .
<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0409/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0409/>;
    dc:modified '2006-09-26T18:12:43'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'rainfall_flux'@en ;
    skos:definition 'In accordance with common usage in geophysical disciplines, \'flux\' implies per unit area, called \'flux density\' in physics.'@en ;
    skos:notation 'SDN:P07::CFSN0409'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0414/1/> .
<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0414/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0414/>;
    dc:modified '2006-09-26T18:12:43'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'root_depth'@en ;
    skos:definition 'Depth is the vertical distance below the surface. The root depth is maximum depth of soil reached by plant roots, from which they can extract moisture.'@en ;
    skos:notation 'SDN:P07::CFSN0414'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0415/1/> .
<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0415/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0415/>;
    dc:modified '2006-09-26T18:12:43'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'runoff_amount'@en ;
    skos:definition '\'Amount\' means mass per unit area. Runoff is the liquid water which drains from land. If not specified, \'runoff\' refers to the sum of surface runoff and subsurface drainage.'@en ;
    skos:notation 'SDN:P07::CFSN0415'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0417/1/> .
<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0417/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0417/>;
    dc:modified '2006-09-26T18:12:43'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'scattering_angle'@en ;
    skos:definition 'The scattering angle is that between the direction of the beam of incident radiation and the direction into which it is scattered.'@en ;
    skos:notation 'SDN:P07::CFSN0417'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0426/1/> .
<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0426/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0426/>;
    dc:modified '2006-09-26T18:12:43'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'product_of_eastward_wind_and_geopotential_height'@en ;
    skos:definition '\'product_of_X_and_Y\' means X*Y. Geopotential is the sum of the specific gravitational potential energy relative to the geoid and the specific centripetal potential energy. Geopotential height is the geopotential divided by the standard acceleration due to gravity. It is numerically similar to the altitude (or geometric height) and not to the quantity with standard name height, which is relative to the surface. \'Eastward\' indicates a vector component which is positive when directed eastward (negative westward). Wind is defined as a two-dimensional (horizontal) air velocity vector, with no vertical component. (Vertical motion in the atmosphere has the standard name upward_air_velocity.)'@en ;
    skos:notation 'SDN:P07::CFSN0426'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0427/1/> .
<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0427/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0427/>;
    dc:modified '2006-09-26T18:12:43'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'product_of_eastward_wind_and_northward_wind'@en ;
    skos:definition '\'product_of_X_and_Y\' means X*Y. \'Eastward\' indicates a vector component which is positive when directed eastward (negative westward). \'Northward\' indicates a vector component which is positive when directed northward (negative southward). Wind is defined as a two-dimensional (horizontal) air velocity vector, with no vertical component. (Vertical motion in the atmosphere has the standard name upward_air_velocity.)'@en ;
    skos:notation 'SDN:P07::CFSN0427'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0429/1/> .
<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0429/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0429/>;
    dc:modified '2006-09-26T18:12:43'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'product_of_eastward_wind_and_specific_humidity'@en ;
    skos:definition '\'product_of_X_and_Y\' means X*Y. \'specific\' means per unit mass. \'Eastward\' indicates a vector component which is positive when directed eastward (negative westward). Specific humidity is the mass fraction of water vapor in (moist) air. Wind is defined as a two-dimensional (horizontal) air velocity vector, with no vertical component. (Vertical motion in the atmosphere has the standard name upward_air_velocity.)'@en ;
    skos:notation 'SDN:P07::CFSN0429'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0430/1/> .
<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0430/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0430/>;
    dc:modified '2006-09-26T18:12:43'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'product_of_eastward_wind_and_upward_air_velocity'@en ;
    skos:definition '\'product_of_X_and_Y\' means X*Y. A velocity is a vector quantity. \'Eastward\' indicates a vector component which is positive when directed eastward (negative westward). \'Upward\' indicates a vector component which is positive when directed upward (negative downward). Wind is defined as a two-dimensional (horizontal) air velocity vector, with no vertical component. (Vertical motion in the atmosphere has the standard name upward_air_velocity.) Upward air velocity is the vertical component of the 3D air velocity vector.'@en ;
    skos:notation 'SDN:P07::CFSN0430'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0435/1/> .
<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0435/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0435/>;
    dc:modified '2006-09-26T18:12:43'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'product_of_northward_wind_and_geopotential_height'@en ;
    skos:definition '\'product_of_X_and_Y\' means X*Y. Geopotential is the sum of the specific gravitational potential energy relative to the geoid and the specific centripetal potential energy. Geopotential height is the geopotential divided by the standard acceleration due to gravity. It is numerically similar to the altitude (or geometric height) and not to the quantity with standard name height, which is relative to the surface. \'Northward\' indicates a vector component which is positive when directed northward (negative southward). Wind is defined as a two-dimensional (horizontal) air velocity vector, with no vertical component. (Vertical motion in the atmosphere has the standard name upward_air_velocity.)'@en ;
    skos:notation 'SDN:P07::CFSN0435'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0438/1/> .
<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0438/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0438/>;
    dc:modified '2006-09-26T18:12:43'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'product_of_northward_wind_and_specific_humidity'@en ;
    skos:definition '\'product_of_X_and_Y\' means X*Y. \'specific\' means per unit mass. \'Northward\' indicates a vector component which is positive when directed northward (negative southward). Specific humidity is the mass fraction of water vapor in (moist) air. Wind is defined as a two-dimensional (horizontal) air velocity vector, with no vertical component. (Vertical motion in the atmosphere has the standard name upward_air_velocity.)'@en ;
    skos:notation 'SDN:P07::CFSN0438'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0449/1/> .
<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0449/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0449/>;
    dc:modified '2006-09-26T18:12:43'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'potential_energy_content_of_atmosphere_layer'@en ;
    skos:definition '\'Content\' indicates a quantity per unit area. \'Layer\' means any layer with upper and lower boundaries that have constant values in some vertical coordinate. There must be a vertical coordinate variable indicating the extent of the layer(s). If the layers are model layers, the vertical coordinate can be model_level_number, but it is recommended to specify a physical coordinate (in a scalar or auxiliary coordinate variable) as well. Potential energy is the sum of the gravitational potential energy relative to the geoid and the centripetal potential energy. (The geopotential is the specific potential energy.)'@en ;
    skos:notation 'SDN:P07::CFSN0449'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0450/1/> .
<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0450/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0450/>;
    dc:modified '2006-09-26T18:12:43'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'potential_vorticity_of_atmosphere_layer'@en ;
    skos:definition '\'Layer\' means any layer with upper and lower boundaries that have constant values in some vertical coordinate. There must be a vertical coordinate variable indicating the extent of the layer(s). If the layers are model layers, the vertical coordinate can be model_level_number, but it is recommended to specify a physical coordinate (in a scalar or auxiliary coordinate variable) as well. Atmosphere potential vorticity is the vertically averaged absolute vorticity of a layer of the atmosphere divided by the pressure difference from the bottom to the top of the layer.'@en ;
    skos:notation 'SDN:P07::CFSN0450'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0451/1/> .
<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0451/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0451/>;
    dc:modified '2006-09-26T18:12:43'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'potential_vorticity_of_ocean_layer'@en ;
    skos:definition '\'Layer\' means any layer with upper and lower boundaries that have constant values in some vertical coordinate. There must be a vertical coordinate variable indicating the extent of the layer(s). If the layers are model layers, the vertical coordinate can be model_level_number, but it is recommended to specify a physical coordinate (in a scalar or auxiliary coordinate variable) as well. Ocean potential vorticity is the vertically averaged absolute vorticity of a layer of the ocean divided by the thickness of the layer.'@en ;
    skos:notation 'SDN:P07::CFSN0451'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0460/1/> .
<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0460/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0460/>;
    dc:modified '2006-09-26T18:12:43'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'northward_water_vapor_transport_across_unit_distance_in_atmosphere_layer'@en ;
    skos:definition '\'Layer\' means any layer with upper and lower boundaries that have constant values in some vertical coordinate. There must be a vertical coordinate variable indicating the extent of the layer(s). If the layers are model layers, the vertical coordinate can be model_level_number, but it is recommended to specify a physical coordinate (in a scalar or auxiliary coordinate variable) as well. \'Northward\' indicates a vector component which is positive when directed northward (negative southward). Transport across_unit_distance means expressed per unit distance normal to the direction of transport.'@en ;
    skos:notation 'SDN:P07::CFSN0460'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0461/1/> .
<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0461/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0461/>;
    dc:modified '2006-09-26T18:12:43'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'northward_wind'@en ;
    skos:definition '\'Northward\' indicates a vector component which is positive when directed northward (negative southward). Wind is defined as a two-dimensional (horizontal) air velocity vector, with no vertical component. (Vertical motion in the atmosphere has the standard name upward_air_velocity.)'@en ;
    skos:notation 'SDN:P07::CFSN0461'^^xsd:string .
