    dc:modified '2006-09-26T18:12:43'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'grid_northward_wind'@en ;
    skos:definition '\'y\' indicates a vector component along the grid y-axis, when this is not true latitude, positive with increasing y. Wind is defined as a two-dimensional (horizontal) air velocity vector, with no vertical component. (Vertical motion in the atmosphere has the standard name upward_air_velocity.)'@en ;
    skos:notation 'SDN:P07::CFSNA040'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CFSNA041/1/> .
