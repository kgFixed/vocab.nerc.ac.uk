    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'atmosphere_net_rate_of_absorption_of_shortwave_energy'@en ;
    skos:definition '\'shortwave\' means shortwave radiation. Net absorbed radiation is the difference between absorbed and emitted radiation.'@en ;
    skos:notation 'SDN:P07::CFSN0761'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0762/1/> .
