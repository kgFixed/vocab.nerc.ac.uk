    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0159/>;
    dc:modified '2006-09-26T18:12:43'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'tendency_of_upward_air_velocity'@en ;
    skos:definition '\'tendency_of_X\' means derivative of X with respect to time. A velocity is a vector quantity. \'Upward\' indicates a vector component which is positive when directed upward (negative downward). Upward air velocity is the vertical component of the 3D air velocity vector.'@en ;
    skos:notation 'SDN:P07::CFSN0159'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0160/1/> .
