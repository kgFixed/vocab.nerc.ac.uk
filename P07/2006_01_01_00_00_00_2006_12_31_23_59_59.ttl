    dc:modified '2006-09-26T18:12:43'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'biomass_burning_carbon_flux'@en ;
    skos:definition '\'Biomass burning carbon\' refers to the rate at which biomass is burned by forest fires etc., expressed as the mass of carbon which it contains. In accordance with common usage in geophysical disciplines, \'flux\' implies per unit area, called \'flux density\' in physics.'@en ;
    skos:notation 'SDN:P07::CFSN0735'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0747/1/> .
