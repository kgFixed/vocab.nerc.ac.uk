    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'coriolis_parameter'@en ;
    skos:definition 'The Coriolis parameter is twice the component of the earth\'s angular velocity about the local vertical i.e. 2 W sin L, where L is latitude and W the angular speed of the earth.'@en ;
    skos:notation 'SDN:P07::CFSN0720'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0721/1/> .
