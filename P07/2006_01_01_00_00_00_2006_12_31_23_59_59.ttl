    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'atmosphere_horizontal_velocity_potential'@en ;
    skos:definition 'A velocity is a vector quantity. \'Horizontal\' indicates that the velocity potential applies to a horizontal velocity field on a particular vertical level.'@en ;
    skos:notation 'SDN:P07::CFSN0753'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0756/1/> .
