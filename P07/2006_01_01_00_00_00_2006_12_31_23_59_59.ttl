    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0129/>;
    dc:modified '2006-09-26T18:12:43'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'toa_outgoing_longwave_flux'@en ;
    skos:definition '\'longwave\' means longwave radiation. \'toa\' means top of atmosphere. The TOA outgoing longwave flux is the upwelling thermal radiative flux, often called the \'outgoing longwave radiation\' or \'OLR\'. In accordance with common usage in geophysical disciplines, \'flux\' implies per unit area, called \'flux density\' in physics.'@en ;
    skos:notation 'SDN:P07::CFSN0129'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0130/1/> .
