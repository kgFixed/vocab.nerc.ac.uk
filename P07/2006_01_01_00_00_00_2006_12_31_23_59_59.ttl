    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'surface_drag_coefficient_for_heat_in_air'@en ;
    skos:definition 'The surface called \'surface\' means the lower boundary of the atmosphere.'@en ;
    skos:notation 'SDN:P07::CFSN0263'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0264/1/> .
<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0264/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0264/>;
    dc:modified '2006-09-26T18:12:43'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'surface_drag_coefficient_for_momentum_in_air'@en ;
    skos:definition 'The surface called \'surface\' means the lower boundary of the atmosphere.'@en ;
    skos:notation 'SDN:P07::CFSN0264'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0265/1/> .
