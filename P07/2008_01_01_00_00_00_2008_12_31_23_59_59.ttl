    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'wave_frequency'@en ;
    skos:definition 'Frequency is the number of oscillations of a wave per unit time.'@en ;
    skos:notation 'SDN:P07::CFV8NS6'^^xsd:string .
