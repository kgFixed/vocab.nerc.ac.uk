<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/JDZWRQSB/1/> .
<http://vocab.nerc.ac.uk/collection/P07/current/JDZWRQSB/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P07/current/JDZWRQSB/>;
