    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P07/current/G1N8HPK6/>;
    dc:modified '2024-05-20T20:39:48'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'left_singular_vector_of_remote_sensing_averaging_kernel_of_logarithm_of_mole_fraction_of_methane_in_air'@en ;
    skos:definition 'Left singular vectors of the matrix representing the logarithmic scale remote sensing averaging kernels (Weber 2019; Schneider et al., 2022) of the methane mole fractions obtained by a remote sensing observation (fractional changes of methane in the retrieved atmosphere relative to the fractional changes of methane in the true atmosphere, Rodgers 2000; Keppens et al., 2015).'@en ;
    skos:notation 'SDN:P07::G1N8HPK6'^^xsd:string .
