    skos:prefLabel 'right_singular_vector_of_remote_sensing_averaging_kernel_of_mole_fraction_of_methane_in_air'@en ;
    skos:definition 'Right singular vectors of the matrix representing the remote sensing averaging kernels (Weber 2019; Schneider et al., 2022) of the methane mole fractions obtained by a remote sensing observation (changes of methane in the retrieved atmosphere relative to the changes of methane in the true atmosphere, Rodgers 2000).'@en ;
    skos:notation 'SDN:P07::7QWVMGLE'^^xsd:string .
