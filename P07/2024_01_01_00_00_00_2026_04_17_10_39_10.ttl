<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/MEAA0SY7/2/> .
<http://vocab.nerc.ac.uk/collection/P07/current/MEAA0SY7/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P07/current/MEAA0SY7/>;
    dc:modified '2024-12-16T16:23:21'^^xsd:dateTime ;
