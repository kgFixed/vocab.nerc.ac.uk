<http://vocab.nerc.ac.uk/collection/P07/current/TVRJCWB0/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P07/current/TVRJCWB0/>;
    dc:modified '2025-03-19T08:31:35'^^xsd:dateTime ;
