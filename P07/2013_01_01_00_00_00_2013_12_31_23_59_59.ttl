    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'downwelling_spectral_photon_flux_in_sea_water'@en ;
    skos:definition 'Downwelling radiation is radiation from above. It does not mean \'net downward\'. A photon flux is specified in terms of numbers of photons expressed in moles. In accordance with common usage in geophysical disciplines, \'flux\' implies per unit area, called \'flux density\' in physics.'@en ;
    skos:notation 'SDN:P07::CFSN0662'^^xsd:string .
