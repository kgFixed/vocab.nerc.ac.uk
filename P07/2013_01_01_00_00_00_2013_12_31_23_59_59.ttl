    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'x_wind'@en ;
    skos:definition '"x" indicates a vector component along the grid x-axis, positive with increasing x. Wind is defined as a two-dimensional (horizontal) air velocity vector, with no vertical component. (Vertical motion in the atmosphere has the standard name upward_air_velocity.)'@en ;
    skos:notation 'SDN:P07::CFSN0042'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0043/2/> .
