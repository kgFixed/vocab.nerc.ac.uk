    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'y_wind'@en ;
    skos:definition '"y" indicates a vector component along the grid y-axis, positive with increasing y. Wind is defined as a two-dimensional (horizontal) air velocity vector, with no vertical component. (Vertical motion in the atmosphere has the standard name upward_air_velocity.)'@en ;
    skos:notation 'SDN:P07::CFSN0043'^^xsd:string .
