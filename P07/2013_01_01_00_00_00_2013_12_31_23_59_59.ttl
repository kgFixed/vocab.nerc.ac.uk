    skos:notation 'SDN:P07::CFSN0579'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0588/3/> .
<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0588/3/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0588/>;
    dc:modified '2013-01-11T16:56:43'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'land_ice_vertical_mean_x_velocity'@en ;
    skos:definition 'A velocity is a vector quantity. "x" indicates a vector component along the grid x-axis, positive with increasing x. "Land ice" means glaciers, ice-caps and ice-sheets resting on bedrock and also includes ice-shelves. The vertical mean land ice velocity is the average from the bedrock to the surface of the ice.'@en ;
    skos:notation 'SDN:P07::CFSN0588'^^xsd:string .
