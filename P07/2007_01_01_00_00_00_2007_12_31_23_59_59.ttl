    skos:prefLabel 'mole_concentration_of_ammonium_in_sea_water'@en ;
    skos:definition 'Mole concentration means moles (amount of substance) per unit volume and is used in the construction mole_concentration_of_X_in_Y, where X is a material constituent of Y.'@en ;
    skos:notation 'SDN:P07::CFSN0802'^^xsd:string .
