    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'mass_concentration_of_condensed_water_in_soil'@en ;
    skos:definition 'Mass concentration means mass per unit volume and is used in the construction mass_concentration_of_X_in_Y, where X is a material constituent of Y.  Condensed water means liquid and ice.'@en ;
    skos:notation 'SDN:P07::CFSN0787'^^xsd:string .
