    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'number_concentration_of_bathypelagic_fish_in_sea_water'@en ;
    skos:definition '"Number concentration" means the number of particles or other specified objects per unit volume. Bathypelagic fish are deep-sea fish that live at depths of about 1000-3000 m in cold and dark waters.'@en ;
    skos:notation 'SDN:P07::W2UCETWV'^^xsd:string .
