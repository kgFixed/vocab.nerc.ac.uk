    dc:modified '2026-06-08T13:55:32'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'mass_concentration_of_suspended_matter_in_sea_water'@en ;
    skos:definition '"Mass concentration" means mass per unit volume and is used in the construction "mass_concentration_of_X_in_Y", where X is a material constituent of Y. A chemical species denoted by X may be described by a single term such as "nitrogen" or a phrase such as "nox_expressed_as_nitrogen". Suspended matter may also be called suspended sediment. Suspended sediment means undissolved solid particles.'@en ;
    skos:notation 'SDN:P07::CF12S23'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/CF12S23/2/> .
