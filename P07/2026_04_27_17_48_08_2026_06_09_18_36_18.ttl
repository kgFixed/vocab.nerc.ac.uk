    skos:prefLabel 'ocean_number_content_of_demersal_fish'@en ;
    skos:definition '"Content" indicates a quantity per unit area. Demersal fish spend a fraction of their lives in close association with the seabed, feeding primarily on bottom organisms, they can carry out diel vertical migrations (e.g. cod).'@en ;
    skos:notation 'SDN:P07::6WRVG0ER'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/775ZJ0F5/1/> .
<http://vocab.nerc.ac.uk/collection/P07/current/775ZJ0F5/1/>
    a skos:Concept ;
