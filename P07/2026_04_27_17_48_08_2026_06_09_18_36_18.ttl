    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'ocean_number_content_of_bathypelagic_fish'@en ;
    skos:definition '"Content" indicates a quantity per unit area. Bathypelagic fish are deep-sea fish that live at depths of about 1000-3000 m in cold and dark waters.'@en ;
    skos:notation 'SDN:P07::XW8VAQDP'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P07/current/XY16HWNE/1/> .
