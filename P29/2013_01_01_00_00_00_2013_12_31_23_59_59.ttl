<feed> tree:member <http://vocab.nerc.ac.uk/collection/P29/current/cftreess/1/> .
<http://vocab.nerc.ac.uk/collection/P29/current/cftreess/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P29/current/cftreess/>;
    dc:modified '2013-07-11T09:54:22'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'trees'@en ;
    skos:definition 'The distinction between trees and shrubs is model dependent. All trees are C3 plant functional type.'@en ;
