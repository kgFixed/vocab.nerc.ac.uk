    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:definition
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:notation
    ];
    sh:targetClass skos:Concept
  ] ;
  tree:view <> ;
  .

<feed> tree:member <http://vocab.nerc.ac.uk/collection/P29/current/cfat5psl/2/> .
<http://vocab.nerc.ac.uk/collection/P29/current/cfat5psl/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P29/current/cfat5psl/>;
    dc:modified '2017-02-21T16:02:00'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'primary_and_secondary_land'@en ;
    skos:definition '"Primary and secondary land" is land that is not in use as crop land or pasture land, including forests, grasslands, bare ground and vegetated wetlands. "Primary land" is land that has not undergone lulcc (land use or land cover change) due to human disturbance. "Secondary land" is land that has previously been used for agriculture, urban development or logging and has subsequently been abandoned. Reference: Hurtt et al. (2011), Climatic Change, 109 - 117, Harmonization of land-use scenarios for the period 1500–2100: 600 years of global gridded annual land-use transitions, wood harvest, and resulting secondary lands, doi: 10.1007/s10584-011-0153-2. "Primary and secondary land" refers to land use or management, rather than to specific categories of vegetation cover, e.g. the primary and secondary succession of plant species.'@en ;
    skos:notation 'SDN:P29::cfat5psl'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P29/current/cfat5urb/2/> .
<http://vocab.nerc.ac.uk/collection/P29/current/cfat5urb/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P29/current/cfat5urb/>;
    dc:modified '2017-02-21T16:02:00'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'urban'@en ;
    skos:definition 'Urban land is comprised of areas where much of the land is covered by structures. Included in this category are cities, towns and villages. Reference: Anderson, J.R, E. E. Hardy, J. T. Roach and R. E. Witmer (1976), A Land Use And Land Cover Classification System For Use With Remote Sensor Data, Appendix C Land Use Definitions, Geological Survey Professional Paper 964, A revision of the land use classification system as presented in U.S. Geological Survey Circular 671, https://www.usbr.gov/lc/socal/reports/SMappend_C.pdf.'@en ;
    skos:notation 'SDN:P29::cfat5urb'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P29/current/land_ice/2/> .
<http://vocab.nerc.ac.uk/collection/P29/current/land_ice/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P29/current/land_ice/>;
    dc:modified '2017-02-21T16:02:00'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'land_ice'@en ;
    skos:definition '"Land ice" means glaciers, ice-caps, grounded ice sheets resting on bedrock and floating ice-shelves.'@en ;
    skos:notation 'SDN:P29::land_ice'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P29/current/cfpastur/2/> .
<http://vocab.nerc.ac.uk/collection/P29/current/cfpastur/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P29/current/cfpastur/>;
    dc:modified '2017-01-24T16:10:07'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'pastures'@en ;
    skos:definition 'Pastures are assumed to be anthropogenic in origin. They include anthropogenically managed pastureland and rangeland.'@en ;
    skos:notation 'SDN:P29::cfpastur'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P29/current/cfat5fis/1/> .
<http://vocab.nerc.ac.uk/collection/P29/current/cfat5fis/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P29/current/cfat5fis/>;
    dc:modified '2017-01-24T16:10:06'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'floating_ice_shelf'@en ;
    skos:definition 'An area type of "floating ice shelf" indicates where ice shelves are present. Ice shelves are the component of ice sheets that flow over the ocean.'@en ;
    skos:notation 'SDN:P29::cfat5fis'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/P29/current/cfat5gis/1/> .
<http://vocab.nerc.ac.uk/collection/P29/current/cfat5gis/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P29/current/cfat5gis/>;
    dc:modified '2017-01-24T16:10:06'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'grounded_ice_sheet'@en ;
    skos:definition 'An area type of "grounded ice sheet" indicates where the ice sheet rest over bedrock and is thus grounded. It excludes ice-caps, glaciers and floating ice shelves.'@en ;
    skos:notation 'SDN:P29::cfat5gis'^^xsd:string .
