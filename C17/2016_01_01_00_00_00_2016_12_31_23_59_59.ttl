    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Valor'@en ;
    skos:definition '''{"node": {
    "country": "United States",
    "notes": "Multiple hull situation. Data in WOD for 1944-1945. Possibly correspond to AMc 108 (1942-1944), but she sank in 1944 so 1945 cruises look odd. Data in WOD for 1954-1968 correspond to MSO 472 (1954-1970). Data in WOD for 1980 from US Coastguard indicate a third possible Valor, but no reference found."
}}'''@en ;
    skos:notation 'SDN:C17::31VR'^^xsd:string .
