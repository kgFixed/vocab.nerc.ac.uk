    skos:definition '''{"node": {
    "country": "United States",
    "notes": "Multiple hull issue. WOD data from 1962 match MSO 493. WOD data from 1985 and 1986 match T-AGOS 1. WOD data from 1972 (1 cast) doesn\'t match any known US navy vessel."
}}'''@en ;
    skos:notation 'SDN:C17::31LX'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/C17/current/31VR/3/> .
