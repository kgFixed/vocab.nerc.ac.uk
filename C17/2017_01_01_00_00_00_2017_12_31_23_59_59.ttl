    skos:prefLabel 'Rembrandt Van Rijn'@en ;
    skos:definition '''{"node": {
    "country": "Vanuatu",
    "MMSI": 576988000,
    "platformclass": "vessel of opportunity",
    "notes": "Sailing passenger schooner. Built as Jacoba, became Anna Marta in 1928, became Minde in 1962, became Klaus D in 1971, became Enno Doedens Star in 1985 became Rembrandt Van Rijn in 1995. Built as a herring lugger, the vessel was rebuilt as a three-masted passenger sailing schooner in The Netherlands in 1994 and sailed in Spitsbergen (1994 \\u2013 1996) and in Galápagos (1998 - 2001). The vessel underwent a complete rebuilding and refurbishment program in 2011.",
    "built": 1924,
    "callsign": "YJRJ3",
    "length": 49.5,
    "previous_name": "Enno Doedens Star",
    "IMO": 8941808,
    "title": "SV",
    "commissioned": 2011,
    "JCOMMOPs_Recruitment_Date": "2015-02-18"
}}'''@en ;
    skos:notation 'SDN:C17::VUHU'^^xsd:string .
