    skos:definition '''{"node": {
    "decommissioned": "1988-02-23",
    "platformclass": "ship",
    "notes": "UK registered fish factory vessel built 1967 as St Jason, renamed Jason 1 Jan 1987 until 23 Feb 1988 when she was renamed Mount Kent.  Subsequently sold, re-registered in Russia as the vessel Mayht Kent, vessel in service as at Sept 2006.",
    "previous_name": "St Jason",
    "commissioned": "1987-01-01"
}}'''@en ;
    skos:notation 'SDN:C17::74JS'^^xsd:string .
