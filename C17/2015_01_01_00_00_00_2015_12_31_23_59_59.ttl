    skos:prefLabel 'Miranda'@en ;
    skos:definition '''{"node": {
    "platformclass": "vessel of opportunity",
    "notes": "Government owned trawler support vessel operating 1974-1980. Served as mothership for fleet involved in the cod war during the 1970\'s.  Fate unknown.  Built in 1942 as a 4 masted motor schooner called Albatross (cargo-carrying, sail-training ship). In 1967 converted to cargo vessel \'Donna\', 1969, sold and became \'Dorothea\', sold to the British Government in 1970 and renamed Miranda.",
    "previous_name": "Albatross (1942), Donna (1967), Dorothea (1969)",
    "title": "MV",
    "commissioned": 1970
}}'''@en ;
    skos:notation 'SDN:C17::745N'^^xsd:string .
