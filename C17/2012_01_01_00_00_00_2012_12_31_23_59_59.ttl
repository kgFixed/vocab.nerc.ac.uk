    skos:prefLabel 'Rattlesnake'@en ;
    skos:definition '''{"node": {
    "decommissioned": 1860,
    "platformclass": "naval vessel",
    "notes": "HMS Rattlesnake was a frigate of the Royal Navy.  She was converted to a survey ship in 1845 and was involved in the discovery voyages of northern Australia (Cape York/Torres Strait). She was broken up in 1860.",
    "title": "HMS",
    "commissioned": 1782
}}'''@en ;
    skos:notation 'SDN:C17::740R'^^xsd:string .
