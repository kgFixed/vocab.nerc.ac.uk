<http://vocab.nerc.ac.uk/collection/G10/current/004/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/G10/current/004/>;
    dc:modified '2012-07-04T11:01:10'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
