@prefix tree: <https://w3id.org/tree#> .
@prefix ldes: <https://w3id.org/ldes#> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

@base <https://kgfixed.github.io/vocab.nerc.ac.uk/G10/2012_01_01_00_00_00_2012_12_31_23_59_59.ttl> .

<>
    a tree:Node
     .

<feed>
  a ldes:EventStream ;
  ldes:timestampPath dc:modified ;
  ldes:versionOfPath dc:isVersionOf ;
  
  
  tree:shape [
    a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path dc:isVersionOf
    ],
    [
      sh:datatype xsd:dateTime ;
      sh:minCount 1 ;
      sh:path dc:modified
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:altLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:prefLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:definition
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:notation
    ];
    sh:targetClass skos:Concept
  ] ;
  tree:view <> ;
  .

<feed> tree:member <http://vocab.nerc.ac.uk/collection/G10/current/001/1/> .
<http://vocab.nerc.ac.uk/collection/G10/current/001/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/G10/current/001/>;
    dc:modified '2012-07-04T11:01:10'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'unclassified'@en ;
    skos:definition 'Available for general disclosure'@en ;
    skos:notation 'SDN:G10::001'^^xsd:string .
