@prefix ldes: <https://w3id.org/ldes#> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

@base <https://kgfixed.github.io/vocab.nerc.ac.uk/C10/2015_01_01_00_00_00_2015_12_31_23_59_59.ttl> .

<>
    a tree:Node
     ;
    tree:relation [
      a tree:LessThanRelation ;
      tree:node <https://kgfixed.github.io/vocab.nerc.ac.uk/C10/2014_01_01_00_00_00_2014_12_31_23_59_59.ttl> ;
      tree:path dc:modified ;
      tree:value '2015-12-31T23:59:59'^^xsd:dateTime
    ]
     .

<feed>
  a ldes:EventStream ;
  ldes:timestampPath dc:modified ;
  ldes:versionOfPath dc:isVersionOf ;
  
  
  tree:shape [
    a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path dc:isVersionOf
    ],
    [
      sh:datatype xsd:dateTime ;
      sh:minCount 1 ;
      sh:path dc:modified
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:altLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:prefLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:definition
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:notation
    ];
    sh:targetClass skos:Concept
  ] ;
  tree:view <> ;
  .

<feed> tree:member <http://vocab.nerc.ac.uk/collection/C10/current/POLYSER/1/> .
<http://vocab.nerc.ac.uk/collection/C10/current/POLYSER/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/C10/current/POLYSER/>;
    dc:modified '2015-01-28T14:07:49'^^xsd:dateTime ;
    skos:altLabel 'Poly_Ser'^^xsd:string ;
    skos:prefLabel 'Polygon time series'@en ;
    skos:definition 'The series has a single set of measurements valid along the whole of a fixed area (e.g. flow from a submarine cable that has been relocated during the series) and fixed elevation or elevation range varying with time. Time and data parameters are stored along the primary dimension (rank 1). Position and the z co-ordinate(s) (depth or height) are stored in metadata.'@en ;
    skos:notation 'SDN:C10::POLYSER'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/C10/current/SECTSER/1/> .
<http://vocab.nerc.ac.uk/collection/C10/current/SECTSER/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/C10/current/SECTSER/>;
    dc:modified '2015-01-28T12:41:22'^^xsd:dateTime ;
    skos:altLabel 'Sect_Ser'^^xsd:string ;
    skos:prefLabel 'Section time series'@en ;
    skos:definition 'The series has a single set of measurements valid along the whole of a fixed section (e.g. flow from a submarine cable) and fixed elevation or elevation range varying with time. Time and data parameters are stored along the primary dimension (rank 1). Position and the z co-ordinate(s) (depth or height) are stored in metadata.'@en ;
    skos:notation 'SDN:C10::SECTSER'^^xsd:string .
