@prefix tree: <https://w3id.org/tree#> .
@prefix ldes: <https://w3id.org/ldes#> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

@base <https://kgfixed.github.io/vocab.nerc.ac.uk/C10/2013_01_01_00_00_00_2013_12_31_23_59_59.ttl> .

<>
    a tree:Node
     .

<feed>
  a ldes:EventStream ;
  ldes:timestampPath dc:modified ;
  ldes:versionOfPath dc:isVersionOf ;
  
  
  tree:shape [
    a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path dc:isVersionOf
    ],
    [
      sh:datatype xsd:dateTime ;
      sh:minCount 1 ;
      sh:path dc:modified
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:altLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:prefLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:definition
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:notation
    ];
    sh:targetClass skos:Concept
  ] ;
  tree:view <> ;
  .

<feed> tree:member <http://vocab.nerc.ac.uk/collection/C10/current/CSPGRSER/1/> .
<http://vocab.nerc.ac.uk/collection/C10/current/CSPGRSER/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/C10/current/CSPGRSER/>;
    dc:modified '2013-10-02T14:16:17'^^xsd:dateTime ;
    skos:altLabel 'Comp_Grid_Ser'^^xsd:string ;
    skos:prefLabel 'Compressed spatial grid series'@en ;
    skos:definition 'The series has data stored in a set of 2D arrays along a time dimension (i.e. a time series of compressed grids). Each has cycle number as the primary dimension variable and both latitude and longitude as the secondary dimension variables. Used in BODC for compact storage of spatial grid series (e.g. OSCR data) in QXF.'@en ;
    skos:notation 'SDN:C10::CSPGRSER'^^xsd:string .
