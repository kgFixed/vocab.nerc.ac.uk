<>
    a tree:Node
     ;
    tree:relation [
      a tree:LessThanRelation ;
      tree:node <https://kgfixed.github.io/vocab.nerc.ac.uk/L23/2011_01_01_00_00_00_2011_12_31_23_59_59.ttl> ;
      tree:path dc:modified ;
      tree:value '2012-12-31T23:59:59'^^xsd:dateTime
    ]
     .

<feed>
  a ldes:EventStream ;
  ldes:timestampPath dc:modified ;
  ldes:versionOfPath dc:isVersionOf ;
  
  
  tree:shape [
    a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path dc:isVersionOf
    ],
    [
      sh:datatype xsd:dateTime ;
      sh:minCount 1 ;
      sh:path dc:modified
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:altLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:prefLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:definition
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:notation
    ];
    sh:targetClass skos:Concept
  ] ;
  tree:view <> ;
  .

<feed> tree:member <http://vocab.nerc.ac.uk/collection/L23/current/IPRD/1/> .
<http://vocab.nerc.ac.uk/collection/L23/current/IPRD/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L23/current/IPRD/>;
    dc:modified '2012-01-17T10:05:10'^^xsd:dateTime ;
    skos:altLabel 'Intermediate product'^^xsd:string ;
    skos:prefLabel 'Intermediate Product record'@en ;
    skos:definition 'Metadata record providing discovery metadata for a product such as a DTM which is produced following the project methodology for the construction of a final product eg a DTM delivered by partners to a regional integrator.'@en ;
