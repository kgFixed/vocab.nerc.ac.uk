    dc:modified '2012-01-17T10:03:53'^^xsd:dateTime ;
    skos:altLabel 'Composite Product'^^xsd:string ;
    skos:prefLabel 'Composite Product Record'@en ;
    skos:definition 'Metadata record providing discovery metadata for a product such as a DTM which is provided by a data provider in place of their actual survey data as source for the project.'@en ;
