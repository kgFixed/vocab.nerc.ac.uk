@prefix tree: <https://w3id.org/tree#> .
@prefix ldes: <https://w3id.org/ldes#> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

@base <https://kgfixed.github.io/vocab.nerc.ac.uk/GS6/2010_01_01_00_00_00_2010_12_31_23_59_59.ttl> .

<>
    a tree:Node
     .

<feed>
  a ldes:EventStream ;
  ldes:timestampPath dc:modified ;
  ldes:versionOfPath dc:isVersionOf ;
  
  
  tree:shape [
    a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path dc:isVersionOf
    ],
    [
      sh:datatype xsd:dateTime ;
      sh:minCount 1 ;
      sh:path dc:modified
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:altLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:prefLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:definition
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:notation
    ];
    sh:targetClass skos:Concept
  ] ;
  tree:view <> ;
  .

<feed> tree:member <http://vocab.nerc.ac.uk/collection/GS6/current/leptokur/1/> .
<http://vocab.nerc.ac.uk/collection/GS6/current/leptokur/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/GS6/current/leptokur/>;
    dc:modified '2010-10-14T10:12:15'^^xsd:dateTime ;
    skos:altLabel 'leptokurtic'^^xsd:string ;
    skos:prefLabel 'leptokurtic'@en ;
    skos:definition 'Sharp-peaked sediment grain-size distribution with a positive Folk and Ward or Krumbein sediment grain-size kurtosis coefficient'@en ;
    skos:notation 'SDN:GS6::leptokur'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/GS6/current/mesokur/1/> .
<http://vocab.nerc.ac.uk/collection/GS6/current/mesokur/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/GS6/current/mesokur/>;
    dc:modified '2010-10-14T10:12:15'^^xsd:dateTime ;
    skos:altLabel 'mesokurtic'^^xsd:string ;
    skos:prefLabel 'mesokurtic'@en ;
    skos:definition 'Normal-peaked sediment grain-size distribution with a zero Folk and Ward or Krumbein sediment grain-size kurtosis coefficient'@en ;
    skos:notation 'SDN:GS6::mesokur'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/GS6/current/platykur/1/> .
<http://vocab.nerc.ac.uk/collection/GS6/current/platykur/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/GS6/current/platykur/>;
    dc:modified '2010-10-14T10:12:15'^^xsd:dateTime ;
    skos:altLabel 'platykurtic'^^xsd:string ;
    skos:prefLabel 'platykurtic'@en ;
    skos:definition 'Flat-peaked sediment grain-size distribution with a negative Folk and Ward or Krumbein sediment grain-size kurtosis coefficient'@en ;
    skos:notation 'SDN:GS6::platykur'^^xsd:string .
