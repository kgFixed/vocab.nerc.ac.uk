<feed> tree:member <http://vocab.nerc.ac.uk/collection/C67/current/TPSL/2/> .
<http://vocab.nerc.ac.uk/collection/C67/current/TPSL/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/C67/current/TPSL/>;
    dc:modified '2023-07-21T11:13:55'^^xsd:dateTime ;
    skos:altLabel 't+s'^^xsd:string ;
    skos:prefLabel 'discrete temperature and salinity'@en ;
    skos:definition 'This term encompasses temperature and salinity measurements that are made on discrete water samples or made with the specific purpose of calibrating in situ sensor data. It specifically excludes CTD sensor data extracted at bottle firing depth or time.'@en ;
    skos:notation 'SDN:C67::TPSL'^^xsd:string .
