    skos:altLabel 'finSkew'^^xsd:string ;
    skos:prefLabel 'fine skewed'@en ;
    skos:definition 'Folk and Ward or Krumbein sediment grain-size  skewness coefficient +0.30 to +0.10'@en ;
    skos:notation 'SDN:GS5::fskew'^^xsd:string .
