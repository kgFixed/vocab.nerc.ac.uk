    skos:altLabel 'nearSymm'^^xsd:string ;
    skos:prefLabel 'near symmetrical'@en ;
    skos:definition 'Folk and Ward or Krumbein sediment grain-size  skewness coefficient +0.10 to -0.10'@en ;
    skos:notation 'SDN:GS5::nearsymm'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/GS5/current/scskew/1/> .
