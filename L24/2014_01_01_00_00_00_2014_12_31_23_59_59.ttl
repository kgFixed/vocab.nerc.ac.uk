<>
    a tree:Node
     ;
    tree:relation [
      a tree:LessThanRelation ;
      tree:node <https://kgfixed.github.io/vocab.nerc.ac.uk/L24/2011_01_01_00_00_00_2013_12_31_23_59_59.ttl> ;
      tree:path dc:modified ;
      tree:value '2014-12-31T23:59:59'^^xsd:dateTime
    ]
     .

<feed>
  a ldes:EventStream ;
  ldes:timestampPath dc:modified ;
  ldes:versionOfPath dc:isVersionOf ;
  
  
  tree:shape [
    a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path dc:isVersionOf
    ],
    [
      sh:datatype xsd:dateTime ;
      sh:minCount 1 ;
      sh:path dc:modified
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:altLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:prefLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:definition
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:notation
    ];
    sh:targetClass skos:Concept
  ] ;
  tree:view <> ;
  .

<feed> tree:member <http://vocab.nerc.ac.uk/collection/L24/current/XYZ/1/> .
<http://vocab.nerc.ac.uk/collection/L24/current/XYZ/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L24/current/XYZ/>;
    dc:modified '2014-11-26T08:24:22'^^xsd:dateTime ;
    skos:altLabel 'XYZ'^^xsd:string ;
    skos:prefLabel 'XYZ ASCII'@en ;
    skos:definition 'XYZ comma separated format (longitude, latitude, depth), designed for gridded data from bathymetric surveys and Digital Terrain Models.'@en ;
    skos:notation 'SDN:L24::XYZ'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L24/current/BAG/1/> .
<http://vocab.nerc.ac.uk/collection/L24/current/BAG/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L24/current/BAG/>;
    dc:modified '2014-06-24T08:56:13'^^xsd:dateTime ;
    skos:altLabel 'BAG'^^xsd:string ;
    skos:prefLabel 'Bathymetric Attributed Grid format'@en ;
    skos:definition 'A global, non-proprietary, open source exchange format created to facilitate the processing and storage of large volume multibeam sonar data. It is developed by the Open Navigation Surface Working Group.'@en ;
    skos:notation 'SDN:L24::BAG'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L24/current/GEOTIFF/1/> .
<http://vocab.nerc.ac.uk/collection/L24/current/GEOTIFF/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L24/current/GEOTIFF/>;
    dc:modified '2014-06-24T08:53:18'^^xsd:dateTime ;
    skos:altLabel 'GEOTIFF'^^xsd:string ;
    skos:prefLabel 'Georeferenced Tagged Image File Format'@en ;
    skos:definition 'A public domain metadata standard which allows georeferencing information to be embedded within a TIFF file. The potential additional information includes map projection, coordinate systems, ellipsoids, datums, and other attributes to establish the exact spatial reference for the file.'@en ;
    skos:notation 'SDN:L24::GEOTIFF'^^xsd:string .
