    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:prefLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:definition
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:notation
    ];
    sh:targetClass skos:Concept
  ] ;
  tree:view <> ;
  .

<feed> tree:member <http://vocab.nerc.ac.uk/collection/L24/current/ODV/2/> .
<http://vocab.nerc.ac.uk/collection/L24/current/ODV/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L24/current/ODV/>;
    dc:modified '2020-11-30T09:46:57'^^xsd:dateTime ;
    skos:altLabel 'ODV'^^xsd:string ;
    skos:prefLabel 'Ocean Data View ASCII input'@en ;
    skos:definition 'SeaDataNet extension of the Ocean Data View ASCII upload format with additional semantics embedded. Designed for profiles and point time series. For taxon-based data and micro-litter data please use the specially designed ODV variants.'@en ;
    skos:notation 'SDN:L24::ODV'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L24/current/BODV/1/> .
<http://vocab.nerc.ac.uk/collection/L24/current/BODV/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L24/current/BODV/>;
    dc:modified '2020-11-30T09:46:45'^^xsd:dateTime ;
    skos:altLabel 'Biological_ODV'^^xsd:string ;
    skos:prefLabel 'Biological ODV'@en ;
    skos:definition 'A variant of the ODV ASCII format to enable Data Centers to exchange biological (taxon-based) data using the SeaDataNet infrastructure. It contains all the elements required to allow conversion to the Darwin Core format and is therefore compatible with formats used by e.g. EMODNet Biology, (Eur)OBIS and GBIF.'@en ;
    skos:notation 'SDN:L24::BODV'^^xsd:string .
