    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:notation
    ];
    sh:targetClass skos:Concept
  ] ;
  tree:view <> ;
  .

<feed> tree:member <http://vocab.nerc.ac.uk/collection/L24/current/EBL/1/> .
<http://vocab.nerc.ac.uk/collection/L24/current/EBL/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L24/current/EBL/>;
    dc:modified '2018-09-05T14:35:25'^^xsd:dateTime ;
    skos:altLabel 'Beach_litter'^^xsd:string ;
    skos:prefLabel 'EMODnet Beach litter data format'@en ;
    skos:definition 'A standard data format in Excel formulated by EMODnet Chemistry in cooperation with TSG-ML and EU-JRC and derived from OSPAR/MCS guidelines and practices. It is used for reporting and classifying beach litter monitoring data. Excel variants are permitted.'@en ;
    skos:notation 'SDN:L24::EBL'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L24/current/ESFL/1/> .
<http://vocab.nerc.ac.uk/collection/L24/current/ESFL/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L24/current/ESFL/>;
    dc:modified '2018-09-05T14:35:25'^^xsd:dateTime ;
    skos:altLabel 'Sea_floor_litter'^^xsd:string ;
    skos:prefLabel 'EMODnet Sea-floor litter data format'@en ;
    skos:definition 'A standard data format in excel formulated by EMODnet Chemistry in cooperation with TSG-ML and EU-JRC and derived from DATRAS- ICES Database of trawl surveys practices and guidelines for North and Western European seas and MEDITS practices and guidelines for the Mediterranean sea. It is used for reporting and classifying benthic litter monitoring data from fish trawl surveys. Excel variants are allowed.'@en ;
    skos:notation 'SDN:L24::ESFL'^^xsd:string .
