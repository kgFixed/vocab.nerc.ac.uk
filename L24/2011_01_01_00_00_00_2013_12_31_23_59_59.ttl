    dc:modified '2013-07-16T12:27:17'^^xsd:dateTime ;
    skos:altLabel 'CF_NetCDF'^^xsd:string ;
    skos:prefLabel 'Climate and Forecast NetCDF'@en ;
    skos:definition 'SeaDataNet extension of the Climate and Forecast (http://www.cfconventions.org/) version 1.5 standard binary format with additional semantics embedded.  Designed for gridded data.'@en ;
