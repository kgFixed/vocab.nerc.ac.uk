@prefix tree: <https://w3id.org/tree#> .
@prefix ldes: <https://w3id.org/ldes#> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

@base <https://kgfixed.github.io/vocab.nerc.ac.uk/C59/2009_01_01_00_00_00_2009_12_31_23_59_59.ttl> .

<>
    a tree:Node
     .

<feed>
  a ldes:EventStream ;
  ldes:timestampPath dc:modified ;
  ldes:versionOfPath dc:isVersionOf ;
  
  
  tree:shape [
    a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path dc:isVersionOf
    ],
    [
      sh:datatype xsd:dateTime ;
      sh:minCount 1 ;
      sh:path dc:modified
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:altLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:prefLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:definition
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:notation
    ];
    sh:targetClass skos:Concept
  ] ;
  tree:view <> ;
  .

<feed> tree:member <http://vocab.nerc.ac.uk/collection/C59/current/CONMEM/5/> .
<http://vocab.nerc.ac.uk/collection/C59/current/CONMEM/5/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/C59/current/CONMEM/>;
    dc:modified '2009-05-07T10:20:38'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Project Member'@en ;
    skos:definition 'An organisation which forms part of a project consortium . A  project consortium is an association of two or more organisations with the objective of participating in a common activity or pooling their resources for achieving a common goal.'@en ;
    skos:notation 'SDN:C59::CONMEM'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/C59/current/FUND/2/> .
<http://vocab.nerc.ac.uk/collection/C59/current/FUND/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/C59/current/FUND/>;
    dc:modified '2009-03-06T17:01:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Project Funding body'@en ;
    skos:definition 'An organisation responsible for providing the funding to a project.'@en ;
    skos:notation 'SDN:C59::FUND'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/C59/current/DATM/1/> .
<http://vocab.nerc.ac.uk/collection/C59/current/DATM/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/C59/current/DATM/>;
    dc:modified '2009-03-06T16:54:19'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Project Data Management'@en ;
    skos:definition 'An organisation which has data management responsibility for a project.'@en ;
    skos:notation 'SDN:C59::DATM'^^xsd:string .
