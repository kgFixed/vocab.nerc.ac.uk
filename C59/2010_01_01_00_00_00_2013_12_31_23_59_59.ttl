    dc:modified '2013-05-15T12:52:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Project Lead'@en ;
    skos:definition 'The organisation responsible for the overall planning and management of a project  This is either the lead organisation in a consortium or the organisation solely responsible for the project. A project consortium is an association of two or more organisations with the objective of participating in a common activity or pooling their resources for achieving a common goal.'@en ;
