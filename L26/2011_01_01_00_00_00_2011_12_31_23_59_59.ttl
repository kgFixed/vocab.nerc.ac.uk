@prefix tree: <https://w3id.org/tree#> .
@prefix ldes: <https://w3id.org/ldes#> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

@base <https://kgfixed.github.io/vocab.nerc.ac.uk/L26/2011_01_01_00_00_00_2011_12_31_23_59_59.ttl> .

<>
    a tree:Node
     .

<feed>
  a ldes:EventStream ;
  ldes:timestampPath dc:modified ;
  ldes:versionOfPath dc:isVersionOf ;
  
  
  tree:shape [
    a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path dc:isVersionOf
    ],
    [
      sh:datatype xsd:dateTime ;
      sh:minCount 1 ;
      sh:path dc:modified
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:altLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:prefLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:definition
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:notation
    ];
    sh:targetClass skos:Concept
  ] ;
  tree:view <> ;
  .

<feed> tree:member <http://vocab.nerc.ac.uk/collection/L26/current/UHOR/1/> .
<http://vocab.nerc.ac.uk/collection/L26/current/UHOR/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L26/current/UHOR/>;
    dc:modified '2011-10-26T14:11:07'^^xsd:dateTime ;
    skos:altLabel 'h'^^xsd:string ;
    skos:prefLabel 'Hours'@en ;
    skos:definition 'A time interval of sixty minutes or 3600 seconds.'@en ;
    skos:notation 'SDN:L26::UHOR'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L26/current/UMIN/1/> .
<http://vocab.nerc.ac.uk/collection/L26/current/UMIN/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L26/current/UMIN/>;
    dc:modified '2011-10-26T14:11:07'^^xsd:dateTime ;
    skos:altLabel 'min'^^xsd:string ;
    skos:prefLabel 'Minutes'@en ;
    skos:definition 'A time interval of sixty seconds'@en ;
    skos:notation 'SDN:L26::UMIN'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L26/current/UYRS/1/> .
<http://vocab.nerc.ac.uk/collection/L26/current/UYRS/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L26/current/UYRS/>;
    dc:modified '2011-10-26T14:11:07'^^xsd:dateTime ;
    skos:altLabel 'yr'^^xsd:string ;
    skos:prefLabel 'Years'@en ;
    skos:definition 'A time interval of 365.25 days or 31557600 seconds'@en ;
    skos:notation 'SDN:L26::UYRS'^^xsd:string .
