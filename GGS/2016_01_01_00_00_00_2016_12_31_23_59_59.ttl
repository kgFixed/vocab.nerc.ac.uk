    skos:prefLabel 'GEBCO_data_source_ID_9999'@en ;
    skos:definition '''{"node": {
    "references_and_links": "SRTM30_plus v5. Becker, J. J., D. T. Sandwell, W. H. F. Smith, J. Braud, B. Binder, J. Depner, D. Fabre, J. Factor, S. Ingalls, S-H. Kim, R. Ladner, K. Marks, S. Nelson, A. Pharaoh, R. Trimmer, J. Von Rosenberg, G. Wallace, P. Weatherall., Global Bathymetry and Elevation Data at 30 Arc Seconds Resolution: SRTM30_PLUS, Marine Geodesy, 32:4, 355-371, 2009",
    "definition": "The grid value at this location is based on a gridded data set developed from a database of ship-track soundings with interpolation between soundings guided by satellite-derived gravity data. At this location, the grid cell has been constrained by bathymetric sounding(s) data during the gridding process."
}}'''@en ;
    skos:notation 'SDN:GGS::SID9999'^^xsd:string .
