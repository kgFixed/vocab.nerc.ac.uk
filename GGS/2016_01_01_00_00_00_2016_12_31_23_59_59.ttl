    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'GEBCO_data_source_ID_0'@en ;
    skos:definition '''{"node": {
    "references_and_links": "SRTM30_plus v5. Becker, J. J., D. T. Sandwell, W. H. F. Smith, J. Braud, B. Binder, J. Depner, D. Fabre, J. Factor, S. Ingalls, S-H. Kim, R. Ladner, K. Marks, S. Nelson, A. Pharaoh, R. Trimmer, J. Von Rosenberg, G. Wallace, P. Weatherall., Global Bathymetry and Elevation Data at 30 Arc Seconds Resolution: SRTM30_PLUS, Marine Geodesy, 32:4, 355-371, 2009; http://topex.ucsd.edu/WWW_html/srtm30_plus.html",
    "definition": "The grid value at this location is based on a gridded data set developed from a database of ship-track soundings with interpolation between soundings guided by satellite-derived gravity data. At this location in the grid, the data value is based on interpolation."
}}'''@en ;
    skos:notation 'SDN:GGS::SID0'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/GGS/current/SID110/2/> .
<http://vocab.nerc.ac.uk/collection/GGS/current/SID110/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/GGS/current/SID110/>;
    dc:modified '2016-03-14T10:38:30'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'GEBCO_data_source_ID_110'@en ;
    skos:definition '''{"node": {
    "references_and_links": "Bathymetric compilations of the seas around Israel I: The Caspian and Black Seas, J.K. Hall, Geological Survey of Israel, Current Research, Vol. 13, December 2002.",
    "definition": "The grid value at this location is taken from a gridded data set for the Caspian Sea region. This grid has been generated from a data set of soundings using a kriging gridding algorithm. GEBCO Source Identifier (SID) grid cells that contain a sounding(s) from the Caspian Sea source data set are coded as \'1100\'."
}}'''@en ;
    skos:notation 'SDN:GGS::SID110'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/GGS/current/SID1100/2/> .
