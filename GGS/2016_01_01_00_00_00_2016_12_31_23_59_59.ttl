<feed> tree:member <http://vocab.nerc.ac.uk/collection/GGS/current/SID130/2/> .
<http://vocab.nerc.ac.uk/collection/GGS/current/SID130/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/GGS/current/SID130/>;
    dc:modified '2016-03-14T10:38:30'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'GEBCO_data_source_ID_130'@en ;
    skos:definition '''{"node": {
    "references_and_links": "Schenke, Hans Werner; Hinze, Heinrich; Dijkstra, Semme J; Hoppmann, Bernd; Niederjasper, Fred; Schöne, Tilo (1997): AWI Bathymetric Chart of the Weddell Sea, Antarctica (BCWS). Alfred Wegener Institute, Helmholtz Center for Polar and Marine Research, Bremerhaven, doi:10.1594/PANGAEA.708081",
    "definition": "The grid value at this location is taken from the GEBCO_08 Grid. In this region, the GEBCO_08 Grid is based on a gridded data set for the Weddell Sea area. This grid has been generated from a data set of bathymetric contours based largely on multibeam and single beam bathymetric surveys. SID grid cells that contain trackline control from the Weddell Sea source data set are coded as \'1300\'."
}}'''@en ;
    skos:notation 'SDN:GGS::SID130'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/GGS/current/SID1300/2/> .
<http://vocab.nerc.ac.uk/collection/GGS/current/SID1300/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/GGS/current/SID1300/>;
    dc:modified '2016-03-14T10:38:30'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'GEBCO_data_source_ID_1300'@en ;
    skos:definition '''{"node": {
    "references_and_links": "Schenke, Hans Werner; Hinze, Heinrich; Dijkstra, Semme J; Hoppmann, Bernd; Niederjasper, Fred; Schöne, Tilo (1997): AWI Bathymetric Chart of the Weddell Sea, Antarctica (BCWS). Alfred Wegener Institute, Helmholtz Center for Polar and Marine Research, Bremerhaven, doi:10.1594/PANGAEA.708081",
    "definition": "The grid value at this location is taken from the GEBCO_08 Grid. In this area the GEBCO_08 Grid is based on a gridded data set for the Weddell Sea area. This grid has been generated from a data set of bathymetric contours based largely on multibeam and single-beam bathymetric surveys. The grid cell at this location is \'crossed\' by trackline control information, i.e. survey track or isolated sounding, from the Weddell Sea source data set. For the Weddell Sea grid, cells that do not contain trackline control are coded as \'130\'."
}}'''@en ;
    skos:notation 'SDN:GGS::SID1300'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/GGS/current/SID1400/2/> .
