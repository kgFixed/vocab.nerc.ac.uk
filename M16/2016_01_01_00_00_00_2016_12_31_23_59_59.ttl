@prefix tree: <https://w3id.org/tree#> .
@prefix ldes: <https://w3id.org/ldes#> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

@base <https://kgfixed.github.io/vocab.nerc.ac.uk/M16/2016_01_01_00_00_00_2016_12_31_23_59_59.ttl> .

<>
    a tree:Node
     .

<feed>
  a ldes:EventStream ;
  ldes:timestampPath dc:modified ;
  ldes:versionOfPath dc:isVersionOf ;
  
  
  tree:shape [
    a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path dc:isVersionOf
    ],
    [
      sh:datatype xsd:dateTime ;
      sh:minCount 1 ;
      sh:path dc:modified
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:altLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:prefLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:definition
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:notation
    ];
    sh:targetClass skos:Concept
  ] ;
  tree:view <> ;
  .

<feed> tree:member <http://vocab.nerc.ac.uk/collection/M16/current/INVEST_BOX/1/> .
<http://vocab.nerc.ac.uk/collection/M16/current/INVEST_BOX/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/M16/current/INVEST_BOX/>;
    dc:modified '2016-05-31T12:37:01'^^xsd:dateTime ;
    skos:altLabel 'Box core'^^xsd:string ;
    skos:prefLabel 'Box core investigation'@en ;
    skos:definition 'A geotechnical site investigation carried out with the intention of recovering soft sediment samples from the seafloor using a sampling technique consisting of a weighted box which penetrates into the seabed to a depth which depends on its descent rate, and has a blade which closes the base of the box after penetration, thus collecting the sample.'@en ;
    skos:notation 'SDN:M16::INVEST_BOX'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/M16/current/INVEST_CPTBORE/1/> .
<http://vocab.nerc.ac.uk/collection/M16/current/INVEST_CPTBORE/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/M16/current/INVEST_CPTBORE/>;
    dc:modified '2016-05-31T12:37:01'^^xsd:dateTime ;
    skos:altLabel 'CPT borehole'^^xsd:string ;
    skos:prefLabel 'Cone penetration test borehole investigation'@en ;
    skos:definition 'A geotechnical site investigation where a narrow shaft is drilled into a substrate to a pre-selected depth and then, at that depth, an instrumented cone with tip facing down is pushed into the base of the borehole at a controlled rate (also known as borehole cone penetration testing).'@en ;
    skos:notation 'SDN:M16::INVEST_CPTBORE'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/M16/current/INVEST_COMPBORE/1/> .
<http://vocab.nerc.ac.uk/collection/M16/current/INVEST_COMPBORE/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/M16/current/INVEST_COMPBORE/>;
    dc:modified '2016-05-31T12:37:01'^^xsd:dateTime ;
    skos:altLabel 'Composite borehole'^^xsd:string ;
    skos:prefLabel 'Composite borehole investigation'@en ;
    skos:definition 'A geotechnical site investigation where a narrow shaft is drilled into a substrate with the intention of performing both sampling of soil or rock and in-situ testing such as insertion of instrumented cones into the substrate.'@en ;
    skos:notation 'SDN:M16::INVEST_COMPBORE'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/M16/current/INVEST_GRAB/1/> .
<http://vocab.nerc.ac.uk/collection/M16/current/INVEST_GRAB/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/M16/current/INVEST_GRAB/>;
    dc:modified '2016-05-31T12:37:01'^^xsd:dateTime ;
    skos:altLabel 'Grab investigation'^^xsd:string ;
    skos:prefLabel 'Grab investigation'@en ;
    skos:definition 'A geotechnical site investigation carried out with the intention of recovering sediment samples from the seabed using a device which consists of a bucket or pair of buckets or similar containers which rotate on impact with the seabed, either through a spring trigger or through human intervention and scoop out a sample of sediment.'@en ;
    skos:notation 'SDN:M16::INVEST_GRAB'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/M16/current/INVEST_PISTON/1/> .
<http://vocab.nerc.ac.uk/collection/M16/current/INVEST_PISTON/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/M16/current/INVEST_PISTON/>;
    dc:modified '2016-05-31T12:37:01'^^xsd:dateTime ;
    skos:altLabel 'Piston core'^^xsd:string ;
    skos:prefLabel 'Piston core investigation'@en ;
    skos:definition 'A geotechnical site investigation carried out with the intention of recovering samples from seafloor substrate using a sampling technique which consists of a heavy weight, above a long metal tube and secured by a trigger arm. When the metal tube impacts the seabed, the trigger arm is released and the heavy weight falls, strikes the metal tube and drives it deep into the seafloor'@en ;
    skos:notation 'SDN:M16::INVEST_PISTON'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/M16/current/INVEST_SAMPBORE/1/> .
<http://vocab.nerc.ac.uk/collection/M16/current/INVEST_SAMPBORE/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/M16/current/INVEST_SAMPBORE/>;
    dc:modified '2016-05-31T12:37:01'^^xsd:dateTime ;
    skos:altLabel 'Sample borehole'^^xsd:string ;
    skos:prefLabel 'Sample borehole investigation'@en ;
    skos:definition 'A geotechnical site investigation consisting of a narrow shaft drilled into a substrate solely to obtain soil or rock samples'@en ;
    skos:notation 'SDN:M16::INVEST_SAMPBORE'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/M16/current/INVEST_BEDCPT/1/> .
<http://vocab.nerc.ac.uk/collection/M16/current/INVEST_BEDCPT/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/M16/current/INVEST_BEDCPT/>;
    dc:modified '2016-05-31T12:37:01'^^xsd:dateTime ;
    skos:altLabel 'Seabed CPT'^^xsd:string ;
    skos:prefLabel 'Seabed cone penetration test investigation'@en ;
    skos:definition 'A geotechnical site investigation where a rig is lowered to the seafloor which contains a mechanical system that forces an instrumented cone with tip down into the seabed at a controlled rate.'@en ;
    skos:notation 'SDN:M16::INVEST_BEDCPT'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/M16/current/INVEST_SPECBORE/1/> .
<http://vocab.nerc.ac.uk/collection/M16/current/INVEST_SPECBORE/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/M16/current/INVEST_SPECBORE/>;
    dc:modified '2016-05-31T12:37:01'^^xsd:dateTime ;
    skos:altLabel 'Specialist borehole'^^xsd:string ;
    skos:prefLabel 'Specialist borehole investigation'@en ;
    skos:definition 'A geotechnical site investigation where anarrow shaft is drilled into a substrate for specialist in-situ testing which excludes penetration tests by instrumented cones.'@en ;
    skos:notation 'SDN:M16::INVEST_SPECBORE'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/M16/current/INVEST_VIBR/1/> .
<http://vocab.nerc.ac.uk/collection/M16/current/INVEST_VIBR/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/M16/current/INVEST_VIBR/>;
    dc:modified '2016-05-31T12:37:01'^^xsd:dateTime ;
    skos:altLabel 'Vibrocore'^^xsd:string ;
    skos:prefLabel 'Vibrocore  investigation'@en ;
    skos:definition 'A geotechnical site investigation carried out with the intention of recovering samples from the seabed using a sampling technique in which a large diameter tube is vibrated into substrate while oscillating.'@en ;
    skos:notation 'SDN:M16::INVEST_VIBR'^^xsd:string .
