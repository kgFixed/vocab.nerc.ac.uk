<>
    a tree:Node
     .

<feed>
  a ldes:EventStream ;
  ldes:timestampPath dc:modified ;
  ldes:versionOfPath dc:isVersionOf ;
  
  
  tree:shape [
    a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path dc:isVersionOf
    ],
    [
      sh:datatype xsd:dateTime ;
      sh:minCount 1 ;
      sh:path dc:modified
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:altLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:prefLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:definition
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:notation
    ];
    sh:targetClass skos:Concept
  ] ;
  tree:view <> ;
  .

<feed> tree:member <http://vocab.nerc.ac.uk/collection/L13/current/AP/1/> .
<http://vocab.nerc.ac.uk/collection/L13/current/AP/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L13/current/AP/>;
    dc:modified '2006-11-15T08:15:00'^^xsd:dateTime ;
    skos:altLabel 'abyssopelagic'^^xsd:string ;
    skos:prefLabel 'abyssopelagic water column'@en ;
    skos:definition 'The water column zone of total darkness extending down to the abyssal sea floor. Typically between depths of approximately 4000 metres and 6000 metres.'@en ;
    skos:notation 'SDN:L13::AP'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L13/current/AT/1/> .
<http://vocab.nerc.ac.uk/collection/L13/current/AT/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L13/current/AT/>;
    dc:modified '2006-11-15T08:15:00'^^xsd:dateTime ;
    skos:altLabel 'atmosphere'^^xsd:string ;
    skos:prefLabel 'atmosphere'@en ;
    skos:definition 'The envelope of gases surrounding the Earth.'@en ;
    skos:notation 'SDN:L13::AT'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L13/current/AB/1/> .
<http://vocab.nerc.ac.uk/collection/L13/current/AB/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L13/current/AB/>;
    dc:modified '2006-11-15T08:15:00'^^xsd:dateTime ;
    skos:altLabel 'atmosphere_boundary'^^xsd:string ;
    skos:prefLabel 'atmospheric boundary layer'@en ;
    skos:definition 'The region of the atmosphere close enough to the Earth\'s surface for frictional effects of that surface to be significant. Typically not more than 1 km thick.'@en ;
    skos:notation 'SDN:L13::AB'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L13/current/BP/1/> .
<http://vocab.nerc.ac.uk/collection/L13/current/BP/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L13/current/BP/>;
    dc:modified '2006-11-15T08:15:00'^^xsd:dateTime ;
    skos:altLabel 'bathypelagic'^^xsd:string ;
    skos:prefLabel 'bathypelagic water column'@en ;
    skos:definition 'The water column zone illuminated only by bioluminescent organisms. Typically between depths of approximately 1000 metres and 4000 metres.'@en ;
    skos:notation 'SDN:L13::BP'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L13/current/NB/1/> .
<http://vocab.nerc.ac.uk/collection/L13/current/NB/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L13/current/NB/>;
    dc:modified '2006-11-15T08:15:00'^^xsd:dateTime ;
    skos:altLabel 'benthic_boundary'^^xsd:string ;
    skos:prefLabel 'benthic boundary layer'@en ;
    skos:definition 'The water column that is significantly influenced by the seabed, which is broader in deep ocean than in shelf seas.  Guideline approximation is bottom 10m of oceans and bottom 5% of shelf (<200m) seas.'@en ;
    skos:notation 'SDN:L13::NB'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L13/current/CO/1/> .
<http://vocab.nerc.ac.uk/collection/L13/current/CO/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L13/current/CO/>;
    dc:modified '2006-11-15T08:15:00'^^xsd:dateTime ;
    skos:altLabel 'core'^^xsd:string ;
    skos:prefLabel 'core'@en ;
    skos:definition 'The central zone of the earth largely composed of solid or molten metal alloys, typically from the centre of the Earth to approximately 2900 km below the surface..'@en ;
    skos:notation 'SDN:L13::CO'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L13/current/CR/1/> .
<http://vocab.nerc.ac.uk/collection/L13/current/CR/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L13/current/CR/>;
    dc:modified '2006-11-15T08:15:00'^^xsd:dateTime ;
    skos:altLabel 'crust'^^xsd:string ;
    skos:prefLabel 'crust'@en ;
    skos:definition 'The layer of lithified rock between the unconsolidated sediment and the Moho seismic discontinuity. Typically 5-10 km thick beneath oceans and 60-70 km thick beneath continents.'@en ;
    skos:notation 'SDN:L13::CR'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L13/current/U2/1/> .
<http://vocab.nerc.ac.uk/collection/L13/current/U2/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L13/current/U2/>;
    dc:modified '2006-11-15T08:15:00'^^xsd:dateTime ;
    skos:altLabel 'epipelagic'^^xsd:string ;
    skos:prefLabel 'epipelagic water column'@en ;
    skos:definition 'The water column zone in which for clear water there is adequate light for photosynthesis. Typically from  the surface down to a depth of approximately 200 metres.'@en ;
    skos:notation 'SDN:L13::U2'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L13/current/ES/1/> .
<http://vocab.nerc.ac.uk/collection/L13/current/ES/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L13/current/ES/>;
    dc:modified '2006-11-15T08:15:00'^^xsd:dateTime ;
    skos:altLabel 'exosphere'^^xsd:string ;
    skos:prefLabel 'exosphere'@en ;
    skos:definition 'The outermost layer of the atmosphere from which atoms can escape into outer space. Lies above the thermosphere from about 400 km in altitude.'@en ;
    skos:notation 'SDN:L13::ES'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L13/current/HW/1/> .
<http://vocab.nerc.ac.uk/collection/L13/current/HW/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L13/current/HW/>;
    dc:modified '2006-11-15T08:15:00'^^xsd:dateTime ;
    skos:altLabel 'hadopelagic'^^xsd:string ;
    skos:prefLabel 'hadopelagic water column'@en ;
    skos:definition 'The zone of the water column occupying ocean trenches, deeper than approximately 6000 metres.'@en ;
    skos:notation 'SDN:L13::HW'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L13/current/HX/1/> .
<http://vocab.nerc.ac.uk/collection/L13/current/HX/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L13/current/HX/>;
    dc:modified '2006-11-15T08:15:00'^^xsd:dateTime ;
    skos:altLabel 'heterosphere'^^xsd:string ;
    skos:prefLabel 'heterosphere'@en ;
    skos:definition 'The region of the atmosphere where the mixing ratio of gases is differentiated by gravity. Lies above the homosphere, from about 100 km in altitude.'@en ;
    skos:notation 'SDN:L13::HX'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L13/current/HP/1/> .
<http://vocab.nerc.ac.uk/collection/L13/current/HP/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L13/current/HP/>;
    dc:modified '2006-11-15T08:15:00'^^xsd:dateTime ;
    skos:altLabel 'homopause'^^xsd:string ;
    skos:prefLabel 'homopause'@en ;
    skos:definition 'The boundary region between the homosphere and the heterosphere. Typically at about 100 km.'@en ;
    skos:notation 'SDN:L13::HP'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L13/current/HS/1/> .
<http://vocab.nerc.ac.uk/collection/L13/current/HS/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L13/current/HS/>;
    dc:modified '2006-11-15T08:15:00'^^xsd:dateTime ;
    skos:altLabel 'homosphere'^^xsd:string ;
    skos:prefLabel 'homosphere'@en ;
    skos:definition 'The region of the atmosphere where gases are fully mixed by diffusion and turbulence. Lies between the surface (0 km) and the base of the heterosphere (at about 100 km).'@en ;
    skos:notation 'SDN:L13::HS'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L13/current/MA/1/> .
<http://vocab.nerc.ac.uk/collection/L13/current/MA/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L13/current/MA/>;
    dc:modified '2006-11-15T08:15:00'^^xsd:dateTime ;
    skos:altLabel 'mantle'^^xsd:string ;
    skos:prefLabel 'mantle'@en ;
    skos:definition 'The layer of basic (i.e ferromagnesian) solid rock between the core and the crust.  Typically from between 5-70 km below the surface to approximately 2900 km below the surface.'@en ;
    skos:notation 'SDN:L13::MA'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L13/current/MP/1/> .
<http://vocab.nerc.ac.uk/collection/L13/current/MP/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L13/current/MP/>;
    dc:modified '2006-11-15T08:15:00'^^xsd:dateTime ;
    skos:altLabel 'mesopause'^^xsd:string ;
    skos:prefLabel 'mesopause'@en ;
    skos:definition 'The boundary between the mesosphere and the thermosphere characterised by a temperature minimum.  Typically lies somewhere between 80 and 90 km.'@en ;
    skos:notation 'SDN:L13::MP'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L13/current/MW/1/> .
<http://vocab.nerc.ac.uk/collection/L13/current/MW/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L13/current/MW/>;
    dc:modified '2006-11-15T08:15:00'^^xsd:dateTime ;
    skos:altLabel 'mesopelagic'^^xsd:string ;
    skos:prefLabel 'mesopelagic water column'@en ;
    skos:definition 'The water column zone penetrated by light, but in insufficient quantities for photosynthesis. Typically between depths of approximately 200 metres and 1000 metres.'@en ;
    skos:notation 'SDN:L13::MW'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L13/current/MS/1/> .
<http://vocab.nerc.ac.uk/collection/L13/current/MS/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L13/current/MS/>;
    dc:modified '2006-11-15T08:15:00'^^xsd:dateTime ;
    skos:altLabel 'mesosphere'^^xsd:string ;
    skos:prefLabel 'mesosphere'@en ;
    skos:definition 'The layer of atmosphere overlying the stratospause characterised by decreasing temperature with height, typically from about 50 to about 80 km'@en ;
    skos:notation 'SDN:L13::MS'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L13/current/SP/1/> .
<http://vocab.nerc.ac.uk/collection/L13/current/SP/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L13/current/SP/>;
    dc:modified '2006-11-15T08:15:00'^^xsd:dateTime ;
    skos:altLabel 'stratopause'^^xsd:string ;
    skos:prefLabel 'stratopause'@en ;
    skos:definition 'The boundary between the stratosphere and the mesosphere characterised by a temperature maximum. Typically at about 50 km.'@en ;
    skos:notation 'SDN:L13::SP'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L13/current/SS/1/> .
<http://vocab.nerc.ac.uk/collection/L13/current/SS/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L13/current/SS/>;
    dc:modified '2006-11-15T08:15:00'^^xsd:dateTime ;
    skos:altLabel 'stratosphere'^^xsd:string ;
    skos:prefLabel 'stratosphere'@en ;
    skos:definition 'The layer of the atmosphere from the tropopause to a height of approximately 50 km, characterised by increasing temperature with height.'@en ;
    skos:notation 'SDN:L13::SS'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L13/current/TZ/1/> .
<http://vocab.nerc.ac.uk/collection/L13/current/TZ/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L13/current/TZ/>;
    dc:modified '2006-11-15T08:15:00'^^xsd:dateTime ;
    skos:altLabel 'thermopause'^^xsd:string ;
    skos:prefLabel 'thermopause'@en ;
    skos:definition 'The boundary between the thermosphere and the exosphere. Typically at about 400 km.'@en ;
    skos:notation 'SDN:L13::TZ'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L13/current/TS/1/> .
<http://vocab.nerc.ac.uk/collection/L13/current/TS/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L13/current/TS/>;
    dc:modified '2006-11-15T08:15:00'^^xsd:dateTime ;
    skos:altLabel 'thermosphere'^^xsd:string ;
    skos:prefLabel 'thermosphere'@en ;
    skos:definition 'The atmospheric layer extending between heights of approximately 80 km to approximately 400 km characterised by rising temperature with height and phenomena associated with ionisation.  Part of the thermosphere is sometimes termed the ionosphere.'@en ;
    skos:notation 'SDN:L13::TS'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L13/current/TP/1/> .
<http://vocab.nerc.ac.uk/collection/L13/current/TP/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L13/current/TP/>;
    dc:modified '2006-11-15T08:15:00'^^xsd:dateTime ;
    skos:altLabel 'tropopause'^^xsd:string ;
    skos:prefLabel 'tropopause'@en ;
    skos:definition 'The boundary between the troposphere and stratosphere, characterized by change in temperature gradient with height from decreasing below to increasing above. May extend over a few km in height. Typically lies somewhere between 10 and 15 km.'@en ;
    skos:notation 'SDN:L13::TP'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L13/current/TH/1/> .
<http://vocab.nerc.ac.uk/collection/L13/current/TH/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L13/current/TH/>;
    dc:modified '2006-11-15T08:15:00'^^xsd:dateTime ;
    skos:altLabel 'troposphere'^^xsd:string ;
    skos:prefLabel 'troposphere'@en ;
    skos:definition 'The  lowest broad layer of the atmosphere characterised by decreasing avearage temperature with height.  Typically from the surface to between 10 and 15 km.'@en ;
    skos:notation 'SDN:L13::TH'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L13/current/UK/1/> .
<http://vocab.nerc.ac.uk/collection/L13/current/UK/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L13/current/UK/>;
    dc:modified '2006-11-15T08:15:00'^^xsd:dateTime ;
    skos:altLabel 'unknown'^^xsd:string ;
    skos:prefLabel 'unknown'@en ;
    skos:definition 'The correct value is not known to, and not computable by, the sender of this data. However, a correct value probably exists.'@en ;
    skos:notation 'SDN:L13::UK'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L13/current/U1/1/> .
<http://vocab.nerc.ac.uk/collection/L13/current/U1/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L13/current/U1/>;
    dc:modified '2006-11-15T08:15:00'^^xsd:dateTime ;
    skos:altLabel 'upper_epipelagic'^^xsd:string ;
    skos:prefLabel 'upper epipelagic water column'@en ;
    skos:definition 'The strongly illuminated upper half of the epipelagic zone. Typically from the surface down to a depth of approximately 100 metres.'@en ;
    skos:notation 'SDN:L13::U1'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L13/current/WC/1/> .
<http://vocab.nerc.ac.uk/collection/L13/current/WC/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L13/current/WC/>;
    dc:modified '2006-11-15T08:15:00'^^xsd:dateTime ;
    skos:altLabel 'water_column'^^xsd:string ;
    skos:prefLabel 'water column'@en ;
    skos:definition 'The entire body of water between the bed and the atmosphere.'@en ;
    skos:notation 'SDN:L13::WC'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L13/current/NS/1/> .
<http://vocab.nerc.ac.uk/collection/L13/current/NS/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L13/current/NS/>;
    dc:modified '2006-11-15T08:15:00'^^xsd:dateTime ;
    skos:altLabel 'water_column_boundary'^^xsd:string ;
    skos:prefLabel 'water column boundary layer'@en ;
    skos:definition 'The zone of the water column that is significantly influenced by the atmosphere. Typically the top 10m of the water column.'@en ;
    skos:notation 'SDN:L13::NS'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L13/current/WS/1/> .
<http://vocab.nerc.ac.uk/collection/L13/current/WS/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L13/current/WS/>;
    dc:modified '2006-11-15T08:15:00'^^xsd:dateTime ;
    skos:altLabel 'water_column_skin'^^xsd:string ;
    skos:prefLabel 'water column skin'@en ;
    skos:definition 'The zone a few microns thick at the extreme surface of the water column that is sampled by radiometers.'@en ;
    skos:notation 'SDN:L13::WS'^^xsd:string .
