<>
    a tree:Node
     ;
    tree:relation [
      a tree:LessThanRelation ;
      tree:node <https://kgfixed.github.io/vocab.nerc.ac.uk/L13/2006_01_01_00_00_00_2006_12_31_23_59_59.ttl> ;
      tree:path dc:modified ;
      tree:value '2010-12-31T23:59:59'^^xsd:dateTime
    ]
     .

<feed>
  a ldes:EventStream ;
  ldes:timestampPath dc:modified ;
  ldes:versionOfPath dc:isVersionOf ;
  
  
  tree:shape [
    a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path dc:isVersionOf
    ],
    [
      sh:datatype xsd:dateTime ;
      sh:minCount 1 ;
      sh:path dc:modified
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:altLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:prefLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:definition
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:notation
    ];
    sh:targetClass skos:Concept
  ] ;
  tree:view <> ;
  .

<feed> tree:member <http://vocab.nerc.ac.uk/collection/L13/current/SB/1/> .
<http://vocab.nerc.ac.uk/collection/L13/current/SB/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L13/current/SB/>;
    dc:modified '2010-05-17T15:28:38'^^xsd:dateTime ;
    skos:altLabel 'sediment_boundary'^^xsd:string ;
    skos:prefLabel 'soil and sediment boundary layer'@en ;
    skos:definition 'The upper surface (interface plus surficial substrate) of the layer of unlithified sediments (of any grain size from silt to boulders) that form a layer between the solid crust and either the atmosphere or the water column.'@en ;
    skos:notation 'SDN:L13::SB'^^xsd:string .
