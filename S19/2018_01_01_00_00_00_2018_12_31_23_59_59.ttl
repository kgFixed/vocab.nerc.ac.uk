    skos:definition 'A wave sample subset with periods in the range 2-5 seconds (higher frequency than wind sea).'@en ;
    skos:notation 'SDN:S19::S1901214'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S19/current/S1901217/2/> .
<http://vocab.nerc.ac.uk/collection/S19/current/S1901217/2/>
    a skos:Concept ;
