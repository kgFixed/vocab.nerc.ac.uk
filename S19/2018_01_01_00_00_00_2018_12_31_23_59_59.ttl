    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S19/current/S1901219/>;
    dc:modified '2018-06-10T17:56:55'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'swell'@en ;
    skos:definition 'A wave sample subset comprising waves that originated a significant distance away from the measurement site whose direction is not governed by the wind field at that site. They are characterised by long periods, low velocity and a limited directional spread.'@en ;
    skos:notation 'SDN:S19::S1901219'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S19/current/S1901220/2/> .
