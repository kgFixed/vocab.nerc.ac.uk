    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'infragravity'@en ;
    skos:definition 'A wave sample subset comprising the low frequency waves with a typical period of 25-250 seconds.'@en ;
    skos:notation 'SDN:S19::S1901217'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S19/current/S1901218/2/> .
<http://vocab.nerc.ac.uk/collection/S19/current/S1901218/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S19/current/S1901218/>;
    dc:modified '2018-06-10T17:56:55'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'wind sea'@en ;
    skos:definition 'A wave sample subset comprising waves in the vicinity of the measurement site whose direction is governed by the wind field at that site. They are characterised by short periods and a broad directional spread.'@en ;
    skos:notation 'SDN:S19::S1901218'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S19/current/S1901219/2/> .
