    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'swell first component'@en ;
    skos:definition 'A wave sample subset comprising a subset of the swell waves. Definition in terms of frequency band may differ between datasets.'@en ;
    skos:notation 'SDN:S19::S1901220'^^xsd:string .
