    skos:altLabel 'includes'^^xsd:string ;
    skos:prefLabel 'includes'@en ;
    skos:definition 'The subject is made up in part by the object'@en ;
    skos:notation 'SDN:C60::INC'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/C60/current/COM/2/> .
