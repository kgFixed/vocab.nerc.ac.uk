@base <https://kgfixed.github.io/vocab.nerc.ac.uk/C60/2008_01_01_00_00_00_2008_12_31_23_59_59.ttl> .

<>
    a tree:Node
     ;
    tree:relation [
      a tree:LessThanRelation ;
      tree:node <https://kgfixed.github.io/vocab.nerc.ac.uk/C60/2007_01_01_00_00_00_2007_12_31_23_59_59.ttl> ;
      tree:path dc:modified ;
      tree:value '2008-12-31T23:59:59'^^xsd:dateTime
    ]
     .

<feed>
  a ldes:EventStream ;
  ldes:timestampPath dc:modified ;
  ldes:versionOfPath dc:isVersionOf ;
  
  
  tree:shape [
    a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path dc:isVersionOf
    ],
    [
      sh:datatype xsd:dateTime ;
      sh:minCount 1 ;
      sh:path dc:modified
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:altLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:prefLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:definition
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:notation
    ];
    sh:targetClass skos:Concept
  ] ;
  tree:view <> ;
  .

<feed> tree:member <http://vocab.nerc.ac.uk/collection/C60/current/PRE/1/> .
<http://vocab.nerc.ac.uk/collection/C60/current/PRE/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/C60/current/PRE/>;
    dc:modified '2008-09-08T16:24:37'^^xsd:dateTime ;
    skos:altLabel 'predecessorOf'^^xsd:string ;
    skos:prefLabel 'predecessor-of'@en ;
    skos:definition 'The subject is an activity passing attributes to the object whose finish is required for the object to start'@en ;
    skos:notation 'SDN:C60::PRE'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/C60/current/SUC/2/> .
<http://vocab.nerc.ac.uk/collection/C60/current/SUC/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/C60/current/SUC/>;
    dc:modified '2008-09-08T16:24:10'^^xsd:dateTime ;
    skos:altLabel 'successorTo'^^xsd:string ;
    skos:prefLabel 'successor-to'@en ;
    skos:definition 'The subject is an activity inheriting attributes from the object whose start depends on the finish of the object'@en ;
    skos:notation 'SDN:C60::SUC'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/C60/current/CMP/1/> .
<http://vocab.nerc.ac.uk/collection/C60/current/CMP/1/>
