    skos:altLabel 'complements'^^xsd:string ;
    skos:prefLabel 'complements'@en ;
    skos:definition 'The subject shares enough attributes with the object that it is probable both will be of equal interest to a user or customer'@en ;
    skos:notation 'SDN:C60::CMP'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/C60/current/INC/1/> .
