@prefix tree: <https://w3id.org/tree#> .
@prefix ldes: <https://w3id.org/ldes#> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

@base <https://kgfixed.github.io/vocab.nerc.ac.uk/EF1/2023_01_01_00_00_00_2023_12_31_23_59_59.ttl> .

<>
    a tree:Node
     .

<feed>
  a ldes:EventStream ;
  ldes:timestampPath dc:modified ;
  ldes:versionOfPath dc:isVersionOf ;
  
  
  tree:shape [
    a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path dc:isVersionOf
    ],
    [
      sh:datatype xsd:dateTime ;
      sh:minCount 1 ;
      sh:path dc:modified
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:altLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:prefLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:definition
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:notation
    ];
    sh:targetClass skos:Concept
  ] ;
  tree:view <> ;
  .

<feed> tree:member <http://vocab.nerc.ac.uk/collection/EF1/current/SwG/1/> .
<http://vocab.nerc.ac.uk/collection/EF1/current/SwG/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/EF1/current/SwG/>;
    dc:modified '2023-09-05T16:33:09'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Spawning grounds'@en ;
    skos:definition 'Areas where there is clear evidence of spawning activity, including areas of known spawning aggregations or with high concentration of eggs.'@en ;
    skos:notation 'SDN:EF1::SwG'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/EF1/current/NuG/1/> .
<http://vocab.nerc.ac.uk/collection/EF1/current/NuG/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/EF1/current/NuG/>;
    dc:modified '2023-09-05T16:33:08'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Nursery grounds'@en ;
    skos:definition 'Areas where there is clear evidence of heavy concentrations of fish below minimum conservation reference size.'@en ;
    skos:notation 'SDN:EF1::NuG'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/EF1/current/MiC/1/> .
<http://vocab.nerc.ac.uk/collection/EF1/current/MiC/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/EF1/current/MiC/>;
    dc:modified '2023-09-05T16:33:07'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Migration corridors'@en ;
    skos:definition 'Routes heavily used by highly mobile species between seasonal habitats during their lifecycle.'@en ;
    skos:notation 'SDN:EF1::MiC'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/EF1/current/FeeG/1/> .
<http://vocab.nerc.ac.uk/collection/EF1/current/FeeG/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/EF1/current/FeeG/>;
    dc:modified '2023-09-05T16:33:05'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Feeding/foraging grounds'@en ;
    skos:definition 'Areas where there is clear evidence that they are favorite feeding grounds, leading to important fish aggregations.'@en ;
    skos:notation 'SDN:EF1::FeeG'^^xsd:string .
