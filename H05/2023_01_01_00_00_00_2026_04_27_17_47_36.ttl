<feed> tree:member <http://vocab.nerc.ac.uk/collection/H05/current/H0500029/1/> .
<http://vocab.nerc.ac.uk/collection/H05/current/H0500029/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/H05/current/H0500029/>;
    dc:modified '2026-03-20T09:30:16'^^xsd:dateTime ;
    skos:altLabel 'PVC'^^xsd:string ;
    skos:prefLabel 'polyvinyl chloride'@en ;
    skos:definition 'The litter material is made of polyvinyl chloride, a widely used synthetic thermoplastic polymer derived from chlorine (salt) and carbon (from oil or gas) that exists in rigid and flexible forms (with the addition of plasticizers). It is used in a wide range of applications.'@en ;
    skos:notation 'SDN:H05::H0500029'^^xsd:string .
