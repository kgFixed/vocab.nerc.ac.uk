    skos:prefLabel 'Sea-level rise'@en ;
    skos:definition 'Changes to the Antarctic and Greenland ice sheets affects sea level all over the world.'@en ;
    skos:notation 'SDN:T01::0b473850-67b5-49ab-9118-c13956185ddd'^^xsd:string .
