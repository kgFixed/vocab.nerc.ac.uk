<feed> tree:member <http://vocab.nerc.ac.uk/collection/T01/current/7916ed55-664b-4d06-8ce4-335dd61badef/1/> .
<http://vocab.nerc.ac.uk/collection/T01/current/7916ed55-664b-4d06-8ce4-335dd61badef/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/T01/current/7916ed55-664b-4d06-8ce4-335dd61badef/>;
    dc:modified '2020-05-05T18:24:43'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Ice & ice-movement'@en ;
    skos:definition '"Over the past 40 years, ice cores have revealed more about climate change than any other scientific technique. Over the last few decades, satellites have detected changes to the amount of sea ice that covers the polar oceans. Since 1979 summer sea-ice extent in the Arctic has reduced at 10% per decade. Some major glaciers that drain the Antarctic and Greenland ice sheets have accelerated by as much as 50%."'@en ;
    skos:notation 'SDN:T01::7916ed55-664b-4d06-8ce4-335dd61badef'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/T01/current/7a7193f4-7826-4abf-b8d2-c56ff209fb2b/1/> .
