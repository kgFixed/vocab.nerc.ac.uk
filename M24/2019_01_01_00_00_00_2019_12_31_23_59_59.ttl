<feed> tree:member <http://vocab.nerc.ac.uk/collection/M24/current/SSIGSESTGS/1/> .
<http://vocab.nerc.ac.uk/collection/M24/current/SSIGSESTGS/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/M24/current/SSIGSESTGS/>;
    dc:modified '2019-11-26T11:41:44'^^xsd:dateTime ;
    skos:altLabel 'SS.IGS.EstGS'^^xsd:string ;
    skos:prefLabel 'Estuarine sublittoral gravels and sands'@en ;
    skos:definition 'Estuarine sublittoral gravels and sands'@en ;
