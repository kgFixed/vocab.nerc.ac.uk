    skos:prefLabel 'Infralittoral rock (and other hard substrata)'@en ;
    skos:definition 'Infralittoral rock (and other hard substrata)'@en ;
    skos:notation 'SDN:M24::IR'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/M24/current/IREIR/1/> .
<http://vocab.nerc.ac.uk/collection/M24/current/IREIR/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/M24/current/IREIR/>;
