<http://vocab.nerc.ac.uk/collection/M24/current/LSLMSMS/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/M24/current/LSLMSMS/>;
    dc:modified '2019-11-26T11:41:44'^^xsd:dateTime ;
    skos:altLabel 'LS.LMS.MS'^^xsd:string ;
