    skos:definition '{"Bottled": "08/01/1991", "Analysis_URL": "http://cdiac.esd.ornl.gov/oceans/Dickson_CRM/rmdata/batch03.pdf", "Comments": "The measured values of total dissolved inorganic carbon and of total alkalinity changed with time, probably due to the effects of microbial growth in the bottles. This batch was not certified as reference materials."}'@en ;
    skos:notation 'SDN:B02::M000003'^^xsd:string .
