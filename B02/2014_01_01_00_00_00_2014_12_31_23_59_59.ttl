    skos:definition '{"Bottled": "07/05/1991", "Analysis_URL": "http://cdiac.esd.ornl.gov/oceans/Dickson_CRM/rmdata/batch05.pdf", "Comments": "The measured values of total dissolved inorganic carbon and of total alkalinity changed with time, probably due to the effects of microbial growth in the bottles. This batch was not certified as reference materials."}'@en ;
    skos:notation 'SDN:B02::M000005'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/B02/current/M000006/1/> .
<http://vocab.nerc.ac.uk/collection/B02/current/M000006/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/B02/current/M000006/>;
    dc:modified '2014-03-11T14:05:46'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'SIO-Batch006'@en ;
    skos:definition '{"Bottled": "22/05/1991", "Analysis_URL": "http://cdiac.esd.ornl.gov/oceans/Dickson_CRM/rmdata/batch06.pdf", "Comments": "Total alkalinity was not measured when the batch was originally certified; the total alkalinity value is based on measurements performed on archived samples of the batch. This batch was a synthetic solution of sodium bicarbonate in sodium chloride prepared directly in the holding tank by diluting concentrated, filtered solutions of the two salts with deionized (Milli-Q®) water. The salinity value was assigned so as to allow the correct density at 20oC to be calculated using the density-salinity relationship for sea water."}'@en ;
    skos:notation 'SDN:B02::M000006'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/B02/current/M000007/1/> .
<http://vocab.nerc.ac.uk/collection/B02/current/M000007/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/B02/current/M000007/>;
    dc:modified '2014-03-11T14:05:46'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'SIO-Batch007'@en ;
    skos:definition '{"Bottled": "08/08/1991", "Analysis_URL": "http://cdiac.esd.ornl.gov/oceans/Dickson_CRM/rmdata/batch07.pdf", "Comments": "This batch was a synthetic solution of sodium bicarbonate in sodium chloride prepared directly in the holding tank by diluting concentrated, filtered solutions of the two salts with deionized (Milli-Q®) water. The salinity value was assigned so as to allow the correct density at 20oC to be calculated using the density-salinity relationship for sea water. Total alkalinity was not measured as archived samples were not available; value is expected to have been stable."}'@en ;
    skos:notation 'SDN:B02::M000007'^^xsd:string .
