    dc:modified '2011-08-15T11:58:51'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Relocation'@en ;
    skos:definition 'Act of moving critical infrastructure or other development out of harms way when a hazard is know to occur in a particular location.'@en ;
    skos:notation 'SDN:A02::Relocation'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A02/current/ResearchReserves/1/> .
<http://vocab.nerc.ac.uk/collection/A02/current/ResearchReserves/1/>
    a skos:Concept ;
