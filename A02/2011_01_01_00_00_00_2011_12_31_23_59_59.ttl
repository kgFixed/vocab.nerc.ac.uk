    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Shellfish'@en ;
    skos:definition 'Refers most commonly to bivalves such as clams, oysters or mussels.'@en ;
    skos:notation 'SDN:A02::Shellfish'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A02/current/ShellfishHarvestBan/1/> .
<http://vocab.nerc.ac.uk/collection/A02/current/ShellfishHarvestBan/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A02/current/ShellfishHarvestBan/>;
    dc:modified '2011-08-15T11:58:51'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Shellfish harvest ban'@en ;
    skos:definition 'From time to time the state may ban the harvesting of shellfish due to elevated potential for paralytic shellfish poisoning. A closure would includes shellfish on beaches, rocks, jetties and at the entrances to bays. Shellfish contaminated with PSP toxins can cause minor to severe illness or even death to people who eat them.'@en ;
    skos:notation 'SDN:A02::ShellfishHarvestBan'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A02/current/Shelters/1/> .
<http://vocab.nerc.ac.uk/collection/A02/current/Shelters/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A02/current/Shelters/>;
    dc:modified '2011-08-15T11:58:51'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Emergency Shelters'@en ;
    skos:definition 'Safe locations designated by local or regional authorities as places where evacuees may receive temporary food, shelter, and other emergency services.'@en ;
    skos:notation 'SDN:A02::Shelters'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A02/current/ShoreProtectiveStructureEligibility/1/> .
<http://vocab.nerc.ac.uk/collection/A02/current/ShoreProtectiveStructureEligibility/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A02/current/ShoreProtectiveStructureEligibility/>;
    dc:modified '2011-08-15T11:58:51'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Shore Protective Structure Eligibility'@en ;
    skos:definition 'The status of whether or not a parcel is eligible for a permit to construct a shore protective structure. Cirteria for eligibility are stated in Goal 18.'@en ;
    skos:notation 'SDN:A02::ShoreProtectiveStructureEligibility'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A02/current/ShoreProtectiveStructures/1/> .
<http://vocab.nerc.ac.uk/collection/A02/current/ShoreProtectiveStructures/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A02/current/ShoreProtectiveStructures/>;
    dc:modified '2011-08-15T11:58:51'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Shoreline Protective Structures'@en ;
    skos:definition 'Structures built to "armour" the shoreline against erosion caused by wave attack.'@en ;
    skos:notation 'SDN:A02::ShoreProtectiveStructures'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A02/current/ShorelandManagementUnits/1/> .
<http://vocab.nerc.ac.uk/collection/A02/current/ShorelandManagementUnits/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A02/current/ShorelandManagementUnits/>;
    dc:modified '2011-08-15T11:58:51'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Shoreland management units'@en ;
    skos:definition 'Goal 17 requires that cities and counties establish a "coastal shoreland boundary" on lands bordering coastal waters, including estuaries. Lands within the boundary are to be planned and managed to recognize their relationship with, and importance to, coastal waters. The coastal shorelands boundary around estuaries must be a minimum of fifty feet upland of the estuary shoreline. The shoreline, or the upper limit of the estuary, is either the line of nonaquatic vegetation or mean higher high water, whichever is higher. The boundary must extend upland to include the following areas and resources: * Areas subject to ocean flooding; * Areas of geologic instability; * Riparian vegetation; * Significant shoreland and wetland biological habitats; * Areas needed for water-dependent and water-related uses, including dredged material disposal and mitigation sites; and * Areas of exceptional aesthetic or scenic quality.'@en ;
    skos:notation 'SDN:A02::ShorelandManagementUnits'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A02/current/ShorelandOverlays/1/> .
<http://vocab.nerc.ac.uk/collection/A02/current/ShorelandOverlays/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A02/current/ShorelandOverlays/>;
    dc:modified '2011-08-15T11:58:51'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Shoreland Overlays'@en ;
    skos:definition 'Coastal Shorelands in Oregon are defined as Those areas immediately adjacent to the ocean, all estuaries and associated wetlands, and all coastal lakes.'@en ;
    skos:notation 'SDN:A02::ShorelandOverlays'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A02/current/ShorelineEmergencyAccess/1/> .
<http://vocab.nerc.ac.uk/collection/A02/current/ShorelineEmergencyAccess/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A02/current/ShorelineEmergencyAccess/>;
    dc:modified '2011-08-15T11:58:51'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Shoreline Emergency Access'@en ;
    skos:definition 'Location of coastal access which is capable of allowing access to the beach/shoreline or water for various forms of emergency rescue vehicles/equipment.'@en ;
    skos:notation 'SDN:A02::ShorelineEmergencyAccess'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A02/current/SmallCraftAdvisory/1/> .
<http://vocab.nerc.ac.uk/collection/A02/current/SmallCraftAdvisory/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A02/current/SmallCraftAdvisory/>;
    dc:modified '2011-08-15T11:58:51'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Small Craft Advisory'@en ;
    skos:definition 'The Small Craft Advisory is a U.S. Coast Guard warning to small craft boaters in Coastal Waters and Nearshore areas of forecasts for sustained winds, frequent gusts, or sea/wave conditions that could be hazardous to small boats. On the west coast of the U.S. this type of advisory is issued when conditions exceed a threshold of sustained winds of 21 to 33 knots, potentially in combination with wave heights exceeding 10 feet.'@en ;
    skos:notation 'SDN:A02::SmallCraftAdvisory'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A02/current/Soil/1/> .
