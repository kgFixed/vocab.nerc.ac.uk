    dc:modified '2011-08-15T11:58:51'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Gravel beach'@en ;
    skos:definition 'Beach composed of gravel: loose rock that is larger than two millimeters (2mm) in its largest dimension (about 1/12 of an inch) and no more than 63 millimeters (about 2.5 inches)'@en ;
    skos:notation 'SDN:A02::Gravel'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A02/current/HabitatRefuge/1/> .
<http://vocab.nerc.ac.uk/collection/A02/current/HabitatRefuge/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A02/current/HabitatRefuge/>;
    dc:modified '2011-08-15T11:58:51'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Habitat Refuge'@en ;
    skos:definition 'Habitat Refuges are areas that are needed to maintain the health of the rocky shore ecosystem. While protection of habitat values of individual sites is important, protection of the aggregate of all sites is essential.'@en ;
    skos:notation 'SDN:A02::HabitatRefuge'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A02/current/HazardEducationOutreach/1/> .
