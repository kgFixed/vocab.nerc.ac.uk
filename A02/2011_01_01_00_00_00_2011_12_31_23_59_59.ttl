    dc:modified '2011-08-15T11:58:51'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Marine Protected Area'@en ;
    skos:definition 'Marine Protected Area (MPA) is often used as an umbrella term covering a wide range of marine areas with some level of restriction to protect living, non-living, cultural, and/or historic resources'@en ;
    skos:notation 'SDN:A02::MarineProtectedArea'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A02/current/MarineTransportationInfrastructure/1/> .
