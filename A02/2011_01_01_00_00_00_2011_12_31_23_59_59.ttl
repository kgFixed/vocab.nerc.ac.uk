    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Evacuation Route'@en ;
    skos:definition 'The path designated for the safest routes away from an emergency situation.'@en ;
    skos:notation 'SDN:A02::Routes'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A02/current/SeaLevelRise/1/> .
