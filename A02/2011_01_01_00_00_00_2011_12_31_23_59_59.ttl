    skos:notation 'SDN:A02::WildernessAreas'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A02/current/Winds/1/> .
<http://vocab.nerc.ac.uk/collection/A02/current/Winds/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A02/current/Winds/>;
    dc:modified '2011-08-15T11:58:51'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Winds'@en ;
    skos:definition 'Wind is the flow of atmospheric air over the earth\'s surface. When a difference in pressure exists between two adjacent air masses, the air tends to flow from the region of high pressure to the region of low pressure.'@en ;
    skos:notation 'SDN:A02::Winds'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A02/current/Zones/1/> .
