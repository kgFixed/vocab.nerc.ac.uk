    skos:notation 'SDN:A02::Water'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A02/current/Watershed/1/> .
<http://vocab.nerc.ac.uk/collection/A02/current/Watershed/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A02/current/Watershed/>;
