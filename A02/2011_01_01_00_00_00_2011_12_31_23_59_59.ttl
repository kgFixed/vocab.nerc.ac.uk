    dc:modified '2011-08-15T11:58:51'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Indian Reservations'@en ;
    skos:definition 'Reservations (or Trust Lands) are areas of land managed by Native American tribes under the United States Department of the Interior\'s Bureau of Indian Affairs, within which Tribes have a form of sovereignty that allows for laws within the reservation to differ from those in the surrounding area.'@en ;
    skos:notation 'SDN:A02::Reservations'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A02/current/RipRap/1/> .
<http://vocab.nerc.ac.uk/collection/A02/current/RipRap/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A02/current/RipRap/>;
    dc:modified '2011-08-15T11:58:51'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'RipRap'@en ;
    skos:definition 'RipRap is large rock or other material used to armor shorelines against erosion. Riprap reduces erosion by resisting the forces of hydraulic attack and dissipating the energy of flowing water or waves.'@en ;
    skos:notation 'SDN:A02::RipRap'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A02/current/RiversStreams/1/> .
