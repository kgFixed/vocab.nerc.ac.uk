    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Rivers and Streams'@en ;
    skos:definition 'A stream is a body of water with a current, confined within a bed and stream-banks. A river is a natural stream of water, usually freshwater, flowing toward an ocean, a lake, or another stream.'@en ;
    skos:notation 'SDN:A02::RiversStreams'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A02/current/RoadTransportationInfrastructure/1/> .
