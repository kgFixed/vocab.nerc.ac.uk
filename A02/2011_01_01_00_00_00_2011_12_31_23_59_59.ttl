    skos:notation 'SDN:A02::HighSurfAdvisory'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A02/current/Hospital/1/> .
<http://vocab.nerc.ac.uk/collection/A02/current/Hospital/1/>
