    skos:notation 'SDN:A02::Reef'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A02/current/RelativeErosionRiskZones/1/> .
<http://vocab.nerc.ac.uk/collection/A02/current/RelativeErosionRiskZones/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A02/current/RelativeErosionRiskZones/>;
    dc:modified '2011-08-15T11:58:51'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Relative Erosion Risk Zones'@en ;
    skos:definition 'These erosion risk zone mapping focuses on identifying minimum and maximum potential erosion distances for bluffs and dune backed shorelines. For both bluff and dune backed beaches, four zones are defined, an active hazard zone characterized by existing, active erosion processes, and three zones of potential future erosion, high, moderate, and low risk zones that respectively depict decreasing risks of becoming active in the future.'@en ;
    skos:notation 'SDN:A02::RelativeErosionRiskZones'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A02/current/Relocation/1/> .
