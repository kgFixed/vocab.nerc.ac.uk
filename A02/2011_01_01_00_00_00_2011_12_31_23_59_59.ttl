    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Research Reserve'@en ;
    skos:definition 'Research Reserves are needed to identify and manage areas suitable or being used for scientific study or research including baseline study, monitoring, or applied research. However, designation of Research Reserves is not intended to limit research or study exclusively to these areas.'@en ;
    skos:notation 'SDN:A02::ResearchReserves'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A02/current/Reservations/1/> .
