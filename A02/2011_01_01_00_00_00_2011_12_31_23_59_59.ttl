    dc:modified '2011-08-15T11:58:51'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Roads'@en ;
    skos:definition 'A road is an identifiable route, way or path between two or more places. Roads are typically smoothed, paved, or otherwise prepared to allow easy travel.'@en ;
    skos:notation 'SDN:A02::RoadTransportationInfrastructure'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A02/current/RockyIntertidal/1/> .
<http://vocab.nerc.ac.uk/collection/A02/current/RockyIntertidal/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A02/current/RockyIntertidal/>;
    dc:modified '2011-08-15T11:58:51'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Rocky Intertidal'@en ;
    skos:definition 'Rocky shoreline areas that fall between the lowest and highest tidelines. haracterized by high wave action, constant submersion and exposure, changing temperature and salinity, and the occurrence of tidepools.'@en ;
    skos:notation 'SDN:A02::RockyIntertidal'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A02/current/RockyShore/1/> .
<http://vocab.nerc.ac.uk/collection/A02/current/RockyShore/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A02/current/RockyShore/>;
    dc:modified '2011-08-15T11:58:51'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Rocky Shore'@en ;
    skos:definition 'Rocky shores are areas of bedrock exposed between the extreme high and extreme low tide levels on the seashore.'@en ;
    skos:notation 'SDN:A02::RockyShore'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A02/current/Routes/1/> .
