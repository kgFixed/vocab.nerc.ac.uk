    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Dune'@en ;
    skos:definition 'A dune is a hill of sand built by aeolian processes. Coastal areas often have one or more sets of dunes running parallel to the shoreline directly inland from the beach. In most cases the dunes are important in protecting the land against potential ravages by storm waves from the sea.'@en ;
    skos:notation 'SDN:A02::Dune'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A02/current/DuneGrading/1/> .
<http://vocab.nerc.ac.uk/collection/A02/current/DuneGrading/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A02/current/DuneGrading/>;
    dc:modified '2011-08-15T11:58:51'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Dune Grading'@en ;
    skos:definition 'Lowering the elevation of the contours of a dune to prevent sand inundation of structures. Only allowed in areas committed to development or within an acknowledged urban growth boundary and only as part of an overall plan for managing foredune grading.'@en ;
    skos:notation 'SDN:A02::DuneGrading'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A02/current/DuneRestoration/1/> .
<http://vocab.nerc.ac.uk/collection/A02/current/DuneRestoration/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A02/current/DuneRestoration/>;
    dc:modified '2011-08-15T11:58:51'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Dune Restoration'@en ;
    skos:definition 'Dune protection and restoration usually involves a combination of sand fencing and planting of vegetation to stabilize the dune and to capture blowing sand to increase dune elevations.'@en ;
    skos:notation 'SDN:A02::DuneRestoration'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A02/current/EarthSurfaceGeology/1/> .
<http://vocab.nerc.ac.uk/collection/A02/current/EarthSurfaceGeology/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A02/current/EarthSurfaceGeology/>;
    dc:modified '2011-08-15T11:58:51'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Earth Surface Geology'@en ;
    skos:definition 'Earth surface geology studies the composition, structure, physical properties, history, and the processes that shape Earth\'s components'@en ;
    skos:notation 'SDN:A02::EarthSurfaceGeology'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A02/current/Education/1/> .
<http://vocab.nerc.ac.uk/collection/A02/current/Education/1/>
    a skos:Concept ;
