    skos:notation 'SDN:A02::Hospital'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A02/current/IntertidalWetlands/1/> .
<http://vocab.nerc.ac.uk/collection/A02/current/IntertidalWetlands/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A02/current/IntertidalWetlands/>;
    dc:modified '2011-08-15T11:58:51'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Intertidal Wetlands'@en ;
    skos:definition 'An intertidal wetland is an environment at the interface between truly terrestrial ecosystems and aquatic systems, in this case coastal tidal systems.'@en ;
    skos:notation 'SDN:A02::IntertidalWetlands'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A02/current/Jetties/1/> .
<http://vocab.nerc.ac.uk/collection/A02/current/Jetties/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A02/current/Jetties/>;
    dc:modified '2011-08-15T11:58:51'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Jetty'@en ;
    skos:definition 'A jetty is a shore-perpendicular manmade structure usually constructed from boulders, and typically placed at locations that require shoreline stabilization (such as on either side of a river mouth).'@en ;
    skos:notation 'SDN:A02::Jetties'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A02/current/Kelp/1/> .
<http://vocab.nerc.ac.uk/collection/A02/current/Kelp/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A02/current/Kelp/>;
    dc:modified '2011-08-15T11:58:51'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Kelp'@en ;
    skos:definition 'Kelp are large seaweeds (algae), belonging to the brown algae and classified in the order Laminariales. Kelp grows in underwater forests (kelp forests) in clear, shallow oceans, requiring cold nutrient-rich water.'@en ;
    skos:notation 'SDN:A02::Kelp'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A02/current/LIDARSurvey/1/> .
