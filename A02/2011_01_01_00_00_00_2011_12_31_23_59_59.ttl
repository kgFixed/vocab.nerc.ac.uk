    skos:notation 'SDN:A02::HazardEducationOutreach'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A02/current/HighSurfAdvisory/1/> .
<http://vocab.nerc.ac.uk/collection/A02/current/HighSurfAdvisory/1/>
