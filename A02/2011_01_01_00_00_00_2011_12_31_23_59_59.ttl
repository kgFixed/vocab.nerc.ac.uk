    dc:modified '2011-08-15T11:58:51'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Soil'@en ;
    skos:definition 'Soil is the naturally occurring, unconsolidated or loose covering of broken rock particles and decaying organic matter on the surface of the Earth, capable of supporting life.'@en ;
    skos:notation 'SDN:A02::Soil'^^xsd:string .
