    skos:notation 'SDN:A02::Zones'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A02/current/Zoning/1/> .
<http://vocab.nerc.ac.uk/collection/A02/current/Zoning/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A02/current/Zoning/>;
