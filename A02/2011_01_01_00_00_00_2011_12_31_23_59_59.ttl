    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A02/current/SeaLevelRise/>;
    dc:modified '2011-08-15T11:58:51'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Sea Level Rise'@en ;
    skos:definition 'Sea-level rise is an increase in sea level, relative to a suitable reference surface.'@en ;
    skos:notation 'SDN:A02::SeaLevelRise'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A02/current/Seawalls/1/> .
<http://vocab.nerc.ac.uk/collection/A02/current/Seawalls/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A02/current/Seawalls/>;
    dc:modified '2011-08-15T11:58:51'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Seawall'@en ;
    skos:definition 'A seawall is a form of hard coastal defence constructed to reduce the effects of strong waves in inland property.'@en ;
    skos:notation 'SDN:A02::Seawalls'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A02/current/SedimentSink/1/> .
<http://vocab.nerc.ac.uk/collection/A02/current/SedimentSink/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A02/current/SedimentSink/>;
    dc:modified '2011-08-15T11:58:51'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Seawall'@en ;
    skos:definition 'A Sediment sink is a location to which sediment is "lost" from a littoral cell budget, in the sense that it is removed to such a depth or distance that is cannot return to the littoral system through natural contidions. Bays, dunes, the offshore, dredging and mining sites are potential examples of sediment sinks.'@en ;
    skos:notation 'SDN:A02::SedimentSink'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A02/current/SedimentSource/1/> .
<http://vocab.nerc.ac.uk/collection/A02/current/SedimentSource/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A02/current/SedimentSource/>;
    dc:modified '2011-08-15T11:58:51'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Sediment Sink'@en ;
    skos:definition 'A sediment source is a location within a littoral cell system that feeds new sediment into the sediment budget of the cell. Rivers, bluffs, dunes, and the inner shelf are examples of potential sources of sediment.'@en ;
    skos:notation 'SDN:A02::SedimentSource'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A02/current/Sewage/1/> .
<http://vocab.nerc.ac.uk/collection/A02/current/Sewage/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A02/current/Sewage/>;
    dc:modified '2011-08-15T11:58:51'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Sewage'@en ;
    skos:definition 'Sewage treatment plants, or domestic wastewater treatment plants, perform the function of removing contaminants from wastewater, both runoff (effluents) and domestic.'@en ;
    skos:notation 'SDN:A02::Sewage'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A02/current/Shellfish/1/> .
<http://vocab.nerc.ac.uk/collection/A02/current/Shellfish/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A02/current/Shellfish/>;
