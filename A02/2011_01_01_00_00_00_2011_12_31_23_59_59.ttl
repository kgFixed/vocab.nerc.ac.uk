    skos:notation 'SDN:A02::Military'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A02/current/MixedSandGravel/1/> .
<http://vocab.nerc.ac.uk/collection/A02/current/MixedSandGravel/1/>
    a skos:Concept ;
