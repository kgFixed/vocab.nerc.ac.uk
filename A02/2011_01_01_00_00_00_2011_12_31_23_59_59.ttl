    skos:prefLabel 'LIDAR Surveys'@en ;
    skos:definition 'LIDAR (Light Detection and Ranging) is an optical remote sensing technology that measures properties of scattered light to find range and/or other information of a distant target.'@en ;
    skos:notation 'SDN:A02::LIDARSurvey'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A02/current/Lakes/1/> .
