    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Medium to Coarse-grained sandy beach'@en ;
    skos:definition 'Beach composed of meadium to coarse grained sand: In USA, sand is commonly divided into five sub-categories based on size: very fine sand (1/16 - 1/8 mm diameter), fine sand (1/8 mm - 1/4 mm), medium sand (1/4 mm - 1/2 mm), coarse sand (1/2 mm - 1 mm), and very coarse sand (1 mm - 2 mm).'@en ;
    skos:notation 'SDN:A02::MediumCoarse'^^xsd:string .
