      sh:minCount 1 ;
      sh:path skos:notation
    ];
    sh:targetClass skos:Concept
  ] ;
  tree:view <> ;
  .

<feed> tree:member <http://vocab.nerc.ac.uk/collection/A02/current/Hachery/2/> .
<http://vocab.nerc.ac.uk/collection/A02/current/Hachery/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A02/current/Hachery/>;
    dc:modified '2016-01-13T16:57:52'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Hatchery'@en ;
    skos:definition 'Fish Hatcheries are used to cultivate and breed a large number of fish in an enclosed environment, typically involving manual labor. Hatcheries release the juvenile fish into a river, lake or the ocean to support commercial, tribal, or recreational fishing or to supplement the natural numbers of threatened or endangered species.'@en ;
    skos:notation 'SDN:A02::Hachery'^^xsd:string .
