    skos:definition 'The average temperature measured during the measurement interval. Units: degrees Celsius; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000555'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000556/1/> .
