    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'animal status date'@en ;
    skos:definition 'The date for which \'animal status\' is valid in relation to the deployment. Example: \'2002-08-26\'; Format: yyyy-MM-dd; Units: date (time and time zone not specified); Entity described: deployment'@en ;
    skos:notation 'SDN:MVB::MVB000526'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000527/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000527/1/>
    a skos:Concept ;
