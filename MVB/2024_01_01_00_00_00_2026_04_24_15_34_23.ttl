    skos:prefLabel 'animal life stage'@en ;
    skos:definition 'The age class or life stage of the animal at the beginning of the deployment. Can be years or months of age or terms such as \'adult\', \'subadult\' and \'juvenile\'. Example: \'juvenile, adult\'; Units: not specified; Entity described: deployment'@en ;
    skos:notation 'SDN:MVB::MVB000018'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000555/1/> .
