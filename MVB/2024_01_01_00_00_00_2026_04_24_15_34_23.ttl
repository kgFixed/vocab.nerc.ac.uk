    skos:prefLabel 'Tinyfox VeDBA 22h ago'@en ;
    skos:definition 'The hourly vector of the dynamic body acceleration (VeDBA) recorded 22 hours before the timestamp. This is calculated as the sum of VeDBA values over 1-second acceleration bursts, recorded at 28 Hz, one time each minute. Example: \'7124\'; Units: m/s^2; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000517'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000518/1/> .
