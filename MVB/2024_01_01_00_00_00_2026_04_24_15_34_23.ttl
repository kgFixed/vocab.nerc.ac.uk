    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000556/>;
    dc:modified '2026-04-08T09:36:14'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'temperature min text'@en ;
    skos:definition 'The minimum temperature measured during the measurement interval. Values are stored as raw text values because non-numeric characters are used. Example: \'>10\'; Units: degrees Celsius; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000556'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000557/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000557/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000557/>;
    dc:modified '2026-04-08T09:36:14'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'VeDBA average'@en ;
    skos:definition 'The average VeDBA (vector of the dynamic body acceleration) over the measurement interval. Values are calculated from accelerometer data and provide a proxy for energy expenditure. Range and method of calculation may vary by the tag provider, model, settings and placement on the animal. Information about the calculations can be stored in \'DBA comments\'. Units: m/s^2; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000557'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000558/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000558/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000558/>;
    dc:modified '2026-04-08T09:36:14'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'VeDBA count'@en ;
    skos:definition 'The number of VeDBA (vector of the dynamic body acceleration) measurements taken over the measurement interval. Values are calculated from accelerometer data and provide a proxy for energy expenditure. Range and method of calculation may vary by the tag provider, model, settings and placement on the animal. Information about the calculations can be stored in \'DBA comments\'. Units: count; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000558'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000013/4/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000013/4/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000013/>;
    dc:modified '2024-10-14T10:18:31'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'animal death comments'@en ;
    skos:definition 'Comments about the death of the animal. Summary information can be reported in \'animal mortality date\', \'animal mortality latitude\', \'animal mortality longitude\', and \'animal mortality type\'. Example: \'hit by a car\'; Units: none; Entity described: individual'@en ;
    skos:notation 'SDN:MVB::MVB000013'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000311/2/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000311/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000311/>;
    dc:modified '2024-10-14T10:18:31'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'GMatrix is moving'@en ;
    skos:definition 'Whether the G-Matrix device is moving (definition from RAMAC CALLBACK Specification, v2.0.2, August 2021). Allowed values are A1 = true (moving) or 0 = false (static). Format: controlled list; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000311'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000474/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000474/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000474/>;
    dc:modified '2024-10-14T10:18:31'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'GSAT charge mode'@en ;
    skos:definition 'The average current from or to the battery since the previous transmission (definition from Global Satellite Engineeering, 2024). Allowed values are Discharge = battery is discharging (<0 mA); ChargeSlow = low charging (0-8 mA); ChargeMedium = medium charging (8-16 mA); ChargeHigh = high charging (>16 mA). Format: controlled list; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000474'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000475/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000475/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000475/>;
    dc:modified '2024-10-14T10:18:31'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'GSAT low power mode'@en ;
    skos:definition 'Whether low power mode was enabled at the time of transmission. Allowed values are TRUE or FALSE (definition from Global Satellite Engineeering, 2024). Units: none; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000475'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000480/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000480/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000480/>;
    dc:modified '2024-10-14T10:18:31'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'ATLAS varxy'@en ;
    skos:definition 'The x-y covariance, measure of the quality of the location estimate, calculated by the ATLAS system. Lower values indicate linear independence of the errors in the easting and northing directions. Example: \'3.64854761612132\'; Units: m^2; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000480'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000484/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000484/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000484/>;
    dc:modified '2024-10-14T10:18:31'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Sensolus location source'@en ;
    skos:definition 'The source of the location estimate from the Sensolus tag. Example: \'network\'; Units: none; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000484'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000515/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000515/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000515/>;
    dc:modified '2024-10-14T10:18:31'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Tinyfox VeDBA 20h ago'@en ;
    skos:definition 'The hourly vector of the dynamic body acceleration (VeDBA) recorded 20 hours before the timestamp. This is calculated as the sum of VeDBA values over 1-second acceleration bursts, recorded at 28 Hz, one time each minute. Example: \'5343\'; Units: m/s^2; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000515'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000516/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000516/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000516/>;
    dc:modified '2024-10-14T10:18:31'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Tinyfox VeDBA 21h ago'@en ;
    skos:definition 'The hourly vector of the dynamic body acceleration (VeDBA) recorded 21 hours before the timestamp. This is calculated as the sum of VeDBA values over 1-second acceleration bursts, recorded at 28 Hz, one time each minute. Example: \'3562\'; Units: m/s^2; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000516'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000517/1/> .
