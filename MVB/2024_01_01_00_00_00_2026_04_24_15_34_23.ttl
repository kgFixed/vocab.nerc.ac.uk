<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000291/3/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000291/3/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000291/>;
    dc:modified '2026-04-09T09:53:18'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Lotek fix status'@en ;
    skos:definition 'The type of GPS fix as provided by the Lotek tag. Example: \'4\'; Units: none; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000291'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000028/4/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000028/4/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000028/>;
    dc:modified '2026-04-08T09:36:15'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Argos calcul freq'@en ;
    skos:definition 'Calculated frequency, Argos diagnostic data. It should be between 401.620 and 401.680 MHz (definition from Argos User\'s Manual 2011). The \'401.\' is sometimes missing from the source data and should be added to the values for correct interpretation. Example: \'401.6732709\'; Units: MHz; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000028'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000067/4/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000067/4/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000067/>;
    dc:modified '2026-04-08T09:36:15'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'behavioural classification'@en ;
    skos:definition 'Behavioral classifications assigned to the animal. Information about the values and how they were obtained can be provided in \'behavior according to\'. Recommended best practice is to use a controlled list. Example: \'roosting, foraging, running\'; Units: none; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000067'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000170/9/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000170/9/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000170/>;
    dc:modified '2026-04-08T09:36:15'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'sensor type'@en ;
    skos:definition 'The type of sensor with which data were collected. All sensors are associated with a tag id, and tags can contain multiple sensor types. Each event record in Movebank is assigned one sensor type. If values from multiple sensors are reported in a single event, the primary sensor is used. Values are chosen from a controlled list: acceleration = The sensor collects acceleration data; accessory-measurements = The sensor collects accessory measurements, such as battery voltage; acoustic-telemetry = The sensor transmits an acoustic signal that is detected by receivers to determine location; argos-doppler-shift = The sensor location is estimated by Argos using Doppler shift; atlas-geolocation = The sensor location is estimated by an ATLAS system; barometer = The sensor records air or water pressure; bird-ring = The animal is identified by a band or ring that has a unique identifier; derived = Information is derived from other sensor data; geolocation-api = The location is determined based on detection by nearby cell towers or other wireless network connectors using the World Wide Web Consortium Geolocation API Recommendation; gnss = The sensor uses one or more global navigation satellite systems to determine location; gps = The sensor uses GPS to determine location; gyroscope = The sensor records angular velocity; heart-rate = The sensor records or is used to calculate heart rate; magnetometer = The sensor records the magnetic field; natural-mark = The animal is identified by a unique natural marking; orientation = Quaternion components describing the orientation of the tag are derived from accelerometer and gyroscope measurements; proximity = The sensor identifies proximity to other tags; radio-transmitter = The sensor transmits a radio signal that is detected by receivers to determine location; sigfox-geolocation = The sensor location is determined by Sigfox using the received signal strength indicator; solar-geolocator = The sensor collects light levels, which are used to determine position (for processed locations); solar-geolocator-raw = The sensor collects light levels, which are used to determine position (for raw light-level measurements); solar-geolocator-twilight = The sensor collects light levels, which are used to determine position (for twilights calculated from light-level measurements); tdr = The sensor is a time-depth recorder; thermometer = The sensor records temperature. Format: controlled list; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000170'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000215/2/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000215/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000215/>;
    dc:modified '2026-04-08T09:36:15'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'geolocator rise'@en ;
    skos:definition 'The period of day used to estimate location by geolocation. Allowed values are TRUE = sunrise, FALSE = sunset. Units: none; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000215'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000240/4/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000240/4/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000240/>;
    dc:modified '2026-04-08T09:36:15'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'timestamp first deployed location'@en ;
    skos:definition 'The timestamp of the first deployed location in the study. Values displayed in the study details on Movebank are calculated within minutes when changes are made. Values obtained through the REST API are calculated approximately daily. Example: \'2008-08-14 15:31:00.000\'; Format: yyyy-MM-dd HH:mm:ss.SSS; Units: UTC or GPS time; Entity described: study'@en ;
    skos:notation 'SDN:MVB::MVB000240'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000327/2/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000327/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000327/>;
    dc:modified '2026-04-08T09:36:15'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Sigfox link quality'@en ;
    skos:definition 'The integer value corresponding to the value in \'Sigfox LQI\', the computed link quality based on the received signal strength indicator (RSSI), the number of stations that received a message (receiver redundancy) and the radio configuration (RC) zone, due to the difference between the RCs (definition from Sigfox Support, 2022). Allowed values are 0 = Limit; 1 = Average; 2 = Good; 3 = Excellent; 4 = NA. Format: controlled list; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000327'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000416/2/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000416/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000416/>;
    dc:modified '2026-04-08T09:36:15'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'WildFi last error'@en ;
    skos:definition 'The error code of the WildFi internal diagnostic routine. If multiple errors have occurred during the current runtime (see \'error count\') this will indicate the type of the most recent error. Units: none; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000416'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000452/2/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000452/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000452/>;
    dc:modified '2026-04-08T09:36:15'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'LoRa SNR'@en ;
    skos:definition 'The SNR (signal-to-noise ratio) measured by the best LoRaWAN Gateway that received the data packet. Example: \'14\'; Units: dB; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000452'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000481/2/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000481/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000481/>;
    dc:modified '2026-04-08T09:36:15'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Lotek deltatime'@en ;
    skos:definition 'The difference between the fix time given by the satellite and that given by the internal tag clock. Example: \'-597\'; Units: seconds; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000481'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000519/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000519/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000519/>;
    dc:modified '2026-04-08T09:36:15'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'animal birth hatch year'@en ;
    skos:definition 'The year in which the animal is known or estimated to have been born or hatched. Example: \'2022\'; Units: year; Entity described: individual'@en ;
    skos:notation 'SDN:MVB::MVB000519'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000520/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000520/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000520/>;
    dc:modified '2026-04-08T09:36:15'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'animal age'@en ;
    skos:definition 'This known or estimated age of the animal at the beginning of the deployment, in years. Units: years; Entity described: deployment'@en ;
    skos:notation 'SDN:MVB::MVB000520'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000521/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000521/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000521/>;
    dc:modified '2026-04-08T09:36:15'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'animal age analytical'@en ;
    skos:definition 'The age of the animal at the beginning of the deployment, in years, based on forensic or lab methods. Values may include a confidence and range based on lab results. Units: years; Entity described: deployment'@en ;
    skos:notation 'SDN:MVB::MVB000521'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000522/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000522/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000522/>;
    dc:modified '2026-04-08T09:36:15'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'animal age comments'@en ;
    skos:definition 'Comments about how the animal age was determined, and the degree of confidence. Units: none; Entity described: deployment'@en ;
    skos:notation 'SDN:MVB::MVB000522'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000523/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000523/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000523/>;
    dc:modified '2026-04-08T09:36:15'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'animal length'@en ;
    skos:definition 'The length of the animal at the start of the deployment. Example: \'195\'; Units: centimeters; Entity described: deployment'@en ;
    skos:notation 'SDN:MVB::MVB000523'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000524/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000524/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000524/>;
    dc:modified '2026-04-08T09:36:15'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'animal life stage exact'@en ;
    skos:definition 'The age class or life stage of the animal at the beginning of the deployment, for cases when the exact age of the animal is known. Can be years or months of age, or age class terms. Use \'animal life stage\' to document the age regardless of confidence, or estimates made without knowledge of the exact age. Example: \'Adult; Short Yearling\'; Units: not specified; Entity described: deployment'@en ;
    skos:notation 'SDN:MVB::MVB000524'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000525/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000525/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000525/>;
    dc:modified '2026-04-08T09:36:15'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'animal status'@en ;
    skos:definition 'The latest known information on the status of the animal. The date of last update can be specified in \'animal status date\'. Values are chosen from a controlled list: active, dead, unknown. Format: controlled list; Entity described: deployment'@en ;
    skos:notation 'SDN:MVB::MVB000525'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000526/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000526/1/>
    a skos:Concept ;
