    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'GPS message count'@en ;
    skos:definition 'The number of messages transmitted to GPS satellites. Example: \'278\'; Units: count; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000251'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000354/3/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000354/3/>
    a skos:Concept ;
