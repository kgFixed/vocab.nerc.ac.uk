    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000200/>;
    dc:modified '2019-10-03T20:36:04'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'timestamp'@en ;
    skos:definition 'The date and time corresponding to a sensor measurement or an estimate derived from sensor measurements. Example: \'2008-08-14 18:31:00.000\'; Format: yyyy-MM-dd HH:mm:ss.SSS; Units: UTC or GPS time; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000200'^^xsd:string .
