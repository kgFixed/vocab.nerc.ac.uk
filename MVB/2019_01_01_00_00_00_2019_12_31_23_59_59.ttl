    skos:definition 'The date and time that the data record was transmitted. Example: \'2014-03-11 18:06:44.000\'; Format: yyyy-MM-dd HH:mm:ss.SSS; Units: UTC or GPS time; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000201'^^xsd:string .
