    dc:modified '2019-10-03T20:36:04'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'temperature min'@en ;
    skos:definition 'The minimum temperature measured during the measurement interval. Example: \'7.4\'; Units: degrees Celsius; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000195'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000196/2/> .
