    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000196/>;
    dc:modified '2019-10-03T20:36:04'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'tilt angle'@en ;
    skos:definition 'The angle in which the tag is tilted in respect to the gravitational angle (0-180). Example: \'78\'; Units: degrees; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000196'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000197/2/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000197/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000197/>;
    dc:modified '2019-10-03T20:36:04'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'tilt x'@en ;
    skos:definition 'Tilt provided by the accelerometer for the X axis. Example: \'0\'; Units: g forces (1 g = 9.8 m s^-2); Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000197'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000198/2/> .
