    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000061/>;
    dc:modified '2019-10-03T20:36:04'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'BAS transition 1'@en ;
    skos:definition 'Time of sunrise (definition from British Antarctic Survey Geolocator Manual v. 8, 2010). Example: \'0.530555555555556\'; Units: GMT; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000061'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000062/2/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000062/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000062/>;
    dc:modified '2019-10-03T20:36:04'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'BAS transition 2'@en ;
    skos:definition 'Time of sunset (definition from British Antarctic Survey Geolocator Manual v. 8, 2010). Example: \'0.690972222222222\'; Units: GMT; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000062'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000063/2/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000063/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000063/>;
    dc:modified '2019-10-03T20:36:04'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'battery charge percent'@en ;
    skos:definition 'The battery charge as a percentage of full charge. Example: \'25\'; Units: none (percent); Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000063'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000064/2/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000064/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000064/>;
    dc:modified '2019-10-03T20:36:04'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'battery charging current'@en ;
    skos:definition 'The battery charging current reported by the tag. Example: \'0\'; Units: milliamperes (mA); Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000064'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000069/2/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000069/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000069/>;
    dc:modified '2019-10-03T20:36:04'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'comments'@en ;
    skos:definition 'Additional information about events that is not described by other event data terms. Example: \'we observed the animal foraging (see photo BT25)\'; Units: none; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000069'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000070/2/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000070/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000070/>;
    dc:modified '2019-10-03T20:36:04'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'compass heading'@en ;
    skos:definition 'The tilt-compensated horizontal compass heading. Example: \'62\'; Units: degrees clockwise from magnetic north; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000070'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000073/2/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000073/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000073/>;
    dc:modified '2019-10-03T20:36:04'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'data processing software'@en ;
    skos:definition 'Name of the software program/s, scripts, etc. used to process raw sensor data and derive location estimates. Example: \'BASTrack\'; Units: none; Entity described: deployment'@en ;
    skos:notation 'SDN:MVB::MVB000073'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000076/2/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000076/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000076/>;
    dc:modified '2019-10-03T20:36:04'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'deploy off person'@en ;
    skos:definition 'The name of the person/people who removed the tag from the animal and ended the deployment. Example: \'J. Smith\'; Units: none; Entity described: deployment'@en ;
    skos:notation 'SDN:MVB::MVB000076'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000080/2/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000080/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000080/>;
    dc:modified '2019-10-03T20:36:04'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'deploy on person'@en ;
    skos:definition 'The name of the person/people who attached the tag to the animal and began the deployment. Example: \'G. Smith\'; Units: none; Entity described: deployment'@en ;
    skos:notation 'SDN:MVB::MVB000080'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000082/2/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000082/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000082/>;
    dc:modified '2019-10-03T20:36:04'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'deployment comments'@en ;
    skos:definition 'Additional information about the tag deployment that is not described by other reference data terms. Example: \'body length 154 cm; condition good\'; Units: none; Entity described: deployment'@en ;
    skos:notation 'SDN:MVB::MVB000082'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000087/2/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000087/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000087/>;
    dc:modified '2019-10-03T20:36:04'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'eobs acceleration axes'@en ;
    skos:definition 'This tells you about the enabled ACC axes, like X and/or Y and/or Z (definition from \'e-obs GPS-acceleration-tags application note: How to use the acceleration sensor, interpret, analyse its data and how to get values in m/s^2\', 2011). Example: \'XYZ\'; Units: none; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000087'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000088/2/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000088/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000088/>;
    dc:modified '2019-10-03T20:36:04'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'eobs acceleration sampling frequency per axis'@en ;
    skos:definition 'This is the sampling frequency for one axis. Don\'t mix this up with the sampling frequency for all axes together. For example if you have three ACC axes enabled, then the sampling frequency for all axes together is three times the sampling frequency for one axis. The sampling frequency is measured in Hertz, which is the same as 1/second. For example a sampling frequency of 10 Hz means that you get 10 samples per second (definition from \'e-obs GPS-acceleration-tags application note: How to use the acceleration sensor, interpret, analyse its data and how to get values in m/s^2\', 2011). Example: \'5.93\'; Units: Hz; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000088'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000089/2/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000089/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000089/>;
    dc:modified '2019-10-03T20:36:04'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'eobs accelerations raw'@en ;
    skos:definition 'Acceleration along the X and or Y and or Z axes of the tag, depending on which axes were activated on the tag as described in \'eobs acceleration axes\'. Measurements alternate one measurement for each active axis in alphabetical order. The values are digital readings between 0 and 4095 of the analogue digital converter on the tag, and can be converted to m/s^2 with proper calibration. These samples are made at the rate described by the field \'eobs acceleration sampling frequency per axis\' starting with the first sample at the time described in the field \'e-obs start timestamp\'. Tags with numbers e-obs numbers 2242 and higher, which began being provided in spring 2012, have Y-axis values in the opposite direction from those in older tags (definition from \'e-obs GPS-acceleration-tags application note: How to use the acceleration sensor, interpret, analyse its data and how to get values in m/s^2\', 2011; Wolgang Heidrich, e-obs Digital Telemetry, personal communication, 2012). Example: \'1844 1889 1653 1845 1896 1653 1837 1897 1653 1842 1898 1650 1844 1899 1644 1840...\'; Units: not defined; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000089'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000092/2/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000092/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000092/>;
    dc:modified '2019-10-03T20:36:04'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'eobs battery voltage'@en ;
    skos:definition 'Unloaded battery voltage (definition from Franz Kuemmeth, e-obs Digital Telemetry, personal communication, 2012). Example: \'3712\'; Units: mV; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000092'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000093/2/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000093/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000093/>;
    dc:modified '2019-10-03T20:36:04'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'eobs fix battery voltage'@en ;
    skos:definition 'Loaded battery voltage, i.e. battery voltage when GPS module is acquiring a fix (definition from e-obs Digital Telemetry Manual for DataDecoder Software, 2010; Franz Kuemmeth, e-obs Digital Telemetry, personal communication, 2012). Example: \'3535\'; Units: mV; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000093'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000095/2/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000095/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000095/>;
    dc:modified '2019-10-03T20:36:04'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'eobs key bin checksum'@en ;
    skos:definition 'A checksum of the original binary data, so that Movebank can quickly compare different lines by comparing their checksums (definition from \'e-obs GPS-acceleration-tags application note: How to use the acceleration sensor, interpret, analyse its data and how to get values in m/s^2\', 2011). Example: \'4152324118\'; Units: none; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000095'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000096/2/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000096/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000096/>;
    dc:modified '2019-10-03T20:36:04'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'eobs speed accuracy estimate'@en ;
    skos:definition 'A speed (in)accuracy estimate, calculated by the GPS module. The speed accuracy estimate (better named \'inaccuracy estimation\') may show very high values, since the GPS module calculates a very conservative value. These speed measurements are potentially very inaccurate when interpreting the data (definition from e-obs Digital Telemetry Manual for DataDecoder Software, 2010; Franz Kuemmeth, e-obs Digital Telemetry, personal communication, 2012). Example: \'6.58\'; Units: m/s; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000096'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000097/2/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000097/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000097/>;
    dc:modified '2019-10-03T20:36:04'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'eobs start timestamp'@en ;
    skos:definition 'The date and time of day when the acceleration burst belonging to this line begins. The exact time of the first sample is a little later (up to 1 second) for older e-obs tags, especially when the ACC-pinger is enabled (4 pings before the start of each ACC burst) (definition from \'e-obs GPS-acceleration-tags application note: How to use the acceleration sensor, interpret, analyse its data and how to get values in m/s^2\', 2011). Example: \'2011-01-03 13:45:00.000\'; Format: yyyy-MM-dd HH:mm:ss.SSS; Units: GPS time; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000097'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000099/2/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000099/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000099/>;
    dc:modified '2019-10-03T20:36:04'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'eobs temperature'@en ;
    skos:definition 'Temperature; this value is not calibrated and therefore very inaccurate (definition from e-obs Digital Telemetry Manual for DataDecoder Software, 2010). Example: \'45, -8\'; Units: degrees Celsius; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000099'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000101/2/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000101/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000101/>;
    dc:modified '2019-10-03T20:36:04'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'eobs used time to get fix'@en ;
    skos:definition 'The amount of time that was needed for this GPS fix; interesting for estimating power requirements (definition from e-obs Digital Telemetry Manual for DataDecoder Software, 2010). Example: \'22\'; Units: seconds; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000101'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000102/2/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000102/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000102/>;
    dc:modified '2019-10-03T20:36:04'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'end timestamp'@en ;
    skos:definition 'The date and time when the sampling interval or burst ended. Example: \'2011-01-03 13:45:00.000\'; Format: yyyy-MM-dd HH:mm:ss.SSS; Units: UTC or GPS time; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000102'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000106/2/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000106/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000106/>;
    dc:modified '2019-10-03T20:36:04'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'geolocator calibration'@en ;
    skos:definition 'A description of how solar geolocators were calibrated. Best practice is to refer to a publication and/or analysis software/parameters used. Example: \'on-animal calibration over a two-week period in the breeding site; see Jameson et al. (2011)\'; Units: none; Entity described: deployment'@en ;
    skos:notation 'SDN:MVB::MVB000106'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000107/2/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000107/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000107/>;
    dc:modified '2019-10-03T20:36:04'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'geolocator fix type'@en ;
    skos:definition 'The period of day (or a value indicating the period of day) used to estimate location by geolocation. Example: \'sunrise\'; Units: none; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000107'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000109/2/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000109/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000109/>;
    dc:modified '2019-10-03T20:36:04'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'geolocator sensor comments'@en ;
    skos:definition 'Description of light and other sensors, e.g. range of light intensity, light spectra (nm) that is not described by other reference data terms. Example: \'tag includes light-level and wet-dry sensors\'; Units: none; Entity described: deployment'@en ;
    skos:notation 'SDN:MVB::MVB000109'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000110/2/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000110/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000110/>;
    dc:modified '2019-10-03T20:36:04'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'geolocator sun elevation angle'@en ;
    skos:definition 'The sun elevation angle used for location estimation with solar geolocators. Example: \'-2.86\'; Units: degrees; Entity described: deployment'@en ;
    skos:notation 'SDN:MVB::MVB000110'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000115/2/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000115/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000115/>;
    dc:modified '2019-10-03T20:36:04'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'GPS DOP'@en ;
    skos:definition 'Dilution of precision provided by the GPS. Example: \'1.8\'; Units: unitless; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000115'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000118/2/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000118/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000118/>;
    dc:modified '2019-10-03T20:36:04'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'GPS HDOP'@en ;
    skos:definition 'Horizontal dilution of precision provided by the GPS. Example: \'1.2\'; Units: unitless; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000118'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000119/2/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000119/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000119/>;
    dc:modified '2019-10-03T20:36:04'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'GPS maximum signal strength'@en ;
    skos:definition 'The signal reception strength of the strongest GPS satellite of those used to calculate the location estimate. Example: \'39\'; Units: dBm; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000119'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000122/2/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000122/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000122/>;
    dc:modified '2019-10-03T20:36:04'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'GPS VDOP'@en ;
    skos:definition 'Vertical dilution of precision provided by the GPS. Example: \'1.9\'; Units: unitless; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000122'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000124/2/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000124/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000124/>;
    dc:modified '2019-10-03T20:36:04'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'ground speed'@en ;
    skos:definition 'The estimated ground speed provided by the sensor or calculated between consecutive locations. Example: \'7.22\'; Units: m/s; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000124'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000129/2/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000129/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000129/>;
    dc:modified '2019-10-03T20:36:04'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'heading'@en ;
    skos:definition 'The direction in which the tag is moving, in decimal degrees clockwise from north, as provided by the sensor or calculated between consecutive locations. Values range from 0-360: 0 = north, 90 = east, 180 = south, 270 = west. Example: \'315.88\'; Units: degrees clockwise from north; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000129'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000130/2/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000130/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000130/>;
    dc:modified '2019-10-03T20:36:04'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'height above ellipsoid'@en ;
    skos:definition 'The estimated height above the ellipsoid, typically estimated by the tag. If altitudes are calculated as height above mean sea level, use \'height above mean sea level\'. Example: \'24.8\'; Units: meters; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000130'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000132/2/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000132/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000132/>;
    dc:modified '2019-10-03T20:36:04'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'height raw'@en ;
    skos:definition 'Raw values for the height of the tag above ellipsoid or mean sea level, typically estimated by the tag. Values are stored as raw text values because non-numeric characters are used or processing is required to derive the correct height estimate. Best practice is to define values in the reference data. Example: \'425, 2D fix\'; Units: not defined; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000132'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000144/2/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000144/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000144/>;
    dc:modified '2019-10-03T20:36:04'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'location error text'@en ;
    skos:definition 'An estimate of the horizontal error of the location estimate, typically provided in the original data file, described using more than numbers. Units should be provided in the values. (If the values are purely numeric, use \'location error numerical\'.) Best practice is to define values and units using \'location error percentile\' and/or \'location accuracy comments\'. Example: \'> 25 ft\'; Units: not defined; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000144'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000146/2/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000146/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000146/>;
    dc:modified '2019-10-03T20:36:04'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'location long'@en ;
    skos:definition 'The geographic longitude of the location as estimated by the sensor. Positive values are east of the Greenwich Meridian, negative values are west of it. Example: \'-121.1761111\'; Units: decimal degrees, WGS84 reference system; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000146'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000154/2/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000154/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000154/>;
    dc:modified '2019-10-03T20:36:04'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'manipulation comments'@en ;
    skos:definition 'Additional comments about the way in which the animal was manipulated during the deployment. Use \'manipulation type\' to define the general type of manipulation. Example: \'Relocated from breeding colony on Smithers Island to release location at 70.02E, 21.21S\'; Units: none; Entity described: deployment'@en ;
    skos:notation 'SDN:MVB::MVB000154'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000160/2/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000160/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000160/>;
    dc:modified '2019-10-03T20:36:04'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'migration stage'@en ;
    skos:definition 'The migration stage of the animal. Values are specific to the study. To use a controlled list of migration stages that can be compared across studies, use migration stage standard. Example: \'Stopover #1d\'; Units: none; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000160'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000165/2/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000165/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000165/>;
    dc:modified '2019-10-03T20:36:04'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'proofed'@en ;
    skos:definition 'Can be used to indicate whether or not records have been proofed by an expert involved with the study. Allowed values are TRUE or FALSE. Units: none; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000165'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000171/2/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000171/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000171/>;
    dc:modified '2019-10-03T20:36:04'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'start timestamp'@en ;
    skos:definition 'The date and time when the sampling interval or burst began. Example: \'2011-01-03 13:45:00.000\'; Format: yyyy-MM-dd HH:mm:ss.SSS; Units: UTC or GPS time; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000171'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000179/2/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000179/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000179/>;
    dc:modified '2019-10-03T20:36:04'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'tag comments'@en ;
    skos:definition 'Additional information about the tag that is not described by other reference data terms. Example: \'custom-made Doppler shift Argos tag with a special altitude sensor\'; Units: none; Entity described: tag'@en ;
    skos:notation 'SDN:MVB::MVB000179'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000185/2/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000185/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000185/>;
    dc:modified '2019-10-03T20:36:04'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'tag model'@en ;
    skos:definition 'The model of the tag. Example: \'T61\'; Units: none; Entity described: tag'@en ;
    skos:notation 'SDN:MVB::MVB000185'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000186/2/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000186/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000186/>;
    dc:modified '2019-10-03T20:36:04'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'tag processing type'@en ;
    skos:definition 'Used to distinguish between data formats produced by different types of Microwave tags (currently not used). Units: none; Entity described: tag'@en ;
    skos:notation 'SDN:MVB::MVB000186'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000190/2/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000190/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000190/>;
    dc:modified '2019-10-03T20:36:04'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'tag tech spec'@en ;
    skos:definition 'Values for a tag-specific technical specification. Can be used to store measurements not described by existing Movebank attributes. Best practice is to define the values and units in the reference data or study details. Example: \'8.31\'; Units: not defined; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000190'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000191/2/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000191/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000191/>;
    dc:modified '2019-10-03T20:36:04'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'tag voltage'@en ;
    skos:definition 'The voltage as reported by the tag. Example: \'2895\'; Units: mV; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000191'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000193/2/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000193/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000193/>;
    dc:modified '2019-10-03T20:36:04'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'TechnoSmart signal quality'@en ;
    skos:definition 'The strength of satellite reception. Ranges from 0 to 500. Higher values indicate better reception. Example: \'230\'; Units: dB-Hz; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000193'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000194/2/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000194/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000194/>;
    dc:modified '2019-10-03T20:36:04'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'temperature max'@en ;
    skos:definition 'The maximum temperature measured during the measurement interval. Example: \'12.4\'; Units: degrees Celsius; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000194'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000195/2/> .
