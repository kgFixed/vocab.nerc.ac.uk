    skos:prefLabel 'Mw show in KML'@en ;
    skos:definition 'Used by Microwave GPS tags to flag implausible locations. Allowed values are TRUE or FALSE; implausible locations have the value FALSE. Units: none; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000159'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000172/2/> .
