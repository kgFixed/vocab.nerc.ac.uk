    skos:notation 'SDN:MVB::MVB000300'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000301/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000301/1/>
    a skos:Concept ;
