<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000250/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000250/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000250/>;
    dc:modified '2021-04-07T19:41:00'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'go public date'@en ;
    skos:definition 'Used in the REST API. A date scheduled by the study owner on which the study will become public. Example: \'2022-04-01 08:00:00.000\'; Format: yyyy-MM-dd HH:mm:ss.SSS; Units: UTC; Entity described: study'@en ;
    skos:notation 'SDN:MVB::MVB000250'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000252/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000252/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000252/>;
    dc:modified '2021-04-07T19:41:00'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'gyroscope axes'@en ;
    skos:definition 'The enabled gyroscope axes. Example: \'XYZ\'; Units: none; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000252'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000253/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000253/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000253/>;
    dc:modified '2021-04-07T19:41:00'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'gyroscope sampling frequency per axis'@en ;
    skos:definition 'The sampling frequency for each axis measured by the gyroscope. Can be used to report bursts of values associated with a single timestamp. Example: \'5.93\'; Units: Hz; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000253'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000254/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000254/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000254/>;
    dc:modified '2021-04-07T19:41:00'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'I am collaborator'@en ;
    skos:definition 'Used in the REST API. Whether the user credentials used in the request are for a Movebank user that is a Collaborator for the study. Allowed values are TRUE or FALSE. Units: none; Entity described: study'@en ;
    skos:notation 'SDN:MVB::MVB000254'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000255/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000255/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000255/>;
    dc:modified '2021-04-07T19:41:00'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'I have download access'@en ;
    skos:definition 'Used in the REST API. Whether the user credentials used in the request are for a Movebank user that has permission to download some or all data from the study. Allowed values are TRUE or FALSE. Units: none; Entity described: study'@en ;
    skos:notation 'SDN:MVB::MVB000255'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000257/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000257/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000257/>;
    dc:modified '2021-04-07T19:41:00'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'license type'@en ;
    skos:definition 'The license that currently applies to data that are publicly downloadable from the study. Chosen by the study owner. If CUSTOM is selected, details may be available in \'license terms\'. Allowed values are CC_BY = Creative Commons Attribution (BY) License; CC_BY_NC = Creative Commons Attribution-NonCommercial (BY-NC) License; CC_0 = Creative Commons Universal (CC0) License; CUSTOM = Custom terms of use defined by the study owner. Format: controlled list; Entity described: study'@en ;
    skos:notation 'SDN:MVB::MVB000257'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000258/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000258/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000258/>;
    dc:modified '2021-04-07T19:41:00'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'magnetic field x'@en ;
    skos:definition 'The magnetic field strength measured by the magnetometer for the X axis. For magnetic field strength values not in units of microtesla, use \'magnetic field raw x\'. Example: \'40.1367\'; Units: microtesla (_T); Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000258'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000259/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000259/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000259/>;
    dc:modified '2021-04-07T19:41:00'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'magnetic field y'@en ;
    skos:definition 'The magnetic field strength measured by the magnetometer for the Y axis. For magnetic field strength values not in units of microtesla, use \'magnetic field raw y\'. Example: \'-12.3047\'; Units: microtesla (_T); Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000259'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000260/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000260/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000260/>;
    dc:modified '2021-04-07T19:41:00'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'magnetic field z'@en ;
    skos:definition 'The magnetic field strength measured by the magnetometer for the Z axis. For magnetic field strength values not in units of microtesla, use \'magnetic field raw z\'. Example: \'99.0234\'; Units: microtesla (_T); Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000260'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000265/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000265/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000265/>;
    dc:modified '2021-04-07T19:41:00'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'receiver ID'@en ;
    skos:definition 'An identifier for the receiver that detected the signal from the tag. Example: \'Schillig\'; Units: none; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000265'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000266/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000266/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000266/>;
    dc:modified '2021-04-07T19:41:00'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'relative humidity'@en ;
    skos:definition 'The relative humidity measured by the tag. Example: \'23.8\'; Units: none (percent); Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000266'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000267/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000267/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000267/>;
    dc:modified '2021-04-07T19:41:00'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'roll'@en ;
    skos:definition 'The roll of the tag, as measured by the gyroscope, accelerometer and/or magnetometer on the tag. Values range from -180 to 180, with positive values indicating clockwise roll (rotation to the right) around the axis and negative values indicating anticlockwise roll (rotation to the left) around the axis. Example: \'-7.35\'; Units: degrees; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000267'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000272/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000272/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000272/>;
    dc:modified '2021-04-07T19:41:00'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'study type'@en ;
    skos:definition 'Type of study. Standard studies are \'research\' studies. Format: controlled list; Entity described: study'@en ;
    skos:notation 'SDN:MVB::MVB000272'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000273/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000273/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000273/>;
    dc:modified '2021-04-07T19:41:00'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'taxon IDs'@en ;
    skos:definition 'A comma-separated list of taxa currently assigned to animals in the study, as defined by the Integrated Taxonomic Information System (ITIS, www.itis.gov). Format: controlled list; Entity described: study'@en ;
    skos:notation 'SDN:MVB::MVB000273'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000276/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000276/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000276/>;
    dc:modified '2021-04-07T19:41:00'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'transmission protocol'@en ;
    skos:definition 'The protocol used to transmit or otherwise obtain the event data from the tag. Best practice is to use when data are retrieved from the tag using multiple methods. Example: \'Iridium\'; Units: none; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000276'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000277/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000277/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000277/>;
    dc:modified '2021-04-07T19:41:00'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'tsn'@en ;
    skos:definition 'Used in the REST API. The taxonomic serial number. A unique, persistent, non-intelligent identifier for a scientific name within the Integrated Taxonomic Information System (ITIS) (itis.gov). Example: \'165355\'; Units: none; Entity described: taxon'@en ;
    skos:notation 'SDN:MVB::MVB000277'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000264/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000264/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000264/>;
    dc:modified '2021-04-07T19:41:00'^^xsd:dateTime ;
    skos:altLabel 'provider update ts'^^xsd:string ;
    skos:prefLabel 'provider update timestamp'@en ;
    skos:definition 'The timestamp on which the event was last updated by the data provider. Example: \'2020-12-18 08:50:06.000\'; Format: yyyy-MM-dd HH:mm:ss.SSS; Units: UTC; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000264'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000256/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000256/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000256/>;
    dc:modified '2021-04-07T19:41:00'^^xsd:dateTime ;
    skos:altLabel 'temperature internal'^^xsd:string ;
    skos:prefLabel 'internal temperature'@en ;
    skos:definition 'The internal body temperature of the animal measured by the tag. Example: \'37.1\'; Units: degrees Celsius; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000256'^^xsd:string .
