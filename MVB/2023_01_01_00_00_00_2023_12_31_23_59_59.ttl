    dc:modified '2023-09-28T13:57:47'^^xsd:dateTime ;
    skos:altLabel 'Gundi Gundi urn'^^xsd:string ;
    skos:prefLabel 'Gundi URN'@en ;
    skos:definition 'The unique identifier for the Gundi integration. Units: none; Entity described: event'@en ;
