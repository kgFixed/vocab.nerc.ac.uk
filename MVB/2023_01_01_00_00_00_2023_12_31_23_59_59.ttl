    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'sensor type IDs'@en ;
    skos:definition 'Used in the REST API. A comma-separated list of sensor types currently assigned to events in the study or for an individual or tag. Example: \'GPS,Acceleration\'; Units: none; Entity described: study'@en ;
    skos:notation 'SDN:MVB::MVB000268'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000274/3/> .
