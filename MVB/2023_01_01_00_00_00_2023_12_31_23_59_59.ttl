    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000420/>;
    dc:modified '2023-09-28T13:57:47'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'WildFi record type'@en ;
    skos:definition 'The WildFi record type. Example: \'12345A\'; Units: none; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000420'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000401/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000401/1/>
    a skos:Concept ;
