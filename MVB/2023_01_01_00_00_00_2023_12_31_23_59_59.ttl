    skos:prefLabel 'orientation quaternions sampling frequency'@en ;
    skos:definition 'The sampling frequency for quaternion measurements. Can be used to report bursts of values associated with a single timestamp. Example: \'20\'; Units: Hz; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000233'^^xsd:string .
