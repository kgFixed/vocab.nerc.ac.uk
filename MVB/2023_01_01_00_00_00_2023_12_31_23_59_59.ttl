<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000184/4/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000184/4/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000184/>;
    dc:modified '2023-09-28T13:57:47'^^xsd:dateTime ;
    skos:altLabel 'weight'^^xsd:string ;
    skos:prefLabel 'tag mass'@en ;
    skos:definition 'The mass of the tag. Can be used with \'tag mass total\' to define the mass of the tag separately from that of the tag with additional hardware. Example: \'24\'; Units: grams; Entity described: tag'@en ;
    skos:notation 'SDN:MVB::MVB000184'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000011/3/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000011/3/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000011/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'algorithm marked outlier'@en ;
    skos:definition 'Identifies events marked as outliers using a user-selected filter algorithm in Movebank. Outliers have the value TRUE. Information about how outliers were defined can be provided in \'outlier comments\'. Units: none; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000011'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000014/3/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000014/3/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000014/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'animal earliest date born'@en ;
    skos:definition 'The earliest date an animal is thought to have been born or hatched. Example: \'2001-01-01 00:00:00.000\'; Format: yyyy-MM-dd HH:mm:ss.SSS; Units: UTC (sometimes date is provided based on local time); Entity described: individual'@en ;
    skos:notation 'SDN:MVB::MVB000014'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000015/4/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000015/4/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000015/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'animal exact date of birth'@en ;
    skos:definition 'The exact date on which animal was born or hatched. Example: \'2001-10-31 00:00:00.000\'; Format: yyyy-MM-dd HH:mm:ss.SSS; Units: UTC (sometimes date is provided based on local time); Entity described: individual'@en ;
    skos:notation 'SDN:MVB::MVB000015'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000017/4/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000017/4/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000017/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'animal latest date born'@en ;
    skos:definition 'The latest date an animal is thought to have been born or hatched. Example: \'2001-12-12 00:00:00.000\'; Format: yyyy-MM-dd HH:mm:ss.SSS; Units: UTC (sometimes date is provided based on local time); Entity described: individual'@en ;
    skos:notation 'SDN:MVB::MVB000017'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000022/3/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000022/3/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000022/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'animal ring ID'@en ;
    skos:definition 'A number or color scheme for a band or ring attached to the animal. Color bands and other markings can be stored in \'animal marker ID\'. Example: \'26225\'; Units: none; Entity described: individual'@en ;
    skos:notation 'SDN:MVB::MVB000022'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000051/4/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000051/4/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000051/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Argos valid location manual'@en ;
    skos:definition 'Indicates which of the two location estimates provided by Argos is the valid location, as chosen by the user. Values override the results of \'Argos valid location algorithm\'. Allowed values are 1 = The user has chosen the primary location (solution 1, lat1/lon1) as the valid location; 2 = The user has chosen the alternate location (solution 2, lat2/lon2) as the valid location. Information about how values were deterimined can be provided in \'outlier comments\'. Format: controlled list; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000051'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000090/4/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000090/4/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000090/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'eobs activity'@en ;
    skos:definition 'An indication of activity since the previous data message was sent, based on raw acceleration data, provided in SMS messages sent by e-obs GSM tags. Values range from 0 (least activity) to 256 (most activity). The number of acceleration measurements used to determine activity is indicated in e-obs activity samples (Wolgang Heidrich, e-obs Digital Telemetry, personal communication, 2013). Example: \'156\'; Units: not specified; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000090'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000091/4/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000091/4/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000091/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'eobs activity samples'@en ;
    skos:definition 'The number of acceleration measurements used to calculate e-obs activity divided by 171. This is provided in SMS messages sent by GSM tags (Wolgang Heidrich, e-obs Digital Telemetry, personal communication, 2013). Example: \'14\'; Units: not specified; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000091'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000103/3/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000103/3/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000103/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'event ID'@en ;
    skos:definition 'An identifier for the set of values associated with each event, i.e. sensor measurement. A unique event ID is assigned to every time-location or other time-measurement record in Movebank. If multiple measurements are included within a single row of a data file, they will share an event ID. If users import the same sensor measurement to Movebank multiple times, a separate event ID will be assigned to each. Example: \'14328243575\'; Units: none; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000103'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000128/4/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000128/4/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000128/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'habitat according to'@en ;
    skos:definition 'A description of habitat categories contained in \'habitat\'. This can include how they were derived and/or a reference to the method or classification system used. Example: \'visual analysis using 2018 satellite imagery\'; Units: none; Entity described: deployment'@en ;
    skos:notation 'SDN:MVB::MVB000128'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000133/3/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000133/3/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000133/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'import marked outlier'@en ;
    skos:definition 'Identifies events as outliers. Outliers have the value TRUE. Typically used to import a record of outliers that were identified by the data provider or owner with automated methods outside of Movebank. Information about how outliers were defined can be provided in \'outlier comments\'. Units: none; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000133'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000155/6/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000155/6/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000155/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'manipulation type'@en ;
    skos:definition 'The way in which the animal was manipulated during the deployment. Additional information can be provided using \'manipulation comments\'. Changes in manipulation status during deployment can be identified using \'manipulation status\'. Values are chosen from a controlled list: confined = The animal\'s movement was restricted to within a defined area; domesticated = The animal is domesticated, for example, is a house pet or part of a managed herd; manipulated-other = The animal was manipulated in some other way, such as a physiological manipulation; none = The animal received no treatment other than tag attachment and related measurements and sampling (if applicable); reintroduction = The animal has been reintroduced as part of wildlife conservation or management efforts; relocated = The animal was released from a site other than the one at which it was captured. Format: controlled list; Entity described: deployment'@en ;
    skos:notation 'SDN:MVB::MVB000155'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000156/3/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000156/3/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000156/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'manually marked outlier'@en ;
    skos:definition 'Identifies events flagged manually as outliers, typically using the Event Editor in Movebank, and may also include outliers identified using other methods. Outliers have the value TRUE. Information about how outliers were defined can be provided in \'outlier comments\'. Units: none; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000156'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000157/3/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000157/3/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000157/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'manually marked valid'@en ;
    skos:definition 'An event marked manually as valid to override the results of a Movebank data filter (stored in \'algorithm marked outlier\'), typically using the Event Editor in Movebank. Records marked as valid have the value TRUE. These values also override values in \'manually marked outlier\' and \'import marked outlier\'. Information about how values were determined can be provided in \'outlier comments\'. Units: none; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000157'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000209/3/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000209/3/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000209/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'visible'@en ;
    skos:definition 'Determines whether an event is visible on the Movebank map. Allowed values are TRUE or FALSE. Values are calculated automatically, with TRUE indicating the event has not been flagged as an outlier by \'algorithm marked outlier\', \'import marked outlier\' or \'manually marked outlier\', or that the user has overridden the results of these outlier attributes using \'manually marked valid\' = TRUE. Units: none; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000209'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000269/2/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000269/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000269/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'solar cell voltage'@en ;
    skos:definition 'The voltage of the solar panel. Example: \'809.76\'; Units: mV; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000269'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000270/2/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000270/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000270/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'solar voltage percent'@en ;
    skos:definition 'The voltage of the solar panel, reported as a percentage of maximum possible voltage. Example: \'78\'; Units: none (percent); Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000270'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000288/2/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000288/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000288/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Icarus solar cell current'@en ;
    skos:definition 'The charging current of the solar cell reported by an Icarus transmitter. Example: \'36\'; Units: milliamperes (mA); Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000288'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000319/2/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000319/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000319/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Savannah record type'@en ;
    skos:definition 'Indicates whether the Savannah tag record is a normal position/location update or an alarm-triggered update. Allowed values are P = Normal position updates and A = Alarm-triggered update. For Alarm records (A) the actual alarm that triggered the update is contained in \'Savannah alarm type\'. Format: controlled list; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000319'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000333/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000333/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000333/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'accelerations'@en ;
    skos:definition 'Burst of acceleration sensor values. To interpret values, best practice is to further define the measurements using \'acceleration axes\' and \'acceleration sampling frequency per axis\', and to order the burst by alternating one measurement for each active axis in alphabetical order. For acceleration values not in units of m/s^2, use \'accelerations raw\'. Example: \'-0.03 -0.41 -0.66 0.03 -0.44 -0.63 0.03 -0.5 -0.63 0.09 -0.47 -0.53 0.09 -0.81 -0.56 0.19 -0.75 -0.59 0.19 -0.5 -0.78?\'; Units: m/s^2; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000333'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000334/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000334/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000334/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'activity x'@en ;
    skos:definition 'Activity values provided by the tag for the X axis. In general, higher values indicate more activity. Range and method of calculation may vary by the tag provider, model, settings and placement on the animal. Units: not specified; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000334'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000335/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000335/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000335/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'activity y'@en ;
    skos:definition 'Activity values provided by the tag for the Y axis. In general, higher values indicate more activity. Range and method of calculation may vary by the tag provider, model, settings and placement on the animal. Units: not specified; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000335'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000336/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000336/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000336/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'activity z'@en ;
    skos:definition 'Activity values provided by the tag for the Z axis. In general, higher values indicate more activity. Range and method of calculation may vary by the tag provider, model, settings and placement on the animal. Units: not specified; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000336'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000337/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000337/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000337/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'alt index ID'@en ;
    skos:definition 'An identifier for the equivalent event (data record) represented in another database. Units: none; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000337'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000340/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000340/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000340/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'animal group ID'@en ;
    skos:definition 'The name or identifier for an associated group, for example, the herd, pack, nest or family group. If the group changes over time, this can be recorded using the event term \'event group ID\'. Units: none; Entity described: animal'@en ;
    skos:notation 'SDN:MVB::MVB000340'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000341/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000341/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000341/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'animal marker ID'@en ;
    skos:definition 'A description of unique identifiers or markings on the animal, for example color bands or ear tags. Bird ring or band numbers should be stored in \'animal-ring-id\'. Units: none; Entity described: animal'@en ;
    skos:notation 'SDN:MVB::MVB000341'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000342/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000342/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000342/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'animal mates'@en ;
    skos:definition 'A description of the animal\'s mate or mates. Where possible, refer to \'animal ID\', \'animal ring ID\' or \'animal marking ID\' used in Movebank or identifiers from other databases. Include the year or period of the pairing if known. Units: none; Entity described: animal'@en ;
    skos:notation 'SDN:MVB::MVB000342'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000345/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000345/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000345/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'animal mortality type'@en ;
    skos:definition 'The likely immediate cause of death. Additional information can be provided using \'animal death comments\'. Values are chosen from a controlled list: bycatch = unintentional death of a non-target animal during fishing activities; capture = related to the capture and handling of the animal for the study; electrocution = electric shock; harvest = intentional killing by humans, for example through hunting, fishing or poaching; disease = related to a specific illness or terminal disease; natural-death = natural causes, not further specified; other = other; parasites = parasitic infection or disease, including parasitoidism; poison = accidental or deliberate exposure to a chemical substance; predation = killed by a predator or micropredator; starvation = lack of caloric energy intake; unknown = could not be determined; vehicle-collision = collision with a motor vehicle, watercraft, aircraft or other vehicle. Format: controlled list; Entity described: animal'@en ;
    skos:notation 'SDN:MVB::MVB000345'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000346/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000346/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000346/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'animal offspring'@en ;
    skos:definition 'A description of the animal\'s offspring. Where possible, refer to \'animal ID\', \'animal ring ID\' or \'animal marking ID\' used in Movebank or identifiers from other databases. Include the method used to determine the relationship if known. Units: none; Entity described: animal'@en ;
    skos:notation 'SDN:MVB::MVB000346'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000347/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000347/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000347/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'animal parents'@en ;
    skos:definition 'A description of the animal\'s parents. Where possible, refer to \'animal ID\', \'animal ring ID\' or \'animal marking ID\' used in Movebank or identifiers from other databases. Include the method used to determine the relationship if known. Units: none; Entity described: animal'@en ;
    skos:notation 'SDN:MVB::MVB000347'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000348/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000348/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000348/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'animal siblings'@en ;
    skos:definition 'A description of the animal\'s siblings. Where possible, refer to \'animal ID\', \'animal ring ID\' or \'animal marking ID\' used in Movebank or identifiers from other databases. Include the method used to determine the relationship, and which parents are shared, if known. Units: none; Entity described: animal'@en ;
    skos:notation 'SDN:MVB::MVB000348'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000349/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000349/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000349/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'capture handling time'@en ;
    skos:definition 'The time elapsed between capture and release of the animal for the purpose of attaching the tag. Can also be calculated as the difference between \'deploy-on timestamp\' and \'capture timestamp\'. Example: \'552\'; Units: seconds; Entity described: deployment'@en ;
    skos:notation 'SDN:MVB::MVB000349'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000352/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000352/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000352/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'capture timestamp'@en ;
    skos:definition 'The timestamp when the animal was captured for the purpose of attaching the tag. Intended primarily for cases in which there is considerable time between capture and release. The time between capture and release can also be provided in \'capture handling time\'. The beginning of the deployment is defined by \'deploy-on timestamp\'. Example: \'2008-08-14 15:31:00.000\'; Format: yyyy-MM-dd HH:mm:ss.SSS; Units: UTC; Entity described: deployment'@en ;
    skos:notation 'SDN:MVB::MVB000352'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000353/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000353/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000353/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'DBA comments'@en ;
    skos:definition 'A description of how dynamic body acceleration in \'ODBA\' or \'VeDBA\' were calculated from acceleration data. If acceleration data are not stored in the study, describe the acceleration axes and collection frequency used. Units: none; Entity described: deployment'@en ;
    skos:notation 'SDN:MVB::MVB000353'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000358/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000358/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000358/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'event group ID'@en ;
    skos:definition 'The name of an associated group, for example, the herd, pack, nest or family group. If the group does not change over time, this can be recorded using \'animal group ID\'. Units: none; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000358'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000359/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000359/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000359/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'georeference protocol'@en ;
    skos:definition 'A description or reference to the methods used to determine location coordinates or uncertainties, for example, for locations derived from natural markings or acoustic or radio telemetry. Also see \'data processing software\'. Units: none; Entity described: deployment'@en ;
    skos:notation 'SDN:MVB::MVB000359'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000360/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000360/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000360/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'GPS GDOP'@en ;
    skos:definition 'Geometric dilution of precision provided by the GPS. Units: unitless; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000360'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000361/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000361/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000361/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'GPS TDOP'@en ;
    skos:definition 'Time dilution of precision provided by the GPS. Units: unitless; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000361'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000362/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000362/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000362/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'height above ground level'@en ;
    skos:definition 'The height above ground level. For altitudes independent of ground level, use \'barometric height\', \'height above ellipsoid\', \'height above mean sea level\' or \'height raw\'. Example: \'123\'; Units: meters; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000362'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000366/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000366/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000366/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'locality'@en ;
    skos:definition 'A description of the place or site. Information about the values and how they were obtained can be provided in \'locality according to\'. Example: \'Markelfingen\'; Units: none; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000366'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000367/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000367/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000367/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'locality according to'@en ;
    skos:definition 'A description of values contained in \'locality\'. This can include how the location was defined and/or a reference to the method or classification system used. Units: none; Entity described: deployment'@en ;
    skos:notation 'SDN:MVB::MVB000367'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000370/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000370/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000370/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Lotek eRes'@en ;
    skos:definition 'An error metric for GPS positions estimated by Lotek devices using SWIFT fixes. Smaller numbers indicate higher-quality location estimates. Example: \'0.9\'; Units: unitless; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000370'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000371/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000371/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000371/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'manipulation status'@en ;
    skos:definition 'A category or description of how the animal is manipulated, to identify periods or events during a deployment, for example, events representing non-free-ranging movements in semi-domesticated herds. Related information can be stored in \'manipulation type\' and \'manipulation comments\'. Units: none; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000371'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000372/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000372/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000372/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'observer'@en ;
    skos:definition 'The name of an individual or group that observed the event. Units: none; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000372'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000374/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000374/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000374/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'outlier comments'@en ;
    skos:definition 'A description or reference for methods used to define outliers in \'manually marked outlier\', \'algorithm marked outlier\', \'import marked outlier\' and/or \'manually marked valid\'. If outliers were removed prior to import, this field can be used to describe which data were excluded. Example: \'Movebank value range filter set to flag records with GPS HDOP => 20, retaining records with null values.\'; Units: none; Entity described: deployment'@en ;
    skos:notation 'SDN:MVB::MVB000374'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000375/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000375/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000375/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'receiver latitude'@en ;
    skos:definition 'The geographic latitude of the receiver that received the signal from the tag. Example: \'47.728\'; Units: decimal degrees, WGS84 reference system; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000375'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000376/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000376/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000376/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'receiver longitude'@en ;
    skos:definition 'The geographic longitude of the receiver that received the signal from the tag. Example: \'9.075\'; Units: decimal degrees, WGS84 reference system; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000376'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000377/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000377/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000377/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Sigfox payload'@en ;
    skos:definition 'The undecoded raw data of the Sigfox message. Example: \'11e923067dfdf1485e802752\'; Units: none; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000377'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000379/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000379/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000379/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'tag backup voltage'@en ;
    skos:definition 'The voltage of a backup battery as reported by the tag. Units: mV; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000379'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000380/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000380/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000380/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'tag firmware'@en ;
    skos:definition 'The tag firmware and version used during the deployment. If needed, identify the relevant sensors on the tag. Units: none; Entity described: deployment'@en ;
    skos:notation 'SDN:MVB::MVB000380'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000382/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000382/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000382/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'TinyFox max movement index'@en ;
    skos:definition 'An indicator of the maximum VeDBA value range over a 3.44-second acceleration burst, recorded at 54 Hz. Allowed values are 0 = 0 to 78 mg; 1 = 78 to 2000 mg; 2 = 2000 to 4000 mg; 3 = 4000 to 8000 mg. Format: controlled list; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000382'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000383/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000383/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000383/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'TinyFox sunny index start voltage'@en ;
    skos:definition 'The voltage of the supercapacitor after waking up. The voltage before the start of data sampling is the sum of this value and \'TinyFox sunny index voltage increase\'. Example: \'2639\'; Units: mV; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000383'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000384/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000384/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000384/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'TinyFox sunny index voltage increase'@en ;
    skos:definition 'The voltage increase of the supercapacitor after sleeping for 20 seconds (with no power consumption). The voltage before the start of data sampling is the sum of this value and \'TinyFox sunny index start voltage\'. Example: \'32\'; Units: mV; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000384'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000385/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000385/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000385/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'TinyFox total VeDBA'@en ;
    skos:definition 'The sum of values recorded by \'TinyFox VeDBA burst sum\'. New values are added to this total every 5 minutes. Example: \'2626010.4\'; Units: m/s^2; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000385'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000386/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000386/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000386/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'TinyFox total VeDBA count'@en ;
    skos:definition 'The total number of \'TinyFox VeDBA burst sum\' measurements. This is reset to 0 when the tag restarts due to low voltage. Example: \'637\'; Units: count; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000386'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000387/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000387/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000387/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'TinyFox VeDBA burst sum'@en ;
    skos:definition 'The sum of VeDBA values over a 3.44-second acceleration burst, recorded at 54 Hz. Example: \'17881.5\'; Units: m/s^2; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000387'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000388/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000388/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000388/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'track segment ID'@en ;
    skos:definition 'An identifier to distinguish segments within the deployment, such as foraging trips. Specific types of track segments may also be stored in \'behavioural classification\', \'habitat\', \'locality\', \'manipulation status\', \'migration stage\' and \'migration stage standard\'. Example: \'EE00316_1\'; Units: none; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000388'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000390/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000390/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000390/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'vertical speed'@en ;
    skos:definition 'The estimated speed of vertical movement provided by the sensor or calculated between consecutive locations. Units: m/s; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000390'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000391/1/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000391/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000391/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'WC residual'@en ;
    skos:definition 'A quality indicator for GPS positions estimated by Wildlife Computers devices using Fastloc GPS processing. Large residuals relative to other locations can indicate a high degree of uncertainty in the location. Example: \'5.5\'; Units: unitless; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000391'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000066/4/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000066/4/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000066/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel 'behaviour according to'^^xsd:string ;
    skos:prefLabel 'behavior according to'@en ;
    skos:definition 'A description of behavioral categories contained in \'behavioural classification\'. This can include how they were derived and/or a reference to the method or classification system used. Example: \'Derived using acceleration data and an algorithm calibrated using field observations (see Doe et al., 2013).\'; Units: none; Entity described: deployment'@en ;
    skos:notation 'SDN:MVB::MVB000066'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000281/2/> .
<http://vocab.nerc.ac.uk/collection/MVB/current/MVB000281/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000281/>;
    dc:modified '2023-02-20T15:55:26'^^xsd:dateTime ;
    skos:altLabel 'heartrate ECG raw'^^xsd:string ;
    skos:prefLabel 'ECG raw'@en ;
    skos:definition 'Raw ECG values provided by the tag. Range and units may vary by provider and tag settings. Example: \'2022\'; Units: not defined; Entity described: event'@en ;
    skos:notation 'SDN:MVB::MVB000281'^^xsd:string .
