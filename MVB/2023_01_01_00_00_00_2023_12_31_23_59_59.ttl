    dc:modified '2023-09-28T13:57:47'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'number of events'@en ;
    skos:definition 'Used in the REST API. The number of events (data records) associated with an individual, tag, or deployment. Values are calculated approximately daily. Example: \'198543\'; Units: count; Entity described: individual'@en ;
    skos:notation 'SDN:MVB::MVB000262'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/MVB/current/MVB000268/2/> .
