    dc:modified '2026-02-02T15:05:36'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Ocean Acoustics'@en ;
    skos:definition 'Scientific field of study pertaining to sound emission and propagation in the marine environment. This topic includes the measurement of sound characteristics and the information they provide in the fields of telluric and hydroclimatic risk, biodiversity inventory and evolution, and anthropic impact. It includes also acoustic backscatter in the water column.'@en ;
    skos:notation 'SDN:OD1::ACOUST'^^xsd:string .
