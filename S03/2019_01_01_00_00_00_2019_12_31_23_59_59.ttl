    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'leaching with 1M ammonium acetate at pH 7'@en ;
    skos:definition 'A gentle sediment leaching treatment designed to release elements classified as being in \'loosely held\' or in \'exchangeable\' associations (stage 1 in Chester et al 1988 https://doi.org/10.1016/0304-4203(88)90036-9).'@en ;
    skos:notation 'SDN:S03::S0341'^^xsd:string .
