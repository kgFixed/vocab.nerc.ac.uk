    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'pressurised liquid extraction using hexane and acetone, florisil cleanup'@en ;
    skos:definition 'The analytes of interest are extracted from a solid sample using a mixture of hexane and acetone at high temperature and pressure (technique known as Pressurised or Pressurized Liquid Extraction or PLE) followed by the elimination of interferences, such as polar compounds, using florisil.'@en ;
    skos:notation 'SDN:S03::S03494'^^xsd:string .
