<http://vocab.nerc.ac.uk/collection/S03/current/S03495/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03495/>;
    dc:modified '2026-07-16T15:28:24'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel '13C-bicarbonate and 15N-N2 tracer addition, on-deck incubation at simulated in-situ light level, filtration'@en ;
    skos:definition 'Bicarbonate labelled with carbon-13 and N2 gas labelled with nitrogen-15 were both added to the sample which was held for a predetermined time in a surface seawater bath and quantitatively shaded natural light (level usually designed to mimic collection depth and documented elsewhere) before filtration to collect the particulate phase.'@en ;
    skos:notation 'SDN:S03::S03495'^^xsd:string .
