    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'in-vitro incubation in the dark on deck'@en ;
    skos:definition 'The sample was retained in darkness or in a darkened bottle for a predetermined period typically in on-deck incubators cooled with pumped surface water ("shipboard incubations").'@en ;
    skos:notation 'SDN:S03::S03483'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03482/1/> .
