    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03185/>;
    dc:modified '2025-04-03T08:11:12'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'isotope-labelled tracer addition, in-vitro incubation on in-situ rig, filtration'@en ;
    skos:definition 'A dissolved radioactive or stable isotope tracer was added to the sample which was held for a predetermined time on a rig at the location and depth of sample collection before filtration to collect the particulate phase.'@en ;
    skos:notation 'SDN:S03::S03185'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03184/3/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03184/3/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03184/>;
    dc:modified '2025-04-03T08:10:25'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'isotope-labelled tracer addition, in-vitro incubation on in-situ rig, cascade filtration'@en ;
    skos:definition 'A dissolved radioactive or stable isotope tracer was added to the sample which was held for a predetermined time on a rig at the location and depth of sample collection before filtration to collect the particulate phase as size fractions.'@en ;
    skos:notation 'SDN:S03::S03184'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03128/2/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03128/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03128/>;
    dc:modified '2025-04-03T08:06:31'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'in-vitro incubation on in-situ rig dilution experiment'@en ;
    skos:definition 'The sample has been taken from one of a series of incubations of a seawater sample at multiple dilutions held on a rig at the depth of sample collection. Usually associated with the quantification of phytoplankton consumption by grazers.'@en ;
    skos:notation 'SDN:S03::S03128'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03127/2/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03127/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03127/>;
    dc:modified '2025-04-03T08:03:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'in-vitro incubation on in-situ rig'@en ;
    skos:definition 'The sample was retained for a predetermined period on a rig at its location and depth of collection.'@en ;
    skos:notation 'SDN:S03::S03127'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03480/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03480/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03480/>;
    dc:modified '2025-04-02T18:24:04'^^xsd:dateTime ;
    skos:altLabel 'in-vitro'^^xsd:string ;
    skos:prefLabel 'in-vitro incubation in the dark'@en ;
    skos:definition 'Aliquots of the sample were retained for a set period of time in bottles incubated in the dark. In oceanography, in-vitro incubations (i.e. in bottle enclosures) are typically carried out in on-deck incubators cooled with pumped surface water ("shipboard incubations"), or on an in-situ rig at the depths the samples were collected, or in an incubation chamber in the laboratory where temperatures close to in-situ temperatures can be maintained.'@en ;
    skos:notation 'SDN:S03::S03480'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03479/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03479/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03479/>;
    dc:modified '2025-01-28T15:27:45'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'filtration, Alcian blue staining'@en ;
    skos:definition 'Suspended solids from the sample are separated then stained using an Alcian blue solution - a family of polyvalent basic dyes used for tissue preparation in microscopy to target specific anionic groups.'@en ;
    skos:notation 'SDN:S03::S03479'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03478/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03478/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03478/>;
    dc:modified '2024-08-29T09:52:38'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'filtration, hydrolysis, reaction with ortho-phthalaldehyde'@en ;
    skos:definition 'Physical separation of the solid phase from a volume of water or air before the phase of interest was treated with reagents to initiate a hydrolysis reaction followed by reaction with ortho-phthalaldehyde (OPA).'@en ;
    skos:notation 'SDN:S03::S03478'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03477/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03477/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03477/>;
    dc:modified '2024-02-07T12:28:17'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'no filtration'@en ;
    skos:definition 'The sample has not undergone any physical separatation of the solid and liquid phases. This code is to be used alongside the appropriate matrix and only in cases where this needs to be made very clear to avoid confusion.'@en ;
    skos:notation 'SDN:S03::S03477'^^xsd:string .
