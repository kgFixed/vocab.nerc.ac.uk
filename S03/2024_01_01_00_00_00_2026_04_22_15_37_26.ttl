    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'in-vitro incubation in the dark on in-situ rig'@en ;
    skos:definition 'The sample was retained in darkness or in a darkened bottle for a predetermined period on a rig deployed close to its original location and depth of collection.'@en ;
    skos:notation 'SDN:S03::S03482'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03481/1/> .
