<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03485/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03485/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03485/>;
    dc:modified '2025-07-10T13:16:27'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'PvI incubation, filtration, acidification'@en ;
    skos:definition 'Aliquots of the sample inoculated with radioactive dissolved inorganic carbon were retained at various known light levels for a predetermined period before the particulate phase was extracted by filtration and acid was added to remove any remaining inorganic radioactivity prior to counting.'@en ;
    skos:notation 'SDN:S03::S03485'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03484/1/> .
