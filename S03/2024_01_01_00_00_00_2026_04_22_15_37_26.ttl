    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'in-situ pore water sampling, filtration, acidification'@en ;
    skos:definition 'Samples of sediment pore water were taken using a specialised in-situ apparatus and particulates were physically removed by filtration. Samples were acidified prior to analysis.'@en ;
    skos:notation 'SDN:S03::S03484'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03483/1/> .
