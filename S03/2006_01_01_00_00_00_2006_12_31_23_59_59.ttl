    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'sediment trapping'@en ;
    skos:definition 'The sample has been collected using a device designed to collect material as it sinks down through the water column.'@en ;
    skos:notation 'SDN:S03::S0330'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S0331/1/> .
