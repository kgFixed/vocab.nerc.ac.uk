    skos:definition 'Aliquots of the sample inoculated with radioactive dissolved inorganic carbon were retained at various known light levels for a predetermined period before the particulate phase was extracted by filtration.'@en ;
    skos:notation 'SDN:S03::S0358'^^xsd:string .
