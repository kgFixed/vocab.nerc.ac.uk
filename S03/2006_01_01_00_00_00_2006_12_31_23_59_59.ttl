    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'enzyme digestion, purging, cryogenic trapping'@en ;
    skos:definition 'The sample was treated with enzyme to convert the target analyte into dissolved gaseous form that was then stripped by passing inert gas through the sample and collected in a liquid nitrogen trap.'@en ;
    skos:notation 'SDN:S03::S0387'^^xsd:string .
