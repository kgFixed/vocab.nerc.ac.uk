    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'DAPI/proflavine staining'@en ;
    skos:definition 'The sample has been stained using DAPI (4\',6-diamidino-2-phenylindole), a fluorescent stain that binds strongly to DNA and more weakly to RNA in both live and fixed cells with proflavine, a disinfectant bacteriostatic against many gram-positive bacteria.'@en ;
    skos:notation 'SDN:S03::S032'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03204/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03204/1/>
    a skos:Concept ;
