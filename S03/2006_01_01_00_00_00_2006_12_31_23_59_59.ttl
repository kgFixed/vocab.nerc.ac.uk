<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03231/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03231/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03231/>;
    dc:modified '2006-07-24T08:12:01'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'eosin staining'@en ;
    skos:definition 'The sample has been stained using eosin, a blue or yellow coal tar dye useful for colouring cytoplasm.'@en ;
    skos:notation 'SDN:S03::S03231'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03230/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03230/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03230/>;
    dc:modified '2006-07-07T11:38:36'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'bulk aerosol extraction'@en ;
    skos:definition 'The collection of aerosol droplets of all sizes from an air sample, usually be condensation onto a moistened filter.'@en ;
    skos:notation 'SDN:S03::S03230'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03228/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03228/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03228/>;
    dc:modified '2006-06-19T11:59:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'micromilling'@en ;
    skos:definition 'Microscopic-scale, precision drilling of a solid substrate to extract a fine powder for further analysis.'@en ;
    skos:notation 'SDN:S03::S03228'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03219/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03219/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03219/>;
    dc:modified '2006-05-04T11:13:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel '3H leucine doping, incubation in the dark, centrifugation'@en ;
    skos:definition 'Addition of leucine (an amino acid) radiotracer with hydrogen labelled (carbon is a possible alternative) followed by storage for a predetermined period in darkness and extraction of the solid phase for assay using a centrifuge.'@en ;
    skos:notation 'SDN:S03::S03219'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S0320/2/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S0320/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S0320/>;
    dc:modified '2006-04-27T09:08:10'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'parallel incubations with and without grazers, acridine orange staining'@en ;
    skos:definition 'Aliquots of the sample, one of which has had zooplankton removed, have been retained, usually under controlled conditions, for a predetermined time. After incubation the samples were stained with acridine orange (3,6-dimethylaminoacridine), a nucleic acid selective metachromatic stain useful for cell cycle determination.'@en ;
    skos:notation 'SDN:S03::S0320'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03227/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03227/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03227/>;
    dc:modified '2006-04-27T08:18:28'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'melting of core section'@en ;
    skos:definition 'Conversion of the sample from solid to liquid by raising its temperature. Generally refers to ice cores.'@en ;
    skos:notation 'SDN:S03::S03227'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S031/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S031/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S031/>;
    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'DAPI staining'@en ;
    skos:definition 'The sample has been stained using DAPI (4\',6-diamidino-2-phenylindole), a fluorescent stain that binds strongly to DNA and more weakly to RNA in both live and fixed cells'@en ;
    skos:notation 'SDN:S03::S031'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S0310/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S0310/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S0310/>;
    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'incubation'@en ;
    skos:definition 'The water sample has been retained, usually under controlled conditions, for a predetermined length of time prior to analysis.'@en ;
    skos:notation 'SDN:S03::S0310'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03107/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03107/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03107/>;
    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'filtration, incubation'@en ;
    skos:definition 'The sample has been filtered to exclude plants and/or animals above a certain size before being held, usually under controlled conditions, for a predetermined length of time.'@en ;
    skos:notation 'SDN:S03::S03107'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03108/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03108/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03108/>;
    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'filtration, incubation in natural sunlight, enzyme reduction to DMS'@en ;
    skos:definition 'The sample has been filtered to remove the solid phase (prevents biological activity) before being retained for a specified period in full natural light. At the end of the incubation an enzyme was added to convert the target analyte (usually DMSO) to dimethylsulphide for assay.'@en ;
    skos:notation 'SDN:S03::S03108'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03109/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03109/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03109/>;
    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'filtration, incubation in natural sunlight, purging, cryogenic trapping'@en ;
    skos:definition 'The sample was filtered to remove particulates (prevents biological activity) before being held for a predetermined time in full natural light. Dissolved gases were stripped by passing inert gas through the sample and collected in a liquid nitrogen trap.'@en ;
    skos:notation 'SDN:S03::S03109'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S0311/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S0311/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S0311/>;
    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'incubation at constant temperature'@en ;
    skos:definition 'The water sample is retained at a predetermined constant temperature for a predetermined length of time prior to analysis.'@en ;
    skos:notation 'SDN:S03::S0311'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03110/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03110/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03110/>;
    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'filtration, incubation in the dark, enzyme reduction to DMS'@en ;
    skos:definition 'The sample has been filtered to remove the solid phase (prevents biological activity) before being retained for a specified period in darkness. At the end of the incubation an enzyme was added to convert the target analyte (usually DMSO) to dimethylsulphide for assay.'@en ;
    skos:notation 'SDN:S03::S03110'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03111/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03111/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03111/>;
    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'filtration, incubation in the dark, purging, cryogenic trapping'@en ;
    skos:definition 'The sample was filtered to remove particulates (prevents biological activity) before being held for a predetermined time in darkness. Dissolved gases were stripped by passing inert gas through the sample and collected in a liquid nitrogen trap.'@en ;
    skos:notation 'SDN:S03::S03111'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03112/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03112/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03112/>;
    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'filtration, incubation in ultra-violet light, enzyme reduction to DMS'@en ;
    skos:definition 'The sample has been filtered to remove the solid phase (prevents biological activity) before being retained for a specified period under ultra-violet light. At the end of the incubation an enzyme was added to convert the target analyte (usually DMSO) to dimethylsulphide for assay.'@en ;
    skos:notation 'SDN:S03::S03112'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03118/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03118/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03118/>;
    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'filtration, purging, cryogenic trapping'@en ;
    skos:definition 'The sample was filtered to remove particulates (prevents biological activity) before dissolved gases were stripped by passing inert gas through the sample and collected in a liquid nitrogen trap.'@en ;
    skos:notation 'SDN:S03::S03118'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S0312/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S0312/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S0312/>;
    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'incubation in filtered seawater'@en ;
    skos:definition 'Specimens, usually zooplankton, are retained in seawater that has been filtered to remove particulate food items for a predetermined length of time.'@en ;
    skos:notation 'SDN:S03::S0312'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03122/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03122/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03122/>;
    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'flux-diluted fused bead preparation'@en ;
    skos:definition 'The sample is mixed with a chemical flux, usually lithium fluoride, and heated to produce a melt which solidifies into a glass bead.'@en ;
    skos:notation 'SDN:S03::S03122'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03124/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03124/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03124/>;
    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'filtration, hydrolysis'@en ;
    skos:definition 'Chemical reaction with reagents that break down molecules by addition of a water molecule, such as strong acids or alkalis.'@en ;
    skos:notation 'SDN:S03::S03124'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03125/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03125/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03125/>;
    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'ignition at 400C'@en ;
    skos:definition 'The sample was heated in air at 400C.'@en ;
    skos:notation 'SDN:S03::S03125'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03129/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03129/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03129/>;
    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'in-situ light and dark bottle incubation'@en ;
    skos:definition 'Aliquots of the sample were retained for a predetermined period on a rig at its location and depth of collection in both clear and totally opaque containers.'@en ;
    skos:notation 'SDN:S03::S03129'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S0313/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S0313/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S0313/>;
    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'methanol extraction'@en ;
    skos:definition 'The sample has been mixed with methanol solvent to extract soluble compounds, usually plant pigments.'@en ;
    skos:notation 'SDN:S03::S0313'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03131/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03131/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03131/>;
    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'in-situ pore water sampling, filtration'@en ;
    skos:definition 'Samples of sediment pore water were taken using a specialised in-situ apparatus and further purified by passing through a filter.'@en ;
    skos:notation 'SDN:S03::S03131'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03132/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03132/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03132/>;
    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'in-situ pore water sampling, filtration, chelation, solvent extraction'@en ;
    skos:definition 'Samples of sediment pore water were taken using a specialised in-situ apparatus and further purified by passing through a filter and analysed for dissolved metals by complexing with a chelating agent (e.g. EDTA) and extracted the resulting complex in a solvent.'@en ;
    skos:notation 'SDN:S03::S03132'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03134/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03134/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03134/>;
    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'incubation at full natural light level'@en ;
    skos:definition 'The sample was retained for a predetermined period in full natural light.'@en ;
    skos:notation 'SDN:S03::S03134'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03135/1/> .
