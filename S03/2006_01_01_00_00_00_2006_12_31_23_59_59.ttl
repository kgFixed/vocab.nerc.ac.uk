    skos:prefLabel 'acridine orange staining'@en ;
    skos:definition 'The sample has been stained using acridine orange (3,6-dimethylaminoacridine), a nucleic acid selective metachromatic stain useful for cell cycle determination.'@en ;
    skos:notation 'SDN:S03::S034'^^xsd:string .
