    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'tracer doping, on-deck incubation at simulated in-situ light level'@en ;
    skos:definition 'A dissolved radioactive or stable isotope tracer was added to the sample which was held in a surface seawater bath for a predetermined time at a reduced (by partial shading) natural light level designed to mimic that at collection depth before filtration to collect the particulate phase.'@en ;
    skos:notation 'SDN:S03::S03214'^^xsd:string .
