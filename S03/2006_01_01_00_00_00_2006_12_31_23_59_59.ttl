    skos:prefLabel 'tracer doping, on-deck incubation at full natural light level, filtration'@en ;
    skos:definition 'The sample, inoculated with dissolved radioactive or stable isotope tracer, was retained for a predetermined period in a surface seawater bath in full natural light (level usually documented elsewhere) before filtration to isolate the particulate phase.'@en ;
    skos:notation 'SDN:S03::S03213'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03214/1/> .
