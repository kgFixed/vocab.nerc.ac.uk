    skos:prefLabel 'variable volume sampling, sieving, picking'@en ;
    skos:definition 'A random volume of sediment was taken from a core sample, sieved to remove fine sediment and biological specimens or microfossils manually extracted from the residue.'@en ;
    skos:notation 'SDN:S03::S0335'^^xsd:string .
