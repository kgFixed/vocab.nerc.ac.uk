    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03136/>;
    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'leaching'@en ;
    skos:definition 'Treatment of a sample with reagents designed to extract analyte in a particular chemical state within the sample.'@en ;
    skos:notation 'SDN:S03::S03136'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03137/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03137/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03137/>;
    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'light and dark bottle incubation'@en ;
    skos:definition 'Aliquots of the sample were retained for a predetermined period at a range of light levels and in total darkness.'@en ;
    skos:notation 'SDN:S03::S03137'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03138/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03138/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03138/>;
    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'mesocosm simulated resuspension'@en ;
    skos:definition 'The sample was taken from a mesocosm following a simulated resuspension event created by vigorous stirring.'@en ;
    skos:notation 'SDN:S03::S03138'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03139/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03139/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03139/>;
    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'no acidification'@en ;
    skos:definition 'There is explicit information that the sample, usually for carbon analysis, had not been treated with acid to remove inorganic carbon.'@en ;
    skos:notation 'SDN:S03::S03139'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S0314/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S0314/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S0314/>;
    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'no preservation and no staining'@en ;
    skos:definition 'The sample has been examined, usually immediately after collection, without commonly applied processing to reduce the risk of biological material degradation.'@en ;
    skos:notation 'SDN:S03::S0314'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03142/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03142/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03142/>;
    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'on-deck incubation'@en ;
    skos:definition 'The sample was retained for a predetermined period in a surface seawater bath at a light level (usually documented elsewhere) produced by quantitative shading of natural light.'@en ;
    skos:notation 'SDN:S03::S03142'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03143/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03143/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03143/>;
    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'on-deck incubation with nutrients, filtration'@en ;
    skos:definition 'The sample, with nutrients present either at ambient or enhanced concentrations, has been retained in an incubator flushed by surface seawater in either full natural light or natural light reduced by a known amount using screens.  This was followed by filtration to isolate the particulate phase for analysis.'@en ;
    skos:notation 'SDN:S03::S03143'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03144/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03144/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03144/>;
    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'on-deck incubation without nutrients, filtration'@en ;
    skos:definition 'The sample, from which nutrients have been excluded, has been retained in an incubator flushed by surface seawater in either full natural light or natural light reduced by a known amount using screens.  This was followed by filtration to isolate the particulate phase for analysis.'@en ;
    skos:notation 'SDN:S03::S03144'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03145/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03145/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03145/>;
    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'on-deck light and dark bottle incubation'@en ;
    skos:definition 'Aliquots of the sample were retained for a predetermined period in a surface seawater bath at a range of light levels produced by quantitative shading of natural light and in total darkness.'@en ;
    skos:notation 'SDN:S03::S03145'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03146/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03146/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03146/>;
    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'on-deck mesocosm incubation'@en ;
    skos:definition 'The sample, usually a sediment core, was retained for a predetermined period in shipboard conditions reproducing the environment in which it was collected as closely as possible.  For deep sea samples this usually includes filling the mesocosm with  bottom water collected from the sampling site and a controlled temperature laboratory.'@en ;
    skos:notation 'SDN:S03::S03146'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03149/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03149/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03149/>;
    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'oxalic acid extraction'@en ;
    skos:definition 'The analyte was leached from the sample by attack with oxalic acid. This selectively samples the amorphous phase of the sample.'@en ;
    skos:notation 'SDN:S03::S03149'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S0315/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S0315/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S0315/>;
    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'no staining'@en ;
    skos:definition 'The sample has been examined without staining to reduce the risk of biological material degradation.'@en ;
    skos:notation 'SDN:S03::S0315'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03150/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03150/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03150/>;
    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'oxidation'@en ;
    skos:definition 'Treatment of the sample with a chemical oxidising agent.'@en ;
    skos:notation 'SDN:S03::S03150'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03151/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03151/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03151/>;
    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'persulphate digestion'@en ;
    skos:definition 'The sample was treated with persulphate to dissolve any particulate phase present.'@en ;
    skos:notation 'SDN:S03::S03151'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03152/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03152/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03152/>;
    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'digestion, purification, plating'@en ;
    skos:definition 'The sample was totally dissolved by aggressive attack with strong acid, chemically processed to remove impurities and then deposited onto a substrate ready for radio-isotope assay.'@en ;
    skos:notation 'SDN:S03::S03152'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03153/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03153/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03153/>;
    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'plating'@en ;
    skos:definition 'Deposition of the sample onto a substrate ready for radio-isotope assay.'@en ;
    skos:notation 'SDN:S03::S03153'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03154/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03154/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03154/>;
    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'polyacrylamide gel probe sampling'@en ;
    skos:definition 'A dissolved substance, usually a trace metal, sample was obtained using a scavenging gel.'@en ;
    skos:notation 'SDN:S03::S03154'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03156/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03156/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03156/>;
    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'purging, cryogenic trapping'@en ;
    skos:definition 'Dissolved gases were stripped from the sample by passing inert gas through the sample and collected in a liquid nitrogen trap.'@en ;
    skos:notation 'SDN:S03::S03156'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S0316/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S0316/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S0316/>;
    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'not specified'@en ;
    skos:definition 'The sample may, and probably has, undergone some form of processing but no information is given concerning this.'@en ;
    skos:notation 'SDN:S03::S0316'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03160/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03160/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03160/>;
    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'sediment trapping, acetone extraction'@en ;
    skos:definition 'The sample has been collected using a device designed to collect material as it sinks down through the water column then mixed with acidified acetone to extract analytes, usually plant pigments.'@en ;
    skos:notation 'SDN:S03::S03160'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03161/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03161/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03161/>;
    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'sediment trapping, acid digestion'@en ;
    skos:definition 'The sample has been collected using a device designed to collect material as it sinks down through the water column then completely dissolved by aggressive attack with strong acid.'@en ;
    skos:notation 'SDN:S03::S03161'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03162/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03162/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03162/>;
    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'sediment trapping, acid hydrolysis'@en ;
    skos:definition 'The sample has been collected using a device designed to collect material as it sinks down through the water column then reacted with acid to liberate amino acids.'@en ;
    skos:notation 'SDN:S03::S03162'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03163/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03163/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03163/>;
    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'sediment trapping, acidification'@en ;
    skos:definition 'The sample has been collected using a device designed to collect material as it sinks down through the water column then treated with acid to remove inorganic carbon.'@en ;
    skos:notation 'SDN:S03::S03163'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03164/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03164/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03164/>;
    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'sediment trapping, combustion'@en ;
    skos:definition 'The sample has been collected using a device designed to collect material as it sinks down through the water column then strongly heated in air.'@en ;
    skos:notation 'SDN:S03::S03164'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03165/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03165/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03165/>;
    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'sediment trapping, methanol extraction'@en ;
    skos:definition 'The sample has been collected using a device designed to collect material as it sinks down through the water column then mixed with methanol to extract analytes, usually plant pigments.'@en ;
    skos:notation 'SDN:S03::S03165'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03166/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03166/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03166/>;
    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'sediment trapping, no acidification'@en ;
    skos:definition 'The sample has been collected using a device designed to collect material as it sinks down through the water column. There is explicit information that there was no treatment to remove inorganic carbon.'@en ;
    skos:notation 'SDN:S03::S03166'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03167/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03167/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03167/>;
    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'sediment trapping, oxidation'@en ;
    skos:definition 'The sample has been collected using a device designed to collect material as it sinks down through the water column then treated with a chemical oxidising agent.'@en ;
    skos:notation 'SDN:S03::S03167'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03168/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03168/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03168/>;
    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'sediment trapping, solvent extraction'@en ;
    skos:definition 'The sample has been collected using a device designed to collect material as it sinks down through the water column then mixed with an unspecified solvent to extract analytes.'@en ;
    skos:notation 'SDN:S03::S03168'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03169/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03169/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03169/>;
    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'sediment trapping, volume measurement, drying'@en ;
    skos:definition 'The sample has been collected using a device designed to collect material as it sinks down through the water column then the physical volume of the wet sample was obtained before water was removed by gentle warming, freezing in a vacuum or storage in a desiccator.'@en ;
    skos:notation 'SDN:S03::S03169'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S0317/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S0317/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S0317/>;
    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'on-deck incubation dilution experiment'@en ;
    skos:definition 'The sample has been taken from one of a series of incubations of a seawater sample at multiple dilutions in an incubator flushed by surface seawater in either full natural light or natural light reduced by a known amount using screens. This is usually associated with the quantification of phytoplankton consumption by grazers.'@en ;
    skos:notation 'SDN:S03::S0317'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03172/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03172/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03172/>;
    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'siphoning'@en ;
    skos:definition 'The sample, usually sediment pore water or water overlying a core sample, was obtained by gentle mechanical extraction designed to minimise sample disturbance.'@en ;
    skos:notation 'SDN:S03::S03172'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03175/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03175/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03175/>;
    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'tracer doping, antibiotic poisoning, incubation at 100uE/m2/s light level, cascade filtration'@en ;
    skos:definition 'A dissolved radioactive or stable isotope tracer was added to the sample which was poisoned with antibiotic (to eliminate bacteria), held for a predetermined time at the stated light intensity before filtration to collect the particulate phase as size fractions.'@en ;
    skos:notation 'SDN:S03::S03175'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03176/1/> .
