    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'tracer doping, antibiotic poisoning, incubation at 188uE/m2/s light level, cascade filtration'@en ;
    skos:definition 'A dissolved radioactive or stable isotope tracer was added to the sample which was poisoned with antibiotic (to eliminate bacteria), held for a predetermined time at the stated light intensity before filtration to collect the particulate phase as size fractions.'@en ;
    skos:notation 'SDN:S03::S03177'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03178/1/> .
