    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'acetone extraction'@en ;
    skos:definition 'The sample has been mixed with acetone solvent, usually acidified, to extract soluble compounds, usually plant pigments.'@en ;
    skos:notation 'SDN:S03::S033'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S0330/1/> .
