    skos:prefLabel 'PvI Incubation, cascade filtration'@en ;
    skos:definition 'Aliquots of the sample inoculated with radioactive dissolved inorganic carbon were retained at various known light levels for a predetermined period before the particulate phase was extracted as size fractions by filtration through a series of increasingly fine filters.'@en ;
    skos:notation 'SDN:S03::S0355'^^xsd:string .
