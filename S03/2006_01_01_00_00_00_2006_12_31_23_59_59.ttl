    skos:prefLabel 'PvI incubation, acidification to remove residual inorganic 14C'@en ;
    skos:definition 'Aliquots of the sample inoculated with radioactive dissolved inorganic carbon were retained at various known light levels for a predetermined period before acid was added to remove any remaining inorganic radioactivity prior to counting.'@en ;
    skos:notation 'SDN:S03::S0357'^^xsd:string .
