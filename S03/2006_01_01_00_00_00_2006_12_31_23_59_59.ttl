    skos:prefLabel 'tracer doping, antibiotic poisoning, incubation at 188uE/m2/s light level, filtration'@en ;
    skos:definition 'A dissolved radioactive or stable isotope tracer was added to the sample which was poisoned with antibiotic (to eliminate bacteria), held for a predetermined time at the stated light intensity before filtration to collect the particulate phase.'@en ;
    skos:notation 'SDN:S03::S03178'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S0318/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S0318/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S0318/>;
    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'on-deck incubation with nutrients'@en ;
    skos:definition 'The sample, with nutrients present either at ambient or enhanced concentrations, has been retained in an incubator flushed by surface seawater in either full natural light or natural light reduced by a known amount using screens.'@en ;
    skos:notation 'SDN:S03::S0318'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03181/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03181/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03181/>;
    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'tracer doping, azide poisoning, incubation at 100uE/m2/s light level, cascade filtration'@en ;
    skos:definition 'A dissolved radioactive or stable isotope tracer was added to the sample which was poisoned with azide (to eliminate biological activity), held for a predetermined time at the stated light intensity before filtration to collect the particulate phase as size fractions.'@en ;
    skos:notation 'SDN:S03::S03181'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03186/1/> .
