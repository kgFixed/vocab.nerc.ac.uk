    skos:definition 'A dissolved radioactive or stable isotope tracer was added to the sample which was held for a predetermined time at the stated light intensity before filtration to collect the particulate phase.'@en ;
    skos:notation 'SDN:S03::S03188'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03189/1/> .
