    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'tracer doping, on-deck incubation at full natural light level, cascade filtration'@en ;
    skos:definition 'The sample, inoculated with dissolved radioactive or stable isotope tracer, was retained for a predetermined period in a surface seawater bath at a light level produced by quantitative shading of natural light (level usually documented elsewhere) before filtration to isolate the particulate phase as size fractions.'@en ;
    skos:notation 'SDN:S03::S03212'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03213/1/> .
