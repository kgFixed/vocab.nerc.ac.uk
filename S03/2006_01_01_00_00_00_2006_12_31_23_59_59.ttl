    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03135/>;
    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'incubation under ultra-violet light'@en ;
    skos:definition 'The sample was retained for a predetermined period under ultra-violet light.'@en ;
    skos:notation 'SDN:S03::S03135'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03136/1/> .
