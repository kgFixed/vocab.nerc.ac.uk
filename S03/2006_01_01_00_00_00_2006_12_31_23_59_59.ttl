    skos:altLabel ''^^xsd:string ;
    skos:prefLabel '14C-glucose doping, incubation in the dark, purging with air, acid washing'@en ;
    skos:definition 'The sample was doped with radioactive glucose, retained for a predetermined time in darkness before dissolved gases were stripped and washed.'@en ;
    skos:notation 'SDN:S03::S0338'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S0339/1/> .
