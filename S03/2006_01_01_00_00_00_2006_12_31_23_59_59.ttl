    dc:modified '2006-04-27T08:10:59'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'tracer doping, incubation at unspecified light level, filtration, acidification'@en ;
    skos:definition 'A dissolved radioactive or stable isotope tracer was added to the sample which was held for a predetermined time at an unstated (usually documented elsewhere) light intensity before filtration to collect the particulate phase.  This was then treated with acid to remove inorganic carbon.'@en ;
    skos:notation 'SDN:S03::S03204'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03205/1/> .
