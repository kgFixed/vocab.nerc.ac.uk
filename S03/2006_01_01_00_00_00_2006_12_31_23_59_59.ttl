    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'sieving and picking under an optical microscope'@en ;
    skos:definition 'Sediment was sieved to remove fines and biological specimens or microfossils manually extracted from the residue.'@en ;
    skos:notation 'SDN:S03::S0331'^^xsd:string .
