    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S0399/>;
    dc:modified '2010-02-18T12:05:12'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'filtration, acid digestion'@en ;
    skos:definition 'Physical separation of the solid phase from a volume of water or air before the solid phase was totally absorbed by aggressive attack with strong acid.'@en ;
    skos:notation 'SDN:S03::S0399'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03412/1/> .
