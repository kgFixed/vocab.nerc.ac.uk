    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S0393/>;
    dc:modified '2010-02-18T12:05:12'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'filtration'@en ;
    skos:definition 'Physical separation of the solid and liquid phases of a water sample.'@en ;
    skos:notation 'SDN:S03::S0393'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S0395/2/> .
