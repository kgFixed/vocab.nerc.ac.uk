    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03217/>;
    dc:modified '2010-06-25T16:37:22'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'isotope-labelled tracer addition, on-deck incubation at simulated in-situ light level, filtration, acidification'@en ;
    skos:definition 'A dissolved radioactive or stable isotope tracer was added to the sample which was held for a predetermined time, in a surface seawater bath and quantitatively shaded natural light (levels usually documented elsewhere) before filtration to collect the particulate phase.  This was then treated with acid to remove inorganic carbon.'@en ;
    skos:notation 'SDN:S03::S03217'^^xsd:string .
