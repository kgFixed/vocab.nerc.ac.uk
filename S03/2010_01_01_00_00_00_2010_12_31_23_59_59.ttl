    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03182/>;
    dc:modified '2010-01-10T14:44:52'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'isotope-labelled tracer addition, azide poisoning, incubation at unspecified light level, cascade filtration'@en ;
    skos:definition 'A dissolved radioactive or stable isotope tracer was added to the sample which was poisoned with azide (to eliminate biological activity), held for a predetermined time at an unstated (usually documented elsewhere) light intensity before filtration to collect the particulate phase as size fractions.'@en ;
    skos:notation 'SDN:S03::S03182'^^xsd:string .
