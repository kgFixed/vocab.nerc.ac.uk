    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'filtration, acidification, chelation, solvent extraction'@en ;
    skos:definition 'Physical separation of the solid phase from a volume of water or air before the acidified (pH 1.8-2) liquid phase was treated with a chelating agent (e.g. a dithiocarbamate or EDTA) to form complexes that were stripped out for analysis using a solvent.'@en ;
    skos:notation 'SDN:S03::S03103'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03418/1/> .
