    dc:modified '2010-03-19T15:16:16'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'solvent extraction'@en ;
    skos:definition 'Separation of analytes by mixing either solid samples with a liquid in which the analyte is soluble or mixing liquid samples with another liquid in which the analyte is more soluble.'@en ;
    skos:notation 'SDN:S03::S03418'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03417/1/> .
