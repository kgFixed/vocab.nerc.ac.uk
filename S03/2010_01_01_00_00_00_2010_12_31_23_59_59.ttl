    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S0396/>;
    dc:modified '2010-02-18T12:05:12'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'filtration, HgCl2 preservation'@en ;
    skos:definition 'Physical separation of the solid phase from a volume of water or air before addition of a strong poison to halt biological activity.'@en ;
    skos:notation 'SDN:S03::S0396'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S0397/2/> .
