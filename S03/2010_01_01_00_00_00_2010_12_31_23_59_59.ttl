    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03411/>;
    dc:modified '2010-01-18T09:18:56'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Soxhlet extraction'@en ;
    skos:definition 'Method for extraction of the soluble fraction of a powdered solid sample by repeated washing with a solvent.'@en ;
    skos:notation 'SDN:S03::S03411'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03410/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03410/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03410/>;
    dc:modified '2010-01-11T11:21:54'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'filtration, DNA extraction, PicoGreen staining, primer selection'@en ;
    skos:definition 'Separation of suspended solids from the sample, which then has its DNA content extracted, labelled with PicoGreen for quantification and processing to target specific subcomponents (genes) of the DNA molecules'@en ;
    skos:notation 'SDN:S03::S03410'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03182/2/> .
