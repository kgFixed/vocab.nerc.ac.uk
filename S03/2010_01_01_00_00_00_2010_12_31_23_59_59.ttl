    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'filtration, DNA extraction, PicoGreen staining'@en ;
    skos:definition 'Separation of suspended solids from the sample, which then has its DNA content extracted and labelled with PicoGreen for quantification'@en ;
    skos:notation 'SDN:S03::S03409'^^xsd:string .
