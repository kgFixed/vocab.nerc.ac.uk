    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'filtration with Teflon filter'@en ;
    skos:definition 'Physical separation of the solid phase from a volume of water or air using a specific type of plastic filter.'@en ;
    skos:notation 'SDN:S03::S0395'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S0396/2/> .
