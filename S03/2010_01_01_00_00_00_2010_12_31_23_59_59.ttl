    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'isotope-labelled tracer addition, azide poisoning, incubation at unspecified light level, filtration'@en ;
    skos:definition 'A dissolved radioactive or stable isotope tracer was added to the sample which was poisoned with azide (to eliminate biological activity), held for a predetermined time at an unstated (usually documented elsewhere) light intensity before filtration to collect the particulate phase.'@en ;
    skos:notation 'SDN:S03::S03183'^^xsd:string .
