    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03412/>;
    dc:modified '2010-02-08T10:02:13'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'cascade impaction'@en ;
    skos:definition 'A process to separate out particles into size fractions by passing the sample repeatedly through acceleration nozzles onto inert impaction substrates that retain the particles.'@en ;
    skos:notation 'SDN:S03::S03412'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03411/2/> .
