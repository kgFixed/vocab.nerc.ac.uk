    dc:modified '2010-08-24T09:51:52'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'preservation, filtration'@en ;
    skos:definition 'Sample has been treated with preserative to fix biological material before physical separation of the solid and liquid phases'@en ;
    skos:notation 'SDN:S03::S03422'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03420/2/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03420/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03420/>;
    dc:modified '2010-07-28T11:48:22'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'filtration, sudan-1 synthesis, SPE extraction, HPLC purification'@en ;
    skos:definition 'Concentration determined through sudan-1 synthesis, SPE extraction and HPLC purification. A deuterate internal standard was used to quantify nitrite concentration.'@en ;
    skos:notation 'SDN:S03::S03420'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03421/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03421/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03421/>;
    dc:modified '2010-07-28T11:02:21'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'isotope-labelled tracer addition, incubation, filtration, sudan-1 synthesis, SPE extraction, HPLC purification'@en ;
    skos:definition 'Derived from magnitude of the dilution of added 15NO2- tracer by determining isotopic enrichment and ambient NO2 concentrations immediately prior to and following incubation.'@en ;
    skos:notation 'SDN:S03::S03421'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03419/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03419/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03419/>;
    dc:modified '2010-06-30T12:07:24'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'filtration, incubation at unspecified light level, purging, cryogenic trapping'@en ;
    skos:definition 'A water sample was filtered to remove particulates above a specified size and held for a predetermined time at an unstated (documented elsewhere) light intensity. Volatiles for analysis were extracted by passing an inert gas through the sample and trapping at liquid nitrogen temperatures.'@en ;
    skos:notation 'SDN:S03::S03419'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03401/2/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03401/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03401/>;
    dc:modified '2010-06-25T16:38:33'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'isotope-labelled tracer addition, on-deck incubation at simulated in-situ light level, cascade filtration, acidification'@en ;
    skos:definition 'A dissolved radioactive or stable isotope tracer was added to the sample which was held for a predetermined time, in a surface seawater bath and quantitatively shaded natural light (level usually designed to mimic collection depth and documented elsewhere) before filtration to collect the particulate phase as size fractions. This was then treated with acid to remove inorganic carbon.'@en ;
    skos:notation 'SDN:S03::S03401'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03217/2/> .
