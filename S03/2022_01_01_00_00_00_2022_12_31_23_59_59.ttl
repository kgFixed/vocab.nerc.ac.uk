    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03455/>;
    dc:modified '2022-05-13T08:17:14'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'sieving, picking'@en ;
    skos:definition 'The sediment was sieved followed by manual extraction of the targeted objects or organisms.'@en ;
