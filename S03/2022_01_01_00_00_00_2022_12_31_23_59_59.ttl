<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03445/2/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03445/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03445/>;
    dc:modified '2022-04-27T17:00:14'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel '15N2-enriched seawater addition, on-deck incubation at simulated in-situ light level, filtration'@en ;
    skos:definition 'A 15N2-tracer addition method which uses 15N2-enriched seawater instead of injecting the tracer directly as a gas bubble; the sample is then held for a predetermined time, in a surface seawater bath and quantitatively shaded natural light (level usually designed to mimic collection depth and documented elsewhere) before filtration to collect the particulate phase.'@en ;
    skos:notation 'SDN:S03::S03445'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03473/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03473/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03473/>;
    dc:modified '2022-03-24T13:53:04'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'carbon-13 isotope-labelled tracer addition, dawn-to-dawn on-deck incubation at simulated in-situ light level, filtration'@en ;
    skos:definition 'A Carbon-13 (13C) stable isotope tracer was added to the sample which was held for 24 hours from dawn to dawn, in an on-deck incubator with controlled light levels designed to mimic in-situ light levels at the collection depth and documented elsewhere before filtration to collect the particulate phase.'@en ;
    skos:notation 'SDN:S03::S03473'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03472/1/> .
<http://vocab.nerc.ac.uk/collection/S03/current/S03472/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S03/current/S03472/>;
    dc:modified '2022-02-28T13:27:09'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'drying, wet sieving <63um, dry sieving >63um'@en ;
    skos:definition 'The sediment is dried, soaked in distilled water for 12 hours, then flushed with distilled water through a <63um sifter to remove particles smaller than 63um. The remaining sediment (>63um) is dried, then sieve analysis is performed.'@en ;
    skos:notation 'SDN:S03::S03472'^^xsd:string .
