    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'shower-head equilibration with air, drying'@en ;
    skos:definition 'The dissolved gas content of a water sample was brought into equilibrium by spraying it into a restricted volume of air which was subsequently dried and analysed, giving the composition of the sample dissolved gas phase.'@en ;
