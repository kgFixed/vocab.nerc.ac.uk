    dc:modified '2007-09-24T13:41:27'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'equilibration with air, drying'@en ;
    skos:definition 'The dissolved gas content of the sample (water or sediment incorporating pore water) was brought into equilibrium with a restricted volume of air which was subsequently dried and analysed, giving the composition of the sample dissolved gas phase.'@en ;
    skos:notation 'SDN:S03::S0388'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S03/current/S03171/2/> .
