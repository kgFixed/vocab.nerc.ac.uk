    dc:modified '2013-08-20T13:53:41'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'moored surface buoy'@en ;
    skos:definition 'An unmanned instrumented platform operating on the surface of the water column loosely tethered to the seafloor to maintain a fixed position (e.g. ODAS buoy).'@en ;
    skos:notation 'SDN:L06::41'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L06/current/44/2/> .
<http://vocab.nerc.ac.uk/collection/L06/current/44/2/>
