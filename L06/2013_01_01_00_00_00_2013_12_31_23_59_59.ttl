    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'drifting subsurface float'@en ;
    skos:definition 'An unmanned instrumented platform drifting freely in the water column at a depth governed by its density (e.g. Swallow float).'@en ;
    skos:notation 'SDN:L06::44'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L06/current/45/2/> .
<http://vocab.nerc.ac.uk/collection/L06/current/45/2/>
