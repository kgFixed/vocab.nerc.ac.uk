    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'fixed benthic node'@en ;
    skos:definition 'A collection of oceanographic instruments mounted at a fixed position on the seabed (e.g. POL Monitoring Platform, seabed ADCP).'@en ;
    skos:notation 'SDN:L06::11'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L06/current/14/3/> .
<http://vocab.nerc.ac.uk/collection/L06/current/14/3/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L06/current/14/>;
    dc:modified '2013-08-20T13:53:41'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'land/onshore structure'@en ;
    skos:definition 'A fixed man-made structure on land to which instrumentation may be attached (e.g. meteorological tower).'@en ;
    skos:notation 'SDN:L06::14'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L06/current/16/3/> .
<http://vocab.nerc.ac.uk/collection/L06/current/16/3/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L06/current/16/>;
    dc:modified '2013-08-20T13:53:41'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'offshore structure'@en ;
    skos:definition 'A fixed (for the duration of the measurements) man-made structure away from the coast to which instrumentation may be attached (e.g. oil rig, gas rig or jack-up barge).'@en ;
    skos:notation 'SDN:L06::16'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L06/current/17/3/> .
<http://vocab.nerc.ac.uk/collection/L06/current/17/3/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L06/current/17/>;
    dc:modified '2013-08-20T13:53:41'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'coastal structure'@en ;
    skos:definition 'A fixed man-made structure permanently linked to land with access to water at all states of the tide to which instrumentation may be attached (e.g. pier).'@en ;
    skos:notation 'SDN:L06::17'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L06/current/21/2/> .
<http://vocab.nerc.ac.uk/collection/L06/current/21/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L06/current/21/>;
    dc:modified '2013-08-20T13:53:41'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'propelled manned submersible'@en ;
    skos:definition 'A platform operating in the water column that has both self-contained propulsion and at least one human operator on board (e.g. submarine).'@en ;
    skos:notation 'SDN:L06::21'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L06/current/23/2/> .
<http://vocab.nerc.ac.uk/collection/L06/current/23/2/>
    a skos:Concept ;
