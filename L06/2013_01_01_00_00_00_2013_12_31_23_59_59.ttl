    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'fixed subsurface vertical profiler'@en ;
    skos:definition 'A platform that periodically makes an automated vertical traverse of the water column at a predetermined fixed location. (e.g. YSI vertical profiler, HOMER CTD).'@en ;
    skos:notation 'SDN:L06::45'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L06/current/46/2/> .
