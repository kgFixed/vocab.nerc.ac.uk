    skos:prefLabel 'drifting subsurface profiling float'@en ;
    skos:definition 'An unmanned instrumented platform drifting freely in the water column that periodically makes vertical traverses through the water column (e.g. Argo float).'@en ;
    skos:notation 'SDN:L06::46'^^xsd:string .
