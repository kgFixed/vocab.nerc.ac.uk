    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'towed unmanned submersible'@en ;
    skos:definition 'A vehicle towed by rigid cable through the water column at fixed or varying depth with no propulsion and no human operator (e.g. Towfish, Scanfish, UOR, SeaSoar).'@en ;
    skos:notation 'SDN:L06::23'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L06/current/41/2/> .
