    dc:modified '2013-08-20T14:00:20'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'surface ice buoy'@en ;
    skos:definition 'An undrogued (i.e. no sub-surface parachute) surface float that is deployed in regions where sea ice forms that moves with either ice or water depending upon the time of year.'@en ;
    skos:notation 'SDN:L06::49'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L06/current/27/1/> .
<http://vocab.nerc.ac.uk/collection/L06/current/27/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L06/current/27/>;
    dc:modified '2013-08-20T13:56:39'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'sub-surface gliders'@en ;
    skos:definition 'Platforms with buoyancy-based propulsion that are capable of operations at variable depths which are not constrained to be near the sea surface.'@en ;
    skos:notation 'SDN:L06::27'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L06/current/11/2/> .
<http://vocab.nerc.ac.uk/collection/L06/current/11/2/>
    a skos:Concept ;
