    skos:notation 'SDN:L06::6C'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L06/current/71/1/> .
<http://vocab.nerc.ac.uk/collection/L06/current/71/1/>
    a skos:Concept ;
