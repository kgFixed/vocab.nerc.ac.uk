    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'tethered balloon'@en ;
    skos:definition 'A container filled with a gas that is lighter than air, which is tethered at a fixed height and location.'@en ;
    skos:notation 'SDN:L06::53'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L06/current/52/2/> .
