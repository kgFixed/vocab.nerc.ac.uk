    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'seabird and duck'@en ;
    skos:definition 'A flighted bird that is able to exist on the water column surface and dive into the water column (e.g. cormorants, auks, ducks and gulls).'@en ;
    skos:notation 'SDN:L06::74'^^xsd:string .
