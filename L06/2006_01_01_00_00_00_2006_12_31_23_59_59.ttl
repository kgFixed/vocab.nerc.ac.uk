    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'flightless bird'@en ;
    skos:definition 'A bird that is unable to fly with the ability to exist within the water column (e.g. penguin).'@en ;
    skos:notation 'SDN:L06::73'^^xsd:string .
