    skos:prefLabel 'kite'@en ;
    skos:definition 'An aerofoil tethered to the ground held aloft by the wind.'@en ;
    skos:notation 'SDN:L06::6B'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L06/current/6C/1/> .
