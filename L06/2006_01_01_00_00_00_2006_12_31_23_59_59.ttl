    dc:modified '2006-07-07T10:48:37'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'free-floating balloon'@en ;
    skos:definition 'A container filled with a gas that is lighter than air, which is free to drift in the atmosphere.'@en ;
    skos:notation 'SDN:L06::52'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L06/current/51/2/> .
<http://vocab.nerc.ac.uk/collection/L06/current/51/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L06/current/51/>;
    dc:modified '2006-07-07T10:48:26'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'free-rising balloon'@en ;
    skos:definition 'A container filled with a gas that is lighter than air, which is constrained to rise vertically at a fixed location.'@en ;
    skos:notation 'SDN:L06::51'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L06/current/0/1/> .
