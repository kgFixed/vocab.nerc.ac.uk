<feed> tree:member <http://vocab.nerc.ac.uk/collection/L06/current/12/1/> .
<http://vocab.nerc.ac.uk/collection/L06/current/12/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L06/current/12/>;
    dc:modified '2006-07-07T10:38:37'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'sea bed vehicle'@en ;
    skos:definition 'An instrumented platform that is propelled on wheels or tracks on the seabed (e.g benthic crawler).'@en ;
    skos:notation 'SDN:L06::12'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L06/current/13/1/> .
<http://vocab.nerc.ac.uk/collection/L06/current/13/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L06/current/13/>;
    dc:modified '2006-07-07T10:38:37'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'beach/intertidal zone structure'@en ;
    skos:definition 'A structure to which instrumentation may be attached that is either in air or under water depending on the state of the tide and weather conditions.'@en ;
    skos:notation 'SDN:L06::13'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L06/current/19/1/> .
<http://vocab.nerc.ac.uk/collection/L06/current/19/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L06/current/19/>;
    dc:modified '2006-07-07T10:38:37'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'mesocosm bag'@en ;
    skos:definition 'A large polythene bag containing a water sample suspended in the natural environment so that it shares ambient physical conditions such as temperature and light levels, but is chemically isolated to allow experiments such as fertilisation.'@en ;
    skos:notation 'SDN:L06::19'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L06/current/22/1/> .
<http://vocab.nerc.ac.uk/collection/L06/current/22/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L06/current/22/>;
    dc:modified '2006-07-07T10:38:37'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'propelled unmanned submersible'@en ;
    skos:definition 'A platform operating in the water column attached to a mothership by an umbilical with limited propulsion and no human operator on board (e.g. ROV).'@en ;
    skos:notation 'SDN:L06::22'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L06/current/24/1/> .
<http://vocab.nerc.ac.uk/collection/L06/current/24/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L06/current/24/>;
    dc:modified '2006-07-07T10:38:37'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'drifting manned submersible'@en ;
    skos:definition 'A platform operating in the water column attached to a mothership by an umbilical but with no means of propulsion that has at least one human operator on board (e.g. bathysphere).'@en ;
    skos:notation 'SDN:L06::24'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L06/current/30/1/> .
<http://vocab.nerc.ac.uk/collection/L06/current/30/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L06/current/30/>;
    dc:modified '2006-07-07T10:38:37'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'ship'@en ;
    skos:definition 'A large platform operating on the surface of the water column. Objective definitions for guidelines: >50m length (EU), >100 foot length (USA), >300 GRT weight (SOLAS). Subjective definition: a ship is a vessel big enough to carry a boat.'@en ;
    skos:notation 'SDN:L06::30'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L06/current/32/1/> .
<http://vocab.nerc.ac.uk/collection/L06/current/32/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L06/current/32/>;
    dc:modified '2006-07-07T10:38:37'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'vessel of opportunity'@en ;
    skos:definition 'A platform for purpose of commerce of any size operating on the surface of the water column in unpredictable locations that regularly collects scientific (oceanographic and meteorological) data (e.g. an instrumented cargo vessel).'@en ;
    skos:notation 'SDN:L06::32'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L06/current/33/1/> .
<http://vocab.nerc.ac.uk/collection/L06/current/33/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L06/current/33/>;
    dc:modified '2006-07-07T10:38:37'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'self-propelled small boat'@en ;
    skos:definition 'A small self-propelled platform operating on the surface of the water column that may be easily removed from the water (e.g. shore-based RIBs, ships\' boats).'@en ;
    skos:notation 'SDN:L06::33'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L06/current/34/1/> .
<http://vocab.nerc.ac.uk/collection/L06/current/34/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L06/current/34/>;
    dc:modified '2006-07-07T10:38:37'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'vessel at fixed position'@en ;
    skos:definition 'A platform of any size occupying a fixed location on the surface of the water column for prolonged periods collecting scientific (oceanographic and meteorological) data as a primary or secondary mission.  Includes light vessels and weather ships.'@en ;
    skos:notation 'SDN:L06::34'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L06/current/35/1/> .
<http://vocab.nerc.ac.uk/collection/L06/current/35/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L06/current/35/>;
    dc:modified '2006-07-07T10:38:37'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'vessel of opportunity on fixed route'@en ;
    skos:definition 'A platform repeatedly following a predictable fixed track on the surface of the water column that collects scientific (oceanographic and meteorological) data (e.g. an instrumented ferry).'@en ;
    skos:notation 'SDN:L06::35'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L06/current/37/1/> .
<http://vocab.nerc.ac.uk/collection/L06/current/37/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L06/current/37/>;
    dc:modified '2006-07-07T10:38:37'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'self-propelled boat'@en ;
    skos:definition 'A small self-propelled platform operating on the surface of the water column in unpredictable locations that is smaller than a ship, but too large to easily remove from the water.'@en ;
    skos:notation 'SDN:L06::37'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L06/current/38/1/> .
<http://vocab.nerc.ac.uk/collection/L06/current/38/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L06/current/38/>;
    dc:modified '2006-07-07T10:38:37'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'man-powered boat'@en ;
    skos:definition 'A platform operating on the surface of the water column that is manually propelled and may not be easily removed from the water (e.g. trireme).'@en ;
    skos:notation 'SDN:L06::38'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L06/current/3A/1/> .
<http://vocab.nerc.ac.uk/collection/L06/current/3A/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L06/current/3A/>;
    dc:modified '2006-07-07T10:38:37'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'man-powered small boat'@en ;
    skos:definition 'A platform operating on the surface of the water column that is manually propelled and may be easily removed from the water (e.g. rowing boat, canoe).'@en ;
    skos:notation 'SDN:L06::3A'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L06/current/42/1/> .
<http://vocab.nerc.ac.uk/collection/L06/current/42/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L06/current/42/>;
    dc:modified '2006-07-07T10:38:37'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'drifting surface float'@en ;
    skos:definition 'An unmanned instrumented platform operating on the surface of the water column often attached to a drogue to track currents rather than winds (e.g. Argos buoy).'@en ;
    skos:notation 'SDN:L06::42'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L06/current/43/1/> .
<http://vocab.nerc.ac.uk/collection/L06/current/43/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L06/current/43/>;
    dc:modified '2006-07-07T10:38:37'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'subsurface mooring'@en ;
    skos:definition 'A collection of oceanographic instruments attached to wires suspended between anchors on the seabed and buoyant spheres in the water column.'@en ;
    skos:notation 'SDN:L06::43'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L06/current/54/1/> .
<http://vocab.nerc.ac.uk/collection/L06/current/54/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L06/current/54/>;
    dc:modified '2006-07-07T10:38:37'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'airship'@en ;
    skos:definition 'A self-propelled container filled with a gas that is lighter than air.'@en ;
    skos:notation 'SDN:L06::54'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L06/current/63/1/> .
<http://vocab.nerc.ac.uk/collection/L06/current/63/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L06/current/63/>;
    dc:modified '2006-07-07T10:38:37'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'rocket'@en ;
    skos:definition 'A rocket is a vehicle, missile or aircraft which obtains thrust by the reaction to the ejection of fast moving exhaust gas from within a rocket engine.'@en ;
    skos:notation 'SDN:L06::63'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L06/current/64/1/> .
<http://vocab.nerc.ac.uk/collection/L06/current/64/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L06/current/64/>;
    dc:modified '2006-07-07T10:38:37'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'geostationary orbiting satellite'@en ;
    skos:definition 'A vehicle operating beyond the Earth\'s atmosphere without human occupants that orbits the Earth at the same rate as the Earth\'s rotation keeping it over a fixed location on the Earth\'s surface..'@en ;
    skos:notation 'SDN:L06::64'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L06/current/65/1/> .
<http://vocab.nerc.ac.uk/collection/L06/current/65/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L06/current/65/>;
    dc:modified '2006-07-07T10:38:37'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'orbiting satellite'@en ;
    skos:definition 'A vehicle operating beyond the Earth\'s atmosphere without human occupants that orbits the Earth at a different rate to the Earth\'s rotation so it moves over the Earth\'s surface..'@en ;
    skos:notation 'SDN:L06::65'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L06/current/66/1/> .
<http://vocab.nerc.ac.uk/collection/L06/current/66/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L06/current/66/>;
    dc:modified '2006-07-07T10:38:37'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'manned spacecraft'@en ;
    skos:definition 'A vehicle operating beyond the Earth\'s atmosphere with human occupants.'@en ;
    skos:notation 'SDN:L06::66'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L06/current/67/1/> .
<http://vocab.nerc.ac.uk/collection/L06/current/67/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L06/current/67/>;
    dc:modified '2006-07-07T10:38:37'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'helicopter'@en ;
    skos:definition 'An aircraft without wings that obtains its lift from the rotation of overhead blades.'@en ;
    skos:notation 'SDN:L06::67'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L06/current/68/1/> .
<http://vocab.nerc.ac.uk/collection/L06/current/68/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L06/current/68/>;
    dc:modified '2006-07-07T10:38:37'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'satellite'@en ;
    skos:definition 'A vehicle operating beyond the Earth\'s atmosphere without human occupants that orbits the Earth.'@en ;
    skos:notation 'SDN:L06::68'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L06/current/69/1/> .
<http://vocab.nerc.ac.uk/collection/L06/current/69/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L06/current/69/>;
    dc:modified '2006-07-07T10:38:37'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'autogyro'@en ;
    skos:definition 'An aircraft without wings that obtains its lift from the rotation of overhead blades, but obtains forward populsion from a fixed propellor.'@en ;
    skos:notation 'SDN:L06::69'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L06/current/6A/1/> .
<http://vocab.nerc.ac.uk/collection/L06/current/6A/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L06/current/6A/>;
    dc:modified '2006-07-07T10:38:37'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'glider'@en ;
    skos:definition 'A fixed-wing aircraft with no propulsion.'@en ;
    skos:notation 'SDN:L06::6A'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L06/current/6B/1/> .
<http://vocab.nerc.ac.uk/collection/L06/current/6B/1/>
    a skos:Concept ;
