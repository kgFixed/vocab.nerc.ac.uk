    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'human'@en ;
    skos:definition 'A human being without specialised equipment operating on land or the surface of the water column.'@en ;
    skos:notation 'SDN:L06::71'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L06/current/72/1/> .
<http://vocab.nerc.ac.uk/collection/L06/current/72/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L06/current/72/>;
