<feed> tree:member <http://vocab.nerc.ac.uk/collection/R26/current/SATLANTIC/1/> .
<http://vocab.nerc.ac.uk/collection/R26/current/SATLANTIC/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/R26/current/SATLANTIC/>;
    dc:modified '2019-10-11T15:08:43'^^xsd:dateTime ;
    skos:altLabel 'SATLANTIC'^^xsd:string ;
    skos:prefLabel 'Satlantic Inc.'@en ;
    skos:definition 'An ocean technology company and brand of Sea-Bird Scientific that develops optical sensors for aquatic research and water quality monitoring. The company was initially founded in 1990. Danaher acquired three ocean science instrumentation companies, Sea-Bird Electronics (2008), WET Labs (2010), and Satlantic (2011), which were then combined to form Sea-Bird Scientific.'@en ;
    skos:notation 'SDN:R26::SATLANTIC'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/R26/current/WETLABS/1/> .
