    skos:prefLabel 'Correlation factor of acoustic signal by altimeter'@en ;
    skos:definition 'Quality of the echo return from an altimeter, ranging from 0 to 1. A value of 1 represents a perfect return echo with negligible noise and distortion.'@en ;
