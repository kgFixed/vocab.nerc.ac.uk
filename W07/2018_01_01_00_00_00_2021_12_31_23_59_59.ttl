<>
    a tree:Node
     ;
    tree:relation [
      a tree:LessThanRelation ;
      tree:node <https://kgfixed.github.io/vocab.nerc.ac.uk/W07/2017_01_01_00_00_00_2017_12_31_23_59_59.ttl> ;
      tree:path dc:modified ;
