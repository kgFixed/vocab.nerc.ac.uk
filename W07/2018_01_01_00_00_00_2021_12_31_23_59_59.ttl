<http://vocab.nerc.ac.uk/collection/W07/current/IDEN0004/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/W07/current/IDEN0004/>;
    dc:modified '2021-10-29T09:33:08'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Model number'@en ;
    skos:definition 'A name or number, usually assigned by the manufacturer, which identifies the unique design of a system or device that is usually mass-produced.'@en ;
