    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'indo_pacific_ocean'@en ;
    skos:definition 'A biogeographic region of sea, comprising the tropical waters of the Indian Ocean, the tropical western and central Pacific Ocean, and the seas connecting the two around Indonesia. The indo_pacific_ocean region does not include the temperate and polar regions of the Indian and Pacific oceans, nor the tropical eastern Pacific. This is distinct from the indian_pacific_ocean region.'@en ;
    skos:notation 'SDN:P30::indo_pacific_ocean'^^xsd:string .
