    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Marine Geology'@en ;
    skos:definition 'Composition and structure of geological features on or below the seabed or associated with the coast (e.g. sediment, magnetics, gravity, geomorphology)'@en ;
