    skos:altLabel 'others_BASEMAN'^^xsd:string ;
    skos:prefLabel 'BASEMAN_OTHERS'@en ;
    skos:definition 'Color class defined in the JPI-Oceans BASEMAN project protocol (e.g. Frias et al, 2018) as including micro-litter items of colour other than black, blue, white, red, green, colourless/transparent, and multicolour. This category could therefore contain items that could be classified as yellow, orange, pink, purple, tan/brown, grey when data are reported using other protocols.'@en ;
    skos:notation 'SDN:H04::H0400010'^^xsd:string .
