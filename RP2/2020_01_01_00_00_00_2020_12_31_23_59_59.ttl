@prefix tree: <https://w3id.org/tree#> .
@prefix ldes: <https://w3id.org/ldes#> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

@base <https://kgfixed.github.io/vocab.nerc.ac.uk/RP2/2020_01_01_00_00_00_2020_12_31_23_59_59.ttl> .

<>
    a tree:Node
     .

<feed>
  a ldes:EventStream ;
  ldes:timestampPath dc:modified ;
  ldes:versionOfPath dc:isVersionOf ;
  
  
  tree:shape [
    a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path dc:isVersionOf
    ],
    [
      sh:datatype xsd:dateTime ;
      sh:minCount 1 ;
      sh:path dc:modified
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:altLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:prefLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:definition
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:notation
    ];
    sh:targetClass skos:Concept
  ] ;
  tree:view <> ;
  .

<feed> tree:member <http://vocab.nerc.ac.uk/collection/RP2/current/A/1/> .
<http://vocab.nerc.ac.uk/collection/RP2/current/A/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/RP2/current/A/>;
    dc:modified '2020-04-04T15:05:33'^^xsd:dateTime ;
    skos:altLabel 'A'^^xsd:string ;
    skos:prefLabel '100% of profile good'@en ;
    skos:definition '100% of all levels in the profile contain good data. This means that all levels are associated with quality control flags (QC) flags of 1, 2, 5 or 8. Levels with QC flag values of 9 are excluded form the computation.'@en ;
    skos:notation 'SDN:RP2::A'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/RP2/current/B/1/> .
<http://vocab.nerc.ac.uk/collection/RP2/current/B/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/RP2/current/B/>;
    dc:modified '2020-04-04T15:05:33'^^xsd:dateTime ;
    skos:altLabel 'B'^^xsd:string ;
    skos:prefLabel '75% - 100% of profile good'@en ;
    skos:definition 'Between 75% (included) and 100% (excluded) of all levels in the profile contain good data. Levels containing good data are associated with quality control flags (QC) flags of 1, 2, 5 or 8. Levels with QC flag values of 9 are excluded form the computation.'@en ;
    skos:notation 'SDN:RP2::B'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/RP2/current/C/1/> .
<http://vocab.nerc.ac.uk/collection/RP2/current/C/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/RP2/current/C/>;
    dc:modified '2020-04-04T15:05:33'^^xsd:dateTime ;
    skos:altLabel 'C'^^xsd:string ;
    skos:prefLabel '50% - 75% of profile good'@en ;
    skos:definition 'Between 50% (included) and 75% (excluded) of all levels in the profile contain good data. Levels containing good data are associated with quality control flags (QC) flags of 1, 2, 5 or 8. Levels with QC flag values of 9 are excluded form the computation.'@en ;
    skos:notation 'SDN:RP2::C'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/RP2/current/D/1/> .
<http://vocab.nerc.ac.uk/collection/RP2/current/D/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/RP2/current/D/>;
    dc:modified '2020-04-04T15:05:33'^^xsd:dateTime ;
    skos:altLabel 'D'^^xsd:string ;
    skos:prefLabel '25% - 50% of profile good'@en ;
    skos:definition 'Between 25% (included) and 50% (excluded) of all levels in the profile contain good data. Levels containing good data are associated with quality control flags (QC) flags of 1, 2, 5 or 8. Levels with QC flag values of 9 are excluded form the computation.'@en ;
    skos:notation 'SDN:RP2::D'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/RP2/current/E/1/> .
<http://vocab.nerc.ac.uk/collection/RP2/current/E/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/RP2/current/E/>;
    dc:modified '2020-04-04T15:05:33'^^xsd:dateTime ;
    skos:altLabel 'E'^^xsd:string ;
    skos:prefLabel '0% - 25% of profile good'@en ;
    skos:definition 'Between 0% (excluded) and 25% (excluded) of all levels in a given profile contain good data. Levels containing good data are associated with quality control flags (QC) flags of 1, 2, 5 or 8. Levels with QC flag values of 9 are excluded form the computation.'@en ;
    skos:notation 'SDN:RP2::E'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/RP2/current/F/1/> .
<http://vocab.nerc.ac.uk/collection/RP2/current/F/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/RP2/current/F/>;
    dc:modified '2020-04-04T15:05:33'^^xsd:dateTime ;
    skos:altLabel 'F'^^xsd:string ;
    skos:prefLabel '0% of profile good'@en ;
    skos:definition '0% of all levels in the profile contain good data. This means that all levels are associated with quality control (QC) flags of 3, 4, 6 or 7. Levels with QC flag values of 9 are excluded form the computation.'@en ;
