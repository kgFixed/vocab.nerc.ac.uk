@prefix tree: <https://w3id.org/tree#> .
@prefix ldes: <https://w3id.org/ldes#> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

@base <https://kgfixed.github.io/vocab.nerc.ac.uk/M01/2010_01_01_00_00_00_2016_12_31_23_59_59.ttl> .

<>
    a tree:Node
     ;
    tree:relation [
      a tree:LessThanRelation ;
      tree:node <https://kgfixed.github.io/vocab.nerc.ac.uk/M01/2009_01_01_00_00_00_2009_12_31_23_59_59.ttl> ;
      tree:path dc:modified ;
      tree:value '2016-12-31T23:59:59'^^xsd:dateTime
    ]
     .

<feed>
  a ldes:EventStream ;
  ldes:timestampPath dc:modified ;
  ldes:versionOfPath dc:isVersionOf ;
  
  
  tree:shape [
    a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path dc:isVersionOf
    ],
    [
      sh:datatype xsd:dateTime ;
      sh:minCount 1 ;
      sh:path dc:modified
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:altLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:prefLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:definition
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:notation
    ];
    sh:targetClass skos:Concept
  ] ;
  tree:view <> ;
  .

<feed> tree:member <http://vocab.nerc.ac.uk/collection/M01/current/ANAUD/1/> .
<http://vocab.nerc.ac.uk/collection/M01/current/ANAUD/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/M01/current/ANAUD/>;
    dc:modified '2016-06-01T13:58:00'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Analogue Audio'@en ;
    skos:definition 'Recordings of sound converted to an electrical signal which is stored continuously using a medium such as magnetic tape or vinyl.'@en ;
    skos:notation 'SDN:M01::ANAUD'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/M01/current/DIGAUD/1/> .
<http://vocab.nerc.ac.uk/collection/M01/current/DIGAUD/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/M01/current/DIGAUD/>;
    dc:modified '2016-06-01T13:57:57'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Digital Audio'@en ;
    skos:definition 'Recordings of sound converted to an electrical signal the properties of which are determined as numbers at regular intervals and stored.'@en ;
    skos:notation 'SDN:M01::DIGAUD'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/M01/current/BIN/1/> .
<http://vocab.nerc.ac.uk/collection/M01/current/BIN/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/M01/current/BIN/>;
    dc:modified '2016-04-01T14:24:24'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Binary'@en ;
    skos:definition 'Any file format for digital data that are not encoded in a recognised standard character code such as ASCII. Binary files need bespoke APIs in order to be interrogated or manipulated and cannot be read using text viewers.'@en ;
    skos:notation 'SDN:M01::BIN'^^xsd:string .
