@prefix tree: <https://w3id.org/tree#> .
@prefix ldes: <https://w3id.org/ldes#> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

@base <https://kgfixed.github.io/vocab.nerc.ac.uk/C72/2012_01_01_00_00_00_2012_12_31_23_59_59.ttl> .

<>
    a tree:Node
     .

<feed>
  a ldes:EventStream ;
  ldes:timestampPath dc:modified ;
  ldes:versionOfPath dc:isVersionOf ;
  
  
  tree:shape [
    a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path dc:isVersionOf
    ],
    [
      sh:datatype xsd:dateTime ;
      sh:minCount 1 ;
      sh:path dc:modified
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:altLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:prefLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:definition
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:notation
    ];
    sh:targetClass skos:Concept
  ] ;
  tree:view <> ;
  .

<feed> tree:member <http://vocab.nerc.ac.uk/collection/C72/current/S/1/> .
<http://vocab.nerc.ac.uk/collection/C72/current/S/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/C72/current/S/>;
    dc:modified '2012-03-07T11:50:08'^^xsd:dateTime ;
    skos:altLabel 'Stones'^^xsd:string ;
    skos:prefLabel 'Stones'@en ;
    skos:definition 'The corer returned loose stones rather than a sample of sediment.'@en ;
    skos:notation 'SDN:C72::S'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/C72/current/F/1/> .
<http://vocab.nerc.ac.uk/collection/C72/current/F/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/C72/current/F/>;
    dc:modified '2012-03-07T11:49:17'^^xsd:dateTime ;
    skos:altLabel 'Failed'^^xsd:string ;
    skos:prefLabel 'Failed'@en ;
    skos:definition 'The corer failed to return a sediment sample'@en ;
    skos:notation 'SDN:C72::F'^^xsd:string .
