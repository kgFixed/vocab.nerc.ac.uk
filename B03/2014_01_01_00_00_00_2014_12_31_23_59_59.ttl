@prefix tree: <https://w3id.org/tree#> .
@prefix ldes: <https://w3id.org/ldes#> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

@base <https://kgfixed.github.io/vocab.nerc.ac.uk/B03/2014_01_01_00_00_00_2014_12_31_23_59_59.ttl> .

<>
    a tree:Node
     .

<feed>
  a ldes:EventStream ;
  ldes:timestampPath dc:modified ;
  ldes:versionOfPath dc:isVersionOf ;
  
  
  tree:shape [
    a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path dc:isVersionOf
    ],
    [
      sh:datatype xsd:dateTime ;
      sh:minCount 1 ;
      sh:path dc:modified
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:altLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:prefLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:definition
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:notation
    ];
    sh:targetClass skos:Concept
  ] ;
  tree:view <> ;
  .

<feed> tree:member <http://vocab.nerc.ac.uk/collection/B03/current/CRM/1/> .
<http://vocab.nerc.ac.uk/collection/B03/current/CRM/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/B03/current/CRM/>;
    dc:modified '2014-03-26T12:29:51'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Certified Reference Material'@en ;
    skos:definition 'A Reference Material, accompanied by a certificate, one or more of whose property values are certified by a procedure which establishes its traceability to an accurate realisation of the unit in which the property values are expressed and for which each certified value is accompanied by an uncertainty at a stated level of confidence. The certification is issued by an organisation generally accepted to be technically competent in the appropriate discipline.'@en ;
    skos:notation 'SDN:B03::CRM'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/B03/current/LRM/1/> .
<http://vocab.nerc.ac.uk/collection/B03/current/LRM/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/B03/current/LRM/>;
    dc:modified '2014-03-26T12:29:51'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Laboratory Reference Material'@en ;
    skos:definition 'A material developed by a laboratory for its own internal quality assurance use. The material is not certified by an external source.'@en ;
    skos:notation 'SDN:B03::LRM'^^xsd:string .
