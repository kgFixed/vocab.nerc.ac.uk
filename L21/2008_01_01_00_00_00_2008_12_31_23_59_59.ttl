    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L21/current/ICAT05/>;
    dc:modified '2008-01-10T13:02:59'^^xsd:dateTime ;
    skos:altLabel 'remote sensors'^^xsd:string ;
    skos:prefLabel 'SeaDataNet remote sensor categories'@en ;
    skos:definition 'Categories used in the SeaDataNet project to classify devices that make remote measurements of phenomena from satellites or aircraft. Also includes categories of shipborne instruments that strictly speaking sense remotely such as magnetometers.'@en ;
    skos:notation 'SDN:L21::ICAT05'^^xsd:string .
