@prefix tree: <https://w3id.org/tree#> .
@prefix ldes: <https://w3id.org/ldes#> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

@base <https://kgfixed.github.io/vocab.nerc.ac.uk/L34/2016_01_01_00_00_00_2016_12_31_23_59_59.ttl> .

<>
    a tree:Node
     .

<feed>
  a ldes:EventStream ;
  ldes:timestampPath dc:modified ;
  ldes:versionOfPath dc:isVersionOf ;
  
  
  tree:shape [
    a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path dc:isVersionOf
    ],
    [
      sh:datatype xsd:dateTime ;
      sh:minCount 1 ;
      sh:path dc:modified
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:altLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:prefLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:definition
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:notation
    ];
    sh:targetClass skos:Concept
  ] ;
  tree:view <> ;
  .

<feed> tree:member <http://vocab.nerc.ac.uk/collection/L34/current/1/1/> .
<http://vocab.nerc.ac.uk/collection/L34/current/1/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L34/current/1/>;
    dc:modified '2016-03-04T14:27:32'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Good'@en ;
    skos:definition 'Passed documented required QC tests'@en ;
    skos:notation 'SDN:L34::1'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L34/current/2/1/> .
<http://vocab.nerc.ac.uk/collection/L34/current/2/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L34/current/2/>;
    dc:modified '2016-03-04T14:27:32'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Not evaluated, not available or unknown'@en ;
    skos:definition 'Used for data when no QC test performed or the information on quality is not available'@en ;
    skos:notation 'SDN:L34::2'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L34/current/3/1/> .
<http://vocab.nerc.ac.uk/collection/L34/current/3/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L34/current/3/>;
    dc:modified '2016-03-04T14:27:32'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Questionable/suspect'@en ;
    skos:definition 'Failed non-critical documented metric or subjective test(s)'@en ;
    skos:notation 'SDN:L34::3'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L34/current/4/1/> .
<http://vocab.nerc.ac.uk/collection/L34/current/4/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L34/current/4/>;
    dc:modified '2016-03-04T14:27:32'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Bad'@en ;
    skos:definition 'Failed critical documented QC test(s) or as assigned by the data provider'@en ;
    skos:notation 'SDN:L34::4'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L34/current/9/1/> .
<http://vocab.nerc.ac.uk/collection/L34/current/9/1/>
