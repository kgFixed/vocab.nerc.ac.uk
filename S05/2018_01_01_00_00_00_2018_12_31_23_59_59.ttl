<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050210/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050210/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050210/>;
    dc:modified '2018-12-05T05:31:40'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'calibration to read zero in clear water with computation from volume scatter'@en ;
    skos:definition 'A correction has been made to the data for light source deterioration due to volume of a medium using a procedure that results in a zero value in pure water, rather than a zero value in air (which would give a value in pure water of around 0.36).'@en ;
    skos:notation 'SDN:S05::S050210'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050209/1/> .
