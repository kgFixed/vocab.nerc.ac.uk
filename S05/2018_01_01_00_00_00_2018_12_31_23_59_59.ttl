    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050209/>;
    dc:modified '2018-10-03T14:24:43'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'computation using the Blackburn-Caperon model'@en ;
    skos:definition 'The value is derived using the isotope dilution technique and equations first described in Blackburn 1979 and in Caperon et al 1979.'@en ;
    skos:notation 'SDN:S05::S050209'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050208/1/> .
