<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050235/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050235/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050235/>;
    dc:modified '2021-05-21T12:11:36'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'computation from true wind speed using the COARE3.5 model (Edson et al. 2013)'@en ;
    skos:definition 'True wind speed is computed to neutral conditionas using the COARE3.5 model algorithm (Edson et al. 2013, https://doi.org/10.1175/JPO-D-12-0173.1).'@en ;
    skos:notation 'SDN:S05::S050235'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050233/2/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050233/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050233/>;
    dc:modified '2021-04-27T14:02:36'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'computation of carbon biomass using the equation of Andrássy (1956)'@en ;
    skos:definition 'Carbon biomass derived from image analysis using the Andrássy (1956) formula for nematodes: W = (L*D2)/(1.6*106) where W is the mass (as fresh weight in ug) per individual, L is the nematode length (um) and D is the greatest body diameter (um).'@en ;
    skos:notation 'SDN:S05::S050233'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050234/2/> .
