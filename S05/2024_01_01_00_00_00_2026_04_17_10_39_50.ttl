    skos:definition 'The data have been derived from the GEBCO 2024 15 arc-second global bathymetric grid.'@en ;
    skos:notation 'SDN:S05::S050260'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050049/3/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050049/3/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050049/>;
    dc:modified '2024-08-19T16:11:43'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'computation using Fourier analysis with no depth attenuation correction'@en ;
    skos:definition 'A wave data processing protocol which does not take into account corrections associated with the attenuation of wave energy with depth.'@en ;
    skos:notation 'SDN:S05::S050049'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050055/2/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050055/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050055/>;
    dc:modified '2024-08-19T16:11:43'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'no correction or calibration of raw count rates'@en ;
    skos:definition 'The data value has not been converted from from the raw number of counts made by the instrument.'@en ;
    skos:notation 'SDN:S05::S050055'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050056/2/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050056/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050056/>;
    dc:modified '2024-08-19T16:11:43'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'no salt correction'@en ;
    skos:definition 'Whilst the data value has been converted into engineering units it has not been corrected for the presence of sea salt in the sample.'@en ;
    skos:notation 'SDN:S05::S050056'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050057/2/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050057/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050057/>;
    dc:modified '2024-08-19T16:11:43'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'no verification against independent measurements'@en ;
    skos:definition 'Whilst the data value has been converted into engineering units it has not been verified or back-calibrated against co-located, generally high accuracy, measurements using a different technique such as Winkler titration for oxygen or bench salinometer for salinity.'@en ;
    skos:notation 'SDN:S05::S050057'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050114/2/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050114/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050114/>;
    dc:modified '2024-08-19T16:11:43'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'computation using UNESCO algorithm and no calibration against independent measurements'@en ;
    skos:definition 'The parameter has been calculated without calibration against an independently measured sample and using the appropriate algorithm from Fofonoff and Millard (1983). Algorithms for computation of fundamental properties of seawater. UNESCO, Paris.'@en ;
    skos:notation 'SDN:S05::S050114'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050183/2/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050183/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050183/>;
    dc:modified '2024-08-19T16:11:43'^^xsd:dateTime ;
    skos:altLabel 'UNESCO_1983_uncal'^^xsd:string ;
    skos:prefLabel 'computation using UNESCO 1983 algorithm and no calibration against independent measurements'@en ;
    skos:definition 'The parameter has been calculated using the algorithm from Fofonoff and Millard (1983). Algorithms for computation of fundamental properties of seawater. UNESCO, Paris; the sensor values have not been checked against in-situ measurements.'@en ;
    skos:notation 'SDN:S05::S050183'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050259/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050259/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050259/>;
    dc:modified '2024-04-24T15:54:54'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'estimation using best available on-board navigation system and algorithm'@en ;
    skos:definition 'The data value is a best estimate, obtained using an on-board navigation system and algorithm.'@en ;
    skos:notation 'SDN:S05::S050259'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050258/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050258/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050258/>;
    dc:modified '2024-04-23T16:59:40'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'rolling averaging of higher frequency data'@en ;
    skos:definition 'The data value is the rolling average of the specified subset of data.'@en ;
    skos:notation 'SDN:S05::S050258'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050257/2/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050257/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050257/>;
    dc:modified '2024-04-23T16:58:41'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'averaging of higher frequency data'@en ;
    skos:definition 'The data value is the simple arithmetic average of a specified subset of data.'@en ;
    skos:notation 'SDN:S05::S050257'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050256/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050256/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050256/>;
    dc:modified '2024-02-08T09:54:33'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'assumption that POC is negligible'@en ;
    skos:definition 'The sample is assumed to contain undetectable amounts of Particulate Organic Carbon (POC), i.e. POC has not been quantitatively measured.'@en ;
    skos:notation 'SDN:S05::S050256'^^xsd:string .
