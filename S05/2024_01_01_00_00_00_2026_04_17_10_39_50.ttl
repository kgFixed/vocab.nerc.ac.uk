    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'estimation from the model of Platt et al. (1980)'@en ;
    skos:definition 'The parameter has been estimated by fitting the experimental data to the model of Platt et al. (1980), Photoinhibition of photosynthesis in natural assemblages of marine phytoplankton. J. Mar. Res 38(4), 687-701.'@en ;
    skos:notation 'SDN:S05::S050275'^^xsd:string .
