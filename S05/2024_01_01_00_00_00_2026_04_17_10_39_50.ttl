    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050271/>;
    dc:modified '2025-02-27T19:56:55'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'correction for drift and correction to sea level'@en ;
    skos:definition 'The data value has been corrected for instrument drift and the data have been corrected to sea level by addition of a constant.'@en ;
    skos:notation 'SDN:S05::S050271'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050270/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050270/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050270/>;
    dc:modified '2025-02-12T12:24:03'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'computation using Mari (1999) formula'@en ;
    skos:definition 'An equation used to estimate the carbon content of transparent exopolymer particles (TEP) based on the equivalent spherical diameter of the particle and a fractal dimension value of 2.55. TEP-Carbon (ug) for each particle=0.25 x 10^-6 r^2.55. Mari, X. (1999). Carbon content and C:N ratio of transparent exopolymeric particles (TEP) produced by bubbling exudates of diatoms. Mar Ecol Prog Ser 183:59-71.'@en ;
    skos:notation 'SDN:S05::S050270'^^xsd:string .
