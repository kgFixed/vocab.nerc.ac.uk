<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050290/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050290/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050290/>;
    dc:modified '2026-02-16T09:55:00'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'derivation from GEBCO_25 15 arc-second global grid'@en ;
    skos:definition 'The data have been derived from the GEBCO 2025 15 arc-second global bathymetric grid.'@en ;
    skos:notation 'SDN:S05::S050290'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050289/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050289/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050289/>;
    dc:modified '2026-02-08T22:15:35'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'computation from True Oxygen Utilisation (TOU) and Transit Time Distribution (TTD)'@en ;
    skos:definition 'The variable (change in dissolved oxygen along water mass pathways) is calculated from an estimation of oxygen utilisation which accounts for oxygen saturation states other than 100% (mostly lower) in surface water at the time of water mass formation, and water mass age estimates taking into account mixing occurring into the ocean interior (Sulpis et al. 2023, 10.1029/2023GB007747).'@en ;
    skos:notation 'SDN:S05::S050289'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050288/2/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050288/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050288/>;
    dc:modified '2026-02-07T21:07:41'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'computation from Apparent Oxygen Utilisation (AOU) derived from Argo float profiles and regression against time along isopycnal surfaces'@en ;
    skos:definition 'The value is obtained by regressing the Apparent Oxygen Utilisation calculated from oxygen, temperature, salinity and pressure measurements made during an Argo profiling float deployment and regressed over time in layers of equal densities.'@en ;
    skos:notation 'SDN:S05::S050288'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050287/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050287/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050287/>;
    dc:modified '2026-01-29T22:36:20'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'conversion using empirically derived equation'@en ;
    skos:definition 'A proxy measurement is converted to the quantity of interest using a formula based on real-world observation or experimental data.'@en ;
    skos:notation 'SDN:S05::S050287'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050286/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050286/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050286/>;
    dc:modified '2025-12-19T12:43:51'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'measurement along the y-axis'@en ;
    skos:definition 'The measurement has been obtained by measuring along the vertical axis of an image.'@en ;
    skos:notation 'SDN:S05::S050286'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050285/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050285/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050285/>;
    dc:modified '2025-12-19T12:43:34'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'measurement along the x-axis'@en ;
    skos:definition 'The measurement has been obtained by measuring along the horizontal axis of an image.'@en ;
    skos:notation 'SDN:S05::S050285'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050284/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050284/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050284/>;
    dc:modified '2025-11-26T12:31:29'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'computation using equations from Chapman et al. (1997)'@en ;
    skos:definition 'The parameter has been calculated using the equations published in Chapman, R. D.; Shay, L. K.; Graber, H. C.; Edson, J. B.; Karachintsev, A.; Trump, C. L.; and Ross, D. B. (1997) On the accuracy of HF radar surface current measurements: Intercomparisons with ship-based sensors. Journal of Geophysical Research Atmospheres 1021(C8):18737-18748.'@en ;
    skos:notation 'SDN:S05::S050284'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050283/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050283/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050283/>;
    dc:modified '2025-11-23T18:52:11'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'differencing between 18O-derived gross oxygen production and net changes in dissolved oxygen concentration over a 24h incubation period.'@en ;
    skos:definition 'Respiration rates over the 24h day-night cycle are obtained by subtracting net changes in oxygen concentrations to the gross oxygen production derived from 18O-spiked samples in parallel 24h incubations.'@en ;
    skos:notation 'SDN:S05::S050283'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050282/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050282/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050282/>;
    dc:modified '2025-11-23T16:37:29'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'computation from Apparent Oxygen Utilisation (AOU) and water mass age along isopycnal surfaces'@en ;
    skos:definition 'The value is calculated by dividing the change in apparent oxygen utilisation (AOU) along a given distance in a layer of constant density (isopycnal surface) by the change in water age along the same distance.'@en ;
    skos:notation 'SDN:S05::S050282'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050281/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050281/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050281/>;
    dc:modified '2025-11-18T10:37:19'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'computation over the coverage period'@en ;
    skos:definition 'The parameter has been calculated to reflect a purely temporal average (no spatial averaging).'@en ;
    skos:notation 'SDN:S05::S050281'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050280/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050280/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050280/>;
    dc:modified '2025-11-18T10:35:33'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'computation over the scatter patch'@en ;
    skos:definition 'The parameter has been calculated to reflect a purely spatial average (no temporal averaging).'@en ;
    skos:notation 'SDN:S05::S050280'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050279/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050279/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050279/>;
    dc:modified '2025-08-20T21:50:40'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'computation by regression against incubation time'@en ;
    skos:definition 'The parameter has been determined from the slope of a linear regression against incubation time of the property measured at different time-points during an incubation experiment.'@en ;
    skos:notation 'SDN:S05::S050279'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050278/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050278/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050278/>;
    dc:modified '2025-08-13T08:32:14'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'correction based on Michaelis Menten kinetics'@en ;
    skos:definition 'A correction used to account for the stimulation by added tracer of in-situ uptake rates of a substrate over and above actual rates at low substrate concentration.'@en ;
    skos:notation 'SDN:S05::S050278'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050277/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050277/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050277/>;
    dc:modified '2025-07-22T09:21:25'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'computation from absolute salinity and conservative temperature using UNESCO 2010 algorithm'@en ;
    skos:definition 'The parameter has been calculated from the corresponding absolute salinity and conservative temperature values using the algorithm from IOC, SCOR and IAPSO (2010). TEOS-10: Thermodynamic Properties of Seawater Calculation and Use. UNESCO, Paris.'@en ;
    skos:notation 'SDN:S05::S050277'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050276/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050276/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050276/>;
    dc:modified '2025-07-14T15:46:18'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'computation using UNESCO 2010 algorithm'@en ;
    skos:definition 'The parameter has been calculated using the appropriate algorithm from IOC, SCOR and IAPSO (2010). TEOS-10: Thermodynamic Properties of Seawater Calculation and Use. UNESCO, Paris.'@en ;
    skos:notation 'SDN:S05::S050276'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050275/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050275/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050275/>;
