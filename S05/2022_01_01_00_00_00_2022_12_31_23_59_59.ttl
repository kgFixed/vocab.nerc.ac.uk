    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'using the delta notation'@en ;
    skos:definition 'The isotope composition is reported using the delta notation for stable isotope fractionation defined as the deviation of the isotope ratio of a sample relative to a standardin parts per thousand (((Rsample - Rstandard)/Rstandard)x1000).'@en ;
