    dc:modified '2022-05-25T19:27:21'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'computation using the published OC3M algorithm'@en ;
    skos:definition 'Calibration algorithm used to derive chlorophyll-a concentrations from the band ratio of three bands of remotely sensed surface reflectance data. OC3M uses sensor-specific coefficients and remotely sensed reflectance from the Moderate Resolution Imaging Spectroradiometer (MODIS) instrument.'@en ;
    skos:notation 'SDN:S05::S050243'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050111/3/> .
