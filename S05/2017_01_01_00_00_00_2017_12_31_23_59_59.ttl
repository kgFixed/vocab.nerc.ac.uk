    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'correction to sea level and averaging of multiple sensors'@en ;
    skos:definition 'The data measured have been corrected to sea level by addition of a constant and have been averaged from the output of multiple instruments.'@en ;
    skos:notation 'SDN:S05::S050137'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050138/1/> .
