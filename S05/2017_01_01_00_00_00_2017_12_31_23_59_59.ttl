    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050160/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'correction after Stuiver and Reimer'@en ;
    skos:definition 'A correction applied to radiocarbon dates for variation in marine carbon reservoir.'@en ;
    skos:notation 'SDN:S05::S050160'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050161/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050161/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050161/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'subtraction of measured atmospheric pressure and conversion to depth using unspecified algorithm'@en ;
    skos:definition 'A depth data processing protocol in which the the recorded pressure at depth is corrected for atmospheric pressure and the resulting value is converted to depth using an unknown algorithm.'@en ;
    skos:notation 'SDN:S05::S050161'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050162/1/> .
