    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050151/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'normalisation with biomass expressed as carbon'@en ;
    skos:definition 'The data presented have been normalised such that the biomass fraction of the sample defined by the parameter is expressed as carbon.'@en ;
    skos:notation 'SDN:S05::S050151'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050152/1/> .
