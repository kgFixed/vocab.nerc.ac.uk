    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'correction to sea level and subtraction of value predicted by tidal analysis'@en ;
    skos:definition 'A residual value of pressure has been computed by calibrating the instrument to read zero at sea level and subtracting values computed using an unspecified tidal analysis algorithm from the measured values.'@en ;
    skos:notation 'SDN:S05::S050138'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050139/1/> .
