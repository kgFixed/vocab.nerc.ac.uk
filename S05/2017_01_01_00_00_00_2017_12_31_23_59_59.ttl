    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'computation from turbulent kinetic energy and density'@en ;
    skos:definition 'A vertical diffusion coefficient data processing protocol which involves computing the parameter from the corresponding values of turbulent kinetic energy and density.'@en ;
    skos:notation 'SDN:S05::S050100'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050101/1/> .
