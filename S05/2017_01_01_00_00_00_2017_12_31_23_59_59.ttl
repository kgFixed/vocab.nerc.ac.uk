    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'computation of density reciprocal from pressure, temperature and salinity'@en ;
    skos:definition 'A factor for the conversion of per volume data to per mass data corresponding to the reciprocal of density as calculated from the corresponding pressure, temperature and salinity measurements.'@en ;
    skos:notation 'SDN:S05::S050106'^^xsd:string .
