    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'computation from the ratio of horizontal translation to heave'@en ;
    skos:definition 'A wave data processing protocol which involves analysis of the ratio of the horizontal and vertical movements of the gauge.'@en ;
    skos:notation 'SDN:S05::S050098'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050099/1/> .
