    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'computation from PvI data and measured light profile'@en ;
    skos:definition 'The data value has been computed from parameters derived from photosynthesis-versus-light curve analyses and the observed in-situ light profile.'@en ;
    skos:notation 'SDN:S05::S050093'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050094/1/> .
