    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050081/>;
    dc:modified '2017-08-10T12:25:40'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'computation from concentration using Benson and Krause algorithm'@en ;
    skos:definition 'Saturation was computed from actual concentration and a theoretical concentration predicted from temperature and salinity using the algorithm of Benson, B.B., and Krause, D., Jr. (1984). The concentration and isotopic fractionation of oxygen dissolved in freshwater and seawater in equilibrium with the atmosphere. Limnology and Oceanography, 29: 620-632.'@en ;
    skos:notation 'SDN:S05::S050081'^^xsd:string .
