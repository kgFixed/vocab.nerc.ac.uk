    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'computation from probe free-fall time using unspecified algorithm'@en ;
    skos:definition 'The distance travelled (i.e. the depth of the probe below the surface) was computed from time using an unknown assumed speed and/or acceleration.'@en ;
    skos:notation 'SDN:S05::S050092'^^xsd:string .
