    skos:prefLabel 'correction to sea level'@en ;
    skos:definition 'The data measured have been corrected to sea level by addition of a constant.'@en ;
    skos:notation 'SDN:S05::S050136'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050137/1/> .
