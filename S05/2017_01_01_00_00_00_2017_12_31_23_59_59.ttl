    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050174/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'verification against independent measurements'@en ;
    skos:definition 'The values have been checked and if necessary adjusted using data collected by another instrument measuring the parameter of interest adjacent to the instrument whilst it was making its measurements. Examples are verification of CTD temperatures using rev'@en ;
    skos:notation 'SDN:S05::S050174'^^xsd:string .
