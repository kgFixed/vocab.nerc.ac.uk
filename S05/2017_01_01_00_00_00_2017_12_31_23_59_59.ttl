    skos:prefLabel 'derivation from GEBCO centenary edition 1-minute global grid'@en ;
    skos:definition 'The data have been derived from the GEBCO Centenary Edition CD-ROM data, one-minute grid.'@en ;
    skos:notation 'SDN:S05::S050145'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050146/1/> .
