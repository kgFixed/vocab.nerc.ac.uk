    skos:definition 'A light extinction coefficient data processing protocol using computation from the light intensity profile.'@en ;
    skos:notation 'SDN:S05::S050101'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050102/1/> .
