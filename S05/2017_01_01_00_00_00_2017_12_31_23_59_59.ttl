    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'computation from temperature and salinity by unspecified algorithm'@en ;
    skos:definition 'The parameter has been calculated from the corresponding salinity and temperature values using an unspecified algorithm.'@en ;
    skos:notation 'SDN:S05::S050097'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050098/1/> .
