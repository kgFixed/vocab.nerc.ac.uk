    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'correction using co-located air pressure data expressed to unspecified datum by subtraction of a constant'@en ;
    skos:definition 'A seawater pressure data processing protocol which corrects the recorded data for the atmospheric pressure signal from a co-located atmospheric pressure sensor and translates the data to an unspecified datum through the subtraction of a constant.'@en ;
    skos:notation 'SDN:S05::S050103'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050105/1/> .
