    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'correction to zero at sea level and conversion to depth using unspecified algorithm'@en ;
    skos:definition 'The recorded data have been corrected to read zero at sea level and have been converted to depth using an unspecified algorithm.'@en ;
    skos:notation 'SDN:S05::S050140'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050141/1/> .
