    skos:definition 'The value has been obtained by differencing simulataneous measurements from duplicate sensors.'@en ;
    skos:notation 'SDN:S05::S050163'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050164/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050164/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050164/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'subtraction of value predicted by tidal analysis'@en ;
    skos:definition 'A residual value of pressure, sea level or current vectors has been computed by subtracting values computed using an unspecified tidal analysis algorithm from the measured values.'@en ;
    skos:notation 'SDN:S05::S050164'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050166/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050166/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050166/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'summation of size-fractions and differencing results from acidified and unacidified samples'@en ;
    skos:definition 'The data presented are the result of differencing the outcomes of both acidified and unacidified experiments and the integration of data from the complete size range.'@en ;
    skos:notation 'SDN:S05::S050166'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050167/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050167/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050167/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'summation of vehicle depth below water column surface and height above bed'@en ;
    skos:definition 'Water column depth has been determined by adding together measurements of distance to bed and distance to surface taken by an underwater vehicle.'@en ;
    skos:notation 'SDN:S05::S050167'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050168/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050168/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050168/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'correction to in-situ temperature after Takahashi'@en ;
    skos:definition 'A partial pressure of CO2 data processing protocol specified in Takahashi et al (1993) Seasonal variation of CO2 and nutrients in the high-latitude surface oceans: A comparative study. Global Biogeochemical Cycles, 7, 843-878.'@en ;
    skos:notation 'SDN:S05::S050168'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050169/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050169/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050169/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'taking the average value from two or more sensors'@en ;
    skos:definition 'The data value has been derived by averaging the simultaneous values recorded by multiple sensors.'@en ;
    skos:notation 'SDN:S05::S050169'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050170/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050170/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050170/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'taking the maximum value from two or more sensors'@en ;
    skos:definition 'The data value has been derived by taking the highest simultaneous value recorded by multiple sensors. Generally used for shipborne radiometer data to minimise artefacts caused by shading.'@en ;
    skos:notation 'SDN:S05::S050170'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050171/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050171/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050171/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'tidal analysis'@en ;
    skos:definition 'An unspecified protocol has been used to determine tidal harmonic constants from the measured time series and these constants have been used to compute the proportion of the measured value due to tides.'@en ;
    skos:notation 'SDN:S05::S050171'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050172/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050172/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050172/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'transformation from WGS84 to Irish National Grid Reference System'@en ;
    skos:definition 'A geometric transformation has been applied to convert positions from a 3D geographic CRS to a national standard projection.'@en ;
    skos:notation 'SDN:S05::S050172'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050173/1/> .
