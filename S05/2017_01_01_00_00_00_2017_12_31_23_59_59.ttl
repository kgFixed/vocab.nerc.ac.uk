    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050045/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'expressed as PPi'@en ;
    skos:definition 'The data presented are expressed as the reagent in the process, PPi.'@en ;
    skos:notation 'SDN:S05::S050045'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050046/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050046/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050046/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'expressed to unspecified datum by subtraction of a constant'@en ;
    skos:definition 'The data presented have been corrected to an unspecified datum by the subtraction of a constant from the recorded measurement.'@en ;
    skos:notation 'SDN:S05::S050046'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050050/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050050/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050050/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'geometric statistics computation'@en ;
    skos:definition 'The parameter has been calculated from the computation of statistics describing the geometry of the sediment sample.'@en ;
    skos:notation 'SDN:S05::S050050'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050051/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050051/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050051/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'laboratory calibration against formazin'@en ;
    skos:definition 'A procedure where a nephelometer is calibrated on standard nominal turbidity scale based on mesurements made in different concentrations of formazin. Formazin is a particulate phase with 1.5 micron median particle size (0.6 micron standard deviation).'@en ;
    skos:notation 'SDN:S05::S050051'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050052/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050052/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050052/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'manual record analysis'@en ;
    skos:definition 'Derived statistics have been obtained by manual analysis of data recorded on hard-copy paper charts.'@en ;
    skos:notation 'SDN:S05::S050052'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050053/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050053/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050053/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'most probable number analysis'@en ;
    skos:definition 'Statistical estimation of an abundance from a number of replicate determinations.'@en ;
    skos:notation 'SDN:S05::S050053'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050054/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050054/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050054/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'multiplication by 10**7'@en ;
    skos:definition 'The data value has been scaled by the stated factor, generally to facilitate precision preservation by storing as an integer.'@en ;
    skos:notation 'SDN:S05::S050054'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050060/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050060/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050060/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'computation from air temperature and relative humidity data'@en ;
    skos:definition 'The data have been calculated from the corresponding air temperature and relative humidity values.'@en ;
    skos:notation 'SDN:S05::S050060'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050061/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050061/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050061/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'computation from concentration'@en ;
    skos:definition 'The parameter has been calculated from a measured concentration and physical parameters such as temperature and salinity.'@en ;
    skos:notation 'SDN:S05::S050061'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050063/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050063/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050063/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'analysis of cumulative frequency ordered by phi (coarse to fine)'@en ;
    skos:definition 'A method of determining the distribution of grain sizes in a sample which involves determining grain size on the logarithmic phi scale described in Krumbein and Sloss (1963) Stratigraphy and Sedimentation, 2nd edition; Freeman; San Francisco.'@en ;
    skos:notation 'SDN:S05::S050063'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050064/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050064/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050064/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'analysis of cumulative settling rate curve'@en ;
    skos:definition 'A method of determining the distribution of grain sizes by ordering the settling rates of the particles within a sample.'@en ;
    skos:notation 'SDN:S05::S050064'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050065/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050065/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050065/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'analysis of cumulative settling rate curve after Folk and Ward (1957)'@en ;
    skos:definition 'A method of determining the distribution of grain sizes by ordering the settling rates of the particles within a sample described in Folk, R.L., and Ward, W.C., 1957, Brazos River Bar: A study in the significance of grain size parameters: Journal of Sedimentary Petrology, v. 27, no. 1, p. 3-26.'@en ;
    skos:notation 'SDN:S05::S050065'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050066/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050066/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050066/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'automated record analysis'@en ;
    skos:definition 'A wave data processing protocol which automatically applies processing protocols to the raw data.'@en ;
    skos:notation 'SDN:S05::S050066'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050067/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050067/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050067/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'averaging of all functional beams'@en ;
    skos:definition 'The data value was produced by taking the simple arithmetic average of values from all functioning replicate sensors on an instrument.'@en ;
    skos:notation 'SDN:S05::S050067'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050068/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050068/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050068/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'averaging values from multiple core segments'@en ;
    skos:definition 'The data value presented has been calculated as the average value of measurements from multiple segments within a core.'@en ;
    skos:notation 'SDN:S05::S050068'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050070/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050070/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050070/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'computation from 1st order Fourier coefficients of directional distribution of energy, A1 and B1'@en ;
    skos:definition "" ;
    skos:notation 'SDN:S05::S050070'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050071/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050071/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050071/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'computation from DMS concentration and shipboard wind speed'@en ;
    skos:definition 'Flux calculation was based on measured DMS and the best available windspeed from the ship\'s anemometer.'@en ;
    skos:notation 'SDN:S05::S050071'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050072/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050072/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050072/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'computation from Fm and Fo fluorescence yields from the dark chamber'@en ;
    skos:definition 'The data value presented has been calculated from the maximum and minimum chlorophyll-a fluorescence yields measured in a dark-adapted state.'@en ;
    skos:notation 'SDN:S05::S050072'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050073/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050073/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050073/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'computation from Fm and Fo fluorescence yields from the light chamber'@en ;
    skos:definition 'The data value presented has been calculated from the maximum and minimum chlorophyll-a fluorescence yields measured in a light-adapted state.'@en ;
    skos:notation 'SDN:S05::S050073'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050074/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050074/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050074/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'computation from potassium concentration'@en ;
    skos:definition 'The beta activity has been determined by measuring the amount of potassium in the sample and using natural isotopic composition data to convert this to the amount of radioactive 40K isotope.'@en ;
    skos:notation 'SDN:S05::S050074'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050075/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050075/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050075/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'computation from rate of change of concentration in overlying water'@en ;
    skos:definition 'The rate of exchange of material between water and sediment has been determined by monitoring the concentration changes in the water and converting this to quantity of material passing between the phases per unit area per unit time.'@en ;
    skos:notation 'SDN:S05::S050075'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050076/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050076/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050076/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'computation of carbon from calcium'@en ;
    skos:definition 'The amount of calcium in the sample was measured and converted to carbon on the basis of CaCO3 composition (one mole of carbon for each mole of calcium).'@en ;
    skos:notation 'SDN:S05::S050076'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050078/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050078/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050078/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'calibration to read zero in clear water'@en ;
    skos:definition 'A correction has been made to the data for light source deterioration using a procedure that results in a zero value in pure water, rather than a zero value in air (which would give a value in pure water of around 0.36).'@en ;
    skos:notation 'SDN:S05::S050078'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050079/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050079/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050079/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'calibration using protocols of Deines (1999)'@en ;
    skos:definition 'An acoustic backscatter calibration protocol described in Deines, K. L. (1999). Backscatter Estimation Using Broadband Acoustic Doppler Current Profilers. In: Anderson, S. P.,Terry, E. A., White, J. A. R., & William, A. J., (Editors), Proceedings of IEEE 6th Working Conference on Current Measurement Technology, pp. 249-253.'@en ;
    skos:notation 'SDN:S05::S050079'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050080/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050080/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050080/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'computation after Folk and Ward (1957)'@en ;
    skos:definition 'The value is a statistic derived from sediment grain size distribution data using the equations published in Folk, R.L., and Ward, W.C. (1957). Brazos River bar, a study in the significance of grain-size parameters. J. Sediment. Petrol. 27:3-26.'@en ;
    skos:notation 'SDN:S05::S050080'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050082/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050082/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050082/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'computation from concentration using Weiss algorithm'@en ;
    skos:definition 'Saturation was computed from actual concentration and theoretical concentrationpredicted from temperature and salinity using the algorithm of Weiss, RF. (1970). The solubility of nitrogen, oxygen and argon in water and seawater. Deep-Sea Research. 17:721-735.'@en ;
    skos:notation 'SDN:S05::S050082'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050083/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050083/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050083/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'computation from cross spectra'@en ;
    skos:definition 'The data have been calculated from a cross spectra analysis: a mathematical covariance function used to identify time-series variations with similar spectral properties, i.e. high power in the same spectral frequency bands.'@en ;
    skos:notation 'SDN:S05::S050083'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050084/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050084/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050084/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'computation from CTD density profile'@en ;
    skos:definition 'The value was derived by determination from a CTD profile of the depth at which the density increased from surface density by the amount given in the parameter definition.'@en ;
    skos:notation 'SDN:S05::S050084'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050085/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050085/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050085/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'computation from CTD temperature profile'@en ;
    skos:definition 'The value was derived by determination from a CTD profile of the depth at which the temperature decreased from surface temperature by the amount given in the parameter definition.'@en ;
    skos:notation 'SDN:S05::S050085'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050086/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050086/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050086/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'computation from fast microstructure temperature'@en ;
    skos:definition 'The parameter has been calculated from the output of a thermistor probe which is capable of resolving high resolution temperature differences in a very small time period.'@en ;
    skos:notation 'SDN:S05::S050086'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050088/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050088/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050088/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'computation from moments as defined by Cartwright and Longuet-Higgins (1956)'@en ;
    skos:definition 'A wave data processing method described in Cartwright and Longuet-Higgins (1956). The statistical distribution of the maxima of a random function. Proc. Roy Soc. A 237:212-232.'@en ;
    skos:notation 'SDN:S05::S050088'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050089/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050089/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050089/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'computation from pH and alkalinity'@en ;
    skos:definition 'The parameter has been calculated from the corresponding pH and alkalinity values.'@en ;
    skos:notation 'SDN:S05::S050089'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050090/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050090/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050090/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'computation from phi size distribution'@en ;
    skos:definition 'The parameter has been calculated from the distribution of grain sizes within the sample as represented on the logarithmic phi scale described in Krumbein & Sloss (1963) Stratigraphy and Sedimentation, 2nd edition; Freeman; San Francisco.'@en ;
    skos:notation 'SDN:S05::S050090'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050091/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050091/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050091/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'computation from pressure, salinity and IPTS-68 temperature using UNESCO algorithm'@en ;
    skos:definition 'The parameter has been calculated from the corresponding pressure, salinity and temperature (on the IPTS-68 scale) values using the algorithm in Fofonoff and Millard (1983). Algorithms for computation of fundamental properties of seawater. UNESCO, Paris.'@en ;
    skos:notation 'SDN:S05::S050091'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050092/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050092/1/>
    a skos:Concept ;
