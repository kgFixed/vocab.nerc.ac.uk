    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050148/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'differencing carbon uptake with and without nitrification inhibitor'@en ;
    skos:definition 'An oxidation rate has been calculated by taking the difference of the carbon uptake in incubation experiments conducted with and without nitrification inhibitors present.'@en ;
    skos:notation 'SDN:S05::S050148'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050149/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050149/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050149/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'volume computation from mass and mean density'@en ;
    skos:definition 'A sediment pore water data processing protocol which involves taking the mass of the sample before and after drying and takes into account the mean density of the sediment.'@en ;
    skos:notation 'SDN:S05::S050149'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050150/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050150/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050150/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'volume computation from weight loss on drying and salt correction'@en ;
    skos:definition 'A sediment pore water data processing protocol which involves taking the mass of the sample before and after drying and takes into account the salinity of the water driven off from the sample during drying.'@en ;
    skos:notation 'SDN:S05::S050150'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050151/1/> .
