    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'correction using Matthew\'s tables'@en ;
    skos:definition 'An echo sounder data correction specified in Matthews (1939). Tables of the Velocity of Sound in Pure Water and Sea Water for Use in Echo-Sounding and Sound- Ranging, 2nd Ed. Hydrographic Department, Ministry of Defense, United Kingdom.'@en ;
    skos:notation 'SDN:S05::S050143'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050144/1/> .
