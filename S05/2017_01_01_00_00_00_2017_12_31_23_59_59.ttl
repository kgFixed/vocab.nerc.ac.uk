    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'computation from volume scatter data'@en ;
    skos:definition 'An optical backscatter data processing protocol where the scattering of light within a volume is used to calculate the values.'@en ;
    skos:notation 'SDN:S05::S050102'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050103/1/> .
