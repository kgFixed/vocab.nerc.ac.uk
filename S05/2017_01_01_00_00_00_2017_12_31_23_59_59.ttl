    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050173/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'unspecified prediction algorithm'@en ;
    skos:definition 'An unspecified computational prediction protocol has been used to derive the data values based on a theoretical model.'@en ;
    skos:notation 'SDN:S05::S050173'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050174/1/> .
