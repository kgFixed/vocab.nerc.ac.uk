    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'computation from wet and dry bulb thermometer data'@en ;
    skos:definition 'Standard meteorological calculation to determine humidity from the degree of cooling produced by evaporation of water.'@en ;
    skos:notation 'SDN:S05::S050105'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050106/1/> .
