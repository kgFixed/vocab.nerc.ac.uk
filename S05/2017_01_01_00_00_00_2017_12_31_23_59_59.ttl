    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050147/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'derivation from the raw data from the light chamber to Kolber et al 1998 biophysical model using Laney v4 2003 software'@en ;
    skos:definition 'The data value has been derived from the light chamber instrument output and software which implements the biophysical model of Kolber, Prasil & Falkowski (1998). Measurements of variable chlorophyll fluorescence using fast repetition rate techniques. I. Defining methodology and experimental protocols. Biochem. Biophys. Acta 1367: 88-106.'@en ;
    skos:notation 'SDN:S05::S050147'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050148/1/> .
