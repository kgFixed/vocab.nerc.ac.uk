    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'correction using Carter\'s tables'@en ;
    skos:definition 'An echo sounder data correction specified in Carter (1980). Echo-Sounding Correction Tables, 3rd Edition. Hydrographic Department, Taunton, UK.'@en ;
    skos:notation 'SDN:S05::S050141'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050142/1/> .
