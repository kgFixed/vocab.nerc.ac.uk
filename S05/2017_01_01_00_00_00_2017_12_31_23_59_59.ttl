    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'computation from travel time averaged from all operational beams and unknown sound velocity profile'@en ;
    skos:definition 'The parameter has been derived from the average of the two-way travel time of all operational acoustic beams on the instrument and using an unspecified sound velocity profile within the water column.'@en ;
    skos:notation 'SDN:S05::S050099'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050100/1/> .
