    skos:notation 'SDN:S05::S050104'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050077/2/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050077/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050077/>;
    dc:modified '2017-08-10T12:25:40'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'calibration against sample data and computation from concentration using Benson and Krause algorithm'@en ;
    skos:definition 'Oxygen concentration was determined by an instrumental measurement calibrated against chemical (generally Winkler Titration) measurements on co-located water samples and saturation was computed according to Benson, B.B., and Krause, D., Jr. 1984. The concentration and isotopic fractionation of oxygen dissolved in freshwater and seawater in equilibrium with the atmosphere. Limnology and Oceanography, 29: 620-632.'@en ;
    skos:notation 'SDN:S05::S050077'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050081/2/> .
