    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'normalisation with biomass expressed as nitrogen'@en ;
    skos:definition 'The data presented have been normalised such that the biomass fraction of the sample defined by the parameter is expressed as nitrogen.'@en ;
    skos:notation 'SDN:S05::S050152'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050153/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050153/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050153/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'processing following SCOR protocol'@en ;
    skos:definition 'A pigment concentration data protocol defined in Jeffrey SW, Humphrey SF (1975) New spectrophotometric equations for determining chlorophylls a, b, c1 and c2 in higher plants, algae and phytoplankton. Biochem. Biophysiol. Planzen, 167, 191-194.'@en ;
    skos:notation 'SDN:S05::S050153'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050154/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050154/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050154/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'processing after Wright and Coffin (1984)'@en ;
    skos:definition 'A technique for calculating grazing turnover of bacteria described in Wright, R.T. and R.B. Coffin. 1984. Measurements of bacterial production and microzooplankton in an estuarine-coastal water system of northern Massachusetts. Microbial Ecology 10: 137-149.'@en ;
    skos:notation 'SDN:S05::S050154'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050155/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050155/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050155/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'recomputation to potential temperature using pCO2*EXP((Theta - T)*0.0423)'@en ;
    skos:definition 'A partial pressure of CO2 data proccessing method where the data are recalculated to a potential temperature scale using the equation pCO2new = pCO2old * EXP((potential temperature - temperature) * 0.0423)'@en ;
    skos:notation 'SDN:S05::S050155'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050156/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050156/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050156/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'recomputation to water location at fixed time using POL NSP model'@en ;
    skos:definition 'A positional data processing method which recomputes the position a sample was taken at to the water location at a fixed time as outlined in Jones (1991). A general purpose model for the North Sea project. NERC News 16: 25-26.'@en ;
    skos:notation 'SDN:S05::S050156'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050157/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050157/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050157/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'salt correction'@en ;
    skos:definition 'A sediment density data processing protocol in which the mass of the dried sample has been corrected for the presence of salt from the water driven off during srying'@en ;
    skos:notation 'SDN:S05::S050157'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050158/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050158/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050158/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'smoothed'@en ;
    skos:definition 'The irradiance field is smoothed as it is defined by an integral smoothing function.'@en ;
    skos:notation 'SDN:S05::S050158'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050159/1/> .
<http://vocab.nerc.ac.uk/collection/S05/current/S050159/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/S05/current/S050159/>;
    dc:modified '2017-04-25T16:24:02'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'standardisation to NBS scale'@en ;
    skos:definition 'The measurements have been standardised to the appropriate scale defined by the United States National Institute of Standards and Technology (formerly the National Standards Bureau).'@en ;
    skos:notation 'SDN:S05::S050159'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/S05/current/S050160/1/> .
