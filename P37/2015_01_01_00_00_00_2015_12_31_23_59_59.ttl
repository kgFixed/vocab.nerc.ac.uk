<feed> tree:member <http://vocab.nerc.ac.uk/collection/P37/current/proleptic_gregorian/1/> .
<http://vocab.nerc.ac.uk/collection/P37/current/proleptic_gregorian/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/P37/current/proleptic_gregorian/>;
    dc:modified '2015-02-18T11:28:48'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'proleptic_gregorian'@en ;
    skos:definition 'A Gregorian calendar extended to dates before the 15th of October 1582. That is, a year is a leap year if either: (i) it is divisible by 4 but not by 100; (ii) it is divisible by 400.'@en ;
    skos:notation 'SDN:P37::proleptic_gregorian'^^xsd:string .
