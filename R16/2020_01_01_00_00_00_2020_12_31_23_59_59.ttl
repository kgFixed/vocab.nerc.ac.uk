@prefix tree: <https://w3id.org/tree#> .
@prefix ldes: <https://w3id.org/ldes#> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

@base <https://kgfixed.github.io/vocab.nerc.ac.uk/R16/2020_01_01_00_00_00_2020_12_31_23_59_59.ttl> .

<>
    a tree:Node
     .

<feed>
  a ldes:EventStream ;
  ldes:timestampPath dc:modified ;
  ldes:versionOfPath dc:isVersionOf ;
  
  
  tree:shape [
    a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path dc:isVersionOf
    ],
    [
      sh:datatype xsd:dateTime ;
      sh:minCount 1 ;
      sh:path dc:modified
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:altLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:prefLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:definition
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:notation
    ];
    sh:targetClass skos:Concept
  ] ;
  tree:view <> ;
  .

<feed> tree:member <http://vocab.nerc.ac.uk/collection/R16/current/BOAVE/1/> .
<http://vocab.nerc.ac.uk/collection/R16/current/BOAVE/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/R16/current/BOAVE/>;
    dc:modified '2020-05-03T20:29:08'^^xsd:dateTime ;
    skos:altLabel 'BOAVE'^^xsd:string ;
    skos:prefLabel 'Bounce sampling: averaged'@en ;
    skos:definition 'Bounce sampling scheme for which the \'averaged\' sampling method was used. The bounce sampling scheme is composed of profiles with N_PROF>1 collected on multiple rises and falls during a single cycle. The profiles are temporally offset from each other and/or the primary sampling profile. The \'averaged\' sampling method refers to profiles where each data point was obtained from binned averages of multiple data measurements (pollings) from a sensor. Bounce sampling scheme profiles can be sampled with the Primary CTD or with auxiliary sensors.'@en ;
    skos:notation 'SDN:R16::BOAVE'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/R16/current/BODIS/1/> .
<http://vocab.nerc.ac.uk/collection/R16/current/BODIS/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/R16/current/BODIS/>;
    dc:modified '2020-05-03T20:29:08'^^xsd:dateTime ;
    skos:altLabel 'BODIS'^^xsd:string ;
    skos:prefLabel 'Bounce sampling: discrete'@en ;
    skos:definition 'Bounce sampling scheme for which the \'discrete\' sampling method was used. The bounce sampling scheme is composed of profiles with N_PROF>1 collected on multiple rises and falls during a single cycle. The profiles are temporally offset from each other and/or the primary sampling profile. The \'discrete\' sampling method refers to profiles where each data point was obtained from a single measurement (polling) from a sensor. Bounce sampling scheme profiles can be sampled with the Primary CTD or with auxiliary sensors.'@en ;
    skos:notation 'SDN:R16::BODIS'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/R16/current/BOMIX/1/> .
<http://vocab.nerc.ac.uk/collection/R16/current/BOMIX/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/R16/current/BOMIX/>;
    dc:modified '2020-05-03T20:29:08'^^xsd:dateTime ;
    skos:altLabel 'BOMIX'^^xsd:string ;
    skos:prefLabel 'Bounce sampling: mixed'@en ;
    skos:definition 'Bounce sampling scheme for which the \'mixed\' sampling method was used. The bounce sampling scheme is composed of profiles with N_PROF>1 collected on multiple rises and falls during a single cycle. The profiles are temporally offset from each other and/or the primary sampling profile. The \'mixed\' sampling method refers to profiles composed of data points obtained by both the \'averaged\' and \'discrete\' sampling methods. Bounce sampling scheme profiles can be sampled with the Primary CTD or with auxiliary sensors.'@en ;
    skos:notation 'SDN:R16::BOMIX'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/R16/current/NSAVGP/1/> .
<http://vocab.nerc.ac.uk/collection/R16/current/NSAVGP/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/R16/current/NSAVGP/>;
    dc:modified '2020-05-03T20:29:08'^^xsd:dateTime ;
    skos:altLabel 'NSAVGP'^^xsd:string ;
    skos:prefLabel 'Near-surface sampling: averaged, pumped'@en ;
    skos:definition 'Near-surface sampling scheme for which the \'averaged\' sampling method was used, and measurements obtained from a pumped CTD stream. The near-surface sampling profile has N_PROF>1. It is composed of measurements focusing on the top 5 dbar of the water column, which may extend deeper so as to overlap with the primary sampling profile for the purpose of cross-calibration. These measurements are taken at pressure levels different from the primary sampling profile, or obtained by a sampling method different from that of the primary sampling profile. The \'averaged\' sampling method refers to profiles where each data point was obtained from binned averages of multiple data measurements (pollings) from a sensor. Primary sampling profiles measuring above 5 dbar should not be labelled with this sampling scheme.'@en ;
    skos:notation 'SDN:R16::NSAVGP'^^xsd:string .
