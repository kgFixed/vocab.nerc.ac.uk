    skos:altLabel 'CEAS'^^xsd:string ;
    skos:prefLabel 'cavity enhanced absorption spectrometers'@en ;
    skos:definition 'Instruments that illuminate a sample inside an optical cavity, typically using laser light, and measure the concentration or amount of a species in gas phase by absorption spectroscopy. Techniques include cavity ring-down spectroscopy (CRDS) and integrated cavity output spectroscopy (ICOS).'@en ;
    skos:notation 'SDN:L05::LAB38'^^xsd:string .
