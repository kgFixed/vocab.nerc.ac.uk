    dc:modified '2012-08-02T14:44:24'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'flow injection analysers'@en ;
    skos:definition 'Instruments that inject a sample into a flowing carrier solution, adding reagents whilst controlling the environment to produce a chemical reaction before passing the sample to a detector.'@en ;
    skos:notation 'SDN:L05::LAB36'^^xsd:string .
