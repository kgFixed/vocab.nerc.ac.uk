    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L05/current/LAB39/>;
    dc:modified '2012-08-30T14:13:49'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Geiger counters'@en ;
    skos:definition 'Instruments that measure the amount of alpha, beta or gamma radiation through quantification of the ionization of a low-pressure gas contained in a tube. Sometimes referred to as Geiger-Müller counters.'@en ;
    skos:notation 'SDN:L05::LAB39'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L05/current/85/1/> .
