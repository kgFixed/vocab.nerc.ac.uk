    dc:modified '2012-08-02T14:45:33'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'flow cytometers'@en ;
    skos:definition 'Instruments that suspend cells in a stream of fluid past detection sensors whilst illuminating them with laser light. Used for cell counting, sorting, biomarker detection and protein engineering.'@en ;
    skos:notation 'SDN:L05::LAB37'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L05/current/LAB36/1/> .
