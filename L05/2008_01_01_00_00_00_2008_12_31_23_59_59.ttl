    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'X-ray diffractometers'@en ;
    skos:definition 'Instruments that identify crystalline solids by measuring the characteristic spaces between layers of atoms or molecules in a crystal.'@en ;
    skos:notation 'SDN:L05::LAB26'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L05/current/151/1/> .
