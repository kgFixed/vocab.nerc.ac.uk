    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'in-situ incubators'@en ;
    skos:definition 'A rig that allows water samples to be retained from where they were collected whilst physically separated from their surroundings.  Includes small-scale incubation rigs and mesocosms.'@en ;
    skos:notation 'SDN:L05::82'^^xsd:string .
