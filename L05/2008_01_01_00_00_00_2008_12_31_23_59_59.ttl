    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'shipboard incubators'@en ;
    skos:definition 'A device mounted on a ship that holds water samples under conditions of controlled temperature or controlled temperature and illumination.'@en ;
    skos:notation 'SDN:L05::81'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L05/current/82/1/> .
<http://vocab.nerc.ac.uk/collection/L05/current/82/1/>
    a skos:Concept ;
