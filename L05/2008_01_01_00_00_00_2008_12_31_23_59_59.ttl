    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L05/current/151/>;
    dc:modified '2008-01-10T15:47:47'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'benthic incubation chambers'@en ;
    skos:definition 'A device that isolates a portion of seabed plus overlying water from its surroundings. Either returns the entire system to the surface or incorporates sampling devices and/or in-situ sensors.'@en ;
    skos:notation 'SDN:L05::151'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L05/current/81/1/> .
<http://vocab.nerc.ac.uk/collection/L05/current/81/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L05/current/81/>;
