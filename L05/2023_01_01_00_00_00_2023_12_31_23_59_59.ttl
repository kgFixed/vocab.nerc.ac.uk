<feed> tree:member <http://vocab.nerc.ac.uk/collection/L05/current/73/1/> .
<http://vocab.nerc.ac.uk/collection/L05/current/73/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L05/current/73/>;
    dc:modified '2023-12-15T09:19:20'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'seine nets'@en ;
    skos:definition 'A surrounding net designed to sample fish that hangs vertically in the water with its bottom edge held down by weights and its top edge buoyed by floats. Seine nets can be deployed from the shore as a beach seine, or from a boat.'@en ;
    skos:notation 'SDN:L05::73'^^xsd:string .
