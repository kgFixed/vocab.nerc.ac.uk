    dc:modified '2023-06-26T10:08:24'^^xsd:dateTime ;
    skos:altLabel 'sample splitters'^^xsd:string ;
    skos:prefLabel 'sample dividers'@en ;
    skos:definition 'A device used to subdivide material samples into two or more representative portions.'@en ;
    skos:notation 'SDN:L05::397'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L05/current/POS27/1/> .
<http://vocab.nerc.ac.uk/collection/L05/current/POS27/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L05/current/POS27/>;
    dc:modified '2023-02-16T16:53:32'^^xsd:dateTime ;
    skos:altLabel 'AIS receivers'^^xsd:string ;
    skos:prefLabel 'Automatic Identification System receivers'@en ;
    skos:definition 'Digital positional awareness systems operating in the Very High Frequency (VHF) maritime band. They allow vessels and marine traffic services to automatically receive identity, position, speed, course, operational status and destination transmitted by other ships and platforms.'@en ;
    skos:notation 'SDN:L05::POS27'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L05/current/LAB52/1/> .
<http://vocab.nerc.ac.uk/collection/L05/current/LAB52/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L05/current/LAB52/>;
    dc:modified '2023-02-16T15:27:39'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'homogenisers'@en ;
    skos:definition 'A piece of laboratory or industrial equipment used to disrupt and make uniform samples of various types of material, such as tissue, plant, food, or soil.'@en ;
    skos:notation 'SDN:L05::LAB52'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L05/current/396/1/> .
<http://vocab.nerc.ac.uk/collection/L05/current/396/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L05/current/396/>;
    dc:modified '2023-02-07T08:13:36'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'parametric sub-bottom profilers'@en ;
    skos:definition 'Marine seismic sources that send sound pulses into the sub-sea floor sediments. The sound pulses bounce off the sea floor and subsequent buried sediment layers according to differences in their acoustic impedance (hardness) and in turn, their density. Parametric sub-bottom profilers are non-linear systems that transmit two different higher frequencies that interact during sound propagation to generate a resultant lower operating frequency with narrow bandwidth. They typically operate at frequencies greater than 2 kHz and penerate to several hundreds of metres.'@en ;
    skos:notation 'SDN:L05::396'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L05/current/394/2/> .
<http://vocab.nerc.ac.uk/collection/L05/current/394/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L05/current/394/>;
    dc:modified '2023-02-07T08:04:18'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Pinger sub-bottom profilers'@en ;
    skos:definition 'Marine seismic sources that send sound pulses into the sub-sea floor sediments. The sound pulses bounce off the sea floor and subsequent buried sediment layers according to differences in their acoustic impedance (hardness) and in turn, their density. Pingers are linear, single channel, high frequency systems that typically operate at frequencies greater than 2 kHz and penetrate to several tens of metres.'@en ;
    skos:notation 'SDN:L05::394'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L05/current/FFES/2/> .
<http://vocab.nerc.ac.uk/collection/L05/current/FFES/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L05/current/FFES/>;
    dc:modified '2023-01-03T09:50:33'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Fish-finder echosounders'@en ;
    skos:definition 'Sonar instruments primarily designed to detect aquatic organisms through directed transmission and reception of acoustic signals. They often utilise multiple frequencies.'@en ;
    skos:notation 'SDN:L05::FFES'^^xsd:string .
