    skos:prefLabel 'telecommunication systems'@en ;
    skos:definition 'Devices or systems that transmit data from one geographic location to another (e.g. WIFI, cellular phone or satellite networks).'@en ;
    skos:notation 'SDN:L05::398'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L05/current/LAB23/2/> .
<http://vocab.nerc.ac.uk/collection/L05/current/LAB23/2/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L05/current/LAB23/>;
    dc:modified '2023-08-29T11:40:47'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'bench fluorometers'@en ;
    skos:definition 'Instruments that determine the amount of chlorophyll in in-vitro samples by measuring the quantity of red light (around 685 nm) emitted following excitation by pulses of blue light (around 460 - 470 nm).'@en ;
    skos:notation 'SDN:L05::LAB23'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L05/current/397/1/> .
