    skos:prefLabel 'Waves'@en ;
    skos:definition 'This APG contains all parameters pertaining to the measurement of:   Wave height  Wave period  Wave direction  Wave energy spectra'@en ;
    skos:notation 'SDN:P03::D034'^^xsd:string .
