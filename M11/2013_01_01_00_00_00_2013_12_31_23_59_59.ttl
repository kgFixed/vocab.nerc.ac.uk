@prefix tree: <https://w3id.org/tree#> .
@prefix ldes: <https://w3id.org/ldes#> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

@base <https://kgfixed.github.io/vocab.nerc.ac.uk/M11/2013_01_01_00_00_00_2013_12_31_23_59_59.ttl> .

<>
    a tree:Node
     .

<feed>
  a ldes:EventStream ;
  ldes:timestampPath dc:modified ;
  ldes:versionOfPath dc:isVersionOf ;
  
  
  tree:shape [
    a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path dc:isVersionOf
    ],
    [
      sh:datatype xsd:dateTime ;
      sh:minCount 1 ;
      sh:path dc:modified
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:altLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:prefLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:definition
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:notation
    ];
    sh:targetClass skos:Concept
  ] ;
  tree:view <> ;
  .

<feed> tree:member <http://vocab.nerc.ac.uk/collection/M11/current/1/1/> .
<http://vocab.nerc.ac.uk/collection/M11/current/1/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/M11/current/1/>;
    dc:modified '2013-11-14T10:15:17'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Ecosystem services'@en ;
    skos:definition 'The conditions and processes through which natural ecosystems, and the species that make them up, sustain and fulfil human life. (Daily, G.C. (Ed) 1997).'@en ;
    skos:notation 'SDN:M11::1'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/M11/current/2/1/> .
<http://vocab.nerc.ac.uk/collection/M11/current/2/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/M11/current/2/>;
    dc:modified '2013-11-14T10:15:17'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Intermediate services'@en ;
    skos:definition 'Intermediate ecological components that contribute to final services, but are not directly consumed, enjoyed or used.  (Boyd & Banzhaf 2007).'@en ;
    skos:notation 'SDN:M11::2'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/M11/current/3/1/> .
<http://vocab.nerc.ac.uk/collection/M11/current/3/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/M11/current/3/>;
    dc:modified '2013-11-14T10:15:17'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Final services'@en ;
    skos:definition 'Components of nature, directly enjoyed, consumed, or used to yield human well-being. (Boyd & Banzhaf 2007).'@en ;
    skos:notation 'SDN:M11::3'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/M11/current/4/1/> .
<http://vocab.nerc.ac.uk/collection/M11/current/4/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/M11/current/4/>;
    dc:modified '2013-11-14T10:15:17'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Benefits'@en ;
    skos:definition 'A measurable improvement to human well-being, derived from one or more ecosystem service(s).  (Boyd & Banzhaf 2007).'@en ;
    skos:notation 'SDN:M11::4'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/M11/current/5/1/> .
<http://vocab.nerc.ac.uk/collection/M11/current/5/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/M11/current/5/>;
    dc:modified '2013-11-14T10:15:17'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Ecological processes and functions'@en ;
    skos:definition 'The physical, chemical, and biological processes or attributes that contribute to the self-maintenance of an ecosystem. (MEA, 2003)'@en ;
    skos:notation 'SDN:M11::5'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/M11/current/8/1/> .
<http://vocab.nerc.ac.uk/collection/M11/current/8/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/M11/current/8/>;
    dc:modified '2013-11-14T10:15:17'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Cultural services'@en ;
    skos:definition 'Ecosystem services that provide non-material benefits for people such as recreational, aesthetic, intellectual and spiritual benefits. (MEA, 2003)'@en ;
    skos:notation 'SDN:M11::8'^^xsd:string .
