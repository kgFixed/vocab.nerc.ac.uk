<feed> tree:member <http://vocab.nerc.ac.uk/collection/R11/current/26/1/> .
<http://vocab.nerc.ac.uk/collection/R11/current/26/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/R11/current/26/>;
    dc:modified '2024-09-11T11:40:41'^^xsd:dateTime ;
    skos:altLabel 'Test 26'^^xsd:string ;
    skos:prefLabel 'TEMP_CNDC test applied to RBRargo3 2K'@en ;
    skos:definition 'TEMP_CNDC test applied to RBRargo3|2K, test added in July 2022. CTD data (< 2000 dbar) (TEMP_CNDC is used in the long timescale thermal inertia correction for RBR salinity data. This test aims to identify vertical profiles where TEMP_CNDC is of bad quality and thus unsuitable for use in the real-time adjustment of RBR salinity data.) Test 26 binary id = 67 108 864.'@en ;
    skos:notation 'SDN:R11::26'^^xsd:string .
