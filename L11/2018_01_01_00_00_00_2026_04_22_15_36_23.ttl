<http://vocab.nerc.ac.uk/collection/L11/current/D34/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L11/current/D34/>;
    dc:modified '2024-01-25T10:55:59'^^xsd:dateTime ;
    skos:altLabel 'NCD_EPSG-1301'^^xsd:string ;
    skos:prefLabel 'Norwegian Chart Datum'@en ;
    skos:definition 'The elevation of the zero metres contour on Norwegian navigation charts as defined by the Norwegian Mapping Authority, Hydrographic Service. The area of extent includes the waters of Norway, Svalbard and Jan Mayen (offshore). EPSG code 1301.'@en ;
