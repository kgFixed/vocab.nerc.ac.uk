<feed> tree:member <http://vocab.nerc.ac.uk/collection/L11/current/D32/1/> .
<http://vocab.nerc.ac.uk/collection/L11/current/D32/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L11/current/D32/>;
    dc:modified '2012-12-12T15:16:55'^^xsd:dateTime ;
    skos:altLabel 'Portuguese_CD'^^xsd:string ;
    skos:prefLabel 'Portuguese Chart Datum'@en ;
    skos:definition 'The elevation of the zero metres contour on Portuguese navigation charts for Portuguese coastal waters. It has been set near the theoretical level reached by the lowest astronomical tide (LAT) calculated from tide gauge data.'@en ;
    skos:notation 'SDN:L11::D32'^^xsd:string .
