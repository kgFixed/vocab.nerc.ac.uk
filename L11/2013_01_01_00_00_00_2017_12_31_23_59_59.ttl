<feed> tree:member <http://vocab.nerc.ac.uk/collection/L11/current/D33/3/> .
<http://vocab.nerc.ac.uk/collection/L11/current/D33/3/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L11/current/D33/>;
    dc:modified '2017-05-22T15:41:48'^^xsd:dateTime ;
    skos:altLabel 'BSCD2000'^^xsd:string ;
    skos:prefLabel 'Baltic Sea Chart Datum 2000'@en ;
    skos:definition 'The elevation of the zero metres contour in the Baltic Sea as approved by the IHO Baltic Sea Hydrographic Commission as the common chart datum for the Baltic Sea. The datum refers to each Baltic country´s realization of the European Vertical Reference System (EVRS), which is connected to the Normaal Amsterdams Peil (NAP).'@en ;
    skos:notation 'SDN:L11::D33'^^xsd:string .
