    skos:altLabel 'local'^^xsd:string ;
    skos:prefLabel 'local reference plane'@en ;
    skos:definition 'A local fixed elevation, usually labelled with a benchmark like a bolt, connected to a national datum through levelling.'@en ;
    skos:notation 'SDN:L11::D22'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L11/current/D09/1/> .
