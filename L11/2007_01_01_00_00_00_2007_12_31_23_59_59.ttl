    skos:altLabel 'ground'^^xsd:string ;
    skos:prefLabel 'ground level'@en ;
    skos:definition 'The level of the land surface at an unspecified location of interest.  Usually associated with meteorological instruments tethered to the ground.'@en ;
    skos:notation 'SDN:L11::D10'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L11/current/D22/1/> .
