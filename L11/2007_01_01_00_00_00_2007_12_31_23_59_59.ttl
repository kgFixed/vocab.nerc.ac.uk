    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L11/current/D09/>;
    dc:modified '2007-02-16T07:52:39'^^xsd:dateTime ;
    skos:altLabel 'sea_floor'^^xsd:string ;
    skos:prefLabel 'sea floor'@en ;
    skos:definition 'The level of the sea floor at the location of interest.  Usually associated with vertical position co-ordinates of oceanographic instruments tethered to the sea floor.'@en ;
    skos:notation 'SDN:L11::D09'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L11/current/D08/1/> .
