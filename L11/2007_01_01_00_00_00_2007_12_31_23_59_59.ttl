    skos:notation 'SDN:L11::D13'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/L11/current/D18/1/> .
<http://vocab.nerc.ac.uk/collection/L11/current/D18/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/L11/current/D18/>;
