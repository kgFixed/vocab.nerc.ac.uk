@prefix tree: <https://w3id.org/tree#> .
@prefix ldes: <https://w3id.org/ldes#> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

@base <https://kgfixed.github.io/vocab.nerc.ac.uk/GS8/2011_01_01_00_00_00_2011_12_31_23_59_59.ttl> .

<>
    a tree:Node
     .

<feed>
  a ldes:EventStream ;
  ldes:timestampPath dc:modified ;
  ldes:versionOfPath dc:isVersionOf ;
  
  
  tree:shape [
    a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path dc:isVersionOf
    ],
    [
      sh:datatype xsd:dateTime ;
      sh:minCount 1 ;
      sh:path dc:modified
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:altLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:prefLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:definition
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:notation
    ];
    sh:targetClass skos:Concept
  ] ;
  tree:view <> ;
  .

<feed> tree:member <http://vocab.nerc.ac.uk/collection/GS8/current/ACSR/1/> .
<http://vocab.nerc.ac.uk/collection/GS8/current/ACSR/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/GS8/current/ACSR/>;
    dc:modified '2011-01-28T12:26:26'^^xsd:dateTime ;
    skos:altLabel 'ActSeisRefr'^^xsd:string ;
    skos:prefLabel 'Active seismic refraction'@en ;
    skos:definition 'The elucidation of geological structure by quantifying the refration of waves from from artificial sources (such as explosions) far away from the measurement site by sub-surface layers.'@en ;
    skos:notation 'SDN:GS8::ACSR'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/GS8/current/PASR/1/> .
<http://vocab.nerc.ac.uk/collection/GS8/current/PASR/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/GS8/current/PASR/>;
    dc:modified '2011-01-28T12:26:26'^^xsd:dateTime ;
    skos:altLabel 'PassSeisRefr'^^xsd:string ;
    skos:prefLabel 'Passive seismic refraction'@en ;
    skos:definition 'The elucidation of geological structure by quantifying the refration of waves from naturally occurring low frequency earth movements (e.g. earthquakes) by sub-surface layers .'@en ;
    skos:notation 'SDN:GS8::PASR'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/GS8/current/SRFL/1/> .
<http://vocab.nerc.ac.uk/collection/GS8/current/SRFL/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/GS8/current/SRFL/>;
    dc:modified '2011-01-28T12:26:26'^^xsd:dateTime ;
    skos:altLabel 'SeisRefl'^^xsd:string ;
    skos:prefLabel 'Seismic reflection'@en ;
    skos:definition 'The elucidation of geological structure by quantifying the proportion of waves from a high energy source reflected by sub-surface layers.'@en ;
    skos:notation 'SDN:GS8::SRFL'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/GS8/current/SRFR/1/> .
<http://vocab.nerc.ac.uk/collection/GS8/current/SRFR/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/GS8/current/SRFR/>;
    dc:modified '2011-01-28T12:26:26'^^xsd:dateTime ;
    skos:altLabel 'SeisRefr'^^xsd:string ;
    skos:prefLabel 'Seismic refraction'@en ;
    skos:definition 'The elucidation of geological structure by quantifying the refration of waves from a high energy source by sub-surface layers.'@en ;
    skos:notation 'SDN:GS8::SRFR'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/GS8/current/SSCN/1/> .
<http://vocab.nerc.ac.uk/collection/GS8/current/SSCN/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/GS8/current/SSCN/>;
    dc:modified '2011-01-28T12:26:26'^^xsd:dateTime ;
    skos:altLabel 'SideScan'^^xsd:string ;
    skos:prefLabel 'Side-scan sonar'@en ;
    skos:definition 'A technique for mapping the morphology of the seafloor using a sonar swath projected sideways from a towed underwater vehicle.'@en ;
    skos:notation 'SDN:GS8::SSCN'^^xsd:string .
