    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Hazard Mitigation'@en ;
    skos:definition 'Any deliberate action that lessens or otherwise avoids the negative effects of a know hazard.'@en ;
    skos:notation 'SDN:A03::HazardMitigation'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A03/current/Hazards/1/> .
