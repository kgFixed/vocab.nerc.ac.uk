<feed> tree:member <http://vocab.nerc.ac.uk/collection/A03/current/Infrastructure/1/> .
<http://vocab.nerc.ac.uk/collection/A03/current/Infrastructure/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A03/current/Infrastructure/>;
    dc:modified '2011-08-19T11:46:42'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Infrastructure'@en ;
    skos:definition 'Infrastructure is a term to describe (usually public) material assets that are essential for the functioning of a society and economy.'@en ;
    skos:notation 'SDN:A03::Infrastructure'^^xsd:string .
