<feed>
  a ldes:EventStream ;
  ldes:timestampPath dc:modified ;
  ldes:versionOfPath dc:isVersionOf ;
  
  
  tree:shape [
    a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
    sh:property [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path dc:isVersionOf
    ],
    [
      sh:datatype xsd:dateTime ;
      sh:minCount 1 ;
      sh:path dc:modified
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:altLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:prefLabel
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:definition
    ],
    [
      sh:datatype xsd:string ;
      sh:minCount 1 ;
      sh:path skos:notation
    ];
    sh:targetClass skos:Concept
  ] ;
  tree:view <> ;
  .

<feed> tree:member <http://vocab.nerc.ac.uk/collection/A03/current/Aquaculture/1/> .
<http://vocab.nerc.ac.uk/collection/A03/current/Aquaculture/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A03/current/Aquaculture/>;
    dc:modified '2011-08-19T11:46:42'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Aquaculture'@en ;
    skos:definition 'Aquaculture is the active cultivation of aquatic organisms. Unlike fishing, aquaculture, also known as aquafarming, implies the cultivation of aquatic populations under controlled conditions.'@en ;
    skos:notation 'SDN:A03::Aquaculture'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A03/current/Atmosphere/1/> .
<http://vocab.nerc.ac.uk/collection/A03/current/Atmosphere/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A03/current/Atmosphere/>;
    dc:modified '2011-08-19T11:46:42'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Atmosphere'@en ;
    skos:definition 'The Earth\'s atmosphere is a layer of gases surrounding the planet Earth and retained by the Earth\'s gravity. It contains roughly (by molar content/volume) 78.08% nitrogen, 20.95% oxygen, 0.93% argon, 0.038% carbon dioxide, trace amounts of other gases, and a variable amount (average around 1%) of water vapor.'@en ;
    skos:notation 'SDN:A03::Atmosphere'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A03/current/Bathymetry/1/> .
<http://vocab.nerc.ac.uk/collection/A03/current/Bathymetry/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A03/current/Bathymetry/>;
    dc:modified '2011-08-19T11:46:42'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Bathymetry'@en ;
    skos:definition 'Bathymetry is the measurement of sea floor elevation relative to sea level.'@en ;
    skos:notation 'SDN:A03::Bathymetry'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A03/current/Beach/1/> .
<http://vocab.nerc.ac.uk/collection/A03/current/Beach/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A03/current/Beach/>;
    dc:modified '2011-08-19T11:46:42'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Beach'@en ;
    skos:definition 'A beach is a gently sloping area of loose material (e.g., sand, gravel, and cobbles) that extend landward from the low-water line to a point where there is a definite change in the material type or landform, or to the line of vegetation. The Oregon Beach bill recognizes public recreational rights or easements to dry sandy beaches all the way to the statuatory vegetation line.'@en ;
    skos:notation 'SDN:A03::Beach'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A03/current/Boundaries/1/> .
<http://vocab.nerc.ac.uk/collection/A03/current/Boundaries/1/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/A03/current/Boundaries/>;
    dc:modified '2011-08-19T11:46:42'^^xsd:dateTime ;
    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Boundaries'@en ;
    skos:definition 'Refers to the human defined edges in the landscape that define areas of different legal or political jurisdiction, and/or ownership.'@en ;
    skos:notation 'SDN:A03::Boundaries'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A03/current/Climate/1/> .
