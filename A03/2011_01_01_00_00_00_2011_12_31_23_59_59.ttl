    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Shoreline stabilization'@en ;
    skos:definition 'Any human action intended to fix or stabilize the location of the shoreline. Common in areas where fluctuation in shoreline position causes a safety hazard (e.g. at river mouths) or threatens infrastructure or other property (coastal stabilization).'@en ;
    skos:notation 'SDN:A03::ShoreStabilization'^^xsd:string .
