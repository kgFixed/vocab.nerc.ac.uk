    skos:altLabel ''^^xsd:string ;
    skos:prefLabel 'Hazard Avoidance'@en ;
    skos:definition 'Practices designed to distance human activities and critical societal infrastructure from known hazardous locations or situations.'@en ;
    skos:notation 'SDN:A03::HazardAvoidance'^^xsd:string .
<feed> tree:member <http://vocab.nerc.ac.uk/collection/A03/current/HazardMitigation/1/> .
