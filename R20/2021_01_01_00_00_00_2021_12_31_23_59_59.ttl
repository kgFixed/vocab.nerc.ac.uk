<feed> tree:member <http://vocab.nerc.ac.uk/collection/R20/current/Y/3/> .
<http://vocab.nerc.ac.uk/collection/R20/current/Y/3/>
    a skos:Concept ;
    dc:isVersionOf <http://vocab.nerc.ac.uk/collection/R20/current/Y/>;
    dc:modified '2021-02-08T16:25:46'^^xsd:dateTime ;
    skos:altLabel 'Y'^^xsd:string ;
    skos:prefLabel 'Grounded, and free-drift period affected'@en ;
    skos:definition 'Yes, the float touched the ground and the programmed free-drift period was affected. If it is uncertain what mission phase the grounding took place, use \'Y\'.'@en ;
    skos:notation 'SDN:R20::Y'^^xsd:string .
