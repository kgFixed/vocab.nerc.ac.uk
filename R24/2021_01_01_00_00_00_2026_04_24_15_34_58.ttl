@base <https://kgfixed.github.io/vocab.nerc.ac.uk/R24/2021_01_01_00_00_00_2026_04_24_15_34_58.ttl> .

<>
    a tree:Node
     ;
    tree:relation [
      a tree:LessThanRelation ;
      tree:node <https://kgfixed.github.io/vocab.nerc.ac.uk/R24/2020_01_01_00_00_00_2020_12_31_23_59_59.ttl> ;
      tree:path dc:modified ;
